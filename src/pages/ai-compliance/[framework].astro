---
/**
 * One AI governance framework, standard, or enforcement record.
 *
 * Body HTML is SRJ's own writing, carried from site_content unchanged. While
 * the copy at srjconsultingservices.com/ai-governance/ remains the indexed
 * original, each page declares that URL as its canonical, so the two sites do
 * not compete. Removing the row in twoai_canonicals flips a page to
 * self-canonical on the next pipeline run.
 */
import Base from '../../layouts/Base.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

export function getStaticPaths() {
  if (!existsSync('content/compliance')) return [];
  // 'index.json' is the hub; 'what-changed.json' is the what-changed digest,
  // not a framework page and has no slug field - excluding it by name here
  // rather than renaming it keeps the digest's own frontend read
  // (ai-compliance/index.astro) working off the same simple path.
  const files = readdirSync('content/compliance').filter((f) => f.endsWith('.json') && f !== 'index.json' && f !== 'what-changed.json' && f !== 'page-reviews.json');
  // Open review items per page, written by the pipeline's enactment trigger.
  // A governor-stage bill event opens one against the state's page; it stays
  // until the prose is updated and someone clears it. Absent file means no
  // reviews, not an error.
  const reviewsPath = 'content/compliance/page-reviews.json';
  const reviewsDoc = existsSync(reviewsPath) ? JSON.parse(readFileSync(reviewsPath, 'utf8')) : {};
  const reviews = reviewsDoc.reviews || {};
  const reviewed = reviewsDoc.reviewed || {};
  const titles = {};
  const docs = [];
  for (const f of files) {
    const d = JSON.parse(readFileSync(`content/compliance/${f}`, 'utf8'));
    // Only files with a slug are framework pages. enacted-ai-laws.json lives
    // in this directory but is a section page rendered under the ecosystem
    // category by uid; passing its undefined slug as a param fails the whole
    // build ("Missing parameter: framework"), which is exactly what happened
    // the day the enactment trigger first published it.
    if (!d.slug) continue;
    titles[d.slug] = d.title;
    docs.push(d);
  }
  return docs.map((d) => ({ params: { framework: d.slug }, props: { d, titles, reviews: reviews[d.slug] || [], reviewedOn: reviewed[d.slug] || null } }));
}
const { d, titles, reviews, reviewedOn } = Astro.props;
const desc = (d.meta_description || d.short || d.subtitle || d.title).slice(0, 300);
const steps = d.howto?.steps || [];
const cites = d.citations || [];
const kids = (d.children || []).filter((k) => titles[k]);
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': steps.length ? 'HowTo' : 'Article',
  name: d.howto?.name || d.title,
  headline: d.title,
  description: desc,
  url: `https://theworldofai.org/ai-compliance/${d.slug}/`,
  dateModified: d.generated,
  ...(steps.length
    ? { step: steps.map((s) => ({ '@type': 'HowToStep', name: s.name, text: s.text })) }
    : {}),
  publisher: {
    '@type': 'Organization',
    name: 'SRJ Consulting & Services LLC',
    url: 'https://srjconsultingservices.com/',
  },
});
---
<Base title={d.seo_title || `${d.title} — The World of AI`} description={desc}
  current="/ai-compliance/" jsonld={jsonld} canonicalOverride={d.canonical} doc={d} stampLabel="Last reviewed">
  <p class="meta-line"><a href="/">AI Ecosystem</a> ·
    <a href="/ai-compliance/">Governance frameworks</a>
    {d.parent && titles[d.parent] && <> · <a href={`/ai-compliance/${d.parent}/`}>{titles[d.parent]}</a></>}</p>

  <h1>{d.title}</h1>
  {d.subtitle && <p class="lede">{d.subtitle}</p>}
  {d.short && <p class="answer">{d.short}</p>}
  {/* TWO DATES, HONESTLY LABELLED. generated is the build date and moves
      every run; on its own it read "Last verified: today" over guidance
      nobody had touched in weeks. reviewedOn is site_content.updated_at,
      the date a person last changed the words. A reader deciding whether to
      trust this page needs the second one. */}
  {(reviewedOn || d.generated) && (
    <p class="meta-line">
      {reviewedOn && <>Guidance last updated: <time datetime={reviewedOn}>{reviewedOn}</time></>}
      {reviewedOn && d.generated && <> · </>}
      {d.generated && <>Page built: <time datetime={d.generated}>{d.generated}</time></>}
    </p>
  )}

  {/* THE GUIDANCE IS BEHIND THE LAW, AND THE PAGE SAYS SO.

      Stephen, 2026-09-10: intelligence from the news must feed AI governance
      automatically, not sit in a link. California signed SB 813 and AB 1405
      on 09-09, the first state AI auditing regime; the pipeline had the bill
      record hours later and this page kept describing California law as it
      stood before either bill existed, because nothing connected a bill
      event to the page it changes.

      Now it does. The enactment trigger opens a review item against the
      state's compliance page when a bill is presented to, signed by or vetoed
      by the governor, and this block renders it until the prose is updated
      and the item cleared. It is not a rewrite - a model is not allowed to
      change legal guidance on its own - it is the honest state: a reader can
      see the guidance predates the law, with the primary source to hand,
      rather than trusting a page that looks current and is not. */}
  {reviews.length > 0 && (
    <aside class="law-review" aria-label="Legislative changes since this page was reviewed">
      <p class="law-review-label">Changed since this guidance was reviewed</p>
      <ul>
        {reviews.map((r) => (
          <li>
            <strong>{r.ref}</strong> — {r.summary}
            {r.source_url && <> <a href={r.source_url} rel="noopener" target="_blank">Legislative record</a>.</>}
            <span class="n"> Detected {r.opened_on}.</span>
          </li>
        ))}
      </ul>
      <p class="law-review-foot">Detected automatically from the legislative record. The guidance on this page has not yet been reviewed against the enacted text.</p>
    </aside>
  )}

  {/* AN UNCLOSED ANCHOR MUST NOT REPAINT THE PAGE. A single missing </a> in
      the stored HTML left the anchor open for the rest of the document, and
      every paragraph after it rendered in link orange: Stephen screenshotted
      the DCAM page reading that way on 2026-08-31. The source was repaired in
      SQL, but a body written elsewhere can break again, so the container also
      pins its own text colour. A link inside still looks like a link; an
      unclosed one can no longer take the page with it. */}
  <div class="body" set:html={d.body_html} />

  {/* The siting watch. Ordinances, moratoria and utility rulings land in the
      policy-news intake every day; without this they stopped at the daily
      briefing and this page went stale between edits. Each row is a headline
      and its source, nothing more - the analysis belongs in the body above,
      written after somebody has read the ordinance. */}
  {Array.isArray(d.siting_watch) && d.siting_watch.length > 0 && (
    <section class="siting-watch">
      <h2>Recent siting, zoning and utility activity</h2>
      <p>Reported decisions and proposals that bear on where data centres may be built and
        who pays for their power, collected daily from the policy news intake. These are
        headlines with their sources; where one has been read and written into the regimes
        above, it appears there with the ordinance or docket cited.</p>
      <ul>
        {d.siting_watch.map((w) => (
          <li>
            <a href={w.url} rel="noopener" target="_blank">{w.title}</a>
            <span class="sw-meta">
              {w.jurisdiction ? `${w.jurisdiction} · ` : ''}
              {w.kind ? `${w.kind} · ` : ''}
              {w.publisher}{w.date ? ` · ${w.date}` : ''}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {steps.length > 0 && (
    <>
      <h2>{d.howto?.name || 'How to comply'}</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li><b>{s.name}.</b> {s.text}</li>
        ))}
      </ol>
    </>
  )}

  {kids.length > 0 && (
    <>
      <h2>Within this framework</h2>
      <ul>{kids.map((k) => <li><a href={`/ai-compliance/${k}/`}>{titles[k]}</a></li>)}</ul>
    </>
  )}

  {cites.length > 0 && (
    <>
      <h2>Sources</h2>
      {/* THE TEMPLATE READ FIELDS THE DATA DOES NOT CARRY. Stephen, 2026-09-11:
          a row of empty bullets under Sources, on a lot of pages, very ugly.
          Every compliance page showed it. The citations in twoai_pages carry
          author, year, journal and quote - real scholarly references - and
          this list rendered title, url and publisher, none of which exist on
          those objects, so every <li> came out blank. Same failure shape as
          the person template on 2026-09-01: a silent mismatch between what a
          template reads and what the data holds, invisible in JSX because a
          missing property is undefined rather than an error.

          Now it renders the citation as a citation - author, year, journal,
          and the quote where there is one - while still supporting the
          title/url/publisher shape, because other pages that share this
          template do use it. And an entry with nothing renderable is dropped
          rather than printed as a bullet with no content: an empty bullet is
          never the right output. */}
      <ul class="cites">
        {cites.map((c) => {
          const label = c.title || c.author || '';
          const bits = [c.journal || c.publisher, c.year].filter(Boolean).join(', ');
          if (!label && !bits && !c.quote && !c.url) return null;
          return (
            <li>
              {c.url
                ? <a href={c.url} rel="noopener">{label || c.url}</a>
                : <b>{label}</b>}
              {bits && <> · {bits}</>}
              {c.quote && <div class="cite-quote">“{c.quote}”</div>}
            </li>
          );
        })}
      </ul>
    </>
  )}

  <div class="cite-box">Cite this page: <code>"{d.title}." The World of AI,
    theworldofai.org/ai-compliance/{d.slug}/.{d.generated ? ` Verified ${d.generated}.` : ''}</code></div>

  <p class="meta-line">This is reference material, not legal advice. See our
    <a href="/disclaimer/">disclaimer</a>. Advisory work on these frameworks is handled by
    <a href="https://srjconsultingservices.com/" rel="noopener">SRJ Consulting &amp; Services</a>.</p>
</Base>

<style>
  /* Text colour is pinned so a malformed link in the stored HTML cannot
     inherit its colour onto everything that follows it. These need :global()
     because the body is injected with set:html and carries none of Astro's
     scoping attributes, which is why the first version of this rule compiled
     to nothing at all. */
  .body { color: var(--ink); }
  .body :global(p), .body :global(li), .body :global(td), .body :global(th),
  .body :global(h2), .body :global(h3), .body :global(h4), .body :global(strong) { color: var(--ink); }
  .body :global(a) { color: var(--orange); }
  .lede { font-size: 1.08rem; color: #3d3d46; margin: 0 0 .6em; }
  .body :global(h2) { font-size: 1.2rem; margin-top: 1.6em; }
  .body :global(h3) { font-size: 1.03rem; margin-top: 1.3em; }
  .body :global(p) { margin: 0 0 .9em; }
  .body :global(ul), .body :global(ol) { margin: 0 0 1em; padding-left: 1.2em; }
  .body :global(li) { margin-bottom: .4em; }
  .body :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 1.2em; }
  .body :global(th), .body :global(td) {
    border: 1px solid #e7e7ee; padding: 8px 10px; text-align: left; font-size: .93rem;
  }
  .steps li { margin-bottom: .7em; }
  .siting-watch { margin: 2em 0 1.5em; padding-top: 1.2em; border-top: 1px solid #e6e6ef; }
  .siting-watch ul { list-style: none; padding: 0; margin: 1em 0 0; }
  .siting-watch li { padding: .6em 0; border-bottom: 1px solid #ececf2; }
  .siting-watch .sw-meta { display: block; font-size: 12.5px; color: #7A8A9E; margin-top: 2px; text-transform: capitalize; }
  .cites { font-size: .92rem; }
  .cites li { margin-bottom: .35em; }
  .cite-quote { margin: .2em 0 .1em; font-style: italic; color: #5d6470; }
  /* The review flag. Cream ground and an orange rule so it reads as a notice
     the way the answer box does, not as an error and not as decoration. It
     sits above the body because a reader should know the guidance is behind
     before reading it, not after. */
  .law-review { margin: 1.2em 0 1.6em; padding: 14px 18px; background: #fff7ec; border-left: 4px solid var(--orange); }
  .law-review-label { margin: 0 0 .5em; font: 600 12px/1.3 Poppins, sans-serif; letter-spacing: .12em; text-transform: uppercase; color: var(--navy); }
  .law-review ul { list-style: none; margin: 0; padding: 0; }
  .law-review li { margin: 0 0 .6em; font-size: .95rem; }
  .law-review .n { color: #7A8A9E; font-size: 12.5px; }
  .law-review-foot { margin: .6em 0 0; font-size: 12.5px; color: #5d6470; }
</style>

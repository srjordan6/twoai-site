---
/**
 * One AI governance framework, standard, or enforcement record.
 *
 * Body HTML is SRJ's own writing, carried from site_content unchanged. While
 * the copy at srjconsultingservices.com/ai-governance/ remains the indexed
 * original, each page declares that URL as its canonical, so the two sites do
 * not compete. Removing the row in twoai_canonicals flips a page to
 * self-canonical on the next pipeline run.
 */
import Base from '../../layouts/Base.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

export function getStaticPaths() {
  if (!existsSync('content/compliance')) return [];
  // 'index.json' is the hub; 'what-changed.json' is the what-changed digest,
  // not a framework page and has no slug field - excluding it by name here
  // rather than renaming it keeps the digest's own frontend read
  // (ai-compliance/index.astro) working off the same simple path.
  const files = readdirSync('content/compliance').filter((f) => f.endsWith('.json') && f !== 'index.json' && f !== 'what-changed.json');
  const titles = {};
  const docs = [];
  for (const f of files) {
    const d = JSON.parse(readFileSync(`content/compliance/${f}`, 'utf8'));
    // Only files with a slug are framework pages. enacted-ai-laws.json lives
    // in this directory but is a section page rendered under the ecosystem
    // category by uid; passing its undefined slug as a param fails the whole
    // build ("Missing parameter: framework"), which is exactly what happened
    // the day the enactment trigger first published it.
    if (!d.slug) continue;
    titles[d.slug] = d.title;
    docs.push(d);
  }
  return docs.map((d) => ({ params: { framework: d.slug }, props: { d, titles } }));
}
const { d, titles } = Astro.props;
const desc = (d.meta_description || d.short || d.subtitle || d.title).slice(0, 300);
const steps = d.howto?.steps || [];
const cites = d.citations || [];
const kids = (d.children || []).filter((k) => titles[k]);
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': steps.length ? 'HowTo' : 'Article',
  name: d.howto?.name || d.title,
  headline: d.title,
  description: desc,
  url: `https://theworldofai.org/ai-compliance/${d.slug}/`,
  dateModified: d.generated,
  ...(steps.length
    ? { step: steps.map((s) => ({ '@type': 'HowToStep', name: s.name, text: s.text })) }
    : {}),
  publisher: {
    '@type': 'Organization',
    name: 'SRJ Consulting & Services LLC',
    url: 'https://srjconsultingservices.com/',
  },
});
---
<Base title={d.seo_title || `${d.title} — The World of AI`} description={desc}
  current="/ai-compliance/" jsonld={jsonld} canonicalOverride={d.canonical}>
  <p class="meta-line"><a href="/">AI Ecosystem</a> ·
    <a href="/ai-compliance/">Governance frameworks</a>
    {d.parent && titles[d.parent] && <> · <a href={`/ai-compliance/${d.parent}/`}>{titles[d.parent]}</a></>}</p>

  <h1>{d.title}</h1>
  {d.subtitle && <p class="lede">{d.subtitle}</p>}
  {d.short && <p class="answer">{d.short}</p>}
  {d.generated && <p class="meta-line">Last verified: <time datetime={d.generated}>{d.generated}</time></p>}

  {/* AN UNCLOSED ANCHOR MUST NOT REPAINT THE PAGE. A single missing </a> in
      the stored HTML left the anchor open for the rest of the document, and
      every paragraph after it rendered in link orange: Stephen screenshotted
      the DCAM page reading that way on 2026-08-31. The source was repaired in
      SQL, but a body written elsewhere can break again, so the container also
      pins its own text colour. A link inside still looks like a link; an
      unclosed one can no longer take the page with it. */}
  <div class="body" set:html={d.body_html} />

  {/* The siting watch. Ordinances, moratoria and utility rulings land in the
      policy-news intake every day; without this they stopped at the daily
      briefing and this page went stale between edits. Each row is a headline
      and its source, nothing more - the analysis belongs in the body above,
      written after somebody has read the ordinance. */}
  {Array.isArray(d.siting_watch) && d.siting_watch.length > 0 && (
    <section class="siting-watch">
      <h2>Recent siting, zoning and utility activity</h2>
      <p>Reported decisions and proposals that bear on where data centres may be built and
        who pays for their power, collected daily from the policy news intake. These are
        headlines with their sources; where one has been read and written into the regimes
        above, it appears there with the ordinance or docket cited.</p>
      <ul>
        {d.siting_watch.map((w) => (
          <li>
            <a href={w.url} rel="noopener" target="_blank">{w.title}</a>
            <span class="sw-meta">
              {w.jurisdiction && <>{w.jurisdiction} · </>}
              {w.kind && <>{w.kind} · </>}
              {w.publisher}{w.date && <> · {w.date}</>}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {steps.length > 0 && (
    <>
      <h2>{d.howto?.name || 'How to comply'}</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li><b>{s.name}.</b> {s.text}</li>
        ))}
      </ol>
    </>
  )}

  {kids.length > 0 && (
    <>
      <h2>Within this framework</h2>
      <ul>{kids.map((k) => <li><a href={`/ai-compliance/${k}/`}>{titles[k]}</a></li>)}</ul>
    </>
  )}

  {cites.length > 0 && (
    <>
      <h2>Sources</h2>
      <ul class="cites">
        {cites.map((c) => (
          <li>{c.url
            ? <a href={c.url} rel="noopener">{c.title || c.url}</a>
            : (c.title || '')}{c.publisher && <> · {c.publisher}</>}</li>
        ))}
      </ul>
    </>
  )}

  <div class="cite-box">Cite this page: <code>"{d.title}." The World of AI,
    theworldofai.org/ai-compliance/{d.slug}/.{d.generated ? ` Verified ${d.generated}.` : ''}</code></div>

  <p class="meta-line">This is reference material, not legal advice. See our
    <a href="/disclaimer/">disclaimer</a>. Advisory work on these frameworks is handled by
    <a href="https://srjconsultingservices.com/" rel="noopener">SRJ Consulting &amp; Services</a>.</p>
</Base>

<style>
  /* Text colour is pinned so a malformed link in the stored HTML cannot
     inherit its colour onto everything that follows it. These need :global()
     because the body is injected with set:html and carries none of Astro's
     scoping attributes, which is why the first version of this rule compiled
     to nothing at all. */
  .body { color: var(--ink); }
  .body :global(p), .body :global(li), .body :global(td), .body :global(th),
  .body :global(h2), .body :global(h3), .body :global(h4), .body :global(strong) { color: var(--ink); }
  .body :global(a) { color: var(--orange); }
  .lede { font-size: 1.08rem; color: #3d3d46; margin: 0 0 .6em; }
  .body :global(h2) { font-size: 1.2rem; margin-top: 1.6em; }
  .body :global(h3) { font-size: 1.03rem; margin-top: 1.3em; }
  .body :global(p) { margin: 0 0 .9em; }
  .body :global(ul), .body :global(ol) { margin: 0 0 1em; padding-left: 1.2em; }
  .body :global(li) { margin-bottom: .4em; }
  .body :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 1.2em; }
  .body :global(th), .body :global(td) {
    border: 1px solid #e7e7ee; padding: 8px 10px; text-align: left; font-size: .93rem;
  }
  .steps li { margin-bottom: .7em; }
  .siting-watch { margin: 2em 0 1.5em; padding-top: 1.2em; border-top: 1px solid #e6e6ef; }
  .siting-watch ul { list-style: none; padding: 0; margin: 1em 0 0; }
  .siting-watch li { padding: .6em 0; border-bottom: 1px solid #ececf2; }
  .siting-watch .sw-meta { display: block; font-size: 12.5px; color: #7A8A9E; margin-top: 2px; text-transform: capitalize; }
  .cites { font-size: .92rem; }
  .cites li { margin-bottom: .35em; }
</style>

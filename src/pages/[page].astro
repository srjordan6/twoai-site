---
// Static pages (about, contact, privacy, terms, disclaimer, disclosure).
// Copy lives in SQL (site_content, twoai/static/*.json), is rendered by the
// pipeline into twoai-content/static/, and is only read here. Nothing on this
// page is authored in the template.
import Base from '../layouts/Base.astro';
import Reading from '../components/Reading.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';
import { EDITOR_PERSON } from '../lib/editor';

export function getStaticPaths() {
  if (!existsSync('content/static')) return [];
  return readdirSync('content/static')
    .filter((f) => f.endsWith('.json'))
    .map((f) => {
      const d = JSON.parse(readFileSync(`content/static/${f}`, 'utf8'));
      return { params: { page: d.slug }, props: { d } };
    })
    // 2026-09-21: static/gaps.json (the twoai_gaps measures) landed in this
    // folder with no slug and no sections. It is data, not a page, and one
    // file without a slug failed getStaticPaths, and with it every Workers
    // Build from at least 11:49 UTC. Only a file that is a page becomes a route.
    .filter((p) => p.params.page && Array.isArray(p.props.d.sections));
}
const { d } = Astro.props;
// THE EDITOR PAGE. Stephen, 2026-10-02 (theworldofai row 370): /stephen-jordan/
// is the author page Google News reads, so it carries a ProfilePage with the
// Person as its main entity, the same person every NewsArticle names as
// editor. Every other static page stays a WebPage.
const isEditor = d.slug === 'stephen-jordan';
const jsonld = JSON.stringify(isEditor ? {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: d.title,
  description: d.description,
  url: `https://theworldofai.org/${d.slug}/`,
  dateModified: d.updated,
  isPartOf: { '@type': 'WebSite', name: 'The World of AI', url: 'https://theworldofai.org/' },
  // The one Person every NewsArticle names as editor (row 420).
  mainEntity: EDITOR_PERSON,
} : {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: d.title,
  description: d.description,
  url: `https://theworldofai.org/${d.slug}/`,
  dateModified: d.updated,
  isPartOf: { '@type': 'WebSite', name: 'The World of AI', url: 'https://theworldofai.org/' },
  publisher: {
    '@type': 'Organization',
    name: 'SRJ Consulting & Services LLC',
    url: 'https://srjconsultingservices.com/',
  },
});
---

<Base title={`${d.title} — The World of AI`} description={d.description} jsonld={jsonld}>
  <article class="doc">
    <h1>{d.title}</h1>
    <p class="lede">{d.description}</p>
    <p class="verified">Last updated: <time datetime={d.updated}>{d.updated}</time></p>
    {d.sections.map((s) => (
      <section>
        <h2>{s.h}</h2>
        <div set:html={s.body} />
      </section>
    ))}
    <Reading reading={d.reading} heading={`What does this ${d.title.toLowerCase()} page commit us to?`} />
    <p class="doc-foot">
      Questions or a correction for this page? Email
      <a href="mailto:theworldofai@inkboxmail.com">theworldofai@inkboxmail.com</a>.
      For consulting, <a href="mailto:info@srjconsultingservices.com">info@srjconsultingservices.com</a>.
    </p>
  </article>
</Base>

<style>
  .doc { max-width: 760px; }
  .lede { font-size: 1.08rem; color: #3d3d46; margin: 0 0 .5em; }
  .verified { font-size: .82rem; color: var(--gray); margin: 0 0 2.2em;
    padding-bottom: 1.2em; border-bottom: 1px solid #e7e7ee; }
  .doc section { margin-bottom: 1.9em; }
  .doc h2 { font-size: 1.22rem; margin-top: 0; }
  .doc :global(p) { margin: 0 0 .9em; }
  .doc :global(ul) { margin: 0 0 .9em; padding-left: 1.2em; }
  .doc :global(li) { margin-bottom: .4em; }
  .doc :global(ol.path) { padding-left: 1.4em; margin: 0 0 1em; }
  .doc :global(ol.path > li) { margin-bottom: 1em; padding-left: .2em; }
  .doc :global(ol.path > li p) { margin: 0 0 .25em; }
  /* Tables, first used by /data-quality/ (2026-09-28). Wide tables scroll
     inside their own box so the page never scrolls sideways on a phone. */
  .doc :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 1.2em;
    font-size: .88rem; display: block; overflow-x: auto; }
  .doc :global(th) { text-align: left; font-weight: 600; color: var(--navy);
    border-bottom: 2px solid var(--orange); padding: .5em .6em; white-space: nowrap; }
  .doc :global(td) { border-bottom: 1px solid #e7e7ee; padding: .5em .6em; vertical-align: top; }
  .doc :global(tbody tr:nth-child(even)) { background: #f7f7fb; }
  .doc-foot { margin-top: 2.6em; padding-top: 1.2em; border-top: 1px solid #e7e7ee;
    font-size: .9rem; color: var(--gray); }
</style>

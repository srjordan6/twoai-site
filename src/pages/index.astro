---
/**
 * Home page: the AI Ecosystem map.
 *
 * The site's front door is its structure, on Stephen's instruction 2026-08-02.
 * A reader landing here should see the whole field laid out, what is covered
 * and what is not, rather than a marketing page for four sections.
 *
 * This renders the same taxonomy as /ai-ecosystem/, so that path now redirects
 * here rather than serving a second copy: two URLs with identical content is a
 * duplicate we would be creating on purpose. The category pages stay where they
 * are at /ai-ecosystem/{category}/.
 *
 * The ask box moved out to src/components/AskBox.astro on 2026-08-31 so that
 * /sources/ could carry the same one. Markup, script and stylesheet all lived
 * here; a copy would have forked the moment either page was touched.
 */
import Base from '../layouts/Base.astro';
import AskBox from '../components/AskBox.astro';
import Hero from '../components/Hero.astro';
import { readFileSync, existsSync } from 'node:fs';

const j = (p) => (existsSync(p) ? JSON.parse(readFileSync(p, 'utf8')) : null);
const idx = j('content/ecosystem/index.json') || { categories: [], generated: '' };
const cats = idx.categories || [];
const laws = j('content/laws/index.json');
const glossary = j('content/glossary/glossary.json');
const suits = j('content/lawsuits/lawsuits.json');

const billTotal = laws?.total ?? 0;
const termTotal = glossary?.count ?? glossary?.terms?.length ?? 0;
const caseTotal = suits?.count ?? 0;
// The MCP registry count, read from the same index the directory renders, so
// the hero cannot claim a number the directory contradicts.
const mcpIdx = j('content/mcp/index.json');
const mcpTotal = mcpIdx?.total ?? 0;
const totalPages = cats.reduce((n, c) => n + c.pages, 0);
const generated = idx.generated || laws?.generated || '';

const desc =
  'The AI Ecosystem: an atlas of artificial intelligence covering the technology, the market, ' +
  'the research layer, and enterprise governance. Rebuilt daily from primary sources.';
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The World of AI',
  description: desc,
  url: 'https://theworldofai.org/',
  dateModified: generated,
  datePublished: '2026-08-01',
  inLanguage: 'en',
  // WHO STANDS BEHIND THIS. An AEO audit flagged "no author information" as
  // its one critical issue. A byline would be a fiction here: these pages are
  // generated from a database, not written by a person, and inventing an
  // author to satisfy a checker is exactly the kind of thing this site tells
  // other people not to do. The honest equivalent is the publisher, which was
  // genuinely missing from the schema and is now stated.
  publisher: {
    '@type': 'Organization',
    name: 'SRJ Consulting & Services LLC',
    url: 'https://srjconsultingservices.com/',
  },
  hasPart: cats.map((c) => ({
    '@type': 'CollectionPage',
    name: c.name,
    url: `https://theworldofai.org/ai-ecosystem/${c.slug}/`,
  })),
});
---
<Base rail={false} title="The World of AI — the AI Ecosystem, mapped and tracked daily" description={desc} jsonld={jsonld}>
  <Hero slot="bleed" bills={billTotal} terms={termTotal} cases={caseTotal}
    servers={mcpTotal} generated={generated} />


  <AskBox />

  {cats.map((c) => (
    <div class="cat">
      <h2><a href={`/ai-ecosystem/${c.slug}/`}>{c.name}</a></h2>
      <p>{c.blurb}</p>
      <p class="meta-line">{c.live} of {c.total} domains live
        {c.pages > 0 && <> · {c.pages.toLocaleString()} pages published</>}</p>
    </div>
  ))}

  {cats.length === 0 && (
    <ul class="grid">
      <li class="card"><a href="/ai-laws/">AI Laws by State</a><p>Every AI bill in all 50 states, DC, Puerto Rico, and Congress.</p></li>
      <li class="card"><a href="/ai-glossary/">AI Glossary</a><p>AI terms defined in plain English, built to be cited.</p></li>
      <li class="card"><a href="/ai-lawsuits/">AI Lawsuit Tracker</a><p>Living case pages with dockets checked daily.</p></li>
      <li class="card"><a href="/calculators/">AI Calculators</a><p>Cost, memory, context, energy, and ROI estimators.</p></li>
    </ul>
  )}

  {/* "What is not here yet" removed on Stephen's instruction 2026-08-20.
      It was written when domains were genuinely unbuilt and it earned its place
      then: a reference whose gaps you cannot see is one you cannot rely on. All
      29 are live now, so the block rendered "0 of the 29 domains above are named
      but not yet built" - a paragraph explaining an absence that no longer
      exists, which reads as uncertainty about a site that has none.
      The principle stands and is still enforced elsewhere: sections with no
      sourced content stay empty and say so, as the Downloads hub does. */}

  <h2>Free data, free citations</h2>
  <p>Everything here is machine-readable: <a href="/api/laws.json">laws.json</a>,
    <a href="/api/glossary.json">glossary.json</a>, <a href="/api/lawsuits.json">lawsuits.json</a>,
    <a href="/api/tools.json">tools.json</a>, <a href="/api/compliance.json">compliance.json</a>,
    and <a href="/api/weeks.json">weeks.json</a> mirror the pages exactly, and
    <a href="/llms.txt">llms.txt</a> explains the site to AI assistants. Cite any page; every one
    carries its own verification date.</p>
</Base>

<style>
  .cat { padding: 1.2em 0; border-bottom: 1px solid #ececf2; }
  .cat h2 { margin: 0 0 .3em; font-size: 1.18rem; }
  .cat p { margin: 0 0 .35em; }
</style>

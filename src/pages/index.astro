---
import Base from '../layouts/Base.astro';
import { readFileSync, existsSync } from 'node:fs';

const j = (p) => existsSync(p) ? JSON.parse(readFileSync(p, 'utf8')) : null;
const laws = j('content/laws/index.json');
const glossary = j('content/glossary/glossary.json');
const suits = j('content/lawsuits/lawsuits.json');
const billTotal = laws?.total ?? 0;
const termTotal = glossary?.count ?? glossary?.terms?.length ?? 0;
const caseTotal = suits?.count ?? 0;
const generated = laws?.generated ?? suits?.generated ?? '';
const desc = 'The atlas of artificial intelligence: every state AI law, every major AI lawsuit, and the language of AI, rebuilt from primary sources daily.';
---
<Base title="The World of AI — AI laws, lawsuits, and language, tracked daily" description={desc}>
  <section class="home-hero">
    <h1>The atlas of artificial intelligence.</h1>
    <p class="lead">AI is being legislated, litigated, and renamed faster than anyone can follow by
      hand. This site follows it by machine: every page below is rebuilt daily from primary
      sources, LegiScan for legislation, CourtListener for dockets, and the Federal Register,
      then published with the date it was last verified.</p>
    <div class="stat-row">
      <div class="stat"><b>{billTotal.toLocaleString()}</b><span>state AI bills tracked</span></div>
      <div class="stat"><b>{termTotal}</b><span>terms defined</span></div>
      <div class="stat"><b>{caseTotal}</b><span>lawsuits followed live</span></div>
    </div>
    {generated && <p class="meta-line">Last data refresh: {generated}</p>}
  </section>

  <ul class="grid">
    <li class="card">
      <a href="/ai-laws/">AI Laws by State</a>
      <p>Every AI bill in all 50 states, DC, Puerto Rico, and Congress, grouped by jurisdiction
        and linked to the official text.</p>
    </li>
    <li class="card">
      <a href="/ai-glossary/">AI Glossary</a>
      <p>{termTotal || 'Hundreds of'} AI terms defined in plain English, each with origin and a
        real example. Built to be cited.</p>
    </li>
    <li class="card">
      <a href="/ai-lawsuits/">AI Lawsuit Tracker</a>
      <p>Living case pages for the copyright, privacy, and safety suits shaping AI, with dockets
        checked daily.</p>
    </li>
  </ul>

  <h2>Free data, free citations</h2>
  <p>Everything here is also machine-readable: <a href="/api/laws.json">laws.json</a>,
    <a href="/api/glossary.json">glossary.json</a>, and
    <a href="/api/lawsuits.json">lawsuits.json</a> mirror the pages exactly, and
    <a href="/llms.txt">llms.txt</a> explains the site to AI assistants. Cite any page; every one
    carries its own verification date.</p>
</Base>

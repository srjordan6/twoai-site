---
/**
 * Home page: the AI Ecosystem map.
 *
 * The site's front door is its structure, on Stephen's instruction 2026-08-02.
 * A reader landing here should see the whole field laid out, what is covered
 * and what is not, rather than a marketing page for four sections.
 *
 * This renders the same taxonomy as /ai-ecosystem/, so that path now redirects
 * here rather than serving a second copy: two URLs with identical content is a
 * duplicate we would be creating on purpose. The category pages stay where they
 * are at /ai-ecosystem/{category}/.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { readFileSync, existsSync } from 'node:fs';

const j = (p) => (existsSync(p) ? JSON.parse(readFileSync(p, 'utf8')) : null);
const idx = j('content/ecosystem/index.json') || { categories: [], generated: '' };
const cats = idx.categories || [];
const laws = j('content/laws/index.json');
const glossary = j('content/glossary/glossary.json');
const suits = j('content/lawsuits/lawsuits.json');

const billTotal = laws?.total ?? 0;
const termTotal = glossary?.count ?? glossary?.terms?.length ?? 0;
const caseTotal = suits?.count ?? 0;
// The MCP registry count, read from the same index the directory renders, so
// the hero cannot claim a number the directory contradicts.
const mcpIdx = j('content/mcp/index.json');
const mcpTotal = mcpIdx?.total ?? 0;
const totalPages = cats.reduce((n, c) => n + c.pages, 0);
const generated = idx.generated || laws?.generated || '';

const desc =
  'The AI Ecosystem: an atlas of artificial intelligence covering the technology, the market, ' +
  'the research layer, and enterprise governance. Rebuilt daily from primary sources.';
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The World of AI',
  description: desc,
  url: 'https://theworldofai.org/',
  dateModified: generated,
  hasPart: cats.map((c) => ({
    '@type': 'CollectionPage',
    name: c.name,
    url: `https://theworldofai.org/ai-ecosystem/${c.slug}/`,
  })),
});
---
<Base rail={false} title="The World of AI — the AI Ecosystem, mapped and tracked daily" description={desc} jsonld={jsonld}>
  <Hero slot="bleed" bills={billTotal} terms={termTotal} cases={caseTotal}
    servers={mcpTotal} generated={generated} />


  <!-- The ask box is front and centre on Stephen's instruction, above the map.
       It answers ONLY from this site's pages and says so in the sub-line rather
       than hiding it: the limitation is the reason to trust the answer, and a
       visitor who expects a general chatbot and gets a refusal has been misled
       by us, not failed by the tool.

       Progressive enhancement: without JavaScript the box is inert and the
       ecosystem map directly below is unaffected. Nothing on this page depends
       on the assistant being up. -->
  <section class="ask" id="ask">
    <h2 class="ask-h">Ask this site a question</h2>
    <div class="ask-row">
      <input id="ask-q" type="text" autocomplete="off"
        placeholder="What are the AI laws in Texas?"
        aria-label="Ask a question about AI, answered from this site" maxlength="500" />
      <button id="ask-go" type="button">Ask</button>
    </div>
    <p class="ask-note">Answered only from the pages on this site, with links to every source used.
      When we have not covered something, it says so rather than guessing.</p>
    <div id="ask-out" class="ask-out" hidden></div>
  </section>

  <script is:inline>
    (function () {
      var q = document.getElementById('ask-q');
      var go = document.getElementById('ask-go');
      var out = document.getElementById('ask-out');
      if (!q || !go || !out) return;
      var busy = false;
      function esc(s) {
        return String(s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function ask() {
        var text = q.value.trim();
        if (!text || busy) return;
        busy = true;
        go.disabled = true;
        go.textContent = 'Reading';
        out.hidden = false;
        out.innerHTML = '<p class="ask-wait">Searching this site\u2026</p>';
        // The question travels through the hero. See Hero.astro.
        if (window.__twoaiRipple) window.__twoaiRipple();
        fetch('/api/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question: text })
        }).then(function (r) { return r.json(); }).then(function (d) {
          if (d.error) { out.innerHTML = '<p class="ask-wait">' + esc(d.error) + '</p>'; return; }
          var html = '<div class="ask-answer">' +
            esc(d.answer).replace(/\n\n+/g, '</p><p>').replace(/^/, '<p>') + '</p></div>';
          if (d.sources && d.sources.length) {
            html += '<p class="ask-src-label">Sources on this site</p><ul class="ask-src">';
            for (var i = 0; i < d.sources.length; i++) {
              html += '<li><a href="' + esc(d.sources[i].url) + '">' + esc(d.sources[i].title) + '</a></li>';
            }
            html += '</ul>';
          }
          out.innerHTML = html;
        }).catch(function () {
          out.innerHTML = '<p class="ask-wait">The assistant is unavailable right now.</p>';
        }).then(function () {
          busy = false; go.disabled = false; go.textContent = 'Ask';
        });
      }
      go.addEventListener('click', ask);
      q.addEventListener('keydown', function (e) { if (e.key === 'Enter') ask(); });
    })();
  </script>

  {cats.map((c) => (
    <div class="cat">
      <h2><a href={`/ai-ecosystem/${c.slug}/`}>{c.name}</a></h2>
      <p>{c.blurb}</p>
      <p class="meta-line">{c.live} of {c.total} domains live
        {c.pages > 0 && <> · {c.pages.toLocaleString()} pages published</>}</p>
    </div>
  ))}

  {cats.length === 0 && (
    <ul class="grid">
      <li class="card"><a href="/ai-laws/">AI Laws by State</a><p>Every AI bill in all 50 states, DC, Puerto Rico, and Congress.</p></li>
      <li class="card"><a href="/ai-glossary/">AI Glossary</a><p>AI terms defined in plain English, built to be cited.</p></li>
      <li class="card"><a href="/ai-lawsuits/">AI Lawsuit Tracker</a><p>Living case pages with dockets checked daily.</p></li>
      <li class="card"><a href="/calculators/">AI Calculators</a><p>Cost, memory, context, energy, and ROI estimators.</p></li>
    </ul>
  )}

  {/* "What is not here yet" removed on Stephen's instruction 2026-08-20.
      It was written when domains were genuinely unbuilt and it earned its place
      then: a reference whose gaps you cannot see is one you cannot rely on. All
      29 are live now, so the block rendered "0 of the 29 domains above are named
      but not yet built" - a paragraph explaining an absence that no longer
      exists, which reads as uncertainty about a site that has none.
      The principle stands and is still enforced elsewhere: sections with no
      sourced content stay empty and say so, as the Downloads hub does. */}

  <h2>Free data, free citations</h2>
  <p>Everything here is machine-readable: <a href="/api/laws.json">laws.json</a>,
    <a href="/api/glossary.json">glossary.json</a>, <a href="/api/lawsuits.json">lawsuits.json</a>,
    <a href="/api/tools.json">tools.json</a>, <a href="/api/compliance.json">compliance.json</a>,
    and <a href="/api/weeks.json">weeks.json</a> mirror the pages exactly, and
    <a href="/llms.txt">llms.txt</a> explains the site to AI assistants. Cite any page; every one
    carries its own verification date.</p>
</Base>

<style>
  .cat { padding: 1.2em 0; border-bottom: 1px solid #ececf2; }
  .cat h2 { margin: 0 0 .3em; font-size: 1.18rem; }
  .cat p { margin: 0 0 .35em; }
  .ask { max-width: 860px; margin: 0 auto 2.6em; padding: 26px 26px 22px; text-align: center;
    background: #fcfbf7; border: 1px solid #e3e6ee; border-radius: 12px; }
  .ask-h { font-size: 1.25rem; margin: 0 0 14px; }
  .ask-row { display: flex; gap: 10px; max-width: 640px; margin: 0 auto; }
  #ask-q { flex: 1; font-family: 'Poppins', system-ui, sans-serif; font-size: 15px;
    padding: 12px 14px; border: 1px solid #cfd4e4; border-radius: 8px; color: #201868; background: #fff; }
  #ask-q:focus { outline: 2px solid #F07800; outline-offset: 1px; border-color: #F07800; }
  #ask-go { font-family: 'Poppins', system-ui, sans-serif; font-size: 15px; font-weight: 600;
    color: #fff; background: #201868; border: 0; border-radius: 8px; padding: 12px 24px; cursor: pointer; }
  #ask-go:hover { background: #F07800; }
  #ask-go:disabled { background: #7A8A9E; cursor: default; }
  .ask-note { font-size: 13px; color: #7A8A9E; margin: 12px auto 0; max-width: 600px; line-height: 1.6; }
  .ask-out { margin: 20px auto 0; max-width: 640px; text-align: left; }
  .ask-wait { font-size: 14px; color: #7A8A9E; font-style: italic; }
  .ask-answer p { font-size: 15px; line-height: 1.7; margin: 0 0 .8em; }
  .ask-src-label { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: #F07800; margin: 14px 0 6px; }
  .ask-src { list-style: none; margin: 0; padding: 0; }
  .ask-src li { padding: 5px 0; border-bottom: 1px solid #f0f0f5; font-size: 14.5px; }
  .ask-src a { color: #201868; text-decoration: none; font-weight: 600; }
  .ask-src a:hover { color: #F07800; }
</style>

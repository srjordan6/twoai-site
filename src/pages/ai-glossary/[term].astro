---
import Base from '../../layouts/Base.astro';
import KeepReading from '../../components/KeepReading.astro';
import { companiesNamedIn } from '../../lib/related';

// Labels for the audience lenses. Kept here rather than in the data so that
// renaming a label is a template change, not a migration across every term.
const LENS_LABELS = {
  child: 'For a child',
  student: 'For a student',
  developer: 'For a developer',
  researcher: 'For a researcher',
  executive: 'For an executive',
  investor: 'For an investor',
  journalist: 'For a journalist',
  regulator: 'For a regulator',
  ciso: 'For a CISO',
  'small-business': 'For a small business owner',
};
import { readFileSync, existsSync } from 'node:fs';

export function getStaticPaths() {
  if (!existsSync('content/glossary/glossary.json')) return [];
  const g = JSON.parse(readFileSync('content/glossary/glossary.json', 'utf8'));
  const terms = g.terms ?? [];
  return terms.map((t) => ({
    params: { term: t.slug },
    props: {
      t,
      generated: g.generated ?? '',
      related: terms.filter((o) => o.category === t.category && o.slug !== t.slug).slice(0, 6),
    },
  }));
}
const { t, generated, related } = Astro.props;
// Definitions and examples name real companies; those were dead text.
const krCompanies = companiesNamedIn(`${t.definition ?? ''} ${t.example ?? ''} ${t.origin ?? ''}`, { limit: 4 });
const desc = t.definition.length > 152 ? t.definition.slice(0, 149) + '...' : t.definition;
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: t.term,
  description: t.definition,
  url: `https://theworldofai.org/ai-glossary/${t.slug}/`,
  ...(generated ? { dateModified: generated } : {}),
  inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'The World of AI Glossary', url: 'https://theworldofai.org/ai-glossary/' },
});
---
<Base title={`What is ${t.term}? Definition in plain English — The World of AI`.length <= 70
    ? `What is ${t.term}? Definition in plain English — The World of AI`
    : (`What is ${t.term}? — AI Glossary`.length <= 70 ? `What is ${t.term}? — AI Glossary` : `What is ${t.term}?`)} description={desc} current="/ai-glossary/" jsonld={jsonld}>
  <h1>{t.term}</h1>
  <p class="meta-line"><span class="badge">{t.category}</span>{generated && <> · Last verified: {generated}</>}</p>
  <p class="answer">{t.definition}</p>
  {t.example && (<><h2>Example</h2><p>{t.example}</p></>)}

  {t.lenses && t.lenses.length > 0 && (
    <>
      <h2>The same term, explained for different readers</h2>
      <p class="lens-intro">
        The definition above is the one to cite. These are the same idea rewritten for the readers
        who most often need it, and they are explanatory writing rather than sourced fact. Which
        readings appear depends on the term: a governance term earns a regulator&rsquo;s reading,
        an architecture term does not, and we would rather show four that differ than ten that
        repeat each other.
      </p>
      <dl class="lenses">
        {t.lenses.map((l) => (
          <>
            <dt>{LENS_LABELS[l.audience] || l.audience}</dt>
            <dd>{l.body}</dd>
          </>
        ))}
      </dl>
    </>
  )}
  {t.origin && (<><h2>Where the term comes from</h2><p>{t.origin}</p></>)}
  {related.length > 0 && (
    <>
      <h2>Related terms in {t.category}</h2>
      <ul class="grid">
        {related.map((r) => (<li class="card"><a href={`/ai-glossary/${r.slug}/`}>{r.term}</a></li>))}
      </ul>
    </>
  )}
  <div class="cite-box">Cite this definition: <code>"{t.term}." The World of AI Glossary,
    theworldofai.org/ai-glossary/{t.slug}/.{generated ? ` Verified ${generated}.` : ''}</code></div>
  <KeepReading blocks={[
    { label: 'Companies named in this entry',
      links: krCompanies.map((x) => ({ href: `/companies/${x.uid}/`, label: `${x.name} profile`, note: 'what they ship and what is contested' })) },
    { label: 'Across the site', links: [
      { href: '/ai-glossary/', label: 'The full AI glossary', note: '500+ terms, each with an example' },
      { href: '/ai-news/daily/', label: 'Today\u2019s briefing', note: 'the term in the wild' },
      { href: '/companies/', label: 'The AI company directory', note: '261 vendors we track' },
    ] },
  ]} />
</Base>

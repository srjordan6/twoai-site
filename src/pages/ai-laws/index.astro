---
import Base from '../../layouts/Base.astro';
import StateLawMap from '../../components/StateLawMap.astro';
import { readFileSync, existsSync } from 'node:fs';

const idx = existsSync('content/laws/index.json')
  ? JSON.parse(readFileSync('content/laws/index.json', 'utf8'))
  : { states: [], total: 0, generated: '' };
const desc = `Artificial intelligence legislation in every US state: ${idx.total.toLocaleString()} AI bills tracked across ${idx.states.length} jurisdictions, updated daily from LegiScan.`;

// WHAT THE LAWS HAVE IN COMMON, under the map. Stephen, 2026-09-18. The
// statement is content, so it lives in SQL as governance/state-ai-law-patterns
// and reaches this build as a compliance page like any other, with its own URL
// and uid at /ai-compliance/state-ai-law-patterns/. This page renders the same
// body so the two can never disagree. Its counts are spans the build fills from
// the tracker, the same way [framework].astro does, so they do not go stale.
// No file, no section: the hub renders as it did before.
const patPath = 'content/compliance/state-ai-law-patterns.json';
const pat = existsSync(patPath) ? JSON.parse(readFileSync(patPath, 'utf8')) : null;
let patternsHtml = pat?.body_html || '';
if (patternsHtml) {
  const ep = 'content/compliance/enacted-ai-laws.json';
  const laws = existsSync(ep) ? (JSON.parse(readFileSync(ep, 'utf8')).laws || []) : [];
  const stateLaws = laws.filter((l) => l.state && l.state !== 'US');
  const live = laws.length ? {
    enacted_states: String(new Set(stateLaws.map((l) => l.state)).size),
    enacted_state_measures: String(stateLaws.length),
    enacted_measures: String(laws.length),
  } : {};
  patternsHtml = patternsHtml.replace(/<span data-twoai="(\w+)">([^<]*)<\/span>/g, (_m, k, fb) => live[k] || fb);
}
---
{/* doc={idx}: the hub's record has carried a uid since the pipeline began
    stamping every write, 341de729, and this page never passed it to the
    layout, so it was the one page in the section with no uid and no date at
    its foot. Stephen saw it on 2026-09-18. */}
<Base title="AI Laws by State: every US artificial intelligence bill, tracked daily" description={desc} current="/ai-laws/" doc={idx} stampLabel="Last verified">
  <h1>AI Laws by State</h1>
  <p class="answer">United States AI legislation is written state by state, and this page tracks
    all of it: <b>{idx.total.toLocaleString()} artificial intelligence bills</b> across
    {idx.states.length} jurisdictions, refreshed daily from the LegiScan legislative database and
    linked to each bill's official page.</p>
  {idx.generated && <p class="meta-line">Last verified: {idx.generated} · Source: LegiScan API ·
    {' '}<a href="/state-of-ai-laws/">State of AI Laws report</a> · <a href="/embed/">Embed this map</a></p>}
  <StateLawMap />
  {patternsHtml && (
    <section class="patterns">
      <div set:html={patternsHtml} />
      <p class="patterns-link">This statement has its own page, with its review date and uid:
        <a href="/ai-compliance/state-ai-law-patterns/">What State AI Laws Have in Common</a>.</p>
    </section>
  )}
  <h2 id="states">Every state</h2>
  <ul class="grid">
    {idx.states.map((s) => (
      <li class="card">
        <a href={`/ai-laws/${s.slug}/`}>{s.name}</a>
        <p><span class="n">{s.count}</span> AI bill{s.count === 1 ? '' : 's'} tracked</p>
      </li>
    ))}
  </ul>
  {idx.states.length === 0 && <p>The first data synchronization is running; state pages appear within the day.</p>}
</Base>

<style>
  /* The statement arrives as stored HTML through set:html, so its elements carry
     no scope attribute: every rule that reaches them goes through :global. */
  .patterns { margin: 34px 0 40px; }
  .patterns :global(h2) { font-family: Lora, Georgia, serif; font-size: 27px; color: var(--navy); margin: 0 0 12px; }
  .patterns :global(h3) { font-family: Lora, Georgia, serif; font-size: 19.5px; color: var(--navy); margin: 1.6em 0 .35em; }
  .patterns :global(p) { line-height: 1.7; margin: 0 0 1em; color: var(--ink); }
  .patterns :global(a) { color: var(--navy); text-decoration: underline; text-underline-offset: 2px; }
  .patterns :global(a:hover) { color: var(--orange); }
  .patterns :global(.fineprint) { font-size: 13.5px; color: #5d6470; border-top: 1px solid #e4e4ee; padding-top: 14px; margin-top: 1.6em; }
  .patterns-link { font-size: 14px; color: #5d6470; }
  .patterns-link a { color: var(--navy); }
  .patterns-link a:hover { color: var(--orange); }
</style>

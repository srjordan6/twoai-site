---
import Base from '../../layouts/Base.astro';
import AskBox from '../../components/AskBox.astro';
import Reading from '../../components/Reading.astro';
import KeepReading from '../../components/KeepReading.astro';
import { matchTerms } from '../../lib/related';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

export function getStaticPaths() {
  if (!existsSync('content/laws')) return [];
  return readdirSync('content/laws')
    .filter((f) => f.endsWith('.json') && f !== 'index.json')
    .map((f) => {
      const d = JSON.parse(readFileSync(`content/laws/${f}`, 'utf8'));
      return { params: { state: d.slug }, props: { d } };
    });
}
const { d } = Astro.props;
// ENACTED FIRST. Stephen, 2026-09-17: a reader who clicks a state on the map
// wants the AI laws of that state, and this page opened on a flat list of
// every bill filed with nothing to say which ones became law. The enacted
// set is already published for the Enacted AI Laws section, so it is read
// here and filtered to this state. Absent file or no match renders nothing.
const enactedPath = 'content/compliance/enacted-ai-laws.json';
const enactedAll = existsSync(enactedPath) ? (JSON.parse(readFileSync(enactedPath, 'utf8')).laws || []) : [];
const enactedHere = enactedAll
  .filter((l: any) => l.state === d.code)
  .sort((a: any, b: any) => String(b.status_date || '').localeCompare(String(a.status_date || '')));
const recent = d.bills.slice(0, 8).map((b) => b.number).join(', ');

// THE EXPLANATION, NOT JUST THE TABLE. Microsoft Clarity's citation report for
// 2026-09-12 to 18: 549 citations in AI answers across the site, and the whole
// /ai-laws/ section earned 2 of them. Asked "what is Texas doing about AI", the
// answer engine cited /ai-compliance/texas-ai-act/, not this page, because that
// page explains the law and this one lists bills. A reader has the same need.
// So the state page now opens by saying what the state has enacted, in the
// words of our own explainer, and sends the reader there.
//
// The explainer is found, not mapped by hand. A generated one is named
// {state}-ai-laws; the hand-written ones predate that and are named for the
// statute, texas-ai-act, colorado-ai-act, tennessee-elvis-act. Anything under
// content/compliance/ that begins with this state's slug and is not a single
// law page (law-xx-...) is a candidate, and the one that calls itself the
// state's AI laws wins. No match renders nothing.
const explainer = (() => {
  const dir = 'content/compliance';
  if (!existsSync(dir)) return null;
  const cands = readdirSync(dir).filter((f) => f.endsWith('.json') && f.startsWith(`${d.slug}-`) && !f.startsWith('law-'));
  const docs = cands.map((f) => { try { return JSON.parse(readFileSync(`${dir}/${f}`, 'utf8')); } catch { return null; } })
    .filter((x) => x && x.slug && x.title && !x.draft);
  // "virginia-" must not claim west-virginia's page, nor the reverse.
  const mine = docs.filter((x) => String(x.slug).startsWith(`${d.slug}-`));
  return mine.find((x) => String(x.slug) === `${d.slug}-ai-laws`) || mine.find((x) => x.parent === 'state-ai-laws') || mine[0] || null;
})();
const explainerLead = explainer ? String(explainer.short || explainer.subtitle || explainer.meta_description || '').trim() : '';
const krTerms = matchTerms(d.bills.slice(0, 25).map((b: any) => b.title || '').join(' '));
const desc = `${d.name} artificial intelligence legislation: ${d.count} AI bill${d.count === 1 ? '' : 's'} tracked with official links, updated daily from LegiScan.`;
const faq = [
  ...(enactedHere.length > 0 ? [{
    q: `What AI laws has ${d.name} enacted?`,
    a: `${d.name} has enacted ${enactedHere.length} AI measure${enactedHere.length === 1 ? '' : 's'} in our tracker as of ${d.generated}, including ${enactedHere.slice(0, 3).map((l: any) => `${l.bill || ''}${l.title ? ' (' + String(l.title).slice(0, 80) + ')' : ''}`).join('; ')}.${explainerLead ? ' ' + explainerLead : ''}`,
  }] : []),
  {
    q: `How many AI bills does ${d.name} have?`,
    a: `${d.name} currently has ${d.count} artificial intelligence bill${d.count === 1 ? '' : 's'} tracked in the LegiScan legislative database, as of ${d.generated}.`,
  },
  {
    q: `What are the most recent AI bills in ${d.name}?`,
    a: d.count ? `The most recently active include ${recent}. Each links to the full official text below.` : `No AI bills are currently tracked for ${d.name}; this page updates automatically the day one appears.`,
  },
];
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'AI Laws by State', item: 'https://theworldofai.org/ai-laws/' },
        { '@type': 'ListItem', position: 2, name: d.name, item: `https://theworldofai.org/ai-laws/${d.slug}/` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---
<Base title={`${d.name} AI Laws (${d.count} bills tracked) — The World of AI`} description={desc} current="/ai-laws/" jsonld={jsonld} doc={d} stampLabel="Bill list last refreshed">
  <h1>{d.name} AI Laws</h1>
  <p class="answer"><b>{d.name} has {d.count} artificial intelligence bill{d.count === 1 ? '' : 's'}</b> tracked
    as of {d.generated}, drawn daily from the LegiScan legislative database. Every bill below
    links to its official page with full text, sponsors, and status history.</p>
  <p class="meta-line">Last verified: <time datetime={d.generated}>{d.generated}</time> · Source: LegiScan API ·
    <a href="/ai-laws/">All states</a></p>

  {explainer && (
    <aside class="explainer">
      <p class="explainer-eyebrow">{d.name}, explained</p>
      <h2><a href={`/ai-compliance/${explainer.slug}/`}>{explainer.title}</a></h2>
      {explainerLead && <p>{explainerLead}</p>}
      <p class="explainer-more"><a href={`/ai-compliance/${explainer.slug}/`}>Read what {d.name} requires, who it applies to and the penalties</a></p>
    </aside>
  )}

  {/* Hand-written context, joined from twoai_state_law_context at build time
      rather than stored on the page row: the LegiScan stage rewrites the whole
      row every run, so prose kept in it is destroyed daily. What a legislature
      did and did not do, which existing statutes already reach AI conduct, and
      why a zero count is often a session calendar rather than an absence. */}
  {d.context && (
    <section class="state-context">
      {/* Split on blank lines. NOT /\n{2,}/ - Astro's compiler reads the
         braces in {2,} as JSX delimiters and the build dies with
         "Expected ) but found $$render". That broke every build from
         2026-09-05 20:24 until this was found in the Cloudflare log. */}
      {String(d.context).split(/\r?\n\r?\n+/).map((para) => <p>{para}</p>)}
      {Array.isArray(d.context_sources) && d.context_sources.length > 0 && (
        <details class="ctx-sources">
          <summary>Sources for this section</summary>
          <ul>
            {d.context_sources.map((s) => {
              const label = s.title || s.publisher || s.url;
              const tail = [s.title && s.publisher ? s.publisher : '', s.date || ''].filter(Boolean).join(' · ');
              return (
                <li>
                  {s.url ? <a href={s.url} rel="noopener">{label}</a> : <span>{label}</span>}
                  {tail ? <span class="ctx-tail"> · {tail}</span> : null}
                </li>
              );
            })}
          </ul>
        </details>
      )}
      {d.context_updated_on && <p class="meta-line">This section written {d.context_updated_on}.</p>}
    </section>
  )}

  {enactedHere.length > 0 && (
    <section id="enacted">
      <h2>Enacted into law in {d.name}</h2>
      <p>{enactedHere.length} AI bill{enactedHere.length === 1 ? ' has' : 's have'} passed into law in {d.name}
        in our tracker. Each links to the legislative record with the enrolled text.</p>
      <table>
        <thead><tr><th>Bill</th><th>Title</th><th>Enacted</th></tr></thead>
        <tbody>
          {enactedHere.map((l: any) => (
            <tr>
              <td><a href={l.url} rel="noopener">{d.code} {l.bill}</a></td>
              <td>{l.title}</td>
              <td>{l.status_date}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <h2>Every AI bill tracked in {d.name}</h2>
    </section>
  )}

  {d.count > 0 ? (
    <table>
      <thead><tr><th>Bill</th><th>Title</th><th>Last action date</th></tr></thead>
      <tbody>
        {d.bills.map((b) => (
          <tr>
            <td><a href={b.url} rel="noopener">{d.code} {b.number}</a></td>
            <td>{b.title}</td>
            <td>{b.date}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <p>No AI bills are currently tracked for {d.name}. The moment one enters the legislative
      record, it appears here automatically.</p>
  )}

  {/* NEWS ABOUT THIS STATE'S AI POLICY. Stephen, 2026-09-24: executive
      orders, governors' actions and enforcement do not arrive as bills, so a
      page built from bills alone missed them. The pipeline picks the stories
      that name the state and concern government action on AI. */}
  {Array.isArray(d.news) && d.news.length > 0 && (
    <>
      <h2>{d.name} AI policy in the news</h2>
      <ul class="state-news">
        {d.news.map((n) => (
          <li><a href={n.url}>{String(n.headline).split(' - ')[0]}</a>
            <span class="meta-line"> {n.date}</span></li>
        ))}
      </ul>
    </>
  )}

  {/* Ask box before this page's own questions. Stephen, 2026-09-23. */}
  <AskBox heading={`Ask a question about AI law in ${d.name}`}
    placeholder={`Does ${d.name} regulate AI in hiring?`} />

  <h2>Frequently asked questions</h2>
  {faq.map((f) => (<><h3 style="font-family:Poppins;font-size:16.5px;">{f.q}</h3><p>{f.a}</p></>))}

  <Reading reading={d.reading} heading={`What does ${d.name}’s AI legislation add up to?`} />
  <div class="cite-box">Cite this page: <code>"{d.name} AI Laws." The World of AI,
    theworldofai.org/ai-laws/{d.slug}/. Verified {d.generated}.</code></div>
  <KeepReading blocks={[
    { label: 'Terms in these bills, defined',
      links: krTerms.map((t) => ({ href: `/ai-glossary/${t.slug}/`, label: t.term, note: t.category })) },
    { label: 'Across the site', links: [
      { href: '/ai-laws/', label: 'AI laws in every state', note: 'all 53 jurisdictions we track' },
      { href: '/ai-compliance/federal-ai-legislation/', label: 'Federal AI legislation', note: 'what Congress has moved' },
      { href: '/ai-compliance/global-ai-laws/', label: 'Global AI laws', note: 'the EU AI Act and beyond' },
      { href: '/ai-lawsuits/', label: 'The AI lawsuit tracker', note: 'where the law is being tested' },
    ] },
  ]} />
</Base>

<style>
  /* The explainer card: what this state has enacted, in our own words, above
     the bill table. Added 2026-09-18 from the AI citation report. */
  .explainer { margin: 22px 0 28px; padding: 18px 22px; background: #faf8f3; border: 1px solid #e8e2d4;
    border-left: 4px solid var(--orange); border-radius: 10px; }
  .explainer-eyebrow { font: 600 12px/1.3 Poppins, sans-serif; letter-spacing: .12em; text-transform: uppercase;
    color: #7A8A9E; margin: 0 0 6px; }
  .explainer h2 { font-family: Lora, Georgia, serif; font-size: 22px; margin: 0 0 8px; }
  .explainer h2 a { text-decoration: none; }
  .explainer p { margin: 0 0 8px; line-height: 1.65; }
  .explainer-more { font-weight: 600; margin: 0; }
</style>

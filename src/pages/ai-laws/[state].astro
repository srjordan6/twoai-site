---
import Base from '../../layouts/Base.astro';
import Reading from '../../components/Reading.astro';
import KeepReading from '../../components/KeepReading.astro';
import { matchTerms } from '../../lib/related';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

export function getStaticPaths() {
  if (!existsSync('content/laws')) return [];
  return readdirSync('content/laws')
    .filter((f) => f.endsWith('.json') && f !== 'index.json')
    .map((f) => {
      const d = JSON.parse(readFileSync(`content/laws/${f}`, 'utf8'));
      return { params: { state: d.slug }, props: { d } };
    });
}
const { d } = Astro.props;
const recent = d.bills.slice(0, 8).map((b) => b.number).join(', ');
const krTerms = matchTerms(d.bills.slice(0, 25).map((b: any) => b.title || '').join(' '));
const desc = `${d.name} artificial intelligence legislation: ${d.count} AI bill${d.count === 1 ? '' : 's'} tracked with official links, updated daily from LegiScan.`;
const faq = [
  {
    q: `How many AI bills does ${d.name} have?`,
    a: `${d.name} currently has ${d.count} artificial intelligence bill${d.count === 1 ? '' : 's'} tracked in the LegiScan legislative database, as of ${d.generated}.`,
  },
  {
    q: `What are the most recent AI bills in ${d.name}?`,
    a: d.count ? `The most recently active include ${recent}. Each links to the full official text below.` : `No AI bills are currently tracked for ${d.name}; this page updates automatically the day one appears.`,
  },
];
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'AI Laws by State', item: 'https://theworldofai.org/ai-laws/' },
        { '@type': 'ListItem', position: 2, name: d.name, item: `https://theworldofai.org/ai-laws/${d.slug}/` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---
<Base title={`${d.name} AI Laws (${d.count} bills tracked) — The World of AI`} description={desc} current="/ai-laws/" jsonld={jsonld}>
  <h1>{d.name} AI Laws</h1>
  <p class="answer"><b>{d.name} has {d.count} artificial intelligence bill{d.count === 1 ? '' : 's'}</b> tracked
    as of {d.generated}, drawn daily from the LegiScan legislative database. Every bill below
    links to its official page with full text, sponsors, and status history.</p>
  <p class="meta-line">Last verified: <time datetime={d.generated}>{d.generated}</time> · Source: LegiScan API ·
    <a href="/ai-laws/">All states</a></p>

  {/* Hand-written context, joined from twoai_state_law_context at build time
      rather than stored on the page row: the LegiScan stage rewrites the whole
      row every run, so prose kept in it is destroyed daily. What a legislature
      did and did not do, which existing statutes already reach AI conduct, and
      why a zero count is often a session calendar rather than an absence. */}
  {d.context && (
    <section class="state-context">
      {/* Split on blank lines. NOT /\n{2,}/ - Astro's compiler reads the
         braces in {2,} as JSX delimiters and the build dies with
         "Expected ) but found $$render". That broke every build from
         2026-09-05 20:24 until this was found in the Cloudflare log. */}
      {String(d.context).split(/\r?\n\r?\n+/).map((para) => <p>{para}</p>)}
      {Array.isArray(d.context_sources) && d.context_sources.length > 0 && (
        <details class="ctx-sources">
          <summary>Sources for this section</summary>
          <ul>
            {d.context_sources.map((s) => {
              const label = s.title || s.publisher || s.url;
              const tail = [s.title && s.publisher ? s.publisher : '', s.date || ''].filter(Boolean).join(' · ');
              return (
                <li>
                  {s.url ? <a href={s.url} rel="noopener">{label}</a> : <span>{label}</span>}
                  {tail ? <span class="ctx-tail"> · {tail}</span> : null}
                </li>
              );
            })}
          </ul>
        </details>
      )}
      {d.context_updated_on && <p class="meta-line">This section written {d.context_updated_on}.</p>}
    </section>
  )}

  {d.count > 0 ? (
    <table>
      <thead><tr><th>Bill</th><th>Title</th><th>Last action date</th></tr></thead>
      <tbody>
        {d.bills.map((b) => (
          <tr>
            <td><a href={b.url} rel="noopener">{d.code} {b.number}</a></td>
            <td>{b.title}</td>
            <td>{b.date}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <p>No AI bills are currently tracked for {d.name}. The moment one enters the legislative
      record, it appears here automatically.</p>
  )}

  <h2>Frequently asked questions</h2>
  {faq.map((f) => (<><h3 style="font-family:Poppins;font-size:16.5px;">{f.q}</h3><p>{f.a}</p></>))}

  <Reading reading={d.reading} heading={`What does ${d.name}’s AI legislation add up to?`} />
  <div class="cite-box">Cite this page: <code>"{d.name} AI Laws." The World of AI,
    theworldofai.org/ai-laws/{d.slug}/. Verified {d.generated}.</code></div>
  <KeepReading blocks={[
    { label: 'Terms in these bills, defined',
      links: krTerms.map((t) => ({ href: `/ai-glossary/${t.slug}/`, label: t.term, note: t.category })) },
    { label: 'Across the site', links: [
      { href: '/ai-laws/', label: 'AI laws in every state', note: 'all 53 jurisdictions we track' },
      { href: '/ai-compliance/federal-ai-legislation/', label: 'Federal AI legislation', note: 'what Congress has moved' },
      { href: '/ai-compliance/global-ai-laws/', label: 'Global AI laws', note: 'the EU AI Act and beyond' },
      { href: '/ai-lawsuits/', label: 'The AI lawsuit tracker', note: 'where the law is being tested' },
    ] },
  ]} />
</Base>

                const groups = [];
                const idx = new Map();
                for (const f of sec.facilities || []) {
                  const k = `${f.name}|${f.operator || ''}|${f.city || ''}`;
                  if (!idx.has(k)) { idx.set(k, groups.length); groups.push({ key: k, rows: [] }); }
                  groups[idx.get(k)].rows.push(f);
                }
                return groups.map((g) => {
                  const f = g.rows[0];
                  const many = g.rows.length > 1;
                  const mw = g.rows.reduce((s, r) => s + (Number(r.mw) || 0), 0);
                  const bl = many ? [...g.rows].sort((a, b) => (a.lon || 0) - (b.lon || 0)) : g.rows;
                  return (
                    <tr>
                      <td>
                        {many
                          ? <>{f.name} <span class="muted">· {g.rows.length} buildings:</span>{' '}
                              {bl.map((r, i) => (
                                <>{i > 0 && ' '}{r.uid ? <a href={`${BASE}/${r.uid}/`}>{i + 1}</a> : <span>{i + 1}</span>}</>
                              ))}</>
                          : f.uid ? <a href={`${BASE}/${f.uid}/`}>{f.name}</a>
                          : f.website ? <a href={f.website} rel="noopener">{f.name}</a> : f.name}

                    </tr>
                  ))}
                </tbody>
              </table>
            </details>
          ))}
        </section>
      )}

      {sec.retiring?.length > 0 && (
        <section class="letter-block">
          <h2 id="retirements">Scheduled retirements <span class="n">{sec.retiring.length}</span></h2>
          <p>Models with a published shutdown date. The date comes from the routing catalog's own
            deprecation field; after it, calls to the model stop working and traffic must move to a
            successor. Soonest first.</p>
          <table class="pay">
            <thead><tr><th>Model</th><th>Provider</th><th>Retires</th></tr></thead>
            <tbody>
              {sec.retiring.map((m) => (
                <tr>
                  <td><a href={m.url} rel="noopener">{m.name}</a></td>
                  <td>{m.provider}</td>
                  <td>{m.expires}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )}
    </>
  )}

  {isProv && (
    <>
      <p class="answer"><b>{sec.total} companies</b> run the inference behind AI model APIs. This
        directory lists each serving provider with its headquarters country and, where published,
        its datacenter regions — the two facts that decide which AI regulations (the EU AI Act,
        data-residency rules, export controls) apply to a deployment — plus links to each
        provider's own terms of service, privacy policy, and live status page.</p>
      <p class="meta-line">Last verified: {sec.generated} · Source: the
        {' '}<a href="https://openrouter.ai/models" rel="noopener">OpenRouter</a> public providers
        API, refreshed daily. Policy and status links open the provider's own pages.</p>
      <table class="pay">
        <thead><tr><th>Provider</th><th>Headquarters</th><th>Datacenters</th><th>Links</th></tr></thead>
        <tbody>
          {sec.providers.map((p) => (
            <tr>
              <td>{p.name}</td>
              <td>{p.hq || '—'}</td>
              <td>{Array.isArray(p.datacenters) ? p.datacenters.join(', ') : '—'}</td>
              <td>
                {p.terms && <a href={p.terms} rel="noopener nofollow">Terms</a>}
                {p.privacy && <> · <a href={p.privacy} rel="noopener nofollow">Privacy</a></>}
                {p.status && <> · <a href={p.status} rel="noopener nofollow">Status</a></>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  {sec.api_models?.length > 0 && (
    <>
      <h2>Available over commercial APIs</h2>
      <p>The models above publish open weights on the Hugging Face Hub. These
        {' '}<b>{sec.api_models.length}</b> are served over commercial APIs, with per-token
        pricing{sec.api_stats && <>: median {money(sec.api_stats.median_prompt_pm)}/M input and
        {' '}{money(sec.api_stats.median_completion_pm)}/M output across
        {' '}{sec.api_stats.provider_count} providers</>}. Newest first.</p>
      <table class="pay">
        <thead><tr><th>Model</th><th>Provider</th><th class="num">Context</th><th class="num">$/M in</th><th class="num">$/M out</th><th>Released</th></tr></thead>
        <tbody>
          {sec.api_models.map((m) => (
            <tr>
              <td><a href={m.url} rel="noopener">{m.name}</a></td>
              <td>{m.provider}</td>
              <td class="num">{ctx(m.context)}</td>
              <td class="num">{money(m.prompt_pm)}</td>
              <td class="num">{money(m.completion_pm)}</td>
              <td>{m.released}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  {/* The one cite block on this template. Ten branch-level copies were removed
      2026-08-31 after a facility page rendered two, in two different formats.
      It uses pageTitle, not sec.name, because the DC children carry no name
      and cited themselves as "." until this was caught in the same pass. */}
  {/* The reading was rendered only inside the data center branch, so the
      hardware, dataset, model, status and repository sections carried one in
      their JSON and showed none of it: 16 of them were still under 300 words
      on 2026-09-01 with a 1,200 to 1,600 character reading already written and
      merged. The DC branch keeps its own placement above, which is why this is
      guarded rather than unconditional. */}
  <Reading reading={isDCChild ? null : sec.reading} heading="What does this tell us about AI?" />

  <div class="cite-box">Cite this page: <code>"{pageTitle}." The World of AI,
    theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
</Base>


---
/**
 * Technology and Core Infrastructure: model-catalog sections, addressed by
 * identifier, same addressing rule as the entities category. One route serves
 * every section built from content/models/*.json.
 *
 * Two page shapes. Hugging Face sections (open-weight catalogs per modality)
 * lead with downloads, licences, and recency. OpenRouter sections (API
 * models and pricing) lead with computed price and context statistics. Both
 * link every model to its original home, never to a copy, and both carry the
 * source, the refresh cadence, and a cite box.
 */
import Base from '../../../layouts/Base.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

const CATEGORY = 'technology-and-core-infrastructure';
const CATEGORY_NAME = 'Technology and Core Infrastructure';
const BASE = `/ai-ecosystem/${CATEGORY}`;

export function getStaticPaths() {
  const paths = [];
  for (const dir of ['models', 'repos', 'status', 'tech']) {
    if (!existsSync(`content/${dir}`)) continue;
    for (const f of readdirSync(`content/${dir}`)) {
      if (!f.endsWith('.json')) continue;
      const d = JSON.parse(readFileSync(`content/${dir}/${f}`, 'utf8'));
      if (!d.uid) continue;
      paths.push({ params: { id: d.uid }, props: { sec: d } });
    }
  }
  return paths;
}
const { sec } = Astro.props;

const isPricing = sec.tax === 'api-pricing';
const isAPI = sec.source === 'openrouter' && !isPricing;
const hf = sec.source === 'huggingface';
const isRepo = sec.source === 'github';
const isStatus = sec.tax === 'api-status-uptime';
const isDir = sec.tax === 'api-directory';
const isLang = sec.tax === 'programming-languages';
const isMeta = sec.kind === 'standard' && sec.tax === 'model-metadata';
const isMCPSec = sec.tax === 'mcp-security';
const isClients = sec.tax === 'mcp-clients';
const isA2A = sec.shape === 'a2a';
const isHW = sec.shape === 'hardware';
const isDS = sec.shape === 'datasets';
const isDSLic = sec.shape === 'ds-licensing';
// Vibe Coding: a short authored explainer plus a routing table into the
// sections that already cover each part of the job. See twoai_vibe_coding.go.
const isVibe = sec.shape === 'vibe-coding';
const isProv = sec.shape === 'serving-providers';
const mdLite = (t: string) => t
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
  .split(/\n\n+/).map((p) => (/^\d+\.\s/m.test(p)
    ? `<ol>${p.split(/\n/).map((l) => `<li>${l.replace(/^\d+\.\s/, '')}</li>`).join('')}</ol>`
    : `<p>${p.replace(/\n/g, ' ')}</p>`)).join('');

const fmt = (n) => Number(n).toLocaleString();
const money = (v) => (v === null || v === undefined ? '—' : `$${v}`);
const ctx = (n) => (n >= 1000 ? `${Math.round(n / 1000)}k` : `${n}`);

const _descRaw = isHW
  ? `${sec.total} ${sec.name.toLowerCase()} entries, each curated with a verified vendor or primary source and re-verified daily. ${sec.blurb}`
  : isDS
  ? `${sec.total} ${sec.name.toLowerCase()}, curated for significance with downloads, licence, and gating refreshed daily from the Hugging Face Hub. ${sec.blurb}`
  : isDSLic
  ? `Licence split, gating, and provenance context for the dataset catalogue on this site, with the live copyright docket linked from the lawsuit tracker.`
  : isA2A
  ? `The Agent2Agent protocol explained from its v1.0 specification: origin at Google, governance at the Linux Foundation, Agent Cards, task lifecycle, three protocol bindings, enterprise security schemes, and how it complements MCP.`
  : isClients
  ? `${sec.total} applications that speak the Model Context Protocol, ${sec.open_source} of them open source, each verified against its own site; the protocol's official client list is the canonical registry.`
  : isMCPSec
  ? `The Model Context Protocol's security model, documented from the specification: OAuth 2.1 authorization, the server trust boundary, tool-metadata injection, confused-deputy failures, and credential handling.`
  : isMeta
  ? `The record kept for every model on this site: which fields are tracked, where each comes from, and what is deliberately not tracked and why.`
  : isDir
  ? `${sec.total} public AI APIs with base endpoint, documentation, authentication scheme, and official SDKs, ${sec.openai_compatible} of them OpenAI-compatible; every docs link individually verified, refreshed daily.`
  : isLang
  ? `${sec.total} programming languages that carry AI work, from Python's interface layer to the C++ and Rust systems underneath, each profiled with steward, first release, and the tracked repositories written in it.`
  : isRepo
  ? `The ${sec.total} ${sec.name.toLowerCase()} that matter, tracked from their own repositories: stars, licence, language, and last activity, refreshed daily. ${sec.blurb}`
  : isStatus
  ? `Live status for ${sec.total} AI API providers from their own status pages, with current incidents and a 30-day incident count per provider, refreshed daily.`
  : isPricing
  ? `Per-token API pricing for ${sec.total} AI models across ${sec.stats.provider_count} providers, in dollars per million tokens, refreshed daily. Median input price ${money(sec.stats.median_prompt_pm)}/M.`
  : isProv
  ? `${sec.total} AI model serving providers with headquarters country, datacenter regions, and links to terms, privacy policy, and live status pages. Refreshed daily.`
  : isAPI
  ? `${sec.total} ${sec.name.toLowerCase()} available over commercial APIs, with context window, per-token pricing, and release date, refreshed daily. ${sec.blurb}`
  : `The ${sec.total} most-downloaded open ${sec.name.toLowerCase()} on the Hugging Face Hub, with licence, downloads, and release date, refreshed daily. ${sec.blurb}`;
const desc = _descRaw.length <= 158 ? _descRaw : `${_descRaw.slice(0, 157).replace(/\s+\S*$/, '')}…`;

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${sec.name} — The World of AI`,
  description: desc.slice(0, 300),
  url: `https://theworldofai.org${BASE}/${sec.uid}/`,
  dateModified: sec.generated,
  isPartOf: { '@type': 'CollectionPage', name: CATEGORY_NAME, url: `https://theworldofai.org${BASE}/` },
});

// Licence counts render as a readable clause, not a chart.
const licLine = (sec.licences || [])
  .map((l) => `${l.licence} (${l.count})`)
  .join(', ');
---
<Base title={`${sec.name} — The World of AI`} description={desc.slice(0, 300)}
  current={`${BASE}/`} jsonld={jsonld}>
  {isVibe && (
    <>
      {sec.blocks.map((b: any) => (
        <section class="vc-block">
          <h2>{b.heading}</h2>
          <div set:html={mdLite(b.body_md)}></div>
        </section>
      ))}

      <section class="vc-routes">
        <h2>Where to go next on this site</h2>
        <p class="vc-lede">
          Vibe coding touches most of what this site already tracks. Rather than restate any of it
          here, this is the map: what you are trying to do, and the section that covers it. Every
          destination below is a live page, resolved from the site taxonomy when this page was
          built, so a link here cannot outlive the section it points at.
        </p>
        <div class="rule"></div>
        <table class="vc-table">
          <thead><tr><th>If you need to</th><th>Go here</th></tr></thead>
          <tbody>
            {sec.routes.map((r: any) => (
              <tr>
                <td class="vc-need">{r.need}</td>
                <td><a href={r.href}>{r.name}</a><span class="vc-why">{r.why}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    </>
  )}



  <p class="meta-line"><a href="/">AI Ecosystem</a> ·
    <a href={`${BASE}/`}>{CATEGORY_NAME}</a></p>

  <h1>{sec.name}</h1>

  {isHW && (
    <>
      <p class="answer"><b>{sec.total} entries</b> in {sec.name.toLowerCase()}, each one curated
        with a verified vendor or primary source. {sec.blurb}</p>
      <p class="meta-line">Last verified: {sec.generated} · Source links are re-verified daily;
        a row whose source stops answering shows its honest last-verified date. Makers with a
        company page are linked.</p>
      {sec.items.map((h) => (
        <div class="dom">
          <h3>{h.name}</h3>
          <p>{h.note}.</p>
          <p class="meta-line">Maker: {h.entity_uid
            ? <a href={`/ai-ecosystem/ecosystem-entities-market-and-operations/${h.entity_uid}/`}>{h.maker}</a>
            : h.maker} ·
            {' '}<a href={h.source_url} rel="noopener">Source</a> · verified {h.verified}
            {h.verify_note && <span class="vnote"> · {h.verify_note}</span>}</p>
        </div>
      ))}
  <div class="cite-box">Cite this page: <code>"{sec.name}." The World of AI,
        theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

  {isDS && (
    <>
      <p class="answer"><b>{sec.total} {sec.name.toLowerCase()}</b>, curated for significance
        rather than scraped by download rank — raw popularity sorting surfaces noise, so
        membership is editorial and stated per entry, while downloads, licence, and gating are
        live from the Hugging Face Hub.</p>
      <p class="meta-line">Last verified: {sec.generated} · Stats refresh daily from each
        dataset's own Hub record. Licence and provenance context lives in
        {' '}<a href={`${BASE}/c7caaf96/`}>Dataset Licensing and Provenance</a>.</p>
      {sec.items.map((d) => (
        <div class="dom">
          <h3><a href={d.url} rel="noopener">{d.id}</a>
            {d.gated && <span class="n">gated</span>}</h3>
          <p>{d.note}.</p>
          <p class="meta-line">{fmt(d.downloads)} downloads ·
            licence: {d.licence || 'undeclared'}</p>
        </div>
      ))}
      <div class="cite-box">Cite this page: <code>"{sec.name}." The World of AI,
        theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

  {isDSLic && (
    <>
      <p class="answer"><b>Across the {sec.total} datasets this site catalogues, {sec.gated} are
        gated</b> and the licence split is: {sec.splits.map((l) => `${l.licence} (${l.count})`).join(', ')}.
        The licence on a dataset covers the compilation; what it covers underneath is the live
        legal question of the field.</p>
      <p class="meta-line">Last verified: {sec.generated} · Licence tags read daily from each
        dataset's Hub record; context points sourced individually.</p>
      {sec.points.map((f) => (
        <div class="dom">
          <h3>{f.name}</h3>
          <p>{f.desc}</p>
          <p class="meta-line"><a href={f.source} rel="noopener">Source</a></p>
        </div>
      ))}
      <div class="cite-box">Cite this page: <code>"Dataset Licensing and Provenance." The World
        of AI, theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

  {isClients && (
    <>
      <p class="answer"><b>{sec.total} applications speak MCP</b> — {sec.open_source} of them
        open source. A client is the side that grants capability: connecting a server hands it
        tools and context, so which applications speak the protocol defines where the ecosystem
        actually runs. The <a href="https://modelcontextprotocol.io/clients" rel="noopener">official
        client list</a> is the canonical registry; this page is the curated core of it.</p>
      <p class="meta-line">Last verified: {sec.generated} · Each row verified against its own
        site. Servers live in the <a href="/mcp/">MCP Server tracker</a> (1,800+); SDKs in
        {' '}<a href={`${BASE}/37a491f4/`}>MCP SDKs and Registries</a>.</p>
      {sec.clients.map((c) => (
        <div class="dom">
          <h3><a href={c.url} rel="noopener">{c.name}</a>
            {c.open_source && <span class="n">open source</span>}</h3>
          <p>{c.note}.</p>
          <p class="meta-line">Publisher: {c.publisher}
            {c.repo && <> · <a href={`https://github.com/${c.repo}`} rel="noopener">{c.repo}</a></>} ·
            {' '}verified {c.verified}</p>
        </div>
      ))}
      <div class="cite-box">Cite this page: <code>"MCP Clients." The World of AI,
        theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

  {isA2A && (
    <>
      <p class="answer"><b>A2A is the open protocol for one AI agent to delegate work to another</b>,
        across vendors and frameworks, without either exposing its internals. Google introduced it in
        April 2025; the Linux Foundation has governed it since June 2025 under Apache 2.0. Where MCP
        connects an agent downward to tools and data, A2A connects it sideways to other agents.</p>
      <p class="meta-line">Last verified: {sec.generated} · Every point below is sourced to the
        {' '}<a href="https://a2a-protocol.org/latest/specification/" rel="noopener">A2A specification v1.0</a>,
        the Linux Foundation, or Google's own announcements, verified before publication and re-verified
        daily. This page describes what the protocol specifies, not an audit of any implementation.</p>

      {sec.repo_stars > 0 && (
        <p class="meta-line">Live from this site's repo tracker: the
          {' '}<a href="https://github.com/a2aproject/A2A" rel="noopener">a2aproject/A2A</a> repository
          has <b>{Number(sec.repo_stars).toLocaleString()}</b> stars, last pushed {String(sec.repo_pushed).slice(0,10)}.
          The MCP side of the same stack: <b>{Number(sec.mcp_servers).toLocaleString()}</b> servers tracked from the official registry.</p>
      )}

      {[['governance','Origin and governance'],['mechanics','How the protocol works'],['comparison','A2A and MCP together']].map(([g, label]) => (
        <section>
          <h2>{label}</h2>
          {sec.items.filter((i) => i.group === g).map((i) => (
            <div class="dom">
              <h3>{i.name}</h3>
              <p>{i.body}</p>
              <p class="meta-line">Source: <a href={i.source_url} rel="noopener">{i.source_name}</a></p>
            </div>
          ))}
        </section>
      ))}

      <div class="dom">
        <h3>MCP versus A2A at a glance</h3>
        <table>
          <thead><tr><th>Protocol</th><th>Focus</th><th>Primary connection</th><th>Steward</th></tr></thead>
          <tbody>
            <tr><td>MCP</td><td>Tool and context access</td><td>Agent → databases, files, enterprise APIs, via servers</td><td>Anthropic (open specification)</td></tr>
            <tr><td>A2A</td><td>Inter-agent delegation</td><td>Agent → other autonomous agents, via Agent Cards and tasks</td><td>Linux Foundation (Google-originated)</td></tr>
          </tbody>
        </table>
        <p class="meta-line">Related on this site: <a href="/mcp/">the MCP server registry</a> ·
          the MCP Security and Authentication section · the Multi-agent Systems repos section ·
          AI Agent Security and Agent and Non-Human Identity under AI Security and Risk.</p>
      </div>

      <div class="cite-box">Cite this page: <code>"{sec.name}." The World of AI,
        theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

  {isMCPSec && (
    <>
      <p class="answer"><b>MCP's security model in five load-bearing facts</b>, each sourced to
        the specification itself. The short version: authorization is OAuth 2.1, the trust
        boundary sits at the server, tool metadata is attack surface, and credentials belong to
        the user — never to the model.</p>
      <p class="meta-line">Last verified: {sec.generated} · Source: the
        {' '}<a href="https://modelcontextprotocol.io/specification/2025-06-18/basic/authorization"
        rel="noopener">MCP authorization specification</a> and its
        {' '}<a href="https://modelcontextprotocol.io/specification/2025-06-18/basic/security_best_practices"
        rel="noopener">security best practices</a>. This page describes the protocol's model,
        not an audit of any implementation.</p>
      {sec.points.map((f) => (
        <div class="dom">
          <h3>{f.name}</h3>
          <p>{f.desc}</p>
          <p class="meta-line"><a href={f.source} rel="noopener">Specification source</a></p>
        </div>
      ))}
      <div class="cite-box">Cite this page: <code>"MCP Security and Authentication." The World of
        AI, theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

  {isMeta && (
    <>
      <p class="answer">Every model row on this site carries the same record, and every field
        names its source. Just as important is what is <b>not</b> tracked: fields with no free,
        verifiable primary source are left out rather than guessed.</p>
      <p class="meta-line">Last verified: {sec.generated} · This standard describes the live
        pipeline; when a field is added or retired, this page changes with it.</p>
      <h2>Open-weight models (Hugging Face sections)</h2>
      {sec.open_fields.map((f) => (
        <div class="dom"><h3>{f.name}</h3><p>{f.desc}</p>
          <p class="meta-line">Source: {f.source}</p></div>
      ))}
      <h2>API models (pricing and catalogue sections)</h2>
      {sec.api_fields.map((f) => (
        <div class="dom"><h3>{f.name}</h3><p>{f.desc}</p>
          <p class="meta-line">Source: {f.source}</p></div>
      ))}
      <h2>Deliberately not tracked</h2>
      {sec.not_tracked.map((f) => (
        <div class="dom"><h3>{f.name}</h3><p>{f.why}</p></div>
      ))}
      <div class="cite-box">Cite this page: <code>"Model Metadata Standard." The World of AI,
        theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

  {isDir && (
    <>
      <p class="answer"><b>{sec.total} public AI APIs</b>, each with its base endpoint,
        documentation, authentication scheme, and official SDKs — <b>{sec.openai_compatible}</b>
        {' '}of them speak the OpenAI-compatible dialect, which means one SDK covers most of the
        market. Every documentation link was individually verified before listing.</p>
      <p class="meta-line">Last verified: {sec.generated} · Curated from each provider's own
        developer documentation. Pricing lives in <a href={`${BASE}/56f96b2b/`}>API Pricing</a>
        {' '}and live reliability in <a href={`${BASE}/5b57e70c/`}>API Status and Uptime</a>.
        A missing API is an editorial gap, not a judgement — <a href="/contact/">tell us</a>.</p>
      {sec.apis.map((a) => (
        <div class="dom">
          <h3>{a.entity_uid
            ? <a href={`/ai-ecosystem/ecosystem-entities-market-and-operations/${a.entity_uid}/`}>{a.provider}</a>
            : a.provider}
            {a.openai_compatible && <span class="n">OpenAI-compatible</span>}</h3>
          {a.note && <p>{a.note}.</p>}
          <p class="meta-line">Base: <code>{a.base_url}</code> · Auth: {a.auth} · SDKs: {a.sdks} ·
            {' '}<a href={a.docs_url} rel="noopener">Documentation</a>
            {a.has_status && <> · <a href={`${BASE}/5b57e70c/`}>status tracked</a></>}</p>
        </div>
      ))}
      <div class="cite-box">Cite this page: <code>"API Directory." The World of AI,
        theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

  {isLang && (
    <>
      <p class="answer"><b>{sec.total} languages carry AI work.</b> Python is the interface
        nearly everything presents; C++ and Rust are the performance layer underneath it; Go and
        TypeScript run the plumbing and the products; Julia and Mojo bet on closing the gap
        between the two. Each profile below names the steward, the first release, and — where
        this site tracks repositories written in the language — the projects themselves.</p>
      <p class="meta-line">Last verified: {sec.generated} · Repository attributions come from the
        tracked-repo catalogue (GitHub's own language classification), refreshed daily; language
        profiles are curated with a verified source each.</p>
      {sec.languages.map((l) => (
        <div class="dom">
          <h3>{l.name} <span class="n">{l.first_release}</span></h3>
          <p>{l.ai_role}</p>
          <p class="meta-line">Steward: {l.steward} ·
            {' '}<a href={l.source_url} rel="noopener">Official site</a> · verified {l.verified}
            {l.verify_note && <span class="vnote"> · {l.verify_note}</span>}
            {l.repos && l.repos.length > 0 && <> · Tracked repos: {l.repos.join(', ')}</>}</p>
        </div>
      ))}
      <div class="cite-box">Cite this page: <code>"Programming Languages." The World of AI,
        theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

  {isRepo && (
    <>
      <p class="answer"><b>{sec.total} projects</b>, <b>{fmt(sec.stars_total)}</b> GitHub stars
        between them. {licLine && <>Licences here: {licLine}.</>} {sec.blurb} The list is
        curated — these are the canonical repositories, individually verified — and the numbers
        come from GitHub itself on every refresh.</p>
      <p class="meta-line">Last verified: {sec.generated} · Source: the
        {' '}<a href="https://docs.github.com/en/rest" rel="noopener">GitHub REST API</a>,
        refreshed daily. Stars are a popularity signal, not a quality metric; the licence and
        last-push columns are the ones that decide whether you can ship it and whether it is
        still alive.</p>

      <table class="pay">
        <thead><tr><th>Project</th><th>What it is</th><th>Licence</th><th class="num">Stars</th><th>Language</th><th>Last push</th></tr></thead>
        <tbody>
          {sec.repos.map((r) => (
            <tr>
              <td><a href={r.url} rel="noopener">{r.name}</a>{r.archived && <span class="n">archived</span>}</td>
              <td>{r.description || '—'}</td>
              <td>{r.licence || '—'}</td>
              <td class="num">{fmt(r.stars)}</td>
              <td>{r.language || '—'}</td>
              <td>{r.pushed_at ? String(r.pushed_at).slice(0, 10) : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="meta-line">A repository missing from this list is an editorial gap, not a
        judgement — <a href="/contact/">tell us</a> and it gets verified and added.</p>
    </>
  )}

  {isStatus && (
    <>
      <p class="answer"><b>{sec.healthy} of {sec.total} AI API providers</b> report all systems
        operational right now. Each row below is that provider's own status page, read directly:
        current state, anything degraded, and how many incidents they have opened in the last 30
        days — which is the number that tells you what a provider is like to depend on.</p>
      <p class="meta-line">Last checked: {sec.generated} · Source: each provider's public
        Statuspage API, refreshed daily. Incident links open the provider's own incident record.
        Providers without a machine-readable status page cannot be tracked here yet.</p>

      <table class="pay">
        <thead><tr><th>Provider</th><th>Status</th><th>Degraded</th><th class="num">Incidents, 30d</th><th>Latest incident</th></tr></thead>
        <tbody>
          {sec.providers.map((p) => (
            <tr>
              <td>{p.entity_uid
                ? <a href={`/ai-ecosystem/ecosystem-entities-market-and-operations/${p.entity_uid}/`}>{p.provider}</a>
                : p.provider} <a href={p.page_url} rel="noopener" class="n">status page</a></td>
              <td class={p.indicator === 'none' ? 'ok' : 'warn'}>{p.description}</td>
              <td>{p.degraded?.length ? p.degraded.join('; ') : '—'}</td>
              <td class="num">{p.incidents_30d}</td>
              <td>{p.recent?.length
                ? <a href={p.recent[0].url} rel="noopener">{p.recent[0].name}</a>
                : '—'}{p.recent?.length > 0 && <span class="muted"> ({p.recent[0].created})</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="meta-line">Snapshots are taken once a day at build time, so a brief outage
        between builds will not show here; the 30-day incident count comes from each provider's
        own incident log and does not depend on our sampling.</p>
    </>
  )}

  {hf && (
    <>
      <p class="answer">The <b>{sec.total} most-downloaded open {sec.name.toLowerCase()}</b> on the
        Hugging Face Hub, together downloaded <b>{fmt(sec.downloads_total)}</b> times.
        {licLine && <> The most common licences here: {licLine}.</>}
        {sec.newest && <> Newest entry in this set: {sec.newest}.</>} {sec.blurb}</p>
      <p class="meta-line">Last verified: {sec.generated} · Source: the
        {' '}<a href="https://huggingface.co/models" rel="noopener">Hugging Face Hub</a> public API,
        sorted by all-time downloads, refreshed daily. Every model links to its own Hub page.</p>

      <table class="pay">
        <thead><tr><th>Model</th><th>Licence</th><th class="num">Downloads</th><th class="num">Likes</th><th>Task</th><th>Released</th></tr></thead>
        <tbody>
          {sec.models.map((m) => (
            <tr>
              <td><a href={m.url} rel="noopener">{m.id}</a></td>
              <td>{m.licence || '—'}</td>
              <td class="num">{fmt(m.downloads)}</td>
              <td class="num">{fmt(m.likes)}</td>
              <td>{m.task}</td>
              <td>{m.created || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="meta-line">Downloads are the Hub's all-time counter and favour older models;
        the Released column is what shows you the newer entries climbing. A missing licence
        means the repository does not declare one, which itself matters if you plan to ship it.</p>
    </>
  )}

  {isAPI && (
    <>
      <p class="answer"><b>{sec.total} {sec.name.toLowerCase()}</b> are available over commercial
        APIs right now, from <b>{sec.stats.provider_count} providers</b>. Median price:
        {' '}<b>{money(sec.stats.median_prompt_pm)}</b> per million input tokens and
        {' '}<b>{money(sec.stats.median_completion_pm)}</b> per million output tokens. The largest
        context window in this set is <b>{ctx(sec.stats.context_max)} tokens</b>;
        {' '}{sec.stats.open_weight_count} of these models also publish open weights. {sec.blurb}</p>
      <p class="meta-line">Last verified: {sec.generated} · Source: the
        {' '}<a href="https://openrouter.ai/models" rel="noopener">OpenRouter</a> public model API,
        refreshed daily. Newest releases first. Prices are per one million tokens.</p>

      <table class="pay">
        <thead><tr><th>Model</th><th>Provider</th><th class="num">Context</th><th class="num">$/M in</th><th class="num">$/M out</th><th>Released</th></tr></thead>
        <tbody>
          {sec.models.map((m) => (
            <tr>
              <td><a href={m.url} rel="noopener">{m.name}</a>{m.open_weights && <span class="n">open</span>}</td>
              <td>{m.provider}</td>
              <td class="num">{ctx(m.context)}</td>
              <td class="num">{money(m.prompt_pm)}</td>
              <td class="num">{money(m.completion_pm)}</td>
              <td>{m.released}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="meta-line">A price of $0.00 means the provider currently lists the model as free
        to call, usually rate-limited. "Open" marks models whose weights are also published for
        self-hosting, which is the practical difference between renting a model and owning your
        deployment of it.</p>
    </>
  )}

  {isPricing && (
    <>
      <p class="answer">Per-token prices for <b>{sec.total} AI models</b> across
        {' '}<b>{sec.stats.provider_count} providers</b>, in dollars per million tokens. The median
        model costs <b>{money(sec.stats.median_prompt_pm)}/M input</b> and
        {' '}<b>{money(sec.stats.median_completion_pm)}/M output</b>.
        {sec.free_count > 0 && <> <b>{sec.free_count}</b> models are currently listed free to
        call, usually rate-limited.</>}
        {sec.cheapest && <> Cheapest paid model right now:
        {' '}<a href={sec.cheapest.url} rel="noopener">{sec.cheapest.name}</a> at
        {' '}{money(sec.cheapest.prompt_pm)}/M in.</>}
        {sec.cheapest_128k && <> Cheapest paid with a context of 128k or more:
        {' '}<a href={sec.cheapest_128k.url} rel="noopener">{sec.cheapest_128k.name}</a> at
        {' '}{money(sec.cheapest_128k.prompt_pm)}/M in.</>}</p>
      <p class="meta-line">Last verified: {sec.generated} · Source: the
        {' '}<a href="https://openrouter.ai/models" rel="noopener">OpenRouter</a> public model API,
        refreshed daily. Grouped by provider, cheapest input price first within each. Output
        tokens usually cost more than input; budget on the output number for generation-heavy work.</p>

      {sec.providers.map((p) => (
        <section class="letter-block">
          <h2 id={p.provider}>{p.provider} <span class="n">{p.models.length}</span></h2>
          <table class="pay">
            <thead><tr><th>Model</th><th class="num">Context</th><th class="num">$/M in</th><th class="num">$/M out</th><th>Released</th></tr></thead>
            <tbody>
              {p.models.map((m) => (
                <tr>
                  <td><a href={m.url} rel="noopener">{m.name}</a></td>
                  <td class="num">{ctx(m.context)}</td>
                  <td class="num">{money(m.prompt_pm)}</td>
                  <td class="num">{money(m.completion_pm)}</td>
                  <td>{m.released}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))}

      {sec.retiring?.length > 0 && (
        <section class="letter-block">
          <h2 id="retirements">Scheduled retirements <span class="n">{sec.retiring.length}</span></h2>
          <p>Models with a published shutdown date. The date comes from the routing catalog's own
            deprecation field; after it, calls to the model stop working and traffic must move to a
            successor. Soonest first.</p>
          <table class="pay">
            <thead><tr><th>Model</th><th>Provider</th><th>Retires</th></tr></thead>
            <tbody>
              {sec.retiring.map((m) => (
                <tr>
                  <td><a href={m.url} rel="noopener">{m.name}</a></td>
                  <td>{m.provider}</td>
                  <td>{m.expires}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )}
    </>
  )}

  {isProv && (
    <>
      <p class="answer"><b>{sec.total} companies</b> run the inference behind AI model APIs. This
        directory lists each serving provider with its headquarters country and, where published,
        its datacenter regions — the two facts that decide which AI regulations (the EU AI Act,
        data-residency rules, export controls) apply to a deployment — plus links to each
        provider's own terms of service, privacy policy, and live status page.</p>
      <p class="meta-line">Last verified: {sec.generated} · Source: the
        {' '}<a href="https://openrouter.ai/models" rel="noopener">OpenRouter</a> public providers
        API, refreshed daily. Policy and status links open the provider's own pages.</p>
      <table class="pay">
        <thead><tr><th>Provider</th><th>Headquarters</th><th>Datacenters</th><th>Links</th></tr></thead>
        <tbody>
          {sec.providers.map((p) => (
            <tr>
              <td>{p.name}</td>
              <td>{p.hq || '—'}</td>
              <td>{Array.isArray(p.datacenters) ? p.datacenters.join(', ') : '—'}</td>
              <td>
                {p.terms && <a href={p.terms} rel="noopener nofollow">Terms</a>}
                {p.privacy && <> · <a href={p.privacy} rel="noopener nofollow">Privacy</a></>}
                {p.status && <> · <a href={p.status} rel="noopener nofollow">Status</a></>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  {sec.api_models?.length > 0 && (
    <>
      <h2>Available over commercial APIs</h2>
      <p>The models above publish open weights on the Hugging Face Hub. These
        {' '}<b>{sec.api_models.length}</b> are served over commercial APIs, with per-token

                      <td class="num">{mw ? mw : '—'}</td>
                      <td>{f.lat ? <a href={`https://www.openstreetmap.org/?mlat=${f.lat}&mlon=${f.lon}#map=${many ? 15 : 16}/${f.lat}/${f.lon}`}
                        rel="noopener">view</a> : '—'}</td>
                    </tr>
                  );
                });
              })()}

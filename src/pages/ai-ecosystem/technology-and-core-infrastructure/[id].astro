---
/**
 * Technology and Core Infrastructure: model-catalog sections, addressed by
 * identifier, same addressing rule as the entities category. One route serves
 * every section built from content/models/*.json.
 *
 * Two page shapes. Hugging Face sections (open-weight catalogs per modality)
 * lead with downloads, licences, and recency. OpenRouter sections (API
 * models and pricing) lead with computed price and context statistics. Both
 * link every model to its original home, never to a copy, and both carry the
 * source, the refresh cadence, and a cite box.
 */
import Base from '../../../layouts/Base.astro';
import Reading from '../../../components/Reading.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

const CATEGORY = 'technology-and-core-infrastructure';
const CATEGORY_NAME = 'Technology and Core Infrastructure';
const BASE = `/ai-ecosystem/${CATEGORY}`;

export function getStaticPaths() {
  const paths = [];
  for (const dir of ['models', 'repos', 'status', 'tech']) {
    if (!existsSync(`content/${dir}`)) continue;
    for (const f of readdirSync(`content/${dir}`)) {
      if (!f.endsWith('.json')) continue;
      const d = JSON.parse(readFileSync(`content/${dir}/${f}`, 'utf8'));
      if (!d.uid) continue;
      paths.push({ params: { id: d.uid }, props: { sec: d } });
    }
  }
  return paths;
}
const { sec } = Astro.props;

const isPricing = sec.tax === 'api-pricing';
const isAPI = sec.source === 'openrouter' && !isPricing && sec.shape !== 'serving-providers';
const hf = sec.source === 'huggingface';
const isRepo = sec.source === 'github';
const isStatus = sec.tax === 'api-status-uptime';
const isDir = sec.tax === 'api-directory';
const isLang = sec.tax === 'programming-languages';
const isMeta = sec.kind === 'standard' && sec.tax === 'model-metadata';
const isMCPSec = sec.tax === 'mcp-security';
const isClients = sec.tax === 'mcp-clients';
const isA2A = sec.shape === 'a2a';
const isHW = sec.shape === 'hardware';
const isDS = sec.shape === 'datasets';
const isDSLic = sec.shape === 'ds-licensing';
// Vibe Coding: a short authored explainer plus a routing table into the
// sections that already cover each part of the job. See twoai_vibe_coding.go.
const isVibe = sec.shape === 'vibe-coding';
const isProv = sec.shape === 'serving-providers';
const isDC = sec.shape === 'datacenters';
const isDCChild = ['dc-state', 'dc-metric', 'dc-builder', 'dc-smr', 'dc-grid', 'dc-facility', 'dc-operator', 'dc-operators-index', 'dc-states-index'].includes(sec.shape);
const metricUID = isDC ? Object.fromEntries((sec.metric_pages || []).map((m) => [m.label, m.uid])) : {};
const builderUID = isDC ? Object.fromEntries((sec.builder_pages || []).map((b) => [b.label, b.uid])) : {};
const dcOps = isDC ? (sec.metrics || []).filter((m) => m.track === 'operations') : [];
const dcMkt = isDC ? (sec.metrics || []).filter((m) => m.track === 'market') : [];
const dcOpsCats = [...new Set(dcOps.map((m) => m.category))];
const dcMktCats = [...new Set(dcMkt.map((m) => m.category))];
const dcSrcKinds = [
  ['grid-queue', 'Grid operators and public power data'],
  ['market-intel', 'Market intelligence, commercial'],
  ['standard', 'Standards and industry bodies'],
  ['dcim', 'Operations software, DCIM'],
];
const dollars = (v) => '$' + (v / 1e9).toFixed(1) + 'B';
const mdLite = (t: string) => t
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
  .split(/\n\n+/).map((p) => (/^\d+\.\s/m.test(p)
    ? `<ol>${p.split(/\n/).map((l) => `<li>${l.replace(/^\d+\.\s/, '')}</li>`).join('')}</ol>`
    : `<p>${p.replace(/\n/g, ' ')}</p>`)).join('');

const fmt = (n) => Number(n).toLocaleString();
const money = (v) => (v === null || v === undefined ? '—' : `$${v}`);
const ctx = (n) => (n >= 1000 ? `${Math.round(n / 1000)}k` : `${n}`);

// The Data Centers children (state and country directories, metrics,
// builders, the SMR tracker, the Grid Observatory) are the one family of
// docs on this route with no `name` field: they carry `state`, or a metric
// title, or nothing at all. Every branch below reaches for sec.name, so
// without this they fall through to the final fallback and the build dies
// on `Cannot read properties of undefined (reading 'toLowerCase')`, which
// is exactly what took the site down between 03:19 and 15:37 on 2026-08-30.
// Give them their own description, and make every other branch tolerate a
// missing name rather than trusting it.
const secName = sec.name || sec.state || 'AI infrastructure';

// The publisher of a facility page: the operator when OSM tagged one, else
// the host the specifications were read from, which is a fact we hold.
// WHO PUBLISHED THE FACTS, which is not always the operator. The source
// publisher is asked first and the operator is only the fallback, because a
// facility recorded from a state announcement and a county compliance
// release must not be described as the operator's own spec sheet.
// The publisher is whoever the SOURCE names, and nothing else. This used to
// fall back to sec.operator, so every row carrying an operator string claimed
// "published by <operator> on its own facility page" - printed on CITIGROUP
// TECHNOLOGY INC on 2026-09-02 for a facility Citigroup has never published a
// word about. The comment below records an early version printing the same
// line on every unattributed facility; the operator fallback brought it back
// one step later. No source, no publisher, no claim.
const facPublisher = sec.profile?.source?.publisher || '';

// The lead sentence is assembled here rather than in the markup. Astro
// inserts whitespace between expressions written on separate lines, which
// printed "40,000 sq ft of technical space ." and "space , published by"
// on the first facility pages. A sentence built as a string has the
// punctuation where it belongs.
const facSqft = Number(sec.profile?.technical_space_sqft || 0);
const facLead = sec.mw
  ? `${sec.mw} MW of IT capacity`
  : facSqft > 0
    ? `${facSqft.toLocaleString()} sq ft of technical space`
    : sec.name;
// A facility read from a government record is not the operator speaking. The
// Atlas Power page is built from the North Dakota governor's announcement and
// Williams County's own compliance release, and saying "published by Atlas
// Power on its own facility page" would put words in the operator's mouth.
// The sentence follows the source: same-party when the publisher IS the
// operator, third-party when it is not.
const facSelfPublished = !!sec.operator && !!facPublisher
  && facPublisher.toLowerCase().startsWith(sec.operator.toLowerCase().split(' ')[0].toLowerCase());
const facLede = sec.profile?.planned_phases?.length && !sec.mw
  ? `${sec.name} is an announced build in ${sec.city || sec.state}`
  : facLead;
const facRest = [
  sec.mw && facSqft > 0 ? ` across ${facSqft.toLocaleString()} sq ft of technical space` : '',
  sec.profile?.campus ? `, campus ${sec.profile.campus}` : '',
  facPublisher
    ? (facSelfPublished
        ? `, published by ${facPublisher} on its own facility page`
        : `, recorded here from ${facPublisher}`)
    : '',
].join('') + '.';
// What the reader should trust the numbers as. An operator spec sheet and a
// county compliance release are different kinds of fact and must not be
// described with the same sentence.
// A row that carries a spec figure or a named source has, by definition,
// something published about it. On 2026-09-04 the SV1 page carried Equinix's
// own square footage in its reading while the basis line said the operator
// had published no specifications - because the research pass stored the
// figure under a key this test did not look at. The test now looks at all
// of them.
const facHasSources = (Array.isArray(sec.profile?.sources)
  && sec.profile.sources.some((s) => s && (s.title || s.url || s.publisher)))
  || !!sec.profile?.source?.url
  || ['space_sqft', 'technical_space_sqft', 'building_sqft', 'it_capacity_mw', 'planned_it_capacity_mw',
      'certifications', 'power_density_kw_rack', 'standby_generation_mw'].some((k) => sec.profile && sec.profile[k]);
const facBasis = facSelfPublished
  ? "Every figure here is the operator's stated specification"
  : facHasSources
    ? 'Every figure here comes from the public records named at the foot of this page'
    : 'This facility is mapped in OpenStreetMap; its operator has published no specifications for it, and none are inferred here';

// The dc children carry no `name` field, and sec.name straight into the
// <title> is what published "undefined — The World of AI" on every one of
// those pages until 2026-08-30. Each shape knows its own headline.
const pageTitle =
  sec.shape === 'dc-state' ? `Data centers in ${sec.state}` :
  sec.shape === 'dc-facility'
    ? (sec.profile?.campus_buildings > 1
        ? `${sec.name}, building ${sec.profile.campus_building} of ${sec.profile.campus_buildings}`
        : sec.name) :
  sec.shape === 'dc-operator' ? `${sec.name}: every data center it operates` :
  sec.shape === 'dc-operators-index' ? 'Data centers by operator' :
  sec.shape === 'dc-states-index' ? 'Data centers by state' :
  sec.shape === 'dc-metric' ? (sec.metric?.metric || secName) :
  sec.shape === 'dc-builder' ? `${sec.builder?.name || secName} data center capex` :
  sec.shape === 'dc-smr' ? 'SMR programs powering data centers' :
  sec.shape === 'dc-grid' ? 'The Grid Observatory' :
  secName;

const _descRaw = isDCChild
  ? (sec.shape === 'dc-facility'
      ? `${sec.name}: ${sec.mw ? `${sec.mw} MW IT capacity, ` : ''}operator-published facility specifications with source and retrieval date, in the ${sec.state || sec.country} directory of the data center registry.`
      : sec.shape === 'dc-operators-index'
      ? `Every company operating data centers in this registry, ${sec.operator_count} operators across ${sec.facility_count} mapped facilities, grouped by what kind of operator they are, each with its own page listing every facility it controls.`
      : sec.shape === 'dc-states-index'
      ? `Directory pages for data centers in every US state, ${sec.facility_count} mapped facilities, built from OpenStreetMap and grown from operator publications and public records.`
      : sec.shape === 'dc-operator'
      ? `${sec.name} operates ${sec.facility_count} mapped data centers${sec.known_mw ? ` with ${Math.round(sec.known_mw)} MW of published IT capacity` : ''}, listed here by state with address, capacity and campus where the operator or a public record states them, and one link at the end.`
      : sec.shape === 'dc-state'
      ? `${sec.count} mapped data centers in ${sec.state}, with operator and locality where OpenStreetMap contributors have tagged them. Part of the data center facility registry.`
      : sec.shape === 'dc-grid'
      ? `US grid interconnection queues harvested daily from the operators' own files: requests, megawatts tracked, and the storage, solar, wind and gas split behind the AI data center buildout.`
      : sec.shape === 'dc-smr'
      ? `Small modular reactor programs signed to power data centers, with deal status, NRC licensing pathway, fuel type and target date, every figure sourced.`
      : `${secName}, part of the Data Centers section: the capital, buildings and power behind AI compute.`)
  : isHW
  ? `${sec.total} ${secName.toLowerCase()} entries, each curated with a verified vendor or primary source and re-verified daily. ${sec.blurb}`
  : isDS
  ? `${sec.total} ${secName.toLowerCase()}, curated for significance with downloads, licence, and gating refreshed daily from the Hugging Face Hub. ${sec.blurb}`
  : isDSLic
  ? `Licence split, gating, and provenance context for the dataset catalogue on this site, with the live copyright docket linked from the lawsuit tracker.`
  : isA2A
  ? `The Agent2Agent protocol explained from its v1.0 specification: origin at Google, governance at the Linux Foundation, Agent Cards, task lifecycle, three protocol bindings, enterprise security schemes, and how it complements MCP.`
  : isClients
  ? `${sec.total} applications that speak the Model Context Protocol, ${sec.open_source} of them open source, each verified against its own site; the protocol's official client list is the canonical registry.`
  : isMCPSec
  ? `The Model Context Protocol's security model, documented from the specification: OAuth 2.1 authorization, the server trust boundary, tool-metadata injection, confused-deputy failures, and credential handling.`
  : isMeta
  ? `The record kept for every model on this site: which fields are tracked, where each comes from, and what is deliberately not tracked and why.`
  : isDir
  ? `${sec.total} public AI APIs with base endpoint, documentation, authentication scheme, and official SDKs, ${sec.openai_compatible} of them OpenAI-compatible; every docs link individually verified, refreshed daily.`
  : isLang
  ? `${sec.total} programming languages that carry AI work, from Python's interface layer to the C++ and Rust systems underneath, each profiled with steward, first release, and the tracked repositories written in it.`
  : isRepo
  ? `The ${sec.total} ${secName.toLowerCase()} that matter, tracked from their own repositories: stars, licence, language, and last activity, refreshed daily. ${sec.blurb}`
  : isStatus
  ? `Live status for ${sec.total} AI API providers from their own status pages, with current incidents and a 30-day incident count per provider, refreshed daily.`
  : isPricing
  ? `Per-token API pricing for ${sec.total} AI models across ${sec.stats?.provider_count} providers, in dollars per million tokens, refreshed daily. Median input price ${money(sec.stats?.median_prompt_pm)}/M.`
  : isProv
  ? `${sec.total} AI model serving providers with headquarters country, datacenter regions, and links to terms, privacy policy, and live status pages. Refreshed daily.`
  : isAPI
  ? `${sec.total} ${secName.toLowerCase()} available over commercial APIs, with context window, per-token pricing, and release date, refreshed daily. ${sec.blurb}`
  : `The ${sec.total} most-downloaded open ${secName.toLowerCase()} on the Hugging Face Hub, with licence, downloads, and release date, refreshed daily. ${sec.blurb}`;
const desc = _descRaw.length <= 158 ? _descRaw : `${_descRaw.slice(0, 157).replace(/\s+\S*$/, '')}…`;

// The thinnest pages on the site on 2026-08-30 were the metric and builder
// children, at 86 to 102 words. Each now answers the questions a reader
// actually arrives with, and the same pairs go out as FAQPage schema so the
// visible answer and the machine-readable one never differ.
const dcFaqs = [];
if (sec.shape === 'dc-metric' && sec.metric) {
  const m = sec.metric;
  dcFaqs.push({ q: `What is ${m.metric}?`, a: m.definition });
  if (m.formula) dcFaqs.push({ q: `How is ${m.metric} calculated?`, a: `${m.metric} is computed as ${m.formula}.` });
  dcFaqs.push({ q: `Why does ${m.metric} matter for AI data centers?`, a: m.why });
  if (m.target) dcFaqs.push({ q: `What is a good ${m.metric}?`, a: m.target });
  if (m.source_name) dcFaqs.push({ q: `Who defines ${m.metric}?`, a: `${m.source_name} publishes the definition this page follows.` });
}
const bSeries = sec.shape === 'dc-builder' && sec.builder ? (sec.builder.series || []) : [];
const bPrior = bSeries.length > 1 ? bSeries[1] : null;
const bYear = bSeries.length > 4 ? bSeries[4] : null;
const pct = (a, b) => (b ? Math.round(((a - b) / b) * 100) : null);
const bRank = sec.shape === 'dc-builder' && sec.peers
  ? sec.peers.findIndex((p) => p.name === sec.builder.name) + 1 : 0;
if (sec.shape === 'dc-builder' && sec.builder) {
  const b = sec.builder;
  dcFaqs.push({ q: `How much is ${b.name} spending on data centers?`, a: `${b.name} reported ${dollars(b.latest)} of capital expenditure for the quarter ended ${b.end}, per its own XBRL company facts filed with the SEC.` });
  if (bPrior) dcFaqs.push({ q: `Is ${b.name}'s capex rising or falling?`, a: `Against the prior quarter (${bPrior.end}, ${dollars(bPrior.val)}) the latest figure is ${pct(b.latest, bPrior.val) >= 0 ? 'up' : 'down'} ${Math.abs(pct(b.latest, bPrior.val))}%${bYear ? `; against the same quarter a year earlier (${bYear.end}, ${dollars(bYear.val)}) it is ${pct(b.latest, bYear.val) >= 0 ? 'up' : 'down'} ${Math.abs(pct(b.latest, bYear.val))}%` : ''}.` });
  if (bRank > 0) dcFaqs.push({ q: `How does ${b.name} compare with other data center builders?`, a: `${b.name} ranks ${bRank} of ${sec.peers.length} builders this site tracks by latest quarterly capex; the largest is ${sec.peers[0].name} at ${dollars(sec.peers[0].latest)}.` });
  dcFaqs.push({ q: `Where does this number come from?`, a: `From ${b.name}'s XBRL company facts on data.sec.gov, read daily. Capex is tagged under different concepts by different filers; the fetcher keeps whichever tag the company currently files.` });
}

const jsonld = JSON.stringify(dcFaqs.length ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: `${pageTitle} — The World of AI`,
      description: desc.slice(0, 300),
      url: `https://theworldofai.org${BASE}/${sec.uid}/`,
      dateModified: sec.generated,
      isPartOf: { '@type': 'CollectionPage', name: CATEGORY_NAME, url: `https://theworldofai.org${BASE}/` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: dcFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
} : {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${pageTitle} — The World of AI`,
  description: desc.slice(0, 300),
  url: `https://theworldofai.org${BASE}/${sec.uid}/`,
  dateModified: sec.generated,
  isPartOf: { '@type': 'CollectionPage', name: CATEGORY_NAME, url: `https://theworldofai.org${BASE}/` },
});

// Licence counts render as a readable clause, not a chart.
const licLine = (sec.licences || [])
  .map((l) => `${l.licence} (${l.count})`)
  .join(', ');
// A FACILITY PAGE WITH NOTHING ON IT IS NOT ADVERTISED. Stephen, 2026-09-02,
// after seeing 881 pages that held a name, coordinates and boilerplate: this
// site's reputation is the thing at stake, and a search engine must not be
// invited to a page that cannot answer a question yet. The page still
// builds, still serves, still sits in its state directory - the never-removed
// rule is untouched - but it declares noindex, and sitemap-noindex-prune.mjs
// reads that from the built HTML and drops it from the sitemap. The moment
// the facility gains a reading, the next build indexes it again on its own.
// Same containment the research paper pages use.
//
// TIGHTENED 2026-09-03. The first version indexed a facility that held any
// one fact - an address, a capacity - and a live crawl the same evening
// counted 1,570 facility pages in the sitemap under 500 words, 59 under 300:
// an address is a line, not a page. Indexing now requires a READING, either
// the cron's dated reading or the research pass's prose, because that is
// the only thing that carries a facility page past the floor. The facts
// still render for the reader who arrives by the directory or the operator
// page; the search engine is invited when the page can answer a question.
const facBare = sec.shape === 'dc-facility' && !(
  (sec.reading && sec.reading.body && String(sec.reading.body).length > 300)
  || (typeof sec.profile?.reading === 'string' && sec.profile.reading.length > 300)
);
---
<Base title={`${pageTitle} — The World of AI`} description={desc.slice(0, 300)}
  current={`${BASE}/`} jsonld={jsonld} noindex={facBare}>
  {isVibe && (
    <>
      {sec.blocks.map((b: any) => (
        <section class="vc-block">
          <h2>{b.heading}</h2>
          <div set:html={mdLite(b.body_md)}></div>
        </section>
      ))}

      <section class="vc-routes">
        <h2>Where to go next on this site</h2>
        <p class="vc-lede">
          Vibe coding touches most of what this site already tracks. Rather than restate any of it
          here, this is the map: what you are trying to do, and the section that covers it. Every
          destination below is a live page, resolved from the site taxonomy when this page was
          built, so a link here cannot outlive the section it points at.
        </p>
        <div class="rule"></div>
        <table class="vc-table">
          <thead><tr><th>If you need to</th><th>Go here</th></tr></thead>
          <tbody>
            {sec.routes.map((r: any) => (
              <tr>
                <td class="vc-need">{r.need}</td>
                <td><a href={r.href}>{r.name}</a><span class="vc-why">{r.why}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    </>
  )}



  <p class="meta-line"><a href="/">AI Ecosystem</a> ·
    <a href={`${BASE}/`}>{CATEGORY_NAME}</a></p>

  {sec.shape === 'dc-facility' && (
    <>
          {/* THE FACT BOX. Stephen, 2026-09-03: every data-centre page carries
              a box on the right with address, phone, operator, space, power,
              density and distance to the nearest airport. Rendered BEFORE the
              title so it sits at the top of the column, directly under the
              navigation, with the title and lede flowing beside it - not level
              with the lede, which is where it first landed. Every line is either
              a published figure with its source on this page, or "not
              published" - the box never estimates. The airport distance is
              computed from two public coordinates; the operator link goes to
              the operator's own page on this site. */}
          {(() => {
            const p = sec.profile || {};
            const addr = Array.isArray(p.address) ? p.address.join(', ') : (p.address || '');
            const op = sec.operator || '';
            const totalSqft = p.building_sqft || p.total_space_sqft || p.gross_sqft || null;
            const whiteSqft = p.technical_space_sqft || p.white_space_sqft || p.colocation_space_sqft || null;
            // space_sqft is the research pass's figure where the operator did
            // not say whether it meant the building or the floor; shown as
            // published, labelled as such, rather than hidden.
            const asPublished = (!totalSqft && !whiteSqft && p.space_sqft) ? p.space_sqft : null;
            const mwOp = sec.mw || p.it_capacity_mw || null;
            const mwPlan = p.planned_it_capacity_mw || null;
            const density = p.power_density_kw_rack || p.kw_per_rack || null;
            const phone = p.phone || p.contact_phone || null;
            const ap = sec.nearest_airport || null;
            const standby = p.standby_generation_mw || null;
            const certs = Array.isArray(p.certifications) ? p.certifications : [];
            const year = p.year_opened || p.year_built || null;
            const NP = <span class="fb-np">not published</span>;
            const fmtN = (n) => Number(n).toLocaleString();
            return (
              <aside class="fact-box" aria-label="Facility facts">
                <div class="fb-head">{sec.name}</div>
                <dl>
                  <dt>Address</dt><dd>{addr || (sec.city ? `${sec.city}${sec.state ? ', ' + sec.state : ''} (street address not published)` : NP)}</dd>
                  <dt>Phone</dt><dd>{phone || NP}</dd>
                  <dt>Operator</dt><dd>{op ? (sec.operator_uid ? <a href={`${BASE}/${sec.operator_uid}/`}>{op}</a> : op) : NP}</dd>
                  {asPublished
                    ? <><dt>Space, as published</dt><dd>{fmtN(asPublished)} sq ft</dd></>
                    : <><dt>Total space</dt><dd>{totalSqft ? `${fmtN(totalSqft)} sq ft` : NP}</dd>
                       <dt>Technical space</dt><dd>{whiteSqft ? `${fmtN(whiteSqft)} sq ft` : NP}</dd></>}
                  <dt>Total power</dt><dd>{mwOp ? `${fmtN(mwOp)} MW IT` : mwPlan ? `${fmtN(mwPlan)} MW planned` : NP}</dd>
                  <dt>Power density</dt><dd>{density ? `${fmtN(density)} kW per rack` : NP}</dd>
                  {standby ? <><dt>Standby generation</dt><dd>{fmtN(standby)} MW diesel</dd></> : null}
                  {year ? <><dt>Opened</dt><dd>{year}</dd></> : null}
                  {certs.length ? <><dt>Certifications</dt><dd>{certs.join(', ')}</dd></> : null}
                  <dt>Nearest airport</dt><dd>{ap ? <>{ap.miles} miles to {ap.name}{ap.iata ? ` (${ap.iata})` : ''}</> : NP}</dd>
                  <dt>AI Compute suitability, from published facts</dt>
                  <dd>{sec.suitability
                    ? <><b class="fb-score">{sec.suitability.score}</b> / 100 <span class="fb-np">from {sec.suitability.components.join(', ')}</span></>
                    : <span class="fb-np">not enough published data to score</span>}
                    {' '}<a href="/compute-suitability/" class="fb-how">how it is calculated</a></dd>
                </dl>
                <p class="fb-foot">Published figures only, sources at the foot of the page. Airport distance is
                  great-circle from the mapped coordinates.</p>
              </aside>
            );
          })()}
    </>
  )}
  <h1>{pageTitle}</h1>

  {isDC && (
    <>
      <p class="answer"><b>The physical layer of the AI boom, tracked from primary
        sources.</b> Quarterly capital expenditure from {sec.capex?.length || 0} builders,
        hyperscalers, colocation giants, and the pure-play AI cloud, read from each
        company's own SEC filings; their material facility and deal 8-Ks as they land;
        {' '}{sec.metrics?.length || 0} operations and market metrics defined in plain
        English; and a directory of who publishes what this page cannot verify.</p>
      <p class="meta-line">Last verified: {sec.generated} · Capex and filings refresh
        daily from SEC EDGAR. Definitions and the directory are editorial, in this
        site's own words, with the standard-setter linked.</p>

      <section>
        <h2>Two ways to track a data center</h2>
        <p>The industry track watches the market: megawatts in construction, land
          locked up, grid interconnection queues, power purchase agreements, capital

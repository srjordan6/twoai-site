---
/**
 * AI people directory: hub and profiles, addressed by identifier.
 *
 * Per Stephen's instruction 2026-08-03, new sections publish below the category
 * path under a short alphanumeric identifier rather than a name slug, so a page
 * keeps its address when the person's name or title changes. The hub and every
 * profile share this one route:
 *
 *   /ai-ecosystem/ecosystem-entities-market-and-operations/{id}/
 *
 * Source is site_people, the same records behind
 * srjconsultingservices.com/ai-resources/ai-people/.
 */
import Base from '../../../layouts/Base.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

const CATEGORY = 'ecosystem-entities-market-and-operations';
const CATEGORY_NAME = 'Ecosystem Entities, Market and Operations';
const BASE = `/ai-ecosystem/${CATEGORY}`;

export function getStaticPaths() {
  const paths = [];

  if (existsSync('content/people/index.json')) {
    const idx = JSON.parse(readFileSync('content/people/index.json', 'utf8'));
    paths.push({ params: { id: idx.uid }, props: { hub: idx } });
    for (const f of readdirSync('content/people')) {
      if (!f.endsWith('.json') || f === 'index.json') continue;
      const p = JSON.parse(readFileSync(`content/people/${f}`, 'utf8'));
      if (!p.uid) continue;
      // cat-*.json are the category section hubs (Researchers, Investors, ...),
      // not people; they render as member listings below the same route.
      if (f.startsWith('cat-')) {
        paths.push({ params: { id: p.uid }, props: { pcat: p, hubUid: idx.uid } });
        continue;
      }
      paths.push({ params: { id: p.uid }, props: { person: p, hubUid: idx.uid } });
    }
  }

  if (existsSync('content/companies/index.json')) {
    const cidx = JSON.parse(readFileSync('content/companies/index.json', 'utf8'));
    paths.push({ params: { id: cidx.uid }, props: { chub: cidx } });
    for (const f of readdirSync('content/companies')) {
      if (!f.endsWith('.json') || f === 'index.json') continue;
      const d = JSON.parse(readFileSync(`content/companies/${f}`, 'utf8'));
      // public.json and patents.json are the sourced section hubs, not
      // company records; they render as their own page shapes below.
      if (f === 'public.json') {
        paths.push({ params: { id: d.uid }, props: { csec: d, chubUid: cidx.uid } });
        continue;
      }
      if (f === 'patents.json') {
        paths.push({ params: { id: d.uid }, props: { cpat: d, chubUid: cidx.uid } });
        continue;
      }
      if (f === 'private.json') {
        paths.push({ params: { id: d.uid }, props: { cpriv: d, chubUid: cidx.uid } });
        continue;
      }
      if (f === 'acquisitions.json') {
        paths.push({ params: { id: d.uid }, props: { cma: d, chubUid: cidx.uid } });
        continue;
      }
      if (f === 'funding.json') {
        paths.push({ params: { id: d.uid }, props: { cfund: d, chubUid: cidx.uid } });
        continue;
      }
      if (['research-labs.json','university-labs.json','government-labs.json','nonprofits.json'].includes(f)) {
        paths.push({ params: { id: d.uid }, props: { corg: d, chubUid: cidx.uid } });
        continue;
      }
      paths.push({ params: { id: d.company.uid }, props: { company: d.company, generated: d.generated, chubUid: cidx.uid, website: d.website, profileText: d.profile_text } });
    }
  }

  if (existsSync('content/observatory')) {
    for (const f of readdirSync('content/observatory')) {
      if (!f.endsWith('.json')) continue;
      const d = JSON.parse(readFileSync(`content/observatory/${f}`, 'utf8'));
      if (d.uid) paths.push({ params: { id: d.uid }, props: { obs: d } });
    }
  }
  if (existsSync('content/jobs/index.json')) {
    const jidx = JSON.parse(readFileSync('content/jobs/index.json', 'utf8'));
    if (jidx.uid) paths.push({ params: { id: jidx.uid }, props: { jhub: jidx } });
  }

  return paths;
}
const { hub, person, hubUid, chub, company, generated, chubUid, jhub, pcat, csec, cpat, cpriv, corg, cfund, obs, cma, website, profileText } = Astro.props;

const obsDescs = obs ? {
  'obs-release-cadence': `Release cadence of the ${obs.models} open models this site tracks, by month, from each model's own Hub record.`,
  'obs-github-activity': `${obs.repos} tracked AI repositories: ${obs.pushed_7d} pushed in the last 7 days, ${Number(obs.stars_total).toLocaleString()} stars combined.`,
  'obs-huggingface': `Download leaders and licence split across the ${obs.models} tracked open models; ${Number(obs.downloads_total).toLocaleString()} downloads combined.`,
  'obs-api-uptime': `${obs.healthy_now} of ${obs.providers} tracked AI API providers healthy right now, with per-provider uptime share since observation began.`,
  'obs-funding-activity': `${obs.filings} SEC Form D filings across ${obs.companies} tracked AI companies, by month, from EDGAR.`,
  'obs-patent-filings': `${obs.companies} tracked AI companies hold granted US patents — a floor of ${Number(obs.patents_total).toLocaleString()} grants from the USPTO Open Data Portal.`,
  'obs-gpu-availability': `Quarterly capital expenditure from the ${obs.companies?.length ?? 0} companies whose capex is the AI buildout, from their own SEC XBRL facts — the lawful measure of compute, stated plainly where spot availability cannot be measured.`,
  'obs-security-incidents': `${obs.open_now} open incidents right now across ${obs.providers} tracked AI API providers' own status feeds.`,
}[obs.tax] : null;

const money = (n) => n >= 1e9 ? `$${(n/1e9).toFixed(1)}B` : n >= 1e6 ? `$${(n/1e6).toFixed(1)}M` : `$${Math.round(n/1e3)}k`;
const desc = cma
  ? `${cma.completed.length + cma.agreements.length} SEC 8-K filings - completed acquisitions (Item 2.01) and material definitive agreements (Item 1.01) - across ${cma.registrants} tracked AI registrants since 2024, each linked to the filing itself.`
  : obs
  ? (obsDescs || '')
  : cpriv
  ? `${cpriv.total} private AI companies in the directory, ${cpriv.with_formd} with SEC Form D exempt-offering disclosures on record, verified by elimination against SEC EDGAR registrants, refreshed daily.`
  : corg
  ? `${corg.name}: ${corg.total} individually verified organisations, each with a sourced classification note.`
  : cfund
  ? `${cfund.total} SEC Form D exempt-offering filings across ${cfund.companies} tracked AI companies, filing by filing with amounts and dates, refreshed daily.`
  : csec
  ? `${csec.total} of the ${csec.tracked} companies in the AI Company Directory are SEC registrants, with ticker, exchange, industry, and recent filings from SEC EDGAR, refreshed daily.`
  : cpat
  ? `US patent portfolios for ${cpat.total} tracked AI companies, ${cpat.patents_total.toLocaleString()} patents in total, counted from PatentsView assignee records, refreshed daily.`
  : pcat
  ? `${pcat.name} in the AI People Directory: ${pcat.total} profiled ${pcat.total === 1 ? 'person' : 'people'}, each with a timeline, achievements, and sources. ${pcat.blurb || ''}`.trim().slice(0, 300)
  : jhub
  ? `${jhub.total} open AI and computer-security jobs, refreshed daily from USAJobs, company career boards, and free job feeds, with market data on AI hiring share. Every listing links to the original posting.`
  : hub
  ? `Profiles of ${hub.total} people shaping artificial intelligence: researchers, founders, executives, and policymakers, each with a timeline, achievements, and sources.`
  : chub
  ? `${chub.total} companies building AI, with what each one ships, whether it is a defendant in a tracked lawsuit, and whether it publishes to the Model Context Protocol registry.`
  : company
  ? `${company.name}: ${company.products.length} AI product${company.products.length === 1 ? '' : 's'} we track${company.cases?.length ? `, ${company.cases.length} tracked lawsuit${company.cases.length === 1 ? '' : 's'}` : ''}${company.mcp?.length ? `, ${company.mcp.length} MCP server${company.mcp.length === 1 ? '' : 's'}` : ''}.`
  : person?.tracked_only
  ? `${person.name}, ${person.title} at ${person.org}. Tracked in the AI People Directory; a full profile has not been written yet.`
  : `${person.name}${person.moniker ? `, ${person.moniker}` : ''}. ${person.hook || ''}`.slice(0, 300);
const title = cma
  ? 'AI Acquisitions and Partnerships: SEC 8-K Filings — The World of AI'
  : obs
  ? `${obs.name} — AI Observatory — The World of AI`
  : cpriv
  ? 'Private AI Companies — The World of AI'
  : corg
  ? `${corg.name} — The World of AI`
  : cfund
  ? 'AI Funding: SEC Form D Disclosures — The World of AI'
  : csec
  ? 'Public AI Companies — The World of AI'
  : cpat
  ? 'AI Patents by Company — The World of AI'
  : pcat
  ? `${pcat.name} — AI People Directory`
  : jhub
  ? 'AI Jobs and Market Dynamics — The World of AI'
  : hub
  ? 'AI People Directory — The World of AI'
  : chub
  ? 'AI Company Directory — The World of AI'
  : company
  ? `${company.name}: AI products, lawsuits, and MCP servers`
  : `${person.name} — AI People Directory`;

// Alphabetical grouping for the company hub, with a jump index. Anything not
// starting A-Z lands under # so nothing is silently dropped from the list.
const grouped = {};
if (chub) {
  for (const c of chub.companies) {
    const ch = (c.name || '').trim().charAt(0).toUpperCase();
    const key = /[A-Z]/.test(ch) ? ch : '#';
    (grouped[key] ||= []).push(c);
  }
  for (const k of Object.keys(grouped)) grouped[k].sort((a, b) => a.name.localeCompare(b.name));
}
const letters = Object.keys(grouped).sort((a, b) => (a === '#' ? 1 : b === '#' ? -1 : a.localeCompare(b)));

// Jobs hub: group listings by category for the three sections, newest first
// (they arrive pre-sorted from SQL). Market blocks are optional: a missing
// feed renders nothing rather than an empty panel.
const jobCats = jhub
  ? [
      ['ai-security', 'AI × Security', jhub.jobs.filter((j) => j.category === 'ai-security')],
      ['ai', 'Artificial Intelligence', jhub.jobs.filter((j) => j.category === 'ai')],
      ['security', 'Computer Security', jhub.jobs.filter((j) => j.category === 'security')],
    ].filter(([, , list]) => list.length > 0)
  : [];
// Disciplines, alphabetical, from the pipeline. `groups` is the current shape;
// the three-bucket split above stays as a fallback for the first build after
// this change, before a run has published the grouped file.
const jobGroups = jhub?.groups ?? [];
const hiringLab = jhub?.market?.hiring_lab_ai_share ?? null;
const hlUS = hiringLab?.latest?.find((c) => c.country === 'US') ?? null;
const infosec = jhub?.market?.infosec_stats ?? null;
const pay = jhub?.salary ?? null;
const skillData = jhub?.skills ?? null;
const money0 = (n: number) => `$${Math.round(n).toLocaleString()}`;
// Order levels by seniority rather than by pay, so the shape of the curve is
// the thing a reader sees — including where it does not rise.
const LEVELS = ['Intern', 'Junior', 'Mid-level', 'Senior', 'Staff', 'Lead', 'Principal', 'Manager', 'Director', 'Vice President', 'Executive'];
const payLevels = (pay?.by_level ?? [])
  .slice()
  .sort((a: any, b: any) => LEVELS.indexOf(a.group) - LEVELS.indexOf(b.group));

const secHub = csec || cpat || cpriv || corg || cfund;
const jsonld = JSON.stringify(
  cma
    ? {
        '@context': 'https://schema.org',
        '@type': 'Dataset',
        name: 'AI Acquisitions and Partnerships: SEC 8-K Filings',
        description: desc.slice(0, 300),
        url: `https://theworldofai.org${BASE}/${cma.uid}/`,
        dateModified: cma.generated,
        creator: { '@type': 'Organization', name: 'The World of AI' },
      }
    : obs
    ? {
        '@context': 'https://schema.org',
        '@type': 'Dataset',
        name: `${obs.name} — AI Observatory`,
        description: (obsDescs || '').slice(0, 300),
        url: `https://theworldofai.org/ai-ecosystem/ecosystem-entities-market-and-operations/${obs.uid}/`,
        dateModified: obs.generated,
        creator: { '@type': 'Organization', name: 'The World of AI' },
      }
    : secHub
    ? {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: secHub.name,
        description: desc.slice(0, 300),
        url: `https://theworldofai.org${BASE}/${secHub.uid}/`,
        dateModified: secHub.generated,
      }
    : pcat
    ? {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: `${pcat.name} — AI People Directory`,
        description: desc,
        url: `https://theworldofai.org${BASE}/${pcat.uid}/`,
        dateModified: pcat.generated,
        isPartOf: {
          '@type': 'CollectionPage',
          name: 'AI People Directory',
          url: `https://theworldofai.org${BASE}/${hubUid}/`,
        },
      }
    : jhub
    ? {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: 'AI Jobs and Market Dynamics',
        description: desc,
        url: `https://theworldofai.org${BASE}/${jhub.uid}/`,
        dateModified: jhub.generated,
      }
    : hub || chub
    ? {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: hub ? 'AI People Directory' : 'AI Company Directory',
        description: desc,
        url: `https://theworldofai.org${BASE}/${(hub || chub).uid}/`,
        dateModified: (hub || chub).generated,
      }
    : company
    ? {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: company.name,
        description: desc,
        identifier: company.uid,
        url: `https://theworldofai.org${BASE}/${company.uid}/`,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: person.name,
        description: person.hook,
        nationality: person.nationality,
        identifier: person.uid,
        url: `https://theworldofai.org${BASE}/${person.uid}/`,
        ...(person.fields?.length ? { knowsAbout: person.fields } : {}),
      }
);
---
<Base title={title}
  description={desc} current={`${BASE}/`} jsonld={jsonld} noindex={!!person?.tracked_only}>

  <p class="meta-line"><a href="/">AI Ecosystem</a> ·
    <a href={`${BASE}/`}>{CATEGORY_NAME}</a>
    {person && <> · <a href={`${BASE}/${hubUid}/`}>AI People</a></>}
    {pcat && <> · <a href={`${BASE}/${hubUid}/`}>AI People</a></>}
    {secHub && <> · <a href={`${BASE}/${chubUid}/`}>AI Companies</a></>}
    {company && <> · <a href={`${BASE}/${chubUid}/`}>AI Companies</a></>}</p>

  {jhub && (
    <>
      <h1>AI Jobs and Market Dynamics</h1>
      <p class="answer"><b>{jhub.total} open positions</b> in artificial intelligence and computer
        security, refreshed daily: {jhub.counts.ai} AI roles, {jhub.counts.security} security
        roles, and {jhub.counts.ai_security} at the intersection. Listings come from the official
        USAJobs federal feed, the public career boards of tracked AI and security companies, and
        free job feeds whose terms permit republication. Every listing links to the original
        posting; nothing is hosted here.</p>
      <p class="meta-line">Last verified: {jhub.generated} · Sources credited below</p>

      {(hlUS || infosec) && (
        <>
          <h2>Market dynamics</h2>
          <div class="mkt">
            {hlUS && (
              <div class="mkt-panel">
                <p class="mkt-big">{Number(hlUS.share).toFixed(2)}%</p>
                <p class="mkt-label">of US job postings mention AI ({hlUS.date})</p>
                {hiringLab.us_trend?.length > 1 && (
                  <p class="mkt-note">Twelve months ago:
                    {' '}{Number(hiringLab.us_trend[Math.max(0, hiringLab.us_trend.length - 13)].share).toFixed(2)}%.
                    Source: <a href="https://github.com/hiring-lab/ai-tracker" rel="noopener">Indeed
                    Hiring Lab AI Tracker</a>, seven-day trailing average.</p>
                )}
              </div>
            )}
            {infosec && (
              <div class="mkt-panel">
                <p class="mkt-big">{infosec.total_active_jobs?.toLocaleString?.() ?? infosec.total_active_jobs}</p>
                <p class="mkt-label">active cybersecurity openings tracked · {infosec.remote_share_pct}% remote</p>
                <p class="mkt-note">{infosec.new_this_week} new this week. Source:
                  {' '}<a href="https://www.infosecjobboard.com/" rel="noopener">InfoSec Job Board</a>,
                  aggregate hiring data, used with attribution.</p>
              </div>
            )}
          </div>
        </>
      )}

      {jobGroups.length > 0 ? (
        <>
          <h2>Roles by discipline</h2>
          <p>
            {jobGroups.length} disciplines, alphabetical, with roles alphabetical inside each.
            Every title links to the original posting.
          </p>
          <ul class="disc-index">
            {jobGroups.map((g: any) => (
              <li><a href={`#${g.slug}`}>{g.name}</a> <span class="jn">{g.count}</span></li>
            ))}
          </ul>
          {jobGroups.map((g: any) => (
            <section class="letter-block">
              <h3 id={g.slug}>{g.name} <span class="jn">{g.count}</span></h3>
              <ul class="co-list">
                {g.jobs.map((j: any) => (
                  <li>
                    <a href={j.url} rel="noopener nofollow" target="_blank">{j.title}</a>
                    <p>{j.company}{j.location && <> · {j.location}</>}{j.remote && !String(j.location || '').toLowerCase().includes('remote') && <> · Remote</>}{j.salary && <> · {j.salary}</>}{j.posted && <> · Posted {j.posted}</>} · <span class="jsrc">{j.source}</span></p>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </>
      ) : (
        jobCats.map(([slug, label, list]) => (
          <section class="letter-block">
            <h2 id={`cat-${slug}`}>{label} <span class="jn">{list.length}</span></h2>
            <ul class="co-list">
              {list.map((j) => (
                <li>
                  <a href={j.url} rel="noopener nofollow" target="_blank">{j.title}</a>
                  <p>{j.company}{j.location && <> · {j.location}</>}{j.remote && !String(j.location || '').toLowerCase().includes('remote') && <> · Remote</>}{j.salary && <> · {j.salary}</>}{j.posted && <> · Posted {j.posted}</>} · <span class="jsrc">{j.source}</span></p>
                </li>
              ))}
            </ul>
          </section>
        ))
      )}

      {pay && pay.disclosed > 0 && (
        <>
          <h2 id="salary">Salary data</h2>
          <p>
            <b>{pay.disclosed.toLocaleString()} of {pay.listings.toLocaleString()} listings</b>
            {' '}({Math.round((pay.disclosed / pay.listings) * 100)}%) state a pay range. Across
            those, the median is <b>{money0(pay.median)}</b>. The other
            {' '}{Math.round(100 - (pay.disclosed / pay.listings) * 100)}% publish no figure, so
            read every number here as the disclosed half of the market rather than the whole of
            it. Annual ranges only — hourly and other periods are left out rather than
            annualised, because a guess at hours per year is a number nobody stated.
          </p>

          {payLevels.length > 0 && (
            <>
              <h3>By level</h3>
              <table class="pay">
                <thead><tr><th>Level</th><th class="num">Listings</th><th class="num">With pay</th><th class="num">25th</th><th class="num">Median</th><th class="num">75th</th></tr></thead>
                <tbody>
                  {payLevels.map((r: any) => (
                    <tr>
                      <td>{r.group}</td>
                      <td class="num">{r.count.toLocaleString()}</td>
                      <td class="num">{r.disclosed.toLocaleString()}</td>
                      <td class="num">{r.p25 ? money0(r.p25) : '—'}</td>
                      <td class="num"><b>{r.median ? money0(r.median) : '—'}</b></td>
                      <td class="num">{r.p75 ? money0(r.p75) : '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )}

          {(pay.by_discipline ?? []).length > 0 && (
            <>
              <h3>By discipline</h3>
              <p>Disciplines with at least five disclosed ranges. Anything thinner is left out
                rather than shown as a median of two.</p>
              <table class="pay">
                <thead><tr><th>Discipline</th><th class="num">Listings</th><th class="num">With pay</th><th class="num">25th</th><th class="num">Median</th><th class="num">75th</th></tr></thead>
                <tbody>
                  {pay.by_discipline.map((r: any) => (
                    <tr>
                      <td>{r.group}</td>
                      <td class="num">{r.count.toLocaleString()}</td>
                      <td class="num">{r.disclosed.toLocaleString()}</td>
                      <td class="num">{r.p25 ? money0(r.p25) : '—'}</td>
                      <td class="num"><b>{r.median ? money0(r.median) : '—'}</b></td>
                      <td class="num">{r.p75 ? money0(r.p75) : '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )}
        </>
      )}

      {skillData && (skillData.skills ?? []).length > 0 && (
        <>
          <h2 id="skills">Skills in demand</h2>
          <p>
            What employers are actually asking for, counted across the
            {' '}<b>{skillData.postings_read.toLocaleString()} postings</b> whose text we can read,
            against a fixed vocabulary. Share is of those postings, not of every listing: feeds
            that publish no description would otherwise look like employers who want nothing.
            {infosec?.top_skills && <> For cybersecurity specifically, the
            {' '}<a href="https://www.infosecjobboard.com/" rel="noopener">InfoSec Job Board</a>
            {' '}publishes its own skill counts, shown below.</>}
          </p>
          <ol class="skills">
            {skillData.skills.slice(0, 30).map((s: any) => (
              <li>
                <span class="sk">{s.skill}</span>
                <span class="bar" style={`width:${Math.max(2, Math.round(s.share))}%`}></span>
                <span class="pct">{s.share.toFixed(1)}% · {s.count.toLocaleString()}</span>
              </li>
            ))}
          </ol>
          {infosec?.top_skills && (
            <>
              <h3>Cybersecurity skills, from the InfoSec Job Board</h3>
              <p class="mkt-note">Their counts across their own tracked postings, used with
                attribution to <a href="https://www.infosecjobboard.com/" rel="noopener">infosecjobboard.com</a>.</p>
              <ul class="chips">
                {infosec.top_skills.slice(0, 20).map((s: any) => (
                  <li>{s.label} <span class="n">{s.count}</span></li>
                ))}
              </ul>
            </>
          )}
        </>
      )}

      <h2>Where these listings come from</h2>
      <p>Only sources whose terms permit free republication are used, and each is credited. The
        listing text belongs to the employer; this page is an index that points at the original
        posting.</p>
      <ul class="cites">
        {jhub.sources.map((s) => (
          <li>{s.url ? <a href={s.url} rel="noopener">{s.name}</a> : <b>{s.name}</b>} — {s.note}</li>
        ))}
      </ul>

      <div class="cite-box">Cite this page: <code>"AI Jobs and Market Dynamics." The World of AI,
        theworldofai.org{BASE}/{jhub.uid}/. Verified {jhub.generated}.</code></div>
    </>
  )}

  {chub && (
    <>
      <h1>AI Company Directory</h1>
      <p class="answer">Every organisation behind the tools in our catalog, <b>{chub.total} of
        them</b>, listed alphabetically. Each entry says what the company publishes that we track,
        whether it is named as a defendant in a lawsuit we follow, and whether it has published to
        the Model Context Protocol registry. <b>{chub.profiled}</b> have a full page here; the rest
        link to the company's own site, because repeating a single tool page under a company
        heading would tell you nothing new.</p>
      {chub.generated && <p class="meta-line">Last verified: {chub.generated}</p>}

      <nav class="alphabet" aria-label="Jump to letter">
        {letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}
      </nav>

      {letters.map((l) => (
        <section class="letter-block">
          <h2 id={`letter-${l}`}>{l}</h2>

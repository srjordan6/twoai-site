---
/**
 * AI people directory: hub and profiles, addressed by identifier.
 *
 * Per Stephen's instruction 2026-08-03, new sections publish below the category
 * path under a short alphanumeric identifier rather than a name slug, so a page
 * keeps its address when the person's name or title changes. The hub and every
 * profile share this one route:
 *
 *   /ai-ecosystem/ecosystem-entities-market-and-operations/{id}/
 *
 * Source is site_people, the same records behind
 * srjconsultingservices.com/ai-resources/ai-people/.
 */
import Base from '../../../layouts/Base.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

const CATEGORY = 'ecosystem-entities-market-and-operations';
const CATEGORY_NAME = 'Ecosystem Entities, Market and Operations';
const BASE = `/ai-ecosystem/${CATEGORY}`;

export function getStaticPaths() {
  const paths = [];

  if (existsSync('content/people/index.json')) {
    const idx = JSON.parse(readFileSync('content/people/index.json', 'utf8'));
    paths.push({ params: { id: idx.uid }, props: { hub: idx } });
    for (const f of readdirSync('content/people')) {
      if (!f.endsWith('.json') || f === 'index.json') continue;
      const p = JSON.parse(readFileSync(`content/people/${f}`, 'utf8'));
      if (!p.uid) continue;
      paths.push({ params: { id: p.uid }, props: { person: p, hubUid: idx.uid } });
    }
  }

  if (existsSync('content/companies/index.json')) {
    const cidx = JSON.parse(readFileSync('content/companies/index.json', 'utf8'));
    paths.push({ params: { id: cidx.uid }, props: { chub: cidx } });
    for (const f of readdirSync('content/companies')) {
      if (!f.endsWith('.json') || f === 'index.json') continue;
      const d = JSON.parse(readFileSync(`content/companies/${f}`, 'utf8'));
      paths.push({ params: { id: d.company.uid }, props: { company: d.company, generated: d.generated, chubUid: cidx.uid } });
    }
  }

  return paths;
}
const { hub, person, hubUid, chub, company, generated, chubUid } = Astro.props;

const desc = hub
  ? `Profiles of ${hub.total} people shaping artificial intelligence: researchers, founders, executives, and policymakers, each with a timeline, achievements, and sources.`
  : chub
  ? `${chub.total} companies building AI, with what each one ships, whether it is a defendant in a tracked lawsuit, and whether it publishes to the Model Context Protocol registry.`
  : company
  ? `${company.name}: ${company.products.length} AI product${company.products.length === 1 ? '' : 's'} we track${company.cases?.length ? `, ${company.cases.length} tracked lawsuit${company.cases.length === 1 ? '' : 's'}` : ''}${company.mcp?.length ? `, ${company.mcp.length} MCP server${company.mcp.length === 1 ? '' : 's'}` : ''}.`
  : `${person.name}${person.moniker ? `, ${person.moniker}` : ''}. ${person.hook || ''}`.slice(0, 300);
const title = hub
  ? 'AI People Directory — The World of AI'
  : chub
  ? 'AI Company Directory — The World of AI'
  : company
  ? `${company.name}: AI products, lawsuits, and MCP servers`
  : `${person.name} — AI People Directory`;

// Alphabetical grouping for the company hub, with a jump index. Anything not
// starting A-Z lands under # so nothing is silently dropped from the list.
const grouped = {};
if (chub) {
  for (const c of chub.companies) {
    const ch = (c.name || '').trim().charAt(0).toUpperCase();
    const key = /[A-Z]/.test(ch) ? ch : '#';
    (grouped[key] ||= []).push(c);
  }
  for (const k of Object.keys(grouped)) grouped[k].sort((a, b) => a.name.localeCompare(b.name));
}
const letters = Object.keys(grouped).sort((a, b) => (a === '#' ? 1 : b === '#' ? -1 : a.localeCompare(b)));

const jsonld = JSON.stringify(
  hub || chub
    ? {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: hub ? 'AI People Directory' : 'AI Company Directory',
        description: desc,
        url: `https://theworldofai.org${BASE}/${(hub || chub).uid}/`,
        dateModified: (hub || chub).generated,
      }
    : company
    ? {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: company.name,
        description: desc,
        identifier: company.uid,
        url: `https://theworldofai.org${BASE}/${company.uid}/`,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: person.name,
        description: person.hook,
        nationality: person.nationality,
        identifier: person.uid,
        url: `https://theworldofai.org${BASE}/${person.uid}/`,
        ...(person.fields?.length ? { knowsAbout: person.fields } : {}),
      }
);
---
<Base title={title}
  description={desc} current={`${BASE}/`} jsonld={jsonld}>

  <p class="meta-line"><a href="/">AI Ecosystem</a> ·
    <a href={`${BASE}/`}>{CATEGORY_NAME}</a>
    {person && <> · <a href={`${BASE}/${hubUid}/`}>AI People</a></>}
    {company && <> · <a href={`${BASE}/${chubUid}/`}>AI Companies</a></>}</p>

  {chub && (
    <>
      <h1>AI Company Directory</h1>
      <p class="answer">Every organisation behind the tools in our catalog, <b>{chub.total} of
        them</b>, listed alphabetically. Each entry says what the company publishes that we track,
        whether it is named as a defendant in a lawsuit we follow, and whether it has published to
        the Model Context Protocol registry. <b>{chub.profiled}</b> have a full page here; the rest
        link to the company's own site, because repeating a single tool page under a company
        heading would tell you nothing new.</p>
      {chub.generated && <p class="meta-line">Last verified: {chub.generated}</p>}

      <nav class="alphabet" aria-label="Jump to letter">
        {letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}
      </nav>

      {letters.map((l) => (
        <section class="letter-block">
          <h2 id={`letter-${l}`}>{l}</h2>
          <ul class="co-list">
            {grouped[l].map((c) => (
              <li>
                {c.has_page
                  ? <a href={`${BASE}/${c.uid}/`}>{c.name}</a>
                  : (c.url
                      ? <a href={c.url} rel="noopener nofollow">{c.name}</a>
                      : <b>{c.name}</b>)}
                {c.summary && <p>{c.summary}</p>}
              </li>
            ))}
          </ul>
          <p class="back"><a href="#top">Back to top</a></p>
        </section>
      ))}
    </>
  )}

  {company && (
    <>
      <h1>{company.name}</h1>
      <p class="answer">{company.name} publishes <b>{company.products.length}</b> AI
        product{company.products.length === 1 ? '' : 's'} we track
        {company.cases?.length > 0 && <>, is a defendant in <b>{company.cases.length}</b> lawsuit{company.cases.length === 1 ? '' : 's'} on our tracker</>}
        {company.mcp?.length > 0 && <>, and has published <b>{company.mcp.length}</b> server{company.mcp.length === 1 ? '' : 's'} to the MCP registry</>}.
        Everything below is drawn from those records rather than from the company's own marketing.</p>
      {generated && <p class="meta-line">Last verified: {generated} · Entity ID {company.uid}</p>}

      <h2>Products</h2>
      <table>
        <thead><tr><th>Product</th><th>Category</th><th>What it does</th></tr></thead>
        <tbody>
          {company.products.map((p) => (
            <tr>
              <td>{p.profile
                ? <a href={`/ai-tools/${p.profile}/`}>{p.name}</a>
                : (p.url ? <a href={p.url} rel="noopener nofollow">{p.name}</a> : p.name)}</td>
              <td>{p.category}</td>
              <td>{p.note}</td>
            </tr>
          ))}
        </tbody>
      </table>

      {company.cases?.length > 0 && (
        <>
          <h2>Lawsuits we track</h2>
          <ul>{company.cases.map((c) => (
            <li><a href={`/ai-lawsuits/${c.slug}/`}>{c.name}</a>{c.court && <>, {c.court}</>}</li>
          ))}</ul>
          <p class="meta-line">Matched on the defendant field of our tracker. Being named as a
            defendant is not a finding of wrongdoing.</p>
        </>
      )}

      {company.mcp?.length > 0 && (
        <>
          <h2>MCP servers</h2>
          <ul>{company.mcp.map((m) => (
            <li><a href={`/mcp/${m.slug}/`}>{m.name}</a>{m.description && <> — {m.description}</>}</li>
          ))}</ul>
        </>
      )}

      <div class="cite-box">Cite this page: <code>"{company.name}." AI Company Directory,
        The World of AI, theworldofai.org{BASE}/{company.uid}/.
        {generated ? ` Verified ${generated}.` : ''}</code></div>

      <h2>Elsewhere on this site</h2>
      <p>Every page here that mentions {company.name}, so you can see the same organisation from
        each angle we track it from.</p>
      <ul>
        <li><a href={`${BASE}/${chubUid}/`}>AI Company Directory</a> — all {company.name ? 'companies' : ''} we track</li>
        <li><a href="/ai-tools/">AI Tools Directory</a> — the catalog these products come from
          {company.products.some((p) => p.category) && (
            <> · categories: {[...new Set(company.products.map((p) => p.category).filter(Boolean))].join(', ')}</>
          )}</li>
        {company.cases?.length > 0 && (
          <li><a href="/ai-lawsuits/">AI Lawsuit Tracker</a> — {company.cases.length} case{company.cases.length === 1 ? '' : 's'} naming {company.name}</li>
        )}
        {company.mcp?.length > 0 && (
          <li><a href="/mcp/">MCP Server Directory</a> — {company.mcp.length} server{company.mcp.length === 1 ? '' : 's'} published by {company.name}</li>
        )}
        <li><a href="/ai-glossary/">AI Glossary</a> · <a href="/ai-laws/">AI Laws by State</a> ·
          <a href="/ai-compliance/">Governance Frameworks</a></li>
      </ul>
      <p class="meta-line">Entity ID <code>{company.uid}</code>. That identifier is stable across
        this whole site, so the same company is the same record wherever it appears, whatever
        spelling a source used.</p>

      <p><a href={`${BASE}/${chubUid}/`}>All companies</a></p>
    </>
  )}

  {hub && (
    <>
      <h1>AI People Directory</h1>
      <p class="answer">We track <b>{hub.total} people</b> shaping artificial intelligence: the
        researchers behind the methods, the founders and executives running the companies, and the
        policymakers writing the rules. <b>{hub.profiled ?? hub.total}</b> have a full profile with
        a timeline, what they are known for, and sources.
        {hub.tracked_only > 0 && <> The other {hub.tracked_only} are listed with their role and no
        page yet, because a name and a job title is not a profile.</>}</p>
      {hub.generated && <p class="meta-line">Last verified: {hub.generated}</p>}
      <ul class="grid">
        {hub.people.map((p) => (
          <li class="card">
            {p.uid ? <a href={`${BASE}/${p.uid}/`}>{p.name}</a> : <b>{p.name}</b>}
            {p.moniker && <p class="mon">{p.moniker}</p>}
            {p.hook && <p>{p.hook}</p>}
            {!p.uid && (p.title || p.org) && (
              <p class="mon">{p.title}{p.title && p.org ? ' · ' : ''}{p.org}</p>
            )}
            {!p.uid && <p class="mon">Tracked, profile not yet written.</p>}
          </li>
        ))}
      </ul>
    </>
  )}

  {person && (
    <>
      <h1>{person.name}</h1>
      {person.moniker && <p class="lede">{person.moniker}</p>}
      {person.hook && <p class="answer">{person.hook}</p>}
      <p class="meta-line">
        {person.nationality && <>{person.nationality} · </>}
        {person.born && <>Born {person.born}{person.died && <> · Died {person.died}</>} · </>}
        {person.generated && <>Last verified: {person.generated}</>}
      </p>

      {person.quote && <blockquote class="pq">{person.quote}</blockquote>}

      {person.fields?.length > 0 && (
        <p class="meta-line"><b>Fields:</b> {person.fields.join(' · ')}</p>
      )}

      {person.quick_facts && (
        <>
          <h2>Quick facts</h2>
          <table>
            <tbody>
              {Object.entries(person.quick_facts).map(([k, v]) => (
                <tr><th>{k.replace(/_/g, ' ')}</th><td>{Array.isArray(v) ? v.join(', ') : v}</td></tr>
              ))}
            </tbody>
          </table>
        </>
      )}

      {person.achievements?.length > 0 && (
        <>
          <h2>Known for</h2>
          <ul>{person.achievements.map((a) => <li>{typeof a === 'string' ? a : a.text || a.name}</li>)}</ul>
        </>
      )}

      {person.timeline?.length > 0 && (
        <>
          <h2>Timeline</h2>
          <table>
            <thead><tr><th>Year</th><th>Event</th></tr></thead>
            <tbody>
              {person.timeline.map((t) => (
                <tr><td>{t.year || t.date}</td><td>{t.event || t.text}</td></tr>
              ))}
            </tbody>
          </table>
        </>
      )}

      {person.sources?.length > 0 ? (
        <>
          <h2>Sources</h2>
          <ul class="cites">
            {person.sources.map((s) => (
              <li>{typeof s === 'string'
                ? s
                : (s.url ? <a href={s.url} rel="noopener">{s.title || s.url}</a> : (s.title || ''))}
                {typeof s !== 'string' && s.publisher && <> · {s.publisher}</>}</li>
            ))}
          </ul>
        </>
      ) : (
        <p class="meta-line">This profile has no published sources attached yet. Treat the detail
          above as unverified until it does, and tell us if any of it is wrong:
          <a href="/contact/">contact</a>.</p>
      )}

      <div class="cite-box">Cite this profile: <code>"{person.name}." AI People Directory,
        The World of AI, theworldofai.org{BASE}/{person.uid}/.
        {person.generated ? ` Verified ${person.generated}.` : ''}</code></div>

      <p><a href={`${BASE}/${hubUid}/`}>All people</a></p>
    </>
  )}
</Base>

<style>
  .alphabet { display: flex; flex-wrap: wrap; gap: 6px; margin: 1.1em 0 1.6em;
    padding: .7em .8em; background: var(--cream); border-radius: 6px; }
  .alphabet a { display: inline-block; min-width: 1.6em; padding: 2px 6px; text-align: center;
    font-weight: 600; font-size: .93rem; text-decoration: none; border-radius: 4px; }
  .alphabet a:hover { background: var(--orange); color: #fff; }
  .letter-block { margin-bottom: 1.4em; }
  .letter-block h2 { font-size: 1.3rem; margin: 1.2em 0 .4em; padding-bottom: .15em;
    border-bottom: 2px solid var(--orange); }
  .co-list { list-style: none; margin: 0; padding: 0; }
  .co-list li { padding: .7em 0; border-bottom: 1px solid #ececf2; }
  .co-list li:last-child { border-bottom: 0; }
  .co-list li > a, .co-list li > b { font-weight: 600; font-size: 1.02rem; }
  .co-list li p { margin: .2em 0 0; color: #3d3d46; font-size: .95rem; }
  .back { margin: .5em 0 0; font-size: .85rem; }
  .lede { font-size: 1.05rem; color: #3d3d46; margin: 0 0 .5em; }
  .mon { font-size: .88rem; color: #6b6b78; margin: .1em 0 .3em; }
  .pq { margin: 1.2em 0; padding: .6em 0 .6em 1.1em; border-left: 3px solid var(--orange);
    font-family: 'Lora', serif; font-size: 1.06rem; color: #2c2c38; }
  table th { text-align: left; vertical-align: top; }
  .cites { font-size: .92rem; }
  .cites li { margin-bottom: .35em; }
</style>

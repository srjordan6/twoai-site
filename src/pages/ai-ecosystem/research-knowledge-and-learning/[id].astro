---
/**
 * AI Research Library: hub and topic reading lists, addressed by identifier.
 *
 * Per Stephen's instruction 2026-08-03, new sections publish below the category
 * path under a short alphanumeric identifier rather than a name slug, so a page
 * keeps its address when its title changes. The hub and every topic share this
 * one route:
 *
 *   /ai-ecosystem/research-knowledge-and-learning/{id}/
 *
 * Source is twoai_research_papers, curated through the Consensus academic
 * index, rendered from the twoai_pages rows that scripts/fetch-content.mjs
 * reads live from Postgres. We publish the citation record, our one-sentence
 * note, and a link out. WE DO NOT PUBLISH ABSTRACTS: an abstract is publisher
 * copyrighted text, and reproducing hundreds of them on a site whose main asset
 * is a lawsuit tracker would be indefensible. The link is how the reader gets
 * the abstract.
 *
 * There is deliberately no page per paper. A citation and one sentence is a
 * directory row, not a page worth indexing, which is the same rule the MCP
 * tracker already applies to bare registry entries.
 */
import Base from '../../../layouts/Base.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

const CATEGORY = 'research-knowledge-and-learning';
const BASE = `/ai-ecosystem/${CATEGORY}`;

export function getStaticPaths() {
  const paths = [];
  if (existsSync('content/learn')) {
    for (const f of readdirSync('content/learn')) {
      if (!f.endsWith('.json')) continue;
      const d = JSON.parse(readFileSync(`content/learn/${f}`, 'utf8'));
      if (d.uid) paths.push({ params: { id: d.uid }, props: { learn: d } });
    }
  }
  if (!existsSync('content/research/index.json')) return paths;

  const idx = JSON.parse(readFileSync('content/research/index.json', 'utf8'));
  paths.push({ params: { id: idx.uid }, props: { hub: idx } });

  // R2 currently ships two copies of every topic: the old uid-named file and
  // the new slug-named file, and they share a uid. Prefer the new-shape row
  // (has slug + blurb + citations) so the page renders with all the fields
  // the template wants, and skip the older duplicate.
  const byUid = new Map();
  for (const f of readdirSync('content/research')) {
    if (!f.endsWith('.json') || f === 'index.json') continue;
    const t = JSON.parse(readFileSync(`content/research/${f}`, 'utf8'));
    if (!t.uid) continue;
    const existing = byUid.get(t.uid);
    if (!existing || (!existing.slug && t.slug)) byUid.set(t.uid, t);
  }
  for (const t of byUid.values()) {
    paths.push({ params: { id: t.uid }, props: { topic: t, hubUid: idx.uid } });
  }

  // Section pages that belong to this category but are not research topics.
  // They live in content/ecosystem/ and carry their own uid, so they share
  // this route without competing with the research shelf for it. The category
  // is written out rather than read from the CATEGORY const because Astro
  // hoists getStaticPaths out of the module scope, so the const is not
  // visible here at build time.
  if (existsSync('content/ecosystem')) {
    for (const f of readdirSync('content/ecosystem')) {
      if (!f.endsWith('.json') || f === 'index.json') continue;
      let s;
      try {
        s = JSON.parse(readFileSync(`content/ecosystem/${f}`, 'utf8'));
      } catch {
        continue;
      }
      if (!s || !s.uid || s.category !== 'research-knowledge-and-learning') continue;
      paths.push({ params: { id: s.uid }, props: { section: s, hubUid: idx.uid } });
    }
  }

  return paths;
}

const { hub, topic, section, hubUid, learn } = Astro.props;

const desc = learn
  ? `${learn.total} ${learn.name.toLowerCase()}, ${learn.free} free, curated by level and audience with a verified source each${learn.with_code ? `, ${learn.with_code} with companion code` : ''}, re-verified daily.`
  : section
  ? String(section.answer || '').slice(0, 300)
  : hub
  ? `${hub.total} peer-reviewed and preprint papers on AI capability, safety, governance and application, sorted into ${hub.topics.length} topics, each with the citation record and a plain note on why it matters.`
  : `${topic.count} papers on ${topic.name.toLowerCase()} in AI, ${(topic.citations || 0).toLocaleString()} citations between them. ${topic.blurb || ''}`.slice(0, 300);

const title = learn
  ? `${learn.name} — The World of AI`
  : section
  ? `${section.title}: how this site is structured`
  : hub
  ? 'AI Research Library — The World of AI'
  : `${topic.name}: AI research reading list`;

const refreshed = (hub || topic || section || {}).refreshed;

const jsonld = JSON.stringify(
  learn
    ? {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: `${learn.name} — The World of AI`,
        description: desc,
        url: `https://theworldofai.org${BASE}/${learn.uid}/`,
        dateModified: learn.generated,
      }
    : section
    ? {
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: section.title,
        description: desc,
        url: `https://theworldofai.org${BASE}/${section.uid}/`,
        dateModified: section.generated,
      }
    : hub
    ? {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: 'AI Research Library',
        description: desc,
        url: `https://theworldofai.org${BASE}/${hub.uid}/`,
        dateModified: refreshed || hub.generated,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: `${topic.name}: AI research`,
        description: topic.blurb,
        url: `https://theworldofai.org${BASE}/${topic.uid}/`,
        dateModified: refreshed || topic.generated,
        isPartOf: {
          '@type': 'CollectionPage',
          name: 'AI Research Library',
          url: `https://theworldofai.org${BASE}/${hubUid}/`,
        },
      }
);
---
<Base title={title} description={desc} current="/ai-ecosystem/research-knowledge-and-learning/" jsonld={jsonld}>
  <p class="meta-line" id="top">
    <a href="/">AI Ecosystem</a> &middot;
    <a href={`/ai-ecosystem/${CATEGORY}/`}>Research, Knowledge and Learning</a>
    {topic && <> &middot; <a href={`${BASE}/${hubUid}/`}>AI Research Library</a></>}
  </p>

  {learn && learn.shape === 'media' && (
    <>
      <h1>{learn.name}</h1>
      <p class="answer"><b>{learn.total} curated entries</b> in {learn.name.toLowerCase()} — every
        one links its own home, and image sources state their licence terms. {learn.blurb}</p>
      <p class="meta-line">Last verified: {learn.generated} · Links re-verified daily. This
        repository links out; it does not host or reproduce the media itself.</p>
      {learn.items.map((m) => (
        <div class="dom">
          <h3><a href={m.source_url} rel="noopener">{m.name}</a> <span class="n">{m.kind}</span></h3>
          <p>{m.note}.</p>
          <p class="meta-line">{m.creator} · {m.extra} · verified {m.verified}</p>
        </div>
      ))}
      <div class="cite-box">Cite this page: <code>"{learn.name}." The World of AI,
        theworldofai.org{BASE}/{learn.uid}/. Retrieved {learn.generated}.</code></div>
    </>
  )}

  {learn && learn.shape !== 'media' && (
    <>
      <h1>{learn.name}</h1>
      <p class="answer"><b>{learn.total} {learn.name.toLowerCase()}</b>, {learn.free} of them
        free{learn.with_code ? <>, <b>{learn.with_code}</b> with public companion code</> : null} —
        curated by level and audience, one verified source each. {learn.blurb}</p>
      <p class="meta-line">Last verified: {learn.generated} · Source links re-verified daily.
        Membership is editorial: significance, not sponsorship — nothing here is paid placement.
        Skills these teach map to the <a href="/skills/">AI Skills Graph</a>.</p>
      {learn.items.map((l) => (
        <div class="dom">
          <h3><a href={l.source_url} rel="noopener">{l.name}</a></h3>
          <p>{l.note}.</p>
          <p class="meta-line">{l.provider} · Level: {l.level} · For: {l.audience} ·
            Cost: {l.cost}
            {l.renewal && <> · Renewal: {l.renewal}</>}
            {l.code_url && <> · <a href={l.code_url} rel="noopener">Companion code</a></>} ·
            verified {l.verified}</p>
        </div>
      ))}
      <div class="cite-box">Cite this page: <code>"{learn.name}." The World of AI,
        theworldofai.org{BASE}/{learn.uid}/. Retrieved {learn.generated}.</code></div>
    </>
  )}

  {section && (
    <>
      <h1>{section.title}</h1>
      <p class="answer">{section.answer}</p>
      {section.generated && (
        <p class="meta-line">Last reviewed: {section.generated}.</p>
      )}

      {section.chain && (
        <p class="chain">
          {section.chain.map((c, i) => (
            <>{i > 0 && <span class="arrow">&#8596;</span>}<span class="link">{c}</span></>
          ))}
        </p>
      )}

      {section.down && (
        <>
          <h2>{section.down_title || 'Reading down'}</h2>
          {section.down_intro && <p>{section.down_intro}</p>}
          <ol class="co-list">
            {section.down.map((b) => (<li><b>{b.name}</b><p>{b.detail}</p></li>))}
          </ol>
        </>
      )}

      {section.up && (
        <>
          <h2>{section.up_title || 'Reading up'}</h2>
          {section.up_intro && <p>{section.up_intro}</p>}
          <ol class="co-list">
            {section.up.map((b) => (<li><b>{b.name}</b><p>{b.detail}</p></li>))}
          </ol>
        </>
      )}

      {section.why && (
        <>
          <h2>{section.why_title || 'Why it matters'}</h2>
          <ul class="co-list">
            {section.why.map((b) => (<li><b>{b.name}</b><p>{b.detail}</p></li>))}
          </ul>
        </>
      )}

      {section.built && (
        <>
          <h2>What is built</h2>
          <ul class="co-list">
            {section.built.map((b) => (<li><b>{b.name}</b><p>{b.detail}</p></li>))}
          </ul>
        </>
      )}

      {section.planned && (
        <>
          <h2>What is planned</h2>
          {section.note && <p class="mon">{section.note}</p>}
          <ul class="co-list">
            {section.planned.map((b) => (<li><b>{b.name}</b><p>{b.detail}</p></li>))}
          </ul>
        </>
      )}

      {section.sources && (
        <>
          <h2>Sources</h2>
          {section.note && !section.planned && <p class="mon">{section.note}</p>}
          <ul class="src-list">
            {section.sources.map((s) => (
              <li>{s.url ? <a href={s.url} rel="noopener" target="_blank">{s.name}</a> : s.name}</li>
            ))}
          </ul>
        </>
      )}

      {!section.sources && (
        <p class="mon">
          The identifiers described here are visible in the URL of every entity
          page on this site, and the records behind them are published at
          {' '}<a href="/api/">the public API</a>.
        </p>
      )}
    </>
  )}

  {hub && (
    <>
      <h1>AI Research Library</h1>
      <p class="answer">
        <b>{`${hub.total} papers`}</b>{` on how AI works, where it fails, and how it is being governed, sorted into ${hub.topics.length} topics. Every entry carries its authors, venue and citation count, one sentence from us on why it matters, and a link to the paper.`}
      </p>
      <p class="mon">
        We do not reproduce abstracts. Follow the link for the paper's own
        summary, which is where it belongs.
      </p>
      {refreshed && (
        <p class="meta-line">Shelf last refreshed: {refreshed}. Sourced through the Consensus academic index.</p>
      )}
      <ul class="co-list">
        {hub.topics.map((t) => (
          <li>
            <a href={`${BASE}/${t.uid}/`}>{t.name}</a>
            <p>{t.blurb}</p>
            <p class="mon">
              {`${t.count} paper${t.count === 1 ? '' : 's'}${typeof t.citations === 'number' ? ` · ${t.citations.toLocaleString()} citations` : ''}${t.newest ? ` · newest ${t.newest}` : ''}`}
            </p>
          </li>
        ))}
      </ul>
    </>
  )}

  {topic && (
    <>
      <h1>{topic.name}</h1>
      <p class="lede">{topic.blurb}</p>
      <p class="answer">
        <b>{`${topic.count} paper${topic.count === 1 ? '' : 's'}`}</b>{typeof topic.citations === 'number' ? `, ${topic.citations.toLocaleString()} citations between them, ordered by citation count.` : `, ordered by citation count.`} Each line links to the paper on Consensus.
      </p>
      {refreshed && <p class="meta-line">Shelf last refreshed: {refreshed}</p>}
      <ol class="papers">
        {topic.papers.map((p) => (
          <li>
            <a href={p.url} rel="nofollow noopener" target="_blank">{p.title}</a>
            <p class="mon">
              {`${p.authors || ''}${p.authors && p.year ? ' · ' : ''}${p.year || ''}${p.journal ? ` · ${p.journal}` : ''}${typeof p.citations === 'number' ? ` · ${p.citations.toLocaleString()} citation${p.citations === 1 ? '' : 's'}` : ''}`}
            </p>
            {p.note && <p>{p.note}</p>}
          </li>
        ))}
      </ol>
      <p class="back"><a href={`${BASE}/${hubUid}/`}>All research topics</a></p>
    </>
  )}
</Base>

<style>
  .chain { display: flex; flex-wrap: wrap; align-items: center; gap: 6px;
    background: var(--cream); border-radius: 6px; padding: .9em 1em; margin: 1.2em 0 1.6em; }
  .chain .link { background: #201868; color: #fff; border-radius: 4px;
    padding: 4px 11px; font-size: .86rem; font-weight: 600; white-space: nowrap; }
  .chain .arrow { color: #F07800; font-weight: 700; }
  .src-list { margin: .5em 0 1.2em; }
  .src-list li { margin: .35em 0; font-size: .93rem; }
</style>

<style>
  .co-list { list-style: none; margin: 1.2em 0 0; padding: 0; }
  .co-list li { padding: .8em 0; border-bottom: 1px solid #ececf2; }
  .co-list li:last-child { border-bottom: 0; }
  .co-list li > a { font-weight: 600; font-size: 1.05rem; }
  .co-list li p { margin: .25em 0 0; color: #3d3d46; font-size: .95rem; }
  .papers { margin: 1.2em 0 0; padding-left: 1.4em; }
  .papers li { padding: .75em 0; border-bottom: 1px solid #ececf2; }
  .papers li:last-child { border-bottom: 0; }
  .papers li > a { font-weight: 600; }
  .papers li p { margin: .25em 0 0; color: #3d3d46; font-size: .95rem; }
  .lede { font-size: 1.05rem; color: #3d3d46; margin: 0 0 .5em; }
  .mon { font-size: .88rem; color: #6b6b78; margin: .1em 0 .3em; }
  .back { margin: 1.4em 0 0; font-size: .9rem; }
</style>

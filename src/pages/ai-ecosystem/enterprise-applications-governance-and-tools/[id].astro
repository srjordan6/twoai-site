---
/**
 * Enterprise Applications, Governance and Tools: identifier-addressed section
 * pages. First residents: the Industry Use Cases sections, rendered from
 * curated sourced points per industry. A sector with no verifiable primary
 * source beyond the Census adoption series carries less content by design -
 * the page says less rather than inventing case studies.
 */
import Base from '../../../layouts/Base.astro';
import { capParagraphs } from '../../../lib/prose';
import Reading from '../../../components/Reading.astro';
import StateLawsuitMap from '../../../components/StateLawsuitMap.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

const CATEGORY = 'enterprise-applications-governance-and-tools';
const CATEGORY_NAME = 'Enterprise Applications, Governance and Tools';
const BASE = `/ai-ecosystem/${CATEGORY}`;

export function getStaticPaths() {
  const paths = [];
  if (existsSync('content/industries')) {
    for (const f of readdirSync('content/industries')) {
      if (!f.endsWith('.json')) continue;
      const d = JSON.parse(readFileSync(`content/industries/${f}`, 'utf8'));
      if (!d.uid) continue;
      // THE AI LAWYER, 2026-09-22. Its hub, its ten sub-hubs and its fifty
      // topics all get their own prop, so the generic section renderer below
      // never sees a document shaped unlike the ones it was written for.
      if (d.shape === 'art-topic' || d.shape === 'art-hub') {
        paths.push({ params: { id: d.uid }, props: { art: d } });
        continue;
      }
      paths.push({ params: { id: d.uid }, props: { sec: d } });
    }
  }
  if (existsSync('content/security')) {
    for (const f of readdirSync('content/security')) {
      if (!f.endsWith('.json')) continue;
      const d = JSON.parse(readFileSync(`content/security/${f}`, 'utf8'));
      if (d.uid) paths.push({ params: { id: d.uid }, props: { secu: d } });
    }
  }
  // Enacted AI Laws: the taxonomy has carried this section's live_path since
  // the enactment trigger shipped, and the category page links it, but no
  // route rendered the JSON, so the link 404ed. This is that route.
  if (existsSync('content/compliance/enacted-ai-laws.json')) {
    const d = JSON.parse(readFileSync('content/compliance/enacted-ai-laws.json', 'utf8'));
    if (d.uid) paths.push({ params: { id: d.uid }, props: { law: d } });
  }
  // AI Case Law: the pre-AI precedents current AI litigation is argued from.
  // The index and the per-case dissections are separate documents so the
  // list page stays light; each case page carries everything it renders.
  if (existsSync('content/caselaw')) {
    for (const f of readdirSync('content/caselaw')) {
      if (!f.endsWith('.json')) continue;
      const d = JSON.parse(readFileSync(`content/caselaw/${f}`, 'utf8'));
      if (d.shape === 'caselaw-index' && d.uid) paths.push({ params: { id: d.uid }, props: { clx: d } });
      else if (d.shape === 'caselaw-case' && d.case && d.case.uid) paths.push({ params: { id: d.case.uid }, props: { clc: d } });
    }
  }
  return paths;
}
const { sec, secu, law, clx, clc, art } = Astro.props;
// Compliance pages written from the statute: a map from "STATE BILL" to the
// page slug, so the enacted-laws list can link each law to its own reading.
// srj-pipeline's twoai_enacted_laws writes one per passed bill under
// content/compliance/law-*.json; a bill without one yet renders as before.
const lawPages = new Map();
if (law && existsSync('content/compliance')) {
  for (const f of readdirSync('content/compliance')) {
    if (!f.startsWith('law-') || !f.endsWith('.json')) continue;
    try {
      const d = JSON.parse(readFileSync(`content/compliance/${f}`, 'utf8'));
      if (d.state && d.bill_number && d.slug) {
        lawPages.set(`${d.state} ${d.bill_number}`.replace(/\s+/g, ' ').toUpperCase(), d.slug);
      }
    } catch { /* a malformed page fails its own route, not this list */ }
  }
}
const lawPage = (state, bill) => lawPages.get(`${state} ${bill}`.replace(/\s+/g, ' ').toUpperCase());
const dcase = clc ? clc.case : null;
const diss = dcase && dcase.dissection ? dcase.dissection : null;
// Fixed pillar order and field labels for the five-pillar dissection. Keys
// match the jsonb contract in twoai_precedents.dissection exactly, so a
// missing field simply does not render and a renamed field is visible as a
// hole in the page rather than a silent omission.
const PILLARS = [
  ['technology', '1 · Facts and technical architecture', [
    ['architecture', 'The technology'], ['data_inputs', 'Data inputs'],
    ['outputs', 'Outputs'], ['human_agency', 'Human agency'],
    ['ai_mapping', 'Where it maps onto AI, and where it does not']]],
  ['threshold', '2 · Threshold jurisdiction and standing', [
    ['legal_personhood', 'Legal personhood'], ['liability_allocation', 'Liability allocation'],
    ['standing', 'Standing']]],
  ['claims', '3 · Substantive claims', [
    ['ip', 'Intellectual property'], ['tort', 'Tort'],
    ['privacy_consumer', 'Privacy and consumer protection']]],
  ['evidence', '4 · Evidence and algorithmic provenance', [
    ['black_box', 'The black box problem'], ['technical_evidence', 'Technical evidence']]],
  ['policy', '5 · Normative policy and precedential impact', [
    ['regulatory_alignment', 'Regulatory alignment'], ['market_impact', 'Economic and market impact']]],
];
const doctrines = clx ? [...new Set(clx.cases.map((c) => c.doctrine))] : [];
const yrs = clx ? clx.cases.map((c) => +c.decided_on.slice(0, 4)) : [];
const yrMin = yrs.length ? Math.min(...yrs) : 0;
const yrMax = yrs.length ? Math.max(...yrs) : 0;

const clamp158 = (s) => (s.length <= 158 ? s : `${s.slice(0, 157).replace(/\s+\S*$/, '')}…`);
const isCases = !!sec && sec.shape === 'case-studies';
// COVERAGE ITEMS AND INSURANCE HUBS. Stephen, 2026-09-16: every one of the
// 100 AI Insurance items gets its own page, and each carries two fixed
// sections, What the Underwriter Wants to Know and What the Insured Needs
// Secured, the second in five parts. Those are structured fields on the page
// document (shape coverage-item), so they render identically everywhere and
// an empty part renders nothing rather than a heading over blank space.
//
// Without this branch a coverage item fell into isIndustry below and rendered
// as "AI in Direct-to-Chip Liquid Cooling Leaks", which is not a sentence.
const isCoverage = !!sec && sec.shape === 'coverage-item';
// A POINT THAT LEADS TO ONE OF OUR OWN PAGES IS A LINK, NOT A CITATION.
// Stephen, 2026-09-18, on every AI Insurance section: remove the word Source
// and make the title turn orange under the pointer. The ten points on each
// section lead to that item's own page on this site, but the pipeline stores
// the address in full, https://theworldofai.org/..., and the template only
// recognised a path beginning with a slash. So it treated our own page as an
// outside citation: a plain title, then a link called Source underneath that
// went to another page of ours. "Source" now means what it says, a document
// somewhere else, and appears only for those. ownHref returns the site path
// for any address of ours, in either form, and an empty string otherwise.
const ownHref = (src: string | undefined | null): string => {
  const s = String(src || '').trim();
  if (s.startsWith('/')) return s;
  const m = s.match(/^https?:\/\/(?:www\.)?theworldofai\.org(\/.*)?$/i);
  return m ? (m[1] || '/') : '';
};
const isInsHub = !!sec && !isCoverage && (sec.is_hub || (Array.isArray(sec.children) && sec.children.length > 0));
// This route's per-industry branch was written as "any sec that is not the
// hub", so every new sec shape added later fell into it and crashed on
// sec.points. It now names what it renders instead of what it excludes.
const isIndustry = !!sec && sec.shape !== 'industry-hub' && !isCases && !isCoverage && !isInsHub;
const needs = isCoverage ? (sec.insured_needs_secured || {}) : {};
const p2 = needs.part_2_paper_type_and_limit_structure || {};
const p4 = needs.part_4_program_structure_and_limits || {};
const nonEmpty = (v) => Array.isArray(v) ? v.length > 0 : (typeof v === 'string' ? v.trim() !== '' : !!v);
const hasUnderwriter = isCoverage && nonEmpty(sec.underwriter_wants_to_know);
const hasInsured = isCoverage && (nonEmpty(needs.part_1_core_third_party_liability_exposures)
  || Object.values(p2).some(nonEmpty) || nonEmpty(needs.part_3_high_value_red_flags)
  || Object.values(p4).some(nonEmpty) || nonEmpty(needs.manuscript_wording_and_carve_backs));
const artSections = art ? (art.sections || []) : [];
const artSiblings = art ? (art.siblings || []) : [];
const artKids = art ? (art.children || []) : [];
const desc = clamp158(art
  ? `${art.name}: ${art.answer || ''}`
  : clc
  ? `${dcase.case_name}, ${dcase.citation}: what it held, why AI ${dcase.posture === 'plaintiff' ? 'plaintiffs' : 'defendants'} cite it, and where the analogy to machine learning breaks down. With the full five-pillar dissection.`
  : clx
  ? `${clx.total} pre-AI court decisions that current AI litigation is argued from: the holding, why AI parties cite each one, and where the analogy fails, every citation verified against the court record.`
  : law
  ? `${law.total} AI-related bills that have become law across ${law.states} US states, detected from the legislative record on the day the status changes, each linked to the bill itself.`
  : secu ? `${secu.blurb}` : isCases
  ? `${sec.total} published accounts of real AI deployments from ${sec.publishers.length} research publishers, newest first, sector-tagged and linked to the original. Updated daily.`
  : (isCoverage || isInsHub) ? `${sec.summary || sec.blurb || ''}`
  : `${sec.summary || sec.blurb || ''}`);
const jsonld = JSON.stringify(clc ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${dcase.case_name}: the five-pillar dissection`,
  description: desc,
  url: `https://theworldofai.org${BASE}/${dcase.uid}/`,
  dateModified: clc.generated,
  citation: `${dcase.case_name}, ${dcase.citation} (${dcase.decided_on.slice(0, 4)})`,
  author: { '@type': 'Organization', name: 'The World of AI' },
  isPartOf: { '@type': 'CollectionPage', name: 'AI Case Law', url: `https://theworldofai.org${BASE}/${clc.section.uid}/` },
} : {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: art ? `${art.name} — The World of AI` : clx ? `AI Case Law: The Precedents Behind the Defenses — The World of AI` : law ? `Enacted AI Laws — The World of AI` : secu ? `${secu.name} — AI Security and Risk — The World of AI` : (sec.shape === 'industry-hub' || isCases || isCoverage || isInsHub ? `${sec.name} — The World of AI` : `AI in ${sec.name} — The World of AI`),
  description: desc,
  url: `https://theworldofai.org${BASE}/${(art || clx || law || secu || sec).uid}/`,
  dateModified: (art || clx || law || secu || sec).generated,
  isPartOf: { '@type': 'CollectionPage', name: CATEGORY_NAME, url: `https://theworldofai.org${BASE}/` },
});
// DRAFT PAGES ARE BUILT, REACHABLE, AND NOT IN THE INDEX.
//
// Stephen, 2026-09-15, on the new AI Insurance hub: we need time to build
// this right and not be worried that we will get labeled as thin pages, and
// I do not yet know whether each item is a page by itself or a hub for many
// pages until I start building.
//
// Both concerns have the same answer. A page document carrying draft: true
// renders so it can be worked on and read, and carries noindex so a search
// engine never sees a section that is still an outline. astro.config.mjs
// keeps the same pages out of the sitemap. Remove the flag when a section is
// ready and it enters the index on the next build, with the URL it always
// had - which is what makes it safe to decide the shape later.
const isDraft = Boolean((art || clx || law || secu || sec)?.draft);
// A live page can still be kept out of search while its data is thin, the
// politics entity pages from 2026-09-22 (noindex set by the pipeline).
const isThin = Boolean((art || clx || law || secu || sec)?.noindex);
---
<Base noindex={isDraft || isThin} title={art ? `${art.name} — The World of AI` : clc ? `${dcase.case_name} — AI Case Law — The World of AI` : clx ? 'AI Case Law: The Precedents Behind the Defenses — The World of AI' : law ? 'Enacted AI Laws: US Bills That Became Law — The World of AI' : secu ? `${secu.name} — AI Security and Risk — The World of AI` : isCases ? `AI Case Studies: Real Deployments, Indexed — The World of AI` : (isCoverage || isInsHub) ? (sec.name === 'AI Insurance' ? `AI Insurance: Coverage for AI Risk — The World of AI` : `${sec.name} — ${(sec.tax || '').startsWith('ins-') || sec.tax === 'ai-insurance' || isCoverage ? 'AI Insurance' : (sec.parent_name || CATEGORY_NAME)} — The World of AI`) : `AI in ${sec.name} — The World of AI`} description={desc}
  current={`${BASE}/`} jsonld={jsonld}>

  {art && (
    <>
      <p class="meta-line"><a href="/">AI Ecosystem</a> ·
        <a href={`${BASE}/`}>{CATEGORY_NAME}</a>
        {(art.crumbs || []).map((c) => <> · <a href={c.path}>{c.name}</a></>)}</p>
      <h1>{art.name}</h1>
      <p class="answer">{art.answer}</p>
      <p class="meta-line">uid {art.uid} &middot; generated {art.generated}
        {art.parent_path && <> &middot; {' '}<a href={art.parent_path}>{art.parent_name}</a></>}
        {art.hub_path && art.hub_path !== `${BASE}/${art.uid}/` && <>, in {' '}<a href={art.hub_path}>{art.hub_name || 'this section'}</a></>}</p>
      {artSections.map((s) => (
        <section>
          <h2>{s.heading}</h2>
          {capParagraphs(s.body).map((t) => <p>{t}</p>)}
        </section>
      ))}
      {artKids.length > 0 && (
        <>
          <h2>The {artKids.length} pages in {art.name}</h2>
          <ul class="sections">
            {artKids.map((k) => (
              <li><a href={k.path}>{k.name}</a>{k.blurb && <> {k.blurb}</>}</li>
            ))}
          </ul>
        </>
      )}
      {artSections.length > 0 && art.hub_name === 'The AI Lawyer' && (
        <p class="meta-line">Nothing on this page is legal advice. It describes how the
          work is done and where the risk sits, for people who then take proper advice.</p>
      )}
      {artSections.length > 0 && art.hub_name === 'The AI Accountant' && (
        <p class="meta-line">Nothing on this page is accounting, tax or audit advice. It
          describes how the work is done and where the risk sits.</p>
      )}
      {artSections.length > 0 && art.hub_name === 'The AI Physician' && (
        <p class="meta-line">Nothing on this page is medical advice. It describes how AI is
          used in medicine and where the risk sits; decisions about your own health belong
          with a clinician who knows you.</p>
      )}
      {artSections.length > 0 && art.hub_name === 'The AI Economist' && (
        <p class="meta-line">Nothing on this page is investment advice or a recommendation to
          buy, sell or hold anything. It describes how AI is used in economics and investing
          and where the risk sits.</p>
      )}
      {artSiblings.length > 0 && (
        <>
          <h2>Also in {art.parent_name}</h2>
          <ul class="sections">
            {artSiblings.map((k) => <li><a href={k.path}>{k.name}</a></li>)}
          </ul>
        </>
      )}
      <div class="cite-box">Cite this page: <code>"{art.name}." The World of AI,
        theworldofai.org{BASE}/{art.uid}/. Retrieved {art.generated}.</code></div>
    </>
  )}

  {isDraft && (
    <p class="meta-line" style="border-left:3px solid var(--orange); padding-left:12px">
      Draft. This section is being built and is not in the search index yet. The
      items below are what we intend to track, not findings.
    </p>
  )}

  <p class="meta-line"><a href="/">AI Ecosystem</a> ·
    <a href={`${BASE}/`}>{CATEGORY_NAME}</a></p>

  {sec && sec.shape === 'industry-hub' && (
    <>
      {/* This branch shipped without an h1 while every sibling branch has one,
          so the hub was the single page on the site with no heading element.
          It matches the page's own title tag rather than inventing a phrase. */}
      <h1>AI in {sec.name}</h1>
      <p class="answer"><b>{sec.total_points} sourced points across {sec.sectors.length} industries</b>,
        every one linked to a verified primary source, with the official US adoption statistic
        updating live below. This page reads across all of them: what the numbers say, what they
        mean, and what holds true from sector to sector.</p>
      <p class="meta-line">Last verified: {sec.generated}</p>

      {sec.metrics && sec.metrics.questions && (
        <section>
          <h2>The official adoption numbers</h2>
          <p class="meta-line">Source: <a href={sec.metrics.page_url} rel="noopener">{sec.metrics.source}</a>,
            updated {sec.metrics.cadence}{sec.metrics.latest_pub ? `, latest release ${sec.metrics.latest_pub}` : ''}.
            Refetched by this site's pipeline on every run; the analysis below regenerates only when these numbers change.</p>
          <table>
            <thead><tr><th>Question</th><th>Answer</th><th>Latest</th><th>Prior period</th><th>First asked (Sept 2023)</th></tr></thead>
            <tbody>
              {sec.metrics.questions.map((q) => {
                const ps = sec.metrics.periods;
                const latest = ps[ps.length - 1], prior = ps[ps.length - 2], first = ps[0];
                return q.answers.map((a, i) => (
                  <tr>
                    {i === 0 && <td rowspan={q.answers.length}>{q.text}</td>}
                    <td>{a.answer}</td>
                    <td><b>{a.series[latest] || ''}</b></td>
                    <td>{a.series[prior] || ''}</td>
                    <td>{a.series[first] || ''}</td>
                  </tr>
                ));
              })}
            </tbody>
          </table>
        </section>
      )}

      {sec.synthesis && (
        <section>
          <h2>What the accumulated sources show</h2>
          {sec.synthesis.body.split('\n\n').map((para) => <p>{para}</p>)}
          <p class="meta-line">Written {sec.synthesis.generated_on} from this site's harvest of the
            sector sources ({sec.sources_read} of {sec.sources_total} source pages read on the latest
            pass) and the Census figures, and nothing else. Every figure is verified mechanically
            against the harvested data before publication, and this section is rewritten whenever the
            sources or the numbers change.</p>
        </section>
      )}

      {sec.analysis && (
        <section>
          <h2>What the numbers mean</h2>
          {sec.analysis.body.split('\n\n').map((para) => <p>{para}</p>)}
          <p class="meta-line">Written {sec.analysis.generated_on} from the survey data shown above
            and nothing else. Every figure in it is verified mechanically against the source data
            before publication, and the text is rewritten when the Census releases new numbers.</p>
        </section>
      )}

      <section>
        <h2>What holds across industries</h2>
        {sec.findings.map((f) => (
          <div class="dom">
            <h3>{f.heading}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </section>

      <section>
        <h2>The {sec.sectors.length} industries</h2>
        <ul class="sections">
          {sec.sectors.map((sx) => (
            <li>
              {sx.path ? <a href={sx.path}>{sx.name}</a> : sx.name}
              <span class="n">{sx.points}</span>
              {sx.blurb && <p>{sx.blurb}</p>}
            </li>
          ))}
        </ul>
      </section>

      <div class="cite-box">Cite this page: <code>"{sec.name}." The World of AI,
        theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

  {secu && secu.shape === 'security-hub' && (
    <>
      <h1>{secu.name}</h1>
      <p class="answer">{secu.blurb}</p>
      <p class="meta-line">Last verified: {secu.generated} · The threat picture first, MITRE
        ATLAS, the OWASP Top 10 for LLM Applications and AVID, then {secu.topic_count} topics
        organized under the six domains of a security program. The same risk reads differently to
        governance, the SOC, the architects, the product team, vendor risk, and privacy, so each
        topic appears under every domain it genuinely touches.</p>
      {/* THREATS FIRST, THEN DEFENCES. Stephen, 2026-08-30: put ATLAS, the
          OWASP Top 10 and AVID at the top of this hub. He is right on the
          reading order. The six domains below are how a security PROGRAM is
          organised, which is the answer to "where does this belong"; ATLAS,
          OWASP and AVID are what is actually being done to AI systems, which
          is the answer to "what am I defending against". A reader needs the
          second question answered before the first is useful, and these three
          are also the names an auditor or a search engine arrives looking for. */}
      {secu.atlas && (
        <section id="atlas" class="secdom-group">
          <h2>MITRE ATLAS: how AI systems are actually attacked</h2>
          <p>Start with what is actually being done to AI systems. ATLAS is MITRE's
            ATT&amp;CK-style knowledge base of real adversary behaviour against AI,
            built from documented incidents rather than theory, and the six defensive
            domains further down this page are the answer to it. We track its releases
            so this page reflects the current matrix rather than whatever was true when
            it was written.</p>
          <p class="answer"><b>Release {secu.atlas.release}</b>, published
            {' '}{secu.atlas.release_date}: {secu.atlas.techniques} techniques across
            {' '}{secu.atlas.tactics} tactics, {secu.atlas.mitigations} mitigations, and
            {' '}{secu.atlas.case_studies} documented case studies.</p>

          {secu.atlas.newest_techniques && secu.atlas.newest_techniques.length > 0 && (
            <>
              <h3>Newest techniques</h3>
              <ul class="sections">
                {secu.atlas.newest_techniques.map((t) => (
                  <li>{t.name} <span class="atlas-id">{t.id}</span>
                    {t.created && <span class="atlas-id"> · added {t.created}</span>}</li>
                ))}
              </ul>
            </>
          )}

          {secu.atlas.newest_case_studies && secu.atlas.newest_case_studies.length > 0 && (
            <>
              <h3>Newest case studies</h3>
              <ul class="sections">
                {secu.atlas.newest_case_studies.map((c) => (
                  <li>{c.name} <span class="atlas-id">{c.id}</span>
                    {c.target && <p>Target: {c.target}</p>}</li>
                ))}
              </ul>
            </>
          )}

          <p class="meta-line">Source: <a href={secu.atlas.site_url} rel="noopener">MITRE
            ATLAS</a>, data from <a href={secu.atlas.data_url} rel="noopener">mitre-atlas/atlas-data</a>,
            licensed Apache 2.0, copyright MITRE. Release manifest checked
            {' '}{secu.atlas.checked}; a new release is ingested the day it appears. We
            publish identifiers, names, and counts and send you to MITRE for the
            technique descriptions, which are theirs. Individual ATLAS identifiers are
            given as text because atlas.mitre.org renders client-side and does not
            serve stable deep links.</p>
        </section>
      )}

      {secu.owasp && (
        <section id="owasp" class="secdom-group">
          <h2>OWASP Top 10 for LLM Applications</h2>
          <p>The list a security team is most often asked about by name, and the one
            auditors and procurement questionnaires cite. We track what OWASP has
            actually published on the web rather than what has been announced, because
            the two are not always the same thing.</p>
          <p class="answer"><b>The {secu.owasp.edition} edition is the published web
            list</b>, ten risks, each with its own OWASP page linked below. The
            {' '}{secu.owasp.newest_edition} edition was
            {' '}<a href={secu.owasp.newest_url} rel="noopener">released as a document</a>
            {' '}on {secu.owasp.newest_published}; when OWASP publishes its per-risk
            pages, this list moves with it automatically.</p>
          <ul class="sections">
            {secu.owasp.risks.map((r) => (
              <li><a href={r.url} rel="noopener">{r.title}</a>
                {' '}<span class="atlas-id">{r.code}</span></li>
            ))}
          </ul>
          <p class="meta-line">Source: <a href={secu.owasp.list_url} rel="noopener">OWASP
            Gen AI Security Project</a>, checked {secu.owasp.checked}. Titles and links
            only; the risk descriptions are OWASP's and stay on their pages.</p>
        </section>
      )}

      {secu.avid && (
        <section id="avid" class="secdom-group">
          <h2>AVID: the AI Vulnerability Database</h2>
          <p>Where ATLAS describes adversary behaviour and OWASP ranks risk classes,
            AVID catalogues the individual findings: a report is one concrete
            occurrence with evidence, a vulnerability is a recurring failure mode.
            It is the granular layer under the other two.</p>
          <p class="answer"><b>{secu.avid.total.toLocaleString()} records catalogued</b>,
            {' '}{secu.avid.reports.toLocaleString()} reports and

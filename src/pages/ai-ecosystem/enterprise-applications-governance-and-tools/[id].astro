---
/**
 * Enterprise Applications, Governance and Tools: identifier-addressed section
 * pages. First residents: the Industry Use Cases sections, rendered from
 * curated sourced points per industry. A sector with no verifiable primary
 * source beyond the Census adoption series carries less content by design -
 * the page says less rather than inventing case studies.
 */
import Base from '../../../layouts/Base.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

const CATEGORY = 'enterprise-applications-governance-and-tools';
const CATEGORY_NAME = 'Enterprise Applications, Governance and Tools';
const BASE = `/ai-ecosystem/${CATEGORY}`;

export function getStaticPaths() {
  const paths = [];
  if (existsSync('content/industries')) {
    for (const f of readdirSync('content/industries')) {
      if (!f.endsWith('.json')) continue;
      const d = JSON.parse(readFileSync(`content/industries/${f}`, 'utf8'));
      if (d.uid) paths.push({ params: { id: d.uid }, props: { sec: d } });
    }
  }
  if (existsSync('content/security')) {
    for (const f of readdirSync('content/security')) {
      if (!f.endsWith('.json')) continue;
      const d = JSON.parse(readFileSync(`content/security/${f}`, 'utf8'));
      if (d.uid) paths.push({ params: { id: d.uid }, props: { secu: d } });
    }
  }
  // Enacted AI Laws: the taxonomy has carried this section's live_path since
  // the enactment trigger shipped, and the category page links it, but no
  // route rendered the JSON, so the link 404ed. This is that route.
  if (existsSync('content/compliance/enacted-ai-laws.json')) {
    const d = JSON.parse(readFileSync('content/compliance/enacted-ai-laws.json', 'utf8'));
    if (d.uid) paths.push({ params: { id: d.uid }, props: { law: d } });
  }
  // AI Case Law: the pre-AI precedents current AI litigation is argued from.
  // The index and the per-case dissections are separate documents so the
  // list page stays light; each case page carries everything it renders.
  if (existsSync('content/caselaw')) {
    for (const f of readdirSync('content/caselaw')) {
      if (!f.endsWith('.json')) continue;
      const d = JSON.parse(readFileSync(`content/caselaw/${f}`, 'utf8'));
      if (d.shape === 'caselaw-index' && d.uid) paths.push({ params: { id: d.uid }, props: { clx: d } });
      else if (d.shape === 'caselaw-case' && d.case && d.case.uid) paths.push({ params: { id: d.case.uid }, props: { clc: d } });
    }
  }
  return paths;
}
const { sec, secu, law, clx, clc } = Astro.props;
const dcase = clc ? clc.case : null;
const diss = dcase && dcase.dissection ? dcase.dissection : null;
// Fixed pillar order and field labels for the five-pillar dissection. Keys
// match the jsonb contract in twoai_precedents.dissection exactly, so a
// missing field simply does not render and a renamed field is visible as a
// hole in the page rather than a silent omission.
const PILLARS = [
  ['technology', '1 · Facts and technical architecture', [
    ['architecture', 'The technology'], ['data_inputs', 'Data inputs'],
    ['outputs', 'Outputs'], ['human_agency', 'Human agency'],
    ['ai_mapping', 'Where it maps onto AI, and where it does not']]],
  ['threshold', '2 · Threshold jurisdiction and standing', [
    ['legal_personhood', 'Legal personhood'], ['liability_allocation', 'Liability allocation'],
    ['standing', 'Standing']]],
  ['claims', '3 · Substantive claims', [
    ['ip', 'Intellectual property'], ['tort', 'Tort'],
    ['privacy_consumer', 'Privacy and consumer protection']]],
  ['evidence', '4 · Evidence and algorithmic provenance', [
    ['black_box', 'The black box problem'], ['technical_evidence', 'Technical evidence']]],
  ['policy', '5 · Normative policy and precedential impact', [
    ['regulatory_alignment', 'Regulatory alignment'], ['market_impact', 'Economic and market impact']]],
];
const doctrines = clx ? [...new Set(clx.cases.map((c) => c.doctrine))] : [];
const yrs = clx ? clx.cases.map((c) => +c.decided_on.slice(0, 4)) : [];
const yrMin = yrs.length ? Math.min(...yrs) : 0;
const yrMax = yrs.length ? Math.max(...yrs) : 0;

const clamp158 = (s) => (s.length <= 158 ? s : `${s.slice(0, 157).replace(/\s+\S*$/, '')}…`);
const isCases = !!sec && sec.shape === 'case-studies';
// This route's per-industry branch was written as "any sec that is not the
// hub", so every new sec shape added later fell into it and crashed on
// sec.points. It now names what it renders instead of what it excludes.
const isIndustry = !!sec && sec.shape !== 'industry-hub' && !isCases;
const desc = clamp158(clc
  ? `${dcase.case_name}, ${dcase.citation}: what it held, why AI ${dcase.posture === 'plaintiff' ? 'plaintiffs' : 'defendants'} cite it, and where the analogy to machine learning breaks down. With the full five-pillar dissection.`
  : clx
  ? `${clx.total} pre-AI court decisions that current AI litigation is argued from: the holding, why AI parties cite each one, and where the analogy fails, every citation verified against the court record.`
  : law
  ? `${law.total} AI-related bills that have become law across ${law.states} US states, detected from the legislative record on the day the status changes, each linked to the bill itself.`
  : secu ? `${secu.blurb}` : isCases
  ? `${sec.total} published accounts of real AI deployments from ${sec.publishers.length} research publishers, newest first, sector-tagged and linked to the original. Updated daily.`
  : `${sec.summary || sec.blurb || ''}`);
const jsonld = JSON.stringify(clc ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${dcase.case_name}: the five-pillar dissection`,
  description: desc,
  url: `https://theworldofai.org${BASE}/${dcase.uid}/`,
  dateModified: clc.generated,
  citation: `${dcase.case_name}, ${dcase.citation} (${dcase.decided_on.slice(0, 4)})`,
  author: { '@type': 'Organization', name: 'The World of AI' },
  isPartOf: { '@type': 'CollectionPage', name: 'AI Case Law', url: `https://theworldofai.org${BASE}/${clc.section.uid}/` },
} : {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: clx ? `AI Case Law: The Precedents Behind the Defenses — The World of AI` : law ? `Enacted AI Laws — The World of AI` : secu ? `${secu.name} — AI Security and Risk — The World of AI` : (sec.shape === 'industry-hub' || isCases ? `${sec.name} — The World of AI` : `AI in ${sec.name} — The World of AI`),
  description: desc,
  url: `https://theworldofai.org${BASE}/${(clx || law || secu || sec).uid}/`,
  dateModified: (clx || law || secu || sec).generated,
  isPartOf: { '@type': 'CollectionPage', name: CATEGORY_NAME, url: `https://theworldofai.org${BASE}/` },
});
---
<Base title={clc ? `${dcase.case_name} — AI Case Law — The World of AI` : clx ? 'AI Case Law: The Precedents Behind the Defenses — The World of AI' : law ? 'Enacted AI Laws: US Bills That Became Law — The World of AI' : secu ? `${secu.name} — AI Security and Risk — The World of AI` : isCases ? `AI Case Studies: Real Deployments, Indexed — The World of AI` : `AI in ${sec.name} — The World of AI`} description={desc}
  current={`${BASE}/`} jsonld={jsonld}>

  <p class="meta-line"><a href="/">AI Ecosystem</a> ·
    <a href={`${BASE}/`}>{CATEGORY_NAME}</a></p>

  {sec && sec.shape === 'industry-hub' && (
    <>
      {/* This branch shipped without an h1 while every sibling branch has one,
          so the hub was the single page on the site with no heading element.
          It matches the page's own title tag rather than inventing a phrase. */}
      <h1>AI in {sec.name}</h1>
      <p class="answer"><b>{sec.total_points} sourced points across {sec.sectors.length} industries</b>,
        every one linked to a verified primary source, with the official US adoption statistic
        updating live below. This page reads across all of them: what the numbers say, what they
        mean, and what holds true from sector to sector.</p>
      <p class="meta-line">Last verified: {sec.generated}</p>

      {sec.metrics && sec.metrics.questions && (
        <section>
          <h2>The official adoption numbers</h2>
          <p class="meta-line">Source: <a href={sec.metrics.page_url} rel="noopener">{sec.metrics.source}</a>,
            updated {sec.metrics.cadence}{sec.metrics.latest_pub ? `, latest release ${sec.metrics.latest_pub}` : ''}.
            Refetched by this site's pipeline on every run; the analysis below regenerates only when these numbers change.</p>
          <table>
            <thead><tr><th>Question</th><th>Answer</th><th>Latest</th><th>Prior period</th><th>First asked (Sept 2023)</th></tr></thead>
            <tbody>
              {sec.metrics.questions.map((q) => {
                const ps = sec.metrics.periods;
                const latest = ps[ps.length - 1], prior = ps[ps.length - 2], first = ps[0];
                return q.answers.map((a, i) => (
                  <tr>
                    {i === 0 && <td rowspan={q.answers.length}>{q.text}</td>}
                    <td>{a.answer}</td>
                    <td><b>{a.series[latest] || ''}</b></td>
                    <td>{a.series[prior] || ''}</td>
                    <td>{a.series[first] || ''}</td>
                  </tr>
                ));
              })}
            </tbody>
          </table>
        </section>
      )}

      {sec.synthesis && (
        <section>
          <h2>What the accumulated sources show</h2>
          {sec.synthesis.body.split('\n\n').map((para) => <p>{para}</p>)}
          <p class="meta-line">Synthesis generated by {sec.synthesis.model} on {sec.synthesis.generated_on},
            from this site's harvest of the sector sources ({sec.sources_read} of {sec.sources_total} source
            pages read on the latest pass) and the Census figures, and nothing else. Every figure is
            verified mechanically against the harvested data before publication; the synthesis regenerates
            when the sources or the numbers change.</p>
        </section>
      )}

      {sec.analysis && (
        <section>
          <h2>What the numbers mean</h2>
          {sec.analysis.body.split('\n\n').map((para) => <p>{para}</p>)}
          <p class="meta-line">Analysis generated by {sec.analysis.model} on {sec.analysis.generated_on},
            from the survey data shown above and nothing else. Every figure in it is verified
            mechanically against the source data before publication; the text regenerates when
            the Census releases new numbers.</p>
        </section>
      )}

      <section>
        <h2>What holds across industries</h2>
        {sec.findings.map((f) => (
          <div class="dom">
            <h3>{f.heading}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </section>

      <section>
        <h2>The {sec.sectors.length} industries</h2>
        <ul class="sections">
          {sec.sectors.map((sx) => (
            <li>
              {sx.path ? <a href={sx.path}>{sx.name}</a> : sx.name}
              <span class="n">{sx.points}</span>
              {sx.blurb && <p>{sx.blurb}</p>}
            </li>
          ))}
        </ul>
      </section>

      <div class="cite-box">Cite this page: <code>"{sec.name}." The World of AI,
        theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

  {secu && secu.shape === 'security-hub' && (
    <>
      <h1>{secu.name}</h1>
      <p class="answer">{secu.blurb}</p>
      <p class="meta-line">Last verified: {secu.generated} · {secu.topic_count} topics, organized
        under the six domains of a security program. The same risk reads differently to governance,
        the SOC, the architects, the product team, vendor risk, and privacy, so each topic appears
        under every domain it genuinely touches.</p>
      {secu.domains.map((d) => (
        <section id={d.slug} class="secdom-group">
          <h2>{d.label}</h2>
          <p>{d.blurb}</p>
          <ul class="sections">
            {d.topics.map((t) => (
              <li>
                {t.path ? <a href={t.path}>{t.name}</a> : t.name}
                {t.blurb && <p>{t.blurb}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))}
      <div class="cite-box">Cite this page: <code>"{secu.name}." The World of AI,
        theworldofai.org{BASE}/{secu.uid}/. Retrieved {secu.generated}.</code></div>
    </>
  )}

  {secu && secu.shape !== 'security-hub' && (
    <>
      <h1>{secu.name}</h1>
      <p class="answer">{secu.blurb}</p>
      <p class="meta-line">Last verified: {secu.generated} · Part of
        {' '}<a href={`${BASE}/`}>AI Security and Risk</a>. Every entry below carries a source
        that was verified before it was published and is re-verified daily; the spine is
        standards bodies, government agencies, and the labs' own published security research.</p>

      {secu.topic && secu.topic.length > 0 && (
        <section class="topic-depth">
          {secu.topic.map((t) => {
            const H = { def: 'What it is', examples: 'What it looks like', detect: 'How to find it', defend: 'How to defend against it' };
            return (
              <div class="dom">
                <h2>{H[t.block] || t.block}</h2>
                <p>{t.body}</p>
              </div>
            );
          })}
        </section>
      )}

      {secu.deep && secu.deep.length > 0 && secu.deep.map((g) => (
        <section>
          <h2>{g.heading}</h2>
          {g.intro && <p>{g.intro}</p>}
          {g.layout === 'ordered' && (
            <ol class="chain">
              {g.blocks.map((b) => <li><b>{b.label}.</b> {b.body}</li>)}
            </ol>
          )}
          {g.layout === 'grid' && (
            <div class="attack-grid">
              {g.blocks.map((b) => (
                <div class="dom"><h3>{b.label}</h3><p>{b.body}</p></div>
              ))}
            </div>
          )}
          {g.layout === 'table' && (
            <table>
              <thead><tr><th>Control</th><th>What it means in practice</th></tr></thead>
              <tbody>
                {g.blocks.map((b) => <tr><td><b>{b.label}</b></td><td>{b.body}</td></tr>)}
              </tbody>
            </table>
          )}
          {g.layout === 'prose' && g.blocks.map((b) => (
            <>{g.blocks.length > 1 && <h3>{b.label}</h3>}<p>{b.body}</p></>
          ))}
        </section>
      ))}

      {secu.domains && secu.domains.length > 0 && (
        <section class="six-domains">
          <h2>How this lands across the six security domains</h2>
          <p class="meta-line">How this topic lands in each domain of the security program.
            The same risk reads differently to governance, the SOC, the architects, the product
            team, vendor risk, and privacy — and a program that only covers one lens leaves the
            others exposed.</p>
          {secu.domains.map((d) => (
            <div class="dom">
              <h3>{d.label}</h3>
              <p>{d.body}</p>
            </div>
          ))}
        </section>
      )}

      {secu.items.filter((i) => i.kind === 'domain').length > 0 && (
        <div class="dom"><h3>The six domains of the defensive stack</h3>
          {secu.items.filter((i) => i.kind === 'domain').map((i) => (
            <div class="dom">
              <h3>{i.name}</h3>
              <p class="meta-line">{i.note}</p>
            </div>
          ))}
        </div>
      )}

      {secu.items.filter((i) => i.kind !== 'domain').length > 0 && (
        <h2>Primary sources and further reading</h2>
      )}
      {secu.items.filter((i) => i.kind !== 'domain').map((i) => (
        <div class="dom">
          <h3>{i.URL || i.source_url ? <a href={i.source_url} rel="noopener">{i.name}</a> : i.name}</h3>
          <p class="meta-line">{i.note}</p>
          <p class="meta-line">Source: {i.source_name}</p>
        </div>
      ))}

      {secu.tax === 'sec-deepfakes' && secu.stats && (
        <p class="meta-line">Live context from this site: <b>{secu.stats.deepfake_bills}</b> state
          bills in the legislation tracker mention deepfakes or synthetic media.</p>
      )}
      {(secu.tax === 'sec-agent-security' || secu.tax === 'sec-prompt-injection') && secu.stats && (
        <p class="meta-line">Live context from this site: <b>{secu.stats.mcp_servers.toLocaleString()}</b> MCP
          servers tracked from the official registry — the agent toolchain this attack surface runs through.</p>
      )}
      {secu.tax === 'sec-shadow-ai' && secu.stats && (
        <p class="meta-line">Live context from this site: <b>{secu.stats.compliance_docs}</b> governance
          documents in the compliance library.</p>
      )}

      <div class="cite-box">Cite this page: <code>"{secu.name}." The World of AI,
        theworldofai.org{BASE}/{secu.uid}/. Retrieved {secu.generated}.</code></div>
    </>
  )}

  {isIndustry && (
    <>
  <h1>AI in {sec.name}</h1>

  <p class="answer">{sec.summary}</p>
  <p class="meta-line">Last verified: {sec.generated} · Every point below carries its own
    source. Where a sector has no verifiable primary source beyond the official adoption
    survey, this page says less rather than inventing case studies.</p>

  {isIndustry && sec.btos && sec.btos.latest && sec.btos.latest !== 'S' && (
    <div class="dom">
      <h3>The official adoption number for this sector</h3>
      <p><b>{sec.btos.latest}</b> of firms in {sec.btos.label} used AI in the last two
        weeks, per the Census Bureau's Business Trends and Outlook Survey
        {sec.btos.prior && sec.btos.prior !== 'S' ? ` (prior period ${sec.btos.prior}` : ''}{sec.btos.first && sec.btos.prior && sec.btos.prior !== 'S' ? `, ${sec.btos.first} when first asked in September 2023)` : sec.btos.prior && sec.btos.prior !== 'S' ? ')' : ''}.
        Refetched from the <a href="https://www.census.gov/hfp/btos/data" rel="noopener">Census sector file</a> on
        every pipeline run.</p>
    </div>
  )}

  {isIndustry && sec.analysis && (
    <section>
      <h2>The state of AI in {sec.name.toLowerCase()}</h2>
      {sec.analysis.body.split('\n\n').map((para) => <p>{para}</p>)}
      <p class="meta-line">Analysis generated by {sec.analysis.model} on {sec.analysis.generated_on},
        from the Census figure above and this site's harvest of this page's cited sources
        {sec.sources_read ? ` (${sec.sources_read} of ${sec.sources_total} source pages read on the latest pass)` : ''} and
        nothing else; every figure is verified mechanically against the harvested data before
        publication, and the text regenerates when the sources or the numbers change.</p>
    </section>
  )}

  {isIndustry && sec.analysis && <h2>The sourced record</h2>}

  {isIndustry && sec.points.map((f) => (
    <div class="dom">
      <h3>{f.name}</h3>
      <p>{f.desc}</p>
      <p class="meta-line"><a href={f.source} rel="noopener">Source</a></p>
    </div>
  ))}

  <p class="meta-line">Related on this site: <a href="/ai-laws/">AI laws by state</a> ·
    <a href="/ai-lawsuits/">the AI lawsuit tracker</a> ·
    <a href="/ai-tools/">the tools directory</a> ·
    <a href="/skills/">the AI skills graph</a>.</p>

  <div class="cite-box">Cite this page: <code>"AI in {sec.name}." The World of AI,
    theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

  {law && (
    <>
      <h1>Enacted AI Laws</h1>
      <p class="answer"><b>{law.total} AI-related bills across {law.states} US states have
        actually become law.</b> {law.blurb} Each row links to the bill record itself; nothing
        here is summarised from press coverage.</p>
      <p class="meta-line">Last verified: {law.generated}. Detection runs against the
        legislative record daily; a bill appears here the day its status changes to passed.</p>

      {law.recent && law.recent.length > 0 && (
        <section>
          <h2>Enacted most recently</h2>
          {law.recent.map((b) => (
            <div class="dom">
              <h3><a href={b.url} rel="noopener">{b.state} {b.bill}</a> · {b.status_date}</h3>
              <p>{b.description || b.title}</p>
            </div>
          ))}
        </section>
      )}

      <section>
        <h2>Every enacted AI law on record</h2>
        <table>
          <thead><tr><th>State</th><th>Bill</th><th>What it does</th><th>Status date</th></tr></thead>
          <tbody>
            {law.laws.map((b) => (
              <tr>
                <td>{b.state}</td>
                <td><a href={b.url} rel="noopener">{b.bill}</a></td>
                <td>{b.title}</td>
                <td>{b.status_date}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <p class="meta-line">Related on this site: <a href="/ai-laws/">AI laws by state</a> ·
        <a href="/ai-compliance/">the governance library</a> ·
        <a href="/ai-compliance/state-ai-laws/">state AI laws explained</a>.</p>

      <div class="cite-box">Cite this page: <code>"Enacted AI Laws." The World of AI,
        theworldofai.org{BASE}/{law.uid}/. Retrieved {law.generated}.</code></div>
    </>
  )}

  {clx && (
    <>
      <h1>{clx.name}</h1>
      <p class="answer"><b>{clx.total} decisions, handed down between {yrMin} and {yrMax}, are
        doing most of the work in current AI litigation.</b> Every training, scraping and
        platform defense argued today is built from this shelf. Each profile states what the
        case held, why AI parties cite it, and where the analogy to machine learning is
        weakest, with a five-pillar dissection covering the technology, the threshold
        questions, the claims, the evidence and the policy stakes. {clx.dissected} of
        {' '}{clx.total} carry the full dissection so far.</p>
      <p class="meta-line">Last verified: {clx.generated} · Every citation, court and decision
        date was verified against the public court record before publication, and each page
        links to the opinion itself. Cases marked <span class="badge">cited against AI</span>
        are the precedents most used by plaintiffs; a reference that omitted them would be
        advocacy rather than reference.</p>

      {doctrines.map((d) => (
        <section>
          <h2>{d}</h2>
          <table>
            <thead><tr><th>Case</th><th>Citation</th><th>Decided</th><th>Holding</th></tr></thead>
            <tbody>
              {clx.cases.filter((c) => c.doctrine === d).map((c) => (
                <tr>
                  <td><a href={`${BASE}/${c.uid}/`}>{c.case_name}</a>
                    {c.posture === 'plaintiff' && <><br/><span class="badge">cited against AI</span></>}
                    {c.live_total > 0 && <><br/><span class="meta-line">{c.live_total} active {c.live_total === 1 ? 'case' : 'cases'} in this lane</span></>}</td>
                  <td>{c.citation}</td>
                  <td>{c.decided_on.slice(0, 4)}</td>
                  <td>{c.holding}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))}

      <p class="meta-line">Related on this site: <a href="/ai-lawsuits/">the AI lawsuit
        tracker</a> · <a href="/ai-laws/">AI laws by state</a> ·
        {' '}<a href="/ai-compliance/">the governance library</a>.</p>

      <div class="cite-box">Cite this page: <code>"{clx.name}." The World of AI,
        theworldofai.org{BASE}/{clx.uid}/. Retrieved {clx.generated}.</code></div>
    </>
  )}

  {clc && (
    <>
      <h1>{dcase.case_name}</h1>
      <p class="meta-line">{dcase.citation} · {dcase.court} · Decided {dcase.decided_on} ·
        {' '}<a href={`${BASE}/${clc.section.uid}/`}>Part of AI Case Law</a></p>
      {dcase.posture === 'plaintiff' && (
        <p class="meta-line"><span class="badge">cited against AI</span> One of the precedents
          most used by plaintiffs against AI companies. It sits in this reference because a
          shelf of defenses that hid the cases cutting the other way would be advocacy.</p>
      )}
      <p class="answer"><b>{dcase.holding}</b></p>
      <p class="meta-line">Last verified: {clc.generated} · Citation, court and date verified
        against the public court record on {dcase.verified_on} ·
        {' '}<a href={dcase.source_url} rel="noopener">Read the opinion</a> ({dcase.source_name}).</p>

      <section>
        <h2>Why AI {dcase.posture === 'plaintiff' ? 'plaintiffs' : 'defendants'} cite it</h2>
        <p>{dcase.why_ai_cites_it}</p>
      </section>
      {dcase.limits && (
        <section>
          <h2>Where the analogy is weakest</h2>
          <p>{dcase.limits}</p>
        </section>
      )}
      {dcase.era_technology && (
        <p class="meta-line">The technology of the case: {dcase.era_technology}.</p>
      )}

      {dcase.quoted_in && dcase.quoted_in.length > 0 && (
        <section>
          <h2>Quoted in the live AI docket record</h2>
          <p class="meta-line">Found by scanning the extracted text of filings in the public
            docket record. Each entry names the case and the specific document in which this
            decision appears.</p>
          <ul class="sections">
            {dcase.quoted_in.map((q) => (
              <li><a href={q.path}>{q.lawsuit}</a> &mdash; {q.by === 'court' ? 'cited by the court' : q.by === 'defense' ? 'cited by the defense' : q.by === 'plaintiff' ? 'cited by the plaintiffs' : 'cited in a filing'}{q.doc_url && <> (<a href={q.doc_url} rel="nofollow">{q.doc || 'document'}</a>)</>}</li>
            ))}
          </ul>
          {dcase.quoted_total > dcase.quoted_in.length && (
            <p class="meta-line">{dcase.quoted_total} documents in total cite this decision
              across the tracker.</p>
          )}
        </section>
      )}

      {dcase.live_total > 0 && dcase.live_cases && dcase.live_cases.length > 0 && (
        <section>
          <h2>Active AI cases in this doctrine's lane</h2>
          <p class="meta-line">The lawsuit tracker classifies {dcase.live_total} active
            {' '}{dcase.live_total === 1 ? 'case' : 'cases'} under the claim category this
            precedent governs, newest first below. This is the tracker's own classification
            of what each case is about, not a verified record of which briefs quote this
            decision.</p>
          <ul class="sections">
            {dcase.live_cases.map((lc) => (
              <li><a href={lc.path}>{lc.name}</a></li>
            ))}
          </ul>
          {dcase.live_total > dcase.live_cases.length && (
            <p class="meta-line">All {dcase.live_total} are in
              {' '}<a href="/ai-lawsuits/">the AI lawsuit tracker</a>.</p>
          )}
        </section>
      )}

      {diss && PILLARS.map(([key, heading, fields]) => diss[key] && (
        <section>
          <h2>{heading}</h2>
          {fields.map(([fk, fl]) => diss[key][fk] && (
            <div class="dom">
              <h3>{fl}</h3>
              <p>{diss[key][fk]}</p>
            </div>
          ))}
        </section>
      ))}

      {diss && diss.teaching && (
        <section>
          <h2>Teaching the case</h2>
          {diss.teaching.analogy && (
            <div class="dom"><h3>Deconstruct the analogy</h3><p>{diss.teaching.analogy}</p></div>
          )}
          {diss.teaching.socratic && diss.teaching.socratic.length > 0 && (
            <div class="dom"><h3>Socratic questions</h3>
              <ol class="chain">{diss.teaching.socratic.map((q) => <li>{q}</li>)}</ol></div>
          )}
          {diss.teaching.exercise && (
            <div class="dom"><h3>Exercise: reverse-engineer the compliance</h3>
              <p>{diss.teaching.exercise}</p></div>
          )}
        </section>
      )}

      {!diss && (
        <p class="meta-line">Everything on this page was verified against the court record
          before publication.</p>
      )}

      <p class="meta-line">Related on this site: <a href={`${BASE}/${clc.section.uid}/`}>all
        {' '}precedents in AI Case Law</a> · <a href="/ai-lawsuits/">the AI lawsuit tracker</a> ·
        {' '}<a href="/ai-compliance/">the governance library</a>.</p>

      <div class="cite-box">Cite this page: <code>"{dcase.case_name}: AI Case Law." The World of
        AI, theworldofai.org{BASE}/{dcase.uid}/. Retrieved {clc.generated}.</code></div>
    </>
  )}

  {isCases && (
    <>
      <h1>AI Case Studies</h1>
      <p class="answer"><b>{sec.total} published accounts of real AI deployments</b>, indexed from
        {' '}{sec.publishers.length} research publishers and refreshed daily, newest first.
        {sec.sectors_tagged > 0 && <> {sec.sectors_tagged} industries are represented.</>} Each
        entry links to the original: this is an index of who has written up what, not a copy of
        their work.</p>
      <p class="meta-line">Last verified: {sec.generated} · Headline, date and link are recorded
        here; the full case study stays on the publisher's own site, where it belongs.</p>
      <p class="meta-line">This list is deliberately short. Sponsored and vendor-funded posts are
        refused outright rather than labelled, and product launches, funding rounds and market
        commentary are filtered out even when they arrive from the same feed, because a page
        called case studies should contain case studies. What is left is an account of a named
        organisation actually deploying AI. Product announcements live on
        {' '}<a href="/ai-news/vendor/">vendor news</a>.</p>

      <section>
        <h2>Where these come from</h2>
        <table class="pay">
          <thead><tr><th>Publisher</th><th>What it publishes</th><th class="num">Indexed</th></tr></thead>
          <tbody>
            {sec.publishers.map((p) => (
              <tr>
                <td><a href={p.home_url} rel="noopener nofollow">{p.name}</a></td>
                <td>{p.what_it_is}</td>
                <td class="num">{p.count}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="meta-line">A publisher whose feed stops responding keeps its existing entries and
          stops gaining new ones, rather than disappearing without explanation.</p>
      </section>

      <section>
        <h2>The index</h2>
        <ol class="cs-list">
          {sec.studies.map((c) => (
            <li>
              <a href={c.url} rel="noopener nofollow">{c.title}</a>
              <div class="meta-line">{c.publisher}{c.posted_on ? ` · ${c.posted_on}` : ''}
                {c.sector && c.sector_url ? <> · <a href={c.sector_url}>{c.sector}</a></> : c.sector ? ` · ${c.sector}` : ''}</div>
              {c.summary && <p class="cs-sum">{c.summary}</p>}
            </li>
          ))}
        </ol>
      </section>

      <p class="meta-line">Related on this site: <a href={`${BASE}/`}>enterprise applications and
        governance</a> · <a href="/industries/">AI by industry</a> ·
        {' '}<a href="/ai-compliance/">the governance library</a>.</p>

      <div class="cite-box">Cite this page: <code>"AI Case Studies." The World of AI,
        theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

</Base>


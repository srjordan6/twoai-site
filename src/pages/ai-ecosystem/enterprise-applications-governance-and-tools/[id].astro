---
/**
 * Enterprise Applications, Governance and Tools: identifier-addressed section
 * pages. First residents: the Industry Use Cases sections, rendered from
 * curated sourced points per industry. A sector with no verifiable primary
 * source beyond the Census adoption series carries less content by design -
 * the page says less rather than inventing case studies.
 */
import Base from '../../../layouts/Base.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

const CATEGORY = 'enterprise-applications-governance-and-tools';
const CATEGORY_NAME = 'Enterprise Applications, Governance and Tools';
const BASE = `/ai-ecosystem/${CATEGORY}`;

export function getStaticPaths() {
  const paths = [];
  if (existsSync('content/industries')) {
    for (const f of readdirSync('content/industries')) {
      if (!f.endsWith('.json')) continue;
      const d = JSON.parse(readFileSync(`content/industries/${f}`, 'utf8'));
      if (d.uid) paths.push({ params: { id: d.uid }, props: { sec: d } });
    }
  }
  if (existsSync('content/security')) {
    for (const f of readdirSync('content/security')) {
      if (!f.endsWith('.json')) continue;
      const d = JSON.parse(readFileSync(`content/security/${f}`, 'utf8'));
      if (d.uid) paths.push({ params: { id: d.uid }, props: { secu: d } });
    }
  }
  return paths;
}
const { sec, secu } = Astro.props;

const desc = secu ? `${secu.blurb}`.slice(0, 300) : `${sec.summary}`.slice(0, 300);
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: secu ? `${secu.name} — AI Security and Risk — The World of AI` : `AI in ${sec.name} — The World of AI`,
  description: desc,
  url: `https://theworldofai.org${BASE}/${(secu || sec).uid}/`,
  dateModified: (secu || sec).generated,
  isPartOf: { '@type': 'CollectionPage', name: CATEGORY_NAME, url: `https://theworldofai.org${BASE}/` },
});
---
<Base title={secu ? `${secu.name} — AI Security and Risk — The World of AI` : `AI in ${sec.name} — The World of AI`} description={desc}
  current={`${BASE}/`} jsonld={jsonld}>

  <p class="meta-line"><a href="/">AI Ecosystem</a> ·
    <a href={`${BASE}/`}>{CATEGORY_NAME}</a></p>

  {secu && (
    <>
      <h1>{secu.name}</h1>
      <p class="answer">{secu.blurb}</p>
      <p class="meta-line">Last verified: {secu.generated} · Part of
        {' '}<a href={`${BASE}/`}>AI Security and Risk</a>. Every entry below carries a source
        that was verified before it was published and is re-verified daily; the spine is
        standards bodies, government agencies, and the labs' own published security research.</p>

      {secu.items.filter((i) => i.kind === 'domain').length > 0 && (
        <div class="dom"><h3>The six domains of the defensive stack</h3>
          {secu.items.filter((i) => i.kind === 'domain').map((i) => (
            <div class="dom">
              <h3>{i.name}</h3>
              <p class="meta-line">{i.note}</p>
            </div>
          ))}
        </div>
      )}

      {secu.items.filter((i) => i.kind !== 'domain').map((i) => (
        <div class="dom">
          <h3>{i.URL || i.source_url ? <a href={i.source_url} rel="noopener">{i.name}</a> : i.name}</h3>
          <p class="meta-line">{i.note}</p>
          <p class="meta-line">Source: {i.source_name}</p>
        </div>
      ))}

      {secu.tax === 'sec-deepfakes' && secu.stats && (
        <p class="meta-line">Live context from this site: <b>{secu.stats.deepfake_bills}</b> state
          bills in the legislation tracker mention deepfakes or synthetic media.</p>
      )}
      {(secu.tax === 'sec-agent-security' || secu.tax === 'sec-prompt-injection') && secu.stats && (
        <p class="meta-line">Live context from this site: <b>{secu.stats.mcp_servers.toLocaleString()}</b> MCP
          servers tracked from the official registry — the agent toolchain this attack surface runs through.</p>
      )}
      {secu.tax === 'sec-shadow-ai' && secu.stats && (
        <p class="meta-line">Live context from this site: <b>{secu.stats.compliance_docs}</b> governance
          documents in the compliance library.</p>
      )}

      <div class="cite-box">Cite this page: <code>"{secu.name}." The World of AI,
        theworldofai.org{BASE}/{secu.uid}/. Retrieved {secu.generated}.</code></div>
    </>
  )}

  {sec && (
    <>
  <h1>AI in {sec.name}</h1>

  <p class="answer">{sec.summary}</p>
  <p class="meta-line">Last verified: {sec.generated} · Every point below carries its own
    source. Where a sector has no verifiable primary source beyond the official adoption
    survey, this page says less rather than inventing case studies.</p>

  {sec.points.map((f) => (
    <div class="dom">
      <h3>{f.name}</h3>
      <p>{f.desc}</p>
      <p class="meta-line"><a href={f.source} rel="noopener">Source</a></p>
    </div>
  ))}

  <p class="meta-line">Related on this site: <a href="/ai-laws/">AI laws by state</a> ·
    <a href="/ai-lawsuits/">the AI lawsuit tracker</a> ·
    <a href="/ai-tools/">the tools directory</a> ·
    <a href="/skills/">the AI skills graph</a>.</p>

  <div class="cite-box">Cite this page: <code>"AI in {sec.name}." The World of AI,
    theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

</Base>

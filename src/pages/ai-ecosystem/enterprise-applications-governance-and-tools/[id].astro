---
/**
 * Enterprise Applications, Governance and Tools: identifier-addressed section
 * pages. First residents: the Industry Use Cases sections, rendered from
 * curated sourced points per industry. A sector with no verifiable primary
 * source beyond the Census adoption series carries less content by design -
 * the page says less rather than inventing case studies.
 */
import Base from '../../../layouts/Base.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

const CATEGORY = 'enterprise-applications-governance-and-tools';
const CATEGORY_NAME = 'Enterprise Applications, Governance and Tools';
const BASE = `/ai-ecosystem/${CATEGORY}`;

export function getStaticPaths() {
  const paths = [];
  if (existsSync('content/industries')) {
    for (const f of readdirSync('content/industries')) {
      if (!f.endsWith('.json')) continue;
      const d = JSON.parse(readFileSync(`content/industries/${f}`, 'utf8'));
      if (d.uid) paths.push({ params: { id: d.uid }, props: { sec: d } });
    }
  }
  if (existsSync('content/security')) {
    for (const f of readdirSync('content/security')) {
      if (!f.endsWith('.json')) continue;
      const d = JSON.parse(readFileSync(`content/security/${f}`, 'utf8'));
      if (d.uid) paths.push({ params: { id: d.uid }, props: { secu: d } });
    }
  }
  return paths;
}
const { sec, secu } = Astro.props;

const desc = secu ? `${secu.blurb}`.slice(0, 300) : `${sec.summary || sec.blurb || ''}`.slice(0, 300);
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: secu ? `${secu.name} — AI Security and Risk — The World of AI` : (sec.shape === 'industry-hub' ? `${sec.name} — The World of AI` : `AI in ${sec.name} — The World of AI`),
  description: desc,
  url: `https://theworldofai.org${BASE}/${(secu || sec).uid}/`,
  dateModified: (secu || sec).generated,
  isPartOf: { '@type': 'CollectionPage', name: CATEGORY_NAME, url: `https://theworldofai.org${BASE}/` },
});
---
<Base title={secu ? `${secu.name} — AI Security and Risk — The World of AI` : `AI in ${sec.name} — The World of AI`} description={desc}
  current={`${BASE}/`} jsonld={jsonld}>

  <p class="meta-line"><a href="/">AI Ecosystem</a> ·
    <a href={`${BASE}/`}>{CATEGORY_NAME}</a></p>

  {sec && sec.shape === 'industry-hub' && (
    <>
      <p class="answer"><b>{sec.total_points} sourced points across {sec.sectors.length} industries</b>,
        every one linked to a verified primary source, with the official US adoption statistic
        updating live below. This page reads across all of them: what the numbers say, what they
        mean, and what holds true from sector to sector.</p>
      <p class="meta-line">Last verified: {sec.generated}</p>

      {sec.metrics && sec.metrics.questions && (
        <section>
          <h2>The official adoption numbers</h2>
          <p class="meta-line">Source: <a href={sec.metrics.page_url} rel="noopener">{sec.metrics.source}</a>,
            updated {sec.metrics.cadence}{sec.metrics.latest_pub ? `, latest release ${sec.metrics.latest_pub}` : ''}.
            Refetched by this site's pipeline on every run; the analysis below regenerates only when these numbers change.</p>
          <table>
            <thead><tr><th>Question</th><th>Answer</th><th>Latest</th><th>Prior period</th><th>First asked (Sept 2023)</th></tr></thead>
            <tbody>
              {sec.metrics.questions.map((q) => {
                const ps = sec.metrics.periods;
                const latest = ps[ps.length - 1], prior = ps[ps.length - 2], first = ps[0];
                return q.answers.map((a, i) => (
                  <tr>
                    {i === 0 && <td rowspan={q.answers.length}>{q.text}</td>}
                    <td>{a.answer}</td>
                    <td><b>{a.series[latest] || ''}</b></td>
                    <td>{a.series[prior] || ''}</td>
                    <td>{a.series[first] || ''}</td>
                  </tr>
                ));
              })}
            </tbody>
          </table>
        </section>
      )}

      {sec.synthesis && (
        <section>
          <h2>What the accumulated sources show</h2>
          {sec.synthesis.body.split('\n\n').map((para) => <p>{para}</p>)}
          <p class="meta-line">Synthesis generated by {sec.synthesis.model} on {sec.synthesis.generated_on},
            from this site's harvest of the sector sources ({sec.sources_read} of {sec.sources_total} source
            pages read on the latest pass) and the Census figures, and nothing else. Every figure is
            verified mechanically against the harvested data before publication; the synthesis regenerates
            when the sources or the numbers change.</p>
        </section>
      )}

      {sec.analysis && (
        <section>
          <h2>What the numbers mean</h2>
          {sec.analysis.body.split('\n\n').map((para) => <p>{para}</p>)}
          <p class="meta-line">Analysis generated by {sec.analysis.model} on {sec.analysis.generated_on},
            from the survey data shown above and nothing else. Every figure in it is verified
            mechanically against the source data before publication; the text regenerates when
            the Census releases new numbers.</p>
        </section>
      )}

      <section>
        <h2>What holds across industries</h2>
        {sec.findings.map((f) => (
          <div class="dom">
            <h3>{f.heading}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </section>

      <section>
        <h2>The {sec.sectors.length} industries</h2>
        <ul class="sections">
          {sec.sectors.map((sx) => (
            <li>
              {sx.path ? <a href={sx.path}>{sx.name}</a> : sx.name}
              <span class="n">{sx.points}</span>
              {sx.blurb && <p>{sx.blurb}</p>}
            </li>
          ))}
        </ul>
      </section>

      <div class="cite-box">Cite this page: <code>"{sec.name}." The World of AI,
        theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

  {secu && secu.shape === 'security-hub' && (
    <>
      <h1>{secu.name}</h1>
      <p class="answer">{secu.blurb}</p>
      <p class="meta-line">Last verified: {secu.generated} · {secu.topic_count} topics, organized
        under the six domains of a security program. The same risk reads differently to governance,
        the SOC, the architects, the product team, vendor risk, and privacy, so each topic appears
        under every domain it genuinely touches.</p>
      {secu.domains.map((d) => (
        <section id={d.slug} class="secdom-group">
          <h2>{d.label}</h2>
          <p>{d.blurb}</p>
          <ul class="sections">
            {d.topics.map((t) => (
              <li>
                {t.path ? <a href={t.path}>{t.name}</a> : t.name}
                {t.blurb && <p>{t.blurb}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))}
      <div class="cite-box">Cite this page: <code>"{secu.name}." The World of AI,
        theworldofai.org{BASE}/{secu.uid}/. Retrieved {secu.generated}.</code></div>
    </>
  )}

  {secu && secu.shape !== 'security-hub' && (
    <>
      <h1>{secu.name}</h1>
      <p class="answer">{secu.blurb}</p>
      <p class="meta-line">Last verified: {secu.generated} · Part of
        {' '}<a href={`${BASE}/`}>AI Security and Risk</a>. Every entry below carries a source
        that was verified before it was published and is re-verified daily; the spine is
        standards bodies, government agencies, and the labs' own published security research.</p>

      {secu.topic && secu.topic.length > 0 && (
        <section class="topic-depth">
          {secu.topic.map((t) => {
            const H = { def: 'What it is', examples: 'What it looks like', detect: 'How to find it', defend: 'How to defend against it' };
            return (
              <div class="dom">
                <h2>{H[t.block] || t.block}</h2>
                <p>{t.body}</p>
              </div>
            );
          })}
        </section>
      )}

      {secu.deep && secu.deep.length > 0 && secu.deep.map((g) => (
        <section>
          <h2>{g.heading}</h2>
          {g.intro && <p>{g.intro}</p>}
          {g.layout === 'ordered' && (
            <ol class="chain">
              {g.blocks.map((b) => <li><b>{b.label}.</b> {b.body}</li>)}
            </ol>
          )}
          {g.layout === 'grid' && (
            <div class="attack-grid">
              {g.blocks.map((b) => (
                <div class="dom"><h3>{b.label}</h3><p>{b.body}</p></div>
              ))}
            </div>
          )}
          {g.layout === 'table' && (
            <table>
              <thead><tr><th>Control</th><th>What it means in practice</th></tr></thead>
              <tbody>
                {g.blocks.map((b) => <tr><td><b>{b.label}</b></td><td>{b.body}</td></tr>)}
              </tbody>
            </table>
          )}
          {g.layout === 'prose' && g.blocks.map((b) => (
            <>{g.blocks.length > 1 && <h3>{b.label}</h3>}<p>{b.body}</p></>
          ))}
        </section>
      ))}

      {secu.domains && secu.domains.length > 0 && (
        <section class="six-domains">
          <h2>How this lands across the six security domains</h2>
          <p class="meta-line">How this topic lands in each domain of the security program.
            The same risk reads differently to governance, the SOC, the architects, the product
            team, vendor risk, and privacy — and a program that only covers one lens leaves the
            others exposed.</p>
          {secu.domains.map((d) => (
            <div class="dom">
              <h3>{d.label}</h3>
              <p>{d.body}</p>
            </div>
          ))}
        </section>
      )}

      {secu.items.filter((i) => i.kind === 'domain').length > 0 && (
        <div class="dom"><h3>The six domains of the defensive stack</h3>
          {secu.items.filter((i) => i.kind === 'domain').map((i) => (
            <div class="dom">
              <h3>{i.name}</h3>
              <p class="meta-line">{i.note}</p>
            </div>
          ))}
        </div>
      )}

      {secu.items.filter((i) => i.kind !== 'domain').length > 0 && (
        <h2>Primary sources and further reading</h2>
      )}
      {secu.items.filter((i) => i.kind !== 'domain').map((i) => (
        <div class="dom">
          <h3>{i.URL || i.source_url ? <a href={i.source_url} rel="noopener">{i.name}</a> : i.name}</h3>
          <p class="meta-line">{i.note}</p>
          <p class="meta-line">Source: {i.source_name}</p>
        </div>
      ))}

      {secu.tax === 'sec-deepfakes' && secu.stats && (
        <p class="meta-line">Live context from this site: <b>{secu.stats.deepfake_bills}</b> state
          bills in the legislation tracker mention deepfakes or synthetic media.</p>
      )}
      {(secu.tax === 'sec-agent-security' || secu.tax === 'sec-prompt-injection') && secu.stats && (
        <p class="meta-line">Live context from this site: <b>{secu.stats.mcp_servers.toLocaleString()}</b> MCP
          servers tracked from the official registry — the agent toolchain this attack surface runs through.</p>
      )}
      {secu.tax === 'sec-shadow-ai' && secu.stats && (
        <p class="meta-line">Live context from this site: <b>{secu.stats.compliance_docs}</b> governance
          documents in the compliance library.</p>
      )}

      <div class="cite-box">Cite this page: <code>"{secu.name}." The World of AI,
        theworldofai.org{BASE}/{secu.uid}/. Retrieved {secu.generated}.</code></div>
    </>
  )}

  {sec && sec.shape !== 'industry-hub' && (
    <>
  <h1>AI in {sec.name}</h1>

  <p class="answer">{sec.summary}</p>
  <p class="meta-line">Last verified: {sec.generated} · Every point below carries its own
    source. Where a sector has no verifiable primary source beyond the official adoption
    survey, this page says less rather than inventing case studies.</p>

  {sec.btos && sec.btos.latest && sec.btos.latest !== 'S' && (
    <div class="dom">
      <h3>The official adoption number for this sector</h3>
      <p><b>{sec.btos.latest}</b> of firms in {sec.btos.label} used AI in the last two
        weeks, per the Census Bureau's Business Trends and Outlook Survey
        {sec.btos.prior && sec.btos.prior !== 'S' ? ` (prior period ${sec.btos.prior}` : ''}{sec.btos.first && sec.btos.prior && sec.btos.prior !== 'S' ? `, ${sec.btos.first} when first asked in September 2023)` : sec.btos.prior && sec.btos.prior !== 'S' ? ')' : ''}.
        Refetched from the <a href="https://www.census.gov/hfp/btos/data" rel="noopener">Census sector file</a> on
        every pipeline run.</p>
    </div>
  )}

  {sec.analysis && (
    <section>
      <h2>The state of AI in {sec.name.toLowerCase()}</h2>
      {sec.analysis.body.split('\n\n').map((para) => <p>{para}</p>)}
      <p class="meta-line">Analysis generated by {sec.analysis.model} on {sec.analysis.generated_on},
        from the Census figure above and this site's harvest of this page's cited sources
        {sec.sources_read ? ` (${sec.sources_read} of ${sec.sources_total} source pages read on the latest pass)` : ''} and
        nothing else; every figure is verified mechanically against the harvested data before
        publication, and the text regenerates when the sources or the numbers change.</p>
    </section>
  )}

  {sec.analysis && <h2>The sourced record</h2>}

  {sec.points.map((f) => (
    <div class="dom">
      <h3>{f.name}</h3>
      <p>{f.desc}</p>
      <p class="meta-line"><a href={f.source} rel="noopener">Source</a></p>
    </div>
  ))}

  <p class="meta-line">Related on this site: <a href="/ai-laws/">AI laws by state</a> ·
    <a href="/ai-lawsuits/">the AI lawsuit tracker</a> ·
    <a href="/ai-tools/">the tools directory</a> ·
    <a href="/skills/">the AI skills graph</a>.</p>

  <div class="cite-box">Cite this page: <code>"AI in {sec.name}." The World of AI,
    theworldofai.org{BASE}/{sec.uid}/. Retrieved {sec.generated}.</code></div>
    </>
  )}

</Base>

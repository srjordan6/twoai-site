---
/**
 * One AI Ecosystem category, listing the domains beneath it.
 *
 * Live domains link to the section that exists. Planned domains are listed
 * with their description and no link, which is the point: the reader can see
 * what is coming and what is missing, and so can we.
 */
import Base from '../../layouts/Base.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

export function getStaticPaths() {
  if (!existsSync('content/ecosystem')) return [];
  return readdirSync('content/ecosystem')
    .filter((f) => f.endsWith('.json') && f !== 'index.json')
    .map((f) => JSON.parse(readFileSync(`content/ecosystem/${f}`, 'utf8')))
    // Only category files carry domains. concept-taxonomy.json and
    // knowledge-graph.json live in this directory but are section pages
    // rendered by uid under Research & Learning; building them here produced
    // duplicate half-pages with undefined names, which the crawl flagged as
    // orphans. Those slugs now 301 to their uid pages in public/_redirects.
    .filter((c) => Array.isArray(c.domains) && c.name)
    .map((c) => ({ params: { category: c.slug }, props: { c } }));
}
const { c } = Astro.props;

/**
 * Curated cross-references between domains that cover the same subject from
 * different angles.
 *
 * The agents domain has ten sections and none of them is governance, because
 * the agent governance material was written under AI Security and Risk: what an
 * agent may spend and trigger, the autonomy tiers it earns, retention of what
 * it remembers. A reader who arrives at agents never sees it, and a reader who
 * arrives at security is not looking for agents. Nothing needs rewriting, the
 * two shelves just need to point at each other.
 *
 * Keyed by domain name rather than slug because the domain rows carry no stable
 * key of their own; if a domain is renamed this quietly stops rendering, which
 * is the failure mode to prefer over linking to the wrong page.
 */
const E = '/ai-ecosystem/enterprise-applications-governance-and-tools';
const CROSS: Record<string, { intro: string; links: { name: string; href: string; note: string }[] }> = {
  'AI Agents and the MCP Ecosystem': {
    intro: 'Governance and security for agents is written under AI Security and Risk rather than here, because it is the same discipline applied to a new subject. The sections that matter most for anyone running agents:',
    links: [
      { name: 'AI Agent Security', href: `${E}/a2538ec1/`,
        note: 'Machine-enforced limits on what an agent may spend, touch and trigger, circuit breakers, autonomy tiers, and the agent kill chain.' },
      { name: 'Agent and Non-Human Identity', href: `${E}/8f3e19cd/`,
        note: 'Credentials, scopes and lifecycle for identities that are not people.' },
      { name: 'AI Privacy and Data Protection', href: `${E}/95ccea74/`,
        note: 'Retention and erasure that reach conversation logs, embeddings and agent memory stores.' },
    ],
  },
};

const live = (c.domains || []).filter((d) => d.status === 'live');
const rest = (c.domains || []).filter((d) => d.status !== 'live');
const desc = `${c.name}: ${c.live} of ${c.total} domains live, ${c.pages} pages published. ${c.blurb}`.slice(0, 300);
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: c.name,
  description: c.blurb,
  url: `https://theworldofai.org/ai-ecosystem/${c.slug}/`,
  dateModified: c.generated,
  isPartOf: {
    '@type': 'CollectionPage',
    name: 'The AI Ecosystem',
    url: 'https://theworldofai.org/',
  },
});
---
{/* Most category names are long enough on their own; "AI News" composes to a
    26-character title that wastes the SERP line, so a short name gets the
    domain count it is actually a category of. */}
<Base title={`${c.name} — The AI Ecosystem`.length < 30
    ? `${c.name}: ${c.total} domains — The AI Ecosystem`
    : `${c.name} — The AI Ecosystem`} description={desc} current="/ai-ecosystem/" jsonld={jsonld}>
  <p class="meta-line"><a href="/">The AI Ecosystem</a></p>
  <h1>{c.name}</h1>
  <p class="answer">{c.blurb} This category holds <b>{c.total} domains</b>, of which
    <b>{c.live} are live</b>{c.pages > 0 && <> across {c.pages.toLocaleString()} published pages</>}.</p>
  {c.generated && <p class="meta-line">Last verified: {c.generated}</p>}

  {live.length > 0 && (
    <>
      <h2>Live now</h2>
      {live.map((d) => (
        <div class="dom">
          <h3>{d.path ? <a href={d.path}>{d.name}</a> : d.name}
            {d.pages > 0 && <span class="n">{d.pages.toLocaleString()}</span>}</h3>
          <p>{d.blurb}</p>
          {d.sections?.length > 0 && (
            <ul class="sections">
              {d.sections.map((s) => (
                <li>
                  {s.status === 'live' && s.path
                    ? <a href={s.path}>{s.name}</a>
                    : <span class="muted">{s.name}</span>}
                  {s.pages > 0 && <span class="n">{s.pages.toLocaleString()}</span>}
                  {s.blurb && <p>{s.blurb}</p>}
                </li>
              ))}
            </ul>
          )}
          {CROSS[d.name] && (
            <div class="cross">
              <p class="cross-label">Related coverage elsewhere on this site</p>
              <p class="cross-intro">{CROSS[d.name].intro}</p>
              <ul>
                {CROSS[d.name].links.map((l) => (
                  <li><a href={l.href}>{l.name}</a><span>{l.note}</span></li>
                ))}
              </ul>
            </div>
          )}
        </div>
      ))}
    </>
  )}

  {rest.length > 0 && (
    <>
      <h2>Coverage roadmap</h2>
      <p class="meta-line">Coverage this atlas has mapped and not yet published. Every section here
        ships only when a traceable source backs it.</p>
      {rest.map((d) => (
        <div class="dom planned">
          <h3>{d.name} <span class="tag">{d.status}</span></h3>
          <p>{d.blurb}</p>
          {d.sections?.length > 0 && (
            <p class="planned-sections">{d.sections.map((s, i) => (
              <>{i > 0 && ' · '}{s.name}</>
            ))}</p>
          )}
        </div>
      ))}
    </>
  )}
</Base>

<style>
  .cross { background: var(--cream, #FFF6EC); border: 1px solid #F0D6B0; border-radius: 6px;
    padding: 18px 22px; margin: 1.6em 0; max-width: 780px; }
  .cross-label { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: #F07800; margin: 0 0 .5em; }
  .cross-intro { margin: 0 0 .8em; color: #3d3d46; }
  .cross ul { list-style: none; margin: 0; padding: 0; }
  .cross li { padding: .4em 0; border-bottom: 1px solid #F0D6B0; }
  .cross li:last-child { border-bottom: 0; }
  .cross a { color: var(--navy); font-weight: 600; text-decoration: none; }
  .cross a:hover { color: #F07800; }
  .cross span { display: block; font-size: .89rem; color: #6b6b78; margin-top: .15em; }

  .sections { list-style: none; margin: .6em 0 0; padding: 0 0 0 1em; border-left: 2px solid #ececf2; }
  .sections li { margin-bottom: .55em; }
  .sections li p { margin: .1em 0 0; font-size: .9rem; color: #6b6b78; }
  .sections .muted { color: #6b6b78; }
  .planned-sections { margin: .35em 0 0; font-size: .87rem; color: #8a8a96; }
  .dom { padding: .95em 0; border-bottom: 1px solid #ececf2; }
  .dom:last-of-type { border-bottom: 0; }
  .dom h3 { margin: 0 0 .3em; font-size: 1.03rem; }
  .dom p { margin: 0; color: #3d3d46; }
  .dom.planned h3, .dom.planned p { color: #6b6b78; }
  .n, .tag {
    display: inline-block; margin-left: .4em; padding: 1px 8px;
    background: var(--cream); border-radius: 10px;
    font-size: .78rem; font-weight: 600; color: var(--navy);
  }
  .tag { background: #f0f0f5; color: #6b6b78; text-transform: lowercase; }
</style>

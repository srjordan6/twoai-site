---
/**
 * Research library hub at /research/.
 *
 * The AI Research and Publications shelf: ten topical shelves that together
 * catalogue the papers the field cites most, each with a plain note that says
 * why it belongs on that shelf. Reads live from content/research/index.json,
 * which fetch-content.mjs writes from twoai_pages at build time.
 */
import Base from '../../layouts/Base.astro';
import { readFileSync, existsSync } from 'node:fs';

const hub = existsSync('content/research/index.json')
  ? JSON.parse(readFileSync('content/research/index.json', 'utf8'))
  : { topics: [], most_cited: [], total: 0, generated: '', last_added: '' };
const topics = hub.topics ?? [];
const cited = hub.most_cited ?? [];
const total = hub.total ?? 0;
const desc = `${total} papers curated across ${topics.length} topics in artificial intelligence research, each with a plain note on why it matters. Updated ${hub.last_added || hub.generated || 'daily'}.`;
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'AI Research Library',
  description: desc,
  url: 'https://theworldofai.org/research/',
  dateModified: hub.last_added || hub.generated,
  isPartOf: {
    '@type': 'CollectionPage',
    name: 'The AI Ecosystem',
    url: 'https://theworldofai.org/ai-ecosystem/research-knowledge-and-learning/',
  },
});
---
<Base title={`AI Research Library: ${total} curated papers across ${topics.length} topics — The World of AI`} description={desc} current="/research/" jsonld={jsonld}>
  <p class="meta-line"><a href="/ai-ecosystem/research-knowledge-and-learning/">Research, Knowledge and Learning</a></p>
  <h1>AI Research Library</h1>
  <p class="answer">A curated shelf of the artificial intelligence papers the field cites, organised into
    <b>{topics.length} topics</b> covering <b>{total} papers</b> in total. Each paper carries a plain
    note that says why it is here, so a reader can decide whether to open the PDF before opening it.</p>
  {(hub.last_added || hub.generated) && (
    <p class="meta-line">Last added: {hub.last_added || hub.generated}</p>
  )}

  {topics.length > 0 && (
    <>
      <h2>Topics</h2>
      <ul class="grid">
        {topics.map((t) => (
          <li class="card">
            <a href={`/research/${t.slug}/`}>{t.name}</a>
            <p>{t.count} paper{t.count === 1 ? '' : 's'}</p>
          </li>
        ))}
      </ul>
    </>
  )}

  {cited.length > 0 && (
    <>
      <h2>Most cited across all topics</h2>
      <ol class="cited">
        {cited.map((p) => (
          <li>
            <a href={p.url} rel="noopener nofollow">{p.title}</a>
            <p class="meta-line">
              {p.authors}{p.journal ? `, ${p.journal}` : ''}{p.year ? `, ${p.year}` : ''}
              {typeof p.citations === 'number' && <> · <b>{p.citations.toLocaleString()} citations</b></>}
              {p.topic && <> · <a href={`/research/${p.topic}/`}>{p.topic.replace(/-/g, ' ')}</a></>}
            </p>
            {p.note && <p class="note">{p.note}</p>}
          </li>
        ))}
      </ol>
    </>
  )}

  {topics.length === 0 && (
    <p>The research library is being assembled and will appear here shortly.</p>
  )}
</Base>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: .85em; }
  .card { padding: .8em .95em; border: 1px solid #ececf2; border-radius: 8px; background: #fff; }
  .card a { font-weight: 600; text-decoration: none; }
  .card p { margin: .3em 0 0; font-size: .87rem; color: #6b6b78; }
  .cited { list-style: decimal; padding-left: 1.4em; }
  .cited li { margin-bottom: 1.1em; }
  .cited li a { font-weight: 600; }
  .cited .note { margin: .35em 0 0; color: #4a4a55; font-size: .95rem; }
</style>

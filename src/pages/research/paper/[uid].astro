---
/**
 * One AI research paper page at /research/paper/{uid}/.
 *
 * Reads content/research/paper/{uid}.json, which the pipeline writes from
 * twoai_research_papers (one row per paper). Fixed layout: title and paper
 * type, then year, authors, journal, volume and DOI in a facts strip, then
 * the abstract with attribution when one exists, then up to three plain-
 * English explanations for a beginner, a practitioner and a business reader.
 *
 * A missing field renders NOTHING, not a promise. This page used to print
 * "has not been added yet" and "is being written by our scheduled research
 * task" for every absent block, and on 2026-08-29, with 129 of 134 papers
 * still unwritten, AdSense flagged the site for low value content, the
 * under-construction verdict. Placeholder text on a published page is an
 * announcement that the page should not have been published. The page now
 * says what it has; a paper with no abstract and no explanations renders
 * noindex, and astro.config keeps it out of the sitemap so the two signals
 * agree, the same containment the MCP pages use. The content itself arrives
 * from the scheduled research task; when a paper gains its first block, the
 * page indexes again automatically on the next build.
 */
import Base from '../../../layouts/Base.astro';
import Reading from '../../../components/Reading.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

export function getStaticPaths() {
  const dir = 'content/research/paper';
  if (!existsSync(dir)) return [];
  return readdirSync(dir)
    .filter((f) => f.endsWith('.json'))
    .map((f) => JSON.parse(readFileSync(`${dir}/${f}`, 'utf8')))
    .filter((p) => p && p.uid)
    .map((p) => ({ params: { uid: p.uid }, props: { p } }));
}

const { p } = Astro.props;
const doiUrl = p.doi ? `https://doi.org/${p.doi}` : '';
const abstract = (p.abstract || '').trim();
const beg = (p.explain_beginner || '').trim();
const prac = (p.explain_practitioner || '').trim();
const biz = (p.explain_business || '').trim();
const paperType = p.paper_type || 'Journal Article';
// A paper with none of its written blocks is a catalogue entry, not an
// article. It stays reachable and linked, but it is not advertised: noindex
// here, and the matching sitemap exclusion lives in astro.config.mjs.
const thin = !abstract && !beg && !prac && !biz;
const anyExplain = !!(beg || prac || biz);

const authors = (p.authors || '').trim();
const authorList = authors ? authors.split(/\s*,\s*|\s+and\s+/).filter(Boolean) : [];
const authorCount = authorList.length;

const desc = (abstract || p.note || `${p.title} by ${authors || 'unknown authors'}.`).slice(0, 158);

// Paper titles routinely run past any sensible title-tag length; clamp the
// whole tag to 65 characters, cutting the paper title at a word boundary and
// keeping a short suffix so the tag still says whose page it is.
const tSuffix = ' — AI Research';
const tMax = 65 - tSuffix.length;
const tHead = p.title.length <= tMax ? p.title : `${p.title.slice(0, tMax - 1).replace(/\s+\S*$/, '')}…`;
const pageTitle = `${tHead}${tSuffix}`;

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: p.title,
  name: p.title,
  author: authorList.map((n) => ({ '@type': 'Person', name: n })),
  datePublished: p.year ? String(p.year) : undefined,
  isPartOf: p.journal ? { '@type': 'Periodical', name: p.journal, volumeNumber: p.volume || undefined } : undefined,
  identifier: p.doi ? { '@type': 'PropertyValue', propertyID: 'DOI', value: p.doi } : undefined,
  url: `https://theworldofai.org/research/paper/${p.uid}/`,
  abstract: abstract || undefined,
  dateModified: p.generated,
});
---
<Base title={pageTitle} description={desc} current="/research/" jsonld={jsonld} ogType="article" noindex={thin}>
  <p class="meta-line">
    <a href="/research/">AI Research Library</a>
    {p.topic_slug && p.topic_name && (
      <> · <a href={`/research/${p.topic_slug}/`}>{p.topic_name}</a></>
    )}
  </p>

  <h1>{p.title}</h1>

  <table class="facts">
    <tbody>
      <tr><th>Type</th><td>{paperType}</td></tr>
      {p.year > 0 && <tr><th>Year</th><td>{p.year}</td></tr>}
      {authors && (
        <tr>
          <th>Authors{authorCount > 0 ? ` (${authorCount})` : ''}</th>
          <td>{authors}</td>
        </tr>
      )}
      {p.journal && <tr><th>Journal</th><td>{p.journal}</td></tr>}
      {p.volume && <tr><th>Volume</th><td>{p.volume}</td></tr>}
      {p.doi && (
        <tr>
          <th>DOI</th>
          <td><a href={doiUrl} rel="noopener">{p.doi}</a></td>
        </tr>
      )}
      {typeof p.citations === 'number' && p.citations > 0 && (
        <tr><th>Citations</th><td>{p.citations.toLocaleString()}</td></tr>
      )}
    </tbody>
  </table>

  {/* THE ABSTRACT HEADING ONLY EXISTS WHEN THERE IS AN ABSTRACT.

      The 2026-08-29 fix removed the placeholder sentences from this page but
      left this heading unconditional, so 129 of 135 papers still published a
      section called Abstract whose entire content was a link out to the
      publisher. That is the same fault one field further in: a labelled empty
      section is a promise the page does not keep, and it is what an AdSense
      reviewer sampling the research library sees 129 times in a row.

      The source link is not part of the abstract and does not belong under
      that heading when there is nothing to attribute. It moves to the foot of
      the page, where a paper page should point at the publisher anyway.

      Verified before this change rather than assumed: 129 of 135 rows in
      twoai_research_papers still have an empty abstract, all 135 are in the
      live sitemap, and the three sampled pages returned 200 and indexable at
      649 to 802 words. They index because the explanations DID get written -
      the thin test asks for any block, and the explanations satisfy it - so
      the containment is working as designed and only the empty heading is
      wrong. */}
  {abstract && (
    <>
      <h2>Abstract</h2>
      <p class="abstract">{abstract}</p>
      <p class="attribution">
        Read the <a href={p.url} rel="noopener">source paper</a> at the
        original publisher.
      </p>
    </>
  )}

  {anyExplain && (
    <>
      <h2>Three ways to read this paper</h2>

      {beg && (
        <section class="explain">
          <h3>For a beginner</h3>
          <p>{beg}</p>
        </section>
      )}

      {prac && (
        <section class="explain">
          <h3>For a practitioner</h3>
          <p>{prac}</p>
        </section>
      )}

      {biz && (
        <section class="explain">
          <h3>For a business reader</h3>
          <p>{biz}</p>
        </section>
      )}
    </>
  )}

  {p.note && (
    <>
      <h2>Editor&apos;s note</h2>
      <p>{p.note}</p>
    </>
  )}

  <Reading reading={p.reading} heading="Why does this paper matter?" />

  <div class="cite-box">
    Cite this paper on The World of AI: <code>{authors || 'Author(s)'}{p.year ? `. (${p.year}).` : '.'} {p.title}.{p.journal ? ` ${p.journal}` : ''}{p.volume ? `, ${p.volume}` : ''}.{p.doi ? ` https://doi.org/${p.doi}` : ''} Cataloged at theworldofai.org/research/paper/{p.uid}/.{p.generated ? ` Verified ${p.generated}.` : ''}</code>
  </div>

  {/* The source link, for a paper with no abstract to carry it. A paper page
      must always point at the publisher: the DOI row does it when there is a
      DOI, but 129 papers have no abstract and not all of them have a DOI
      either, so removing the empty Abstract block above would otherwise take
      the only outbound link with it. Rendered only when the abstract block
      did not already render it, so no page shows it twice. */}
  {!abstract && p.url && (
    <p class="meta-line">
      Read the <a href={p.url} rel="noopener">source paper</a> at the original publisher.
    </p>
  )}

  <p class="meta-line">
    Every source cited on this site is indexed on our <a href="/sources/">Sources page</a>.
  </p>
</Base>

<style>
  h1 { margin-bottom: .3em; }
  .facts { width: 100%; margin: 1.2em 0 2em; border-collapse: collapse; }
  .facts th, .facts td { text-align: left; padding: .55em .8em; vertical-align: top; border-bottom: 1px solid #ececf2; }
  .facts th { width: 12em; color: #6b6b78; font-weight: 600; font-size: .92rem; }
  .facts td { font-size: .95rem; }
  h2 { margin-top: 1.6em; }
  h3 { margin-top: 1.2em; margin-bottom: .3em; font-size: 1.05rem; color: #201868; }
  .abstract { line-height: 1.55; }
  .attribution { margin-top: .5em; color: #6b6b78; font-size: .9rem; padding: .6em .8em; background: #f7f7fb; border-left: 3px solid #F07800; }
  .pending { color: #6b6b78; font-style: italic; }
  .explain { margin: 1em 0; }
  .explain p { margin: 0; line-height: 1.55; }
  .cite-box { margin-top: 2em; padding: .9em 1em; background: #f7f7fb; border-left: 3px solid #201868; font-size: .9rem; }
  .cite-box code { display: block; margin-top: .35em; font-family: ui-monospace, monospace; color: #201868; white-space: normal; }
</style>

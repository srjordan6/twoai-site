---
import Base from '../../layouts/Base.astro';
import { readFileSync, existsSync } from 'node:fs';

// Question set and dropdown options are generated by the pipeline from the
// same SQL that drives the tools directory, the model catalog, and the
// compliance library, so the form's choices update themselves when the site's
// own data does. If the file has not been published yet the form still
// renders; the questions section explains it is briefly unavailable.
const opts = existsSync('content/talent/options.json')
  ? JSON.parse(readFileSync('content/talent/options.json', 'utf8'))
  : { questions: [] };

const TURNSTILE_SITEKEY = '0x4AAAAAAEXO3e0E3BMHmG2x';
const desc = 'Create a free profile on the AI Talent Network: your AI skills, tools, and governance experience, published for employers to find. Email-confirmed, human-reviewed, first name only.';
const jsonld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'WebPage',
  name: 'Join the AI Talent Network', url: 'https://theworldofai.org/talent/join/',
  isPartOf: { '@type': 'WebSite', name: 'The World of AI', url: 'https://theworldofai.org/' },
});
---
<Base title="Join the AI Talent Network — The World of AI" description={desc} current="/talent/" jsonld={jsonld}>
  <h1>Join the AI Talent Network</h1>
  <p class="answer">A free listing of people who work with AI: the models, frameworks, and
    governance standards you have real experience with, published so employers can find you.
    Your profile shows your <b>first name only</b> plus a profile id. Your email address and
    resume are never published, and employers reach you through our relay, so there is
    nothing on the page to scrape. Every profile is confirmed by email and reviewed by a
    person before it appears.</p>

  <div id="step-signup" class="talent-card">
    <h2>Step 1: confirm your email</h2>
    <p>Enter your address and we send a link that opens the full profile form. The address
      is for confirmation, renewal reminders, and relayed employer contact only.</p>
    <label>Email address <input type="email" id="t-email" autocomplete="email" maxlength="254" /></label>
    <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY}></div>
    <button id="t-signup-btn" type="button">Send confirmation link</button>
    <p id="t-signup-msg" class="t-msg" role="status"></p>
  </div>

  <div id="step-form" class="talent-card" hidden>
    <h2>Step 2: your profile</h2>
    <p>Signed in as <b id="t-whoami"></b> — profile id <b id="t-taiid"></b>. Nothing here is
      required, but the more you fill in, the more findable you are. Every skills question
      allows multiple choices, N/A, and Other.</p>

    <h3>About you</h3>
    <div class="p-grid">
      <label>First name <span class="hint">the only name shown publicly</span>
        <input id="p-first_name" maxlength="60" autocomplete="given-name" /></label>
      <label>Headline <span class="hint">one line on what you do</span>
        <input id="p-headline" maxlength="140" placeholder='"RAG systems engineer, healthcare"' /></label>
      <label>Location <span class="hint">any country, or remote</span>
        <input id="p-location" maxlength="80" placeholder='"Dallas, TX", "London, UK", "Remote, worldwide"' /></label>
      <label>Availability
        <select id="p-availability">
          <option value="">Prefer not to say</option>
          <option value="open">Open to work</option>
          <option value="freelance">Freelance / contract</option>
          <option value="not-looking">Not looking right now</option>
        </select>
      </label>
      <label>Rate or salary range <span class="hint">any currency</span>
        <input id="p-rate" maxlength="60" placeholder='"$120/hr", "€90/hr", "£95k+"' /></label>
    </div>

    <h3>Your AI experience</h3>
    <div id="t-questions">
      {opts.questions.length === 0 && (
        <p class="t-msg">The skills questions are briefly unavailable. You can submit the
          profile section now and add skills when you reopen your link.</p>
      )}
    </div>

    <h3>Your resume (published without your identity)</h3>
    <p>This is what employers see. It appears on your public page and in the downloadable
      PDF <b>with your last name, street address, phone, and email removed</b> — first name
      only, contact through the relay. Add each job and each degree separately. Paste your
      resume text and Autofill takes a first pass at the fields; check everything after,
      it is a best effort, not magic.</p>
    <label class="bg-label">Paste your resume text
      <textarea id="t-paste" rows="4" placeholder="Paste the full text of your resume here, then press Autofill."></textarea></label>
    <button id="t-autofill-btn" type="button" class="t-secondary">Autofill from pasted text</button>
    <p id="t-paste-msg" class="t-msg" role="status"></p>

    <label class="bg-label">Professional summary
      <textarea id="p-summary" rows="4" maxlength="2000" placeholder="A few sentences on what you do and what you're best at."></textarea></label>

    <h4>Work experience</h4>
    <div id="jobs-list"></div>
    <button id="job-add" type="button" class="t-secondary">+ Add a job</button>

    <h4>Education</h4>
    <div id="edu-list"></div>
    <button id="edu-add" type="button" class="t-secondary">+ Add education</button>

    <label class="bg-label" style="margin-top:1rem">Certifications
      <textarea id="p-certifications" rows="3" maxlength="2000" placeholder="One per line, e.g. Certified ScrumMaster (CSM), Scrum Alliance — 2021"></textarea></label>
    <label class="bg-label">Publications, patents, talks
      <textarea id="p-publications" rows="3" maxlength="4000"></textarea></label>
    <label class="bg-label">Awards and recognition
      <textarea id="p-awards" rows="3" maxlength="2000"></textarea></label>
    <button id="t-save-btn" type="button">Save progress</button>
    <p id="t-save-msg" class="t-msg" role="status"></p>

    <h3>Contact details (only in your full-contact resume)</h3>
    <p>Never shown on your public page. These appear only in the resume download, and the
      public copy carries them only if you tick the share box below. Any country's
      formats are fine.</p>
    <div class="p-grid">
      <label>First name <input id="pii-name_first" maxlength="60" autocomplete="given-name" /></label>
      <label>Middle name <input id="pii-name_middle" maxlength="60" autocomplete="additional-name" /></label>
      <label>Last name <input id="pii-name_last" maxlength="60" autocomplete="family-name" /></label>
      <label>Contact email <span class="hint">your verified signup address</span>
        <input id="pii-contact_email" maxlength="254" readonly class="locked" title="This is the address you verified at signup. It cannot be changed here." /></label>
    </div>
    <label class="q-label" style="margin-top:.4rem">Phone</label>
    <div class="ph-row">
      <select id="pii-phone_cc" aria-label="Country calling code"></select>
      <input id="pii-phone_area" maxlength="10" inputmode="numeric" placeholder="Area / city code" aria-label="Area or city code" />
      <input id="pii-phone_num" maxlength="20" inputmode="tel" placeholder="Number" aria-label="Phone number" />
    </div>
    <label class="q-label" style="margin-top:.6rem">Address</label>
    <div class="p-grid">
      <label>Street address <input id="pii-addr_street" maxlength="160" autocomplete="street-address" /></label>
      <label>City <input id="pii-addr_city" maxlength="80" autocomplete="address-level2" /></label>
      <label>State / province / region <input id="pii-addr_region" maxlength="80" autocomplete="address-level1" /></label>
      <label>Postal / ZIP code <input id="pii-addr_postal" maxlength="20" autocomplete="postal-code" /></label>
      <label>Country <input id="pii-country" maxlength="60" autocomplete="country-name" /></label>
    </div>
    <div class="p-grid">
      <label>Link <span class="hint">LinkedIn, GitHub, or site</span>
        <input id="pii-link1" maxlength="200" placeholder="https://…" /></label>
      <label>Link <input id="pii-link2" maxlength="200" placeholder="https://…" /></label>
      <label>Link <input id="pii-link3" maxlength="200" placeholder="https://…" /></label>
    </div>

    <h3>Headshot (optional)</h3>
    <p>JPEG or PNG up to 2 MB. Shown on your public page once the profile is live;
      remove it any time by uploading a replacement or asking us.</p>
    <input type="file" id="t-photo" accept="image/jpeg,image/png" />
    <p id="t-photo-msg" class="t-msg" role="status"></p>

    <h3>Your public page and resume PDF</h3>
    <p>Once approved, your profile lives at
      <b>theworldofai.org/talent/<span id="t-pageid">…</span>/</b> — share that link
      anywhere. The page shows your first name only. You can generate your full resume
      as a PDF right now with the button below, and separately choose whether employers
      can download it from your public page.</p>
    <button id="t-pdf-btn" type="button" class="t-secondary">Download my resume (PDF)</button>
    <button id="t-docx-btn" type="button" class="t-secondary">Download my resume (Word)</button>
    <label class="q-opt" style="margin-top:.6rem"><input type="checkbox" id="p-share_pdf" />
      <span>Allow employers to download my full resume PDF (with my contact details) from my
      public page. Off means the page stays first-name-only with relay contact.</span></label>

    <h3>Account password</h3>
    <p>Set one to log back in at <b>theworldofai.org/talent/login/</b> and edit your
      profile any time. Your email link keeps working either way.</p>
    <div class="p-grid">
      <label>Password <span class="hint">at least 10 characters</span>
        <input type="password" id="t-pw1" maxlength="200" autocomplete="new-password" /></label>
      <label>Repeat password <input type="password" id="t-pw2" maxlength="200" autocomplete="new-password" /></label>
    </div>
    <p id="t-pw-msg" class="t-msg" role="status"></p>

    <h3>Original resume file (optional, kept private)</h3>
    <p>PDF up to 5 MB. This file itself is never shown publicly — it is used to verify
      your profile. What employers see is the structured resume above, published without
      your last name or contact details.</p>
    <input type="file" id="t-resume" accept="application/pdf" />
    <p id="t-resume-msg" class="t-msg" role="status"></p>

    <button id="t-submit-btn" type="button">Submit profile for review</button>
    <p id="t-submit-msg" class="t-msg" role="status"></p>
    <p class="meta-line">Profiles renew by email every 30 days; unanswered reminders remove
      the profile and erase the personal data behind it. Listing is open to people 18 and
      over. Contact from employers is relayed through theworldofai@inkboxmail.com with your
      profile id in the subject.</p>
  </div>

  <script type="application/json" id="t-options" set:html={JSON.stringify(opts.questions || [])} />
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    const $ = (id) => document.getElementById(id);
    const api = (p) => `/api/talent/${p}`;
    const QUESTIONS = JSON.parse($('t-options').textContent || '[]');
    let TOKEN = new URLSearchParams(location.search).get('t') || '';

    function say(id, text, ok) {
      const el = $(id); el.textContent = text; el.style.color = ok ? '#1a7f37' : '#b42318';
    }

    // ITU country calling codes, every assigned code. Values are the +code;
    // labels carry the place names so the list is searchable by typing.
    const CALLING_CODES = [
      ['+1','US / Canada'],['+7','Russia / Kazakhstan'],['+20','Egypt'],['+27','South Africa'],
      ['+30','Greece'],['+31','Netherlands'],['+32','Belgium'],['+33','France'],['+34','Spain'],
      ['+36','Hungary'],['+39','Italy'],['+40','Romania'],['+41','Switzerland'],['+43','Austria'],
      ['+44','United Kingdom'],['+45','Denmark'],['+46','Sweden'],['+47','Norway'],['+48','Poland'],
      ['+49','Germany'],['+51','Peru'],['+52','Mexico'],['+53','Cuba'],['+54','Argentina'],
      ['+55','Brazil'],['+56','Chile'],['+57','Colombia'],['+58','Venezuela'],['+60','Malaysia'],
      ['+61','Australia'],['+62','Indonesia'],['+63','Philippines'],['+64','New Zealand'],
      ['+65','Singapore'],['+66','Thailand'],['+81','Japan'],['+82','South Korea'],['+84','Vietnam'],
      ['+86','China'],['+90','Türkiye'],['+91','India'],['+92','Pakistan'],['+93','Afghanistan'],
      ['+94','Sri Lanka'],['+95','Myanmar'],['+98','Iran'],['+211','South Sudan'],['+212','Morocco'],
      ['+213','Algeria'],['+216','Tunisia'],['+218','Libya'],['+220','Gambia'],['+221','Senegal'],
      ['+222','Mauritania'],['+223','Mali'],['+224','Guinea'],['+225','Côte d\u2019Ivoire'],
      ['+226','Burkina Faso'],['+227','Niger'],['+228','Togo'],['+229','Benin'],['+230','Mauritius'],
      ['+231','Liberia'],['+232','Sierra Leone'],['+233','Ghana'],['+234','Nigeria'],['+235','Chad'],
      ['+236','Central African Republic'],['+237','Cameroon'],['+238','Cabo Verde'],
      ['+239','São Tomé and Príncipe'],['+240','Equatorial Guinea'],['+241','Gabon'],
      ['+242','Congo'],['+243','DR Congo'],['+244','Angola'],['+245','Guinea-Bissau'],
      ['+246','Diego Garcia'],['+248','Seychelles'],['+249','Sudan'],['+250','Rwanda'],
      ['+251','Ethiopia'],['+252','Somalia'],['+253','Djibouti'],['+254','Kenya'],
      ['+255','Tanzania'],['+256','Uganda'],['+257','Burundi'],['+258','Mozambique'],
      ['+260','Zambia'],['+261','Madagascar'],['+262','Réunion / Mayotte'],['+263','Zimbabwe'],
      ['+264','Namibia'],['+265','Malawi'],['+266','Lesotho'],['+267','Botswana'],
      ['+268','Eswatini'],['+269','Comoros'],['+290','Saint Helena'],['+291','Eritrea'],
      ['+297','Aruba'],['+298','Faroe Islands'],['+299','Greenland'],['+350','Gibraltar'],
      ['+351','Portugal'],['+352','Luxembourg'],['+353','Ireland'],['+354','Iceland'],
      ['+355','Albania'],['+356','Malta'],['+357','Cyprus'],['+358','Finland'],['+359','Bulgaria'],
      ['+370','Lithuania'],['+371','Latvia'],['+372','Estonia'],['+373','Moldova'],
      ['+374','Armenia'],['+375','Belarus'],['+376','Andorra'],['+377','Monaco'],
      ['+378','San Marino'],['+380','Ukraine'],['+381','Serbia'],['+382','Montenegro'],
      ['+383','Kosovo'],['+385','Croatia'],['+386','Slovenia'],['+387','Bosnia and Herzegovina'],
      ['+389','North Macedonia'],['+420','Czechia'],['+421','Slovakia'],['+423','Liechtenstein'],
      ['+500','Falkland Islands'],['+501','Belize'],['+502','Guatemala'],['+503','El Salvador'],
      ['+504','Honduras'],['+505','Nicaragua'],['+506','Costa Rica'],['+507','Panama'],
      ['+508','Saint Pierre and Miquelon'],['+509','Haiti'],['+590','Guadeloupe'],
      ['+591','Bolivia'],['+592','Guyana'],['+593','Ecuador'],['+594','French Guiana'],
      ['+595','Paraguay'],['+596','Martinique'],['+597','Suriname'],['+598','Uruguay'],
      ['+599','Curaçao / Caribbean NL'],['+670','Timor-Leste'],['+672','Norfolk Island / Antarctica'],
      ['+673','Brunei'],['+674','Nauru'],['+675','Papua New Guinea'],['+676','Tonga'],
      ['+677','Solomon Islands'],['+678','Vanuatu'],['+679','Fiji'],['+680','Palau'],
      ['+681','Wallis and Futuna'],['+682','Cook Islands'],['+683','Niue'],['+685','Samoa'],
      ['+686','Kiribati'],['+687','New Caledonia'],['+688','Tuvalu'],['+689','French Polynesia'],
      ['+690','Tokelau'],['+691','Micronesia'],['+692','Marshall Islands'],['+850','North Korea'],
      ['+852','Hong Kong'],['+853','Macao'],['+855','Cambodia'],['+856','Laos'],
      ['+880','Bangladesh'],['+886','Taiwan'],['+960','Maldives'],['+961','Lebanon'],
      ['+962','Jordan'],['+963','Syria'],['+964','Iraq'],['+965','Kuwait'],['+966','Saudi Arabia'],
      ['+967','Yemen'],['+968','Oman'],['+970','Palestine'],['+971','United Arab Emirates'],
      ['+972','Israel'],['+973','Bahrain'],['+974','Qatar'],['+975','Bhutan'],['+976','Mongolia'],
      ['+977','Nepal'],['+992','Tajikistan'],['+993','Turkmenistan'],['+994','Azerbaijan'],
      ['+995','Georgia'],['+996','Kyrgyzstan'],['+998','Uzbekistan'],
    ];
    (() => {
      const sel = $('pii-phone_cc');
      const none = document.createElement('option');
      none.value = ''; none.textContent = 'Code…';
      sel.appendChild(none);
      for (const [code, label] of CALLING_CODES) {
        const o = document.createElement('option');
        o.value = code; o.textContent = `${code} ${label}`;
        sel.appendChild(o);
      }
    })();

    // Each question is a dropdown: a closed control showing what is chosen,
    // opening to a scrollable checkbox panel with a filter box for the long
    // lists (the governance question carries 60+ frameworks). The choices
    // themselves still come from the pipeline-published options.json, i.e.
    // from the site's own catalogs in SQL.
    function summarize(q) {
      const sel = [...document.querySelectorAll(`input[data-q="${CSS.escape(q.key)}"]:checked`)].map((i) => i.value);
      const na = !!document.querySelector(`input[data-qna="${CSS.escape(q.key)}"]:checked`);
      const other = (document.querySelector(`input[data-qother="${CSS.escape(q.key)}"]`) || {}).value || '';
      const parts = [...sel];
      if (other.trim()) parts.push('Other');
      let text = 'Select all that apply…';
      if (na && parts.length === 0) text = 'N/A';
      else if (parts.length > 0) {
        text = parts.slice(0, 3).join(', ');
        if (parts.length > 3) text += ` +${parts.length - 3} more`;
        if (na) text += ', N/A';
      }
      const sumEl = document.querySelector(`.msel[data-key="${CSS.escape(q.key)}"] .msel-value`);
      if (sumEl) { sumEl.textContent = text; sumEl.classList.toggle('placeholder', text === 'Select all that apply…'); }
    }

    function renderQuestions(saved) {
      const host = $('t-questions');
      for (const q of QUESTIONS) {
        const prev = (saved && saved[q.key]) || { selections: [], na: false, other: '' };
        const wrap = document.createElement('div');
        wrap.className = 'q-row';
        const esc = (v) => v.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        const opts = q.options.map((o) =>
          `<label class="q-opt"><input type="checkbox" data-q="${esc(q.key)}" value="${esc(o)}"${prev.selections.includes(o) ? ' checked' : ''}/> <span>${esc(o)}</span></label>`
        ).join('');
        const filter = q.options.length > 12
          ? `<input class="msel-filter" type="search" placeholder="Type to filter…" aria-label="Filter options" />`
          : '';
        wrap.innerHTML = `<span class="q-label">${esc(q.label)}</span>
          <details class="msel" data-key="${esc(q.key)}">
            <summary><span class="msel-value placeholder">Select all that apply…</span><span class="msel-caret" aria-hidden="true">▾</span></summary>
            <div class="msel-panel">
              ${filter}
              <div class="msel-list">${opts}</div>
              <div class="msel-foot">
                <label class="q-opt"><input type="checkbox" data-qna="${esc(q.key)}"${prev.na ? ' checked' : ''}/> <span>N/A</span></label>
                <label class="q-other">Other: <input data-qother="${esc(q.key)}" maxlength="200" value="${esc(prev.other || '')}"/></label>
              </div>
            </div>
          </details>`;
        host.appendChild(wrap);
        summarize(q);
      }
      host.addEventListener('change', (e) => {
        const key = e.target.getAttribute('data-q') || e.target.getAttribute('data-qna');
        if (key) { const q = QUESTIONS.find((x) => x.key === key); if (q) summarize(q); }
      });
      host.addEventListener('input', (e) => {
        if (e.target.classList.contains('msel-filter')) {
          const needle = e.target.value.toLowerCase();
          e.target.closest('.msel-panel').querySelectorAll('.q-opt').forEach((l) => {
            if (l.parentElement.classList.contains('msel-foot')) return;
            l.hidden = needle !== '' && !l.textContent.toLowerCase().includes(needle);
          });
        }
        const key = e.target.getAttribute('data-qother');
        if (key) { const q = QUESTIONS.find((x) => x.key === key); if (q) summarize(q); }
      });
      // One dropdown open at a time; any outside click closes them all.
      document.addEventListener('click', (e) => {
        document.querySelectorAll('.msel[open]').forEach((d) => { if (!d.contains(e.target)) d.removeAttribute('open'); });
      });
      host.addEventListener('toggle', (e) => {
        if (e.target.classList.contains('msel') && e.target.open) {
          document.querySelectorAll('.msel[open]').forEach((d) => { if (d !== e.target) d.removeAttribute('open'); });
          const f = e.target.querySelector('.msel-filter'); if (f) f.focus();
        }
      }, true);
    }

    // ---- Repeatable job / education rows -----------------------------------
    // Rendered with innerHTML at runtime, so all styles for these live in the
    // is:global block: Astro's scoped selectors never match injected nodes.
    let jobSeq = 0, eduSeq = 0;
    function jobRow(j) {
      j = j || {};
      const d = document.createElement('div');
      d.className = 'rb-card'; d.dataset.kind = 'job';
      d.innerHTML = `
        <div class="rb-grid">
          <label>Employer <input class="j-employer" maxlength="120" /></label>
          <label>Job title <input class="j-title" maxlength="120" /></label>
          <label>Location <input class="j-location" maxlength="80" placeholder="City, Country" /></label>
          <label class="rb-dates"><span>Dates</span>
            <span class="rb-daterow">
              <input class="j-start" maxlength="30" placeholder="April 2023" />
              <span class="rb-dash">–</span>
              <input class="j-end" maxlength="30" placeholder="Present" />
            </span></label>
        </div>
        <label class="rb-desc">What you did <textarea class="j-description" rows="4" maxlength="2000" placeholder="Responsibilities and results. One point per line reads best."></textarea></label>
        <button type="button" class="rb-remove">Remove this job</button>`;
      d.querySelector('.j-employer').value = j.employer || '';
      d.querySelector('.j-title').value = j.title || '';
      d.querySelector('.j-location').value = j.location || '';
      d.querySelector('.j-start').value = j.start || '';
      d.querySelector('.j-end').value = j.end || '';
      d.querySelector('.j-description').value = j.description || '';
      d.querySelector('.rb-remove').addEventListener('click', () => d.remove());
      $('jobs-list').appendChild(d);
      jobSeq++;
    }
    function eduRow(e) {
      e = e || {};
      const d = document.createElement('div');
      d.className = 'rb-card'; d.dataset.kind = 'edu';
      d.innerHTML = `
        <div class="rb-grid">
          <label>Institution <input class="e-institution" maxlength="140" /></label>
          <label>Degree or credential <input class="e-credential" maxlength="140" placeholder="MSc Computer Science" /></label>
          <label>Years <input class="e-years" maxlength="30" placeholder="2018" /></label>
        </div>
        <button type="button" class="rb-remove">Remove</button>`;
      d.querySelector('.e-institution').value = e.institution || '';
      d.querySelector('.e-credential').value = e.credential || '';
      d.querySelector('.e-years').value = e.years || '';
      d.querySelector('.rb-remove').addEventListener('click', () => d.remove());
      $('edu-list').appendChild(d);
      eduSeq++;
    }
    function collectJobs() {
      return [...document.querySelectorAll('#jobs-list .rb-card')].map((d) => ({
        employer: d.querySelector('.j-employer').value, title: d.querySelector('.j-title').value,
        location: d.querySelector('.j-location').value, start: d.querySelector('.j-start').value,
        end: d.querySelector('.j-end').value, description: d.querySelector('.j-description').value,
      })).filter((j) => j.employer || j.title || j.description);
    }
    function collectEdu() {
      return [...document.querySelectorAll('#edu-list .rb-card')].map((d) => ({
        institution: d.querySelector('.e-institution').value,
        credential: d.querySelector('.e-credential').value,
        years: d.querySelector('.e-years').value,
      })).filter((e) => e.institution || e.credential);
    }
    $('job-add').addEventListener('click', () => jobRow());
    $('edu-add').addEventListener('click', () => eduRow());

    // ---- Autofill v2 --------------------------------------------------------
    // Parses a pasted resume into the structured fields. Handles letterspaced
    // headings (P R O F E S S I O N A L  E X P E R I E N C E), splits jobs on
    // date-range lines, pulls employer/title/location, and routes summary,
    // education, certifications, publications, awards. Best effort by design:
    // every field stays editable and the message says to check them.
    const DATE_RANGE = /((?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:t(?:ember)?)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\.?\s+)?(19|20)\d{2}\s*(?:–|—|-|to)\s*(?:((?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:t(?:ember)?)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\.?\s+)?(19|20)\d{2}|Present|Current|Now)/i;
    function autofillFromPaste() {
      const raw = $('t-paste').value.replace(/\r/g, '');
      if (!raw.trim()) { say('t-paste-msg', 'Paste your resume text first.', false); return; }
      // A heading is a short line that, with everything but letters removed,
      // starts with a known section word. Space-stripped matching is what
      // survives letterspaced headings (E X E C U T I V E  S U M M A R Y),
      // whose word boundaries are unrecoverable after collapsing.
      const SECTIONS = [
        { key: 'jobs', starts: ['professionalexperience', 'workexperience', 'workhistory', 'careerhistory', 'employmenthistory', 'experience', 'employment', 'berufserfahrung', 'experiencia'] },
        { key: 'summary', starts: ['executivesummary', 'professionalsummary', 'summary', 'profile', 'objective', 'aboutme', 'about'] },
        { key: 'education', starts: ['education', 'academic', 'studies', 'ausbildung', 'formation', 'educacion'] },
        { key: 'certifications', starts: ['certification', 'license', 'professionaldevelopment', 'credential'] },
        { key: 'publications', starts: ['publication', 'papers', 'patent', 'talks', 'presentation', 'conference', 'frameworkauthorship', 'authorship'] },
        { key: 'awards', starts: ['award', 'honor', 'recognition', 'achievement'] },
        { key: 'skip', starts: ['corecompetenc', 'competenc', 'skills', 'skill', 'frameworkstools', 'frameworktools', 'technicalskills', 'languages', 'references', 'platformsystems', 'platform', 'regulatorystandards', 'regulatory'] },
      ];
      const buckets = { summary: [], jobs: [], education: [], certifications: [], publications: [], awards: [], skip: [], preamble: [] };
      let cur = 'preamble';
      for (const rawLine of raw.split('\n')) {
        const t = rawLine.trim();
        let hit = null;
        if (t && t.length < 80 && !DATE_RANGE.test(t)) {
          const norm = t.toLowerCase().replace(/[^a-z]/g, '');
          if (norm && norm.length < 45) {
            hit = SECTIONS.find((h) => h.starts.some((w) => norm.startsWith(w)));
          }
        }
        if (hit) { cur = hit.key; continue; }
        buckets[cur].push(t);
      }
      let filled = [];

      // Summary: explicit section, else the preamble prose after dropping
      // contact-looking lines (emails, phones, plain address lines).
      const sumLines = (buckets.summary.length ? buckets.summary : buckets.preamble)
        .filter((l) => l && !/@|www\.|linkedin|github|\+?\d[\d\s().-]{7,}/i.test(l));
      const summary = sumLines.join(' ').replace(/\s{2,}/g, ' ').trim().slice(0, 2000);
      if (summary && !$('p-summary').value) { $('p-summary').value = summary; filled.push('summary'); }

      // Jobs: new job starts at any line containing a date range.
      if (buckets.jobs.length) {
        const blocks = [];
        let b = null;
        for (const line of buckets.jobs) {
          if (!line) continue;
          if (DATE_RANGE.test(line)) { b = { head: line, lines: [] }; blocks.push(b); }
          else if (b) b.lines.push(line);
          else { b = { head: '', lines: [line] }; blocks.push(b); }
        }
        const jobs = blocks.slice(0, 15).map((blk) => {
          const mDate = blk.head.match(DATE_RANGE);
          const range = mDate ? mDate[0] : '';
          let start = '', end = '';
          if (range) {
            const parts = range.split(/\s*(?:–|—|-|to)\s*/i);
            start = (parts[0] || '').trim(); end = (parts[1] || '').trim();
          }
          let head = blk.head.replace(DATE_RANGE, '').replace(/[,;·|]\s*$/, '').trim();
          let employer = head, title = '';
          const ci = head.indexOf(',');
          if (ci > 0) { employer = head.slice(0, ci).trim(); title = head.slice(ci + 1).trim(); }
          let location = '';
          let lines = blk.lines.slice();
          if (lines.length && /^[A-Za-zÀ-ž .'-]+,\s*[A-Za-zÀ-ž .'-]+$/.test(lines[0]) && lines[0].length < 45) {
            location = lines[0]; lines = lines.slice(1);
          }
          const description = lines.join('\n').replace(/^[-•*]\s*/gm, '').trim().slice(0, 2000);
          return { employer, title, location, start, end, description };
        }).filter((j) => j.employer || j.description);
        if (jobs.length) {
          $('jobs-list').innerHTML = '';
          jobs.forEach((j) => jobRow(j));
          filled.push(jobs.length + ' job' + (jobs.length > 1 ? 's' : ''));
        }
      }

      // Education: one entry per line containing a degree keyword or a year.
      if (buckets.education.length) {
        const entries = [];
        for (const line of buckets.education) {
          if (!line) continue;
          if (!/(19|20)\d{2}|master|bachelor|associate|doctor|phd|m\.?sc|b\.?sc|mba|diploma|coursework|degree/i.test(line)) {
            if (entries.length) entries[entries.length - 1].rawExtra = true;
            continue;
          }
          const yr = line.match(/(19|20)\d{2}(?:\s*[–—-]\s*(19|20)\d{2})?/);
          const years = yr ? yr[0] : '';
          let rest = line.replace(/,?\s*(19|20)\d{2}(?:\s*[–—-]\s*(19|20)\d{2})?\.?$/, '').trim();
          let credential = rest, institution = '';
          const sep = rest.match(/\s(?:—|–|-{2,3})\s/);
          if (sep) {
            credential = rest.slice(0, sep.index).trim();
            institution = rest.slice(sep.index + sep[0].length).trim();
          } else {
            const uni = rest.match(/\b(university|college|institute|school|polytechnic|academy|tu\s|iit\s)/i);
            if (uni && uni.index > 0) { credential = rest.slice(0, uni.index).replace(/[,;—–-]\s*$/, '').trim(); institution = rest.slice(uni.index).trim(); }
          }
          entries.push({ institution, credential, years });
        }
        if (entries.length) {
          $('edu-list').innerHTML = '';
          entries.slice(0, 10).forEach((e) => eduRow(e));
          filled.push(entries.length + ' education entr' + (entries.length > 1 ? 'ies' : 'y'));
        }
      }

      for (const [key, id, cap] of [['certifications', 'p-certifications', 2000], ['publications', 'p-publications', 4000], ['awards', 'p-awards', 2000]]) {
        const text = buckets[key].filter(Boolean).join('\n').replace(/^[-•*]\s*/gm, '').trim().slice(0, cap);
        if (text) { $(id).value = text; filled.push(key); }
      }

      say('t-paste-msg', filled.length
        ? 'Filled: ' + filled.join(', ') + '. Check every field — Autofill is a first pass, not a final answer.'
        : 'No sections recognized. Fill the fields directly.', filled.length > 0);
    }

    async function openSession() {
      if (!TOKEN) return;
      try {
        const r = await fetch(api('session?t=' + encodeURIComponent(TOKEN)));
        const d = await r.json();
        if (!r.ok) { say('t-signup-msg', d.error || 'Link not valid.', false); return; }
        $('step-signup').hidden = true;
        $('step-form').hidden = false;
        $('t-whoami').textContent = d.email_masked;
        $('t-taiid').textContent = d.tai_id;
        for (const k of ['first_name', 'headline', 'location', 'availability', 'rate', 'summary', 'certifications', 'publications', 'awards']) {
          if (d.profile && d.profile[k] && $('p-' + k)) $('p-' + k).value = d.profile[k];
        }
        const pj = (d.profile && d.profile.jobs) || [];
        const pe = (d.profile && d.profile.education_items) || [];
        $('jobs-list').innerHTML = ''; $('edu-list').innerHTML = '';
        pj.forEach((j) => jobRow(j));
        pe.forEach((e) => eduRow(e));
        // Legacy free-text profiles predate the structured builder: carry the
        // text into one card so a resubmit never silently drops it.
        if (!pj.length && d.profile && d.profile.work_experience) jobRow({ description: d.profile.work_experience });
        if (!pe.length && d.profile && d.profile.education) eduRow({ credential: '', institution: d.profile.education.slice(0, 140) });
        if (!$('#jobs-list .rb-card') && !document.querySelector('#jobs-list .rb-card')) jobRow();
        if (!document.querySelector('#edu-list .rb-card')) eduRow();
        const pii = d.pii || {};
        for (const k of ['name_first', 'name_middle', 'name_last', 'phone_area', 'phone_num',
                         'addr_street', 'addr_city', 'addr_region', 'addr_postal', 'country']) {
          if (pii[k]) $('pii-' + k).value = pii[k];
        }
        if (pii.phone_cc) $('pii-phone_cc').value = pii.phone_cc;
        // Legacy rows: a single full_name lands in First name for re-splitting.
        if (!pii.name_first && pii.full_name) $('pii-name_first').value = pii.full_name;
        if (!pii.phone_num && pii.phone) $('pii-phone_num').value = pii.phone;
        (pii.links || []).forEach((u, i) => { if (i < 3) $('pii-link' + (i + 1)).value = u; });
        // The contact email IS the verified signup address - filled and locked.
        $('pii-contact_email').value = d.email || '';
        $('p-share_pdf').checked = !!d.share_pdf;
        $('t-pageid').textContent = (d.tai_id || '').toLowerCase();
        $('t-pdf-btn').onclick = () => { location.href = api('pdf/' + d.tai_id) + '?t=' + encodeURIComponent(TOKEN); };
        $('t-docx-btn').onclick = () => { location.href = api('docx/' + d.tai_id) + '?t=' + encodeURIComponent(TOKEN); };
        if (d.has_password) $('t-pw-msg').textContent = 'A password is set. Leave these blank to keep it, or type a new one to change it.';
        renderQuestions(d.answers);
      } catch { say('t-signup-msg', 'Could not load your profile. Refresh to retry.', false); }
    }

    $('t-signup-btn').addEventListener('click', async () => {
      const email = $('t-email').value.trim();
      const ts = document.querySelector('[name="cf-turnstile-response"]');
      say('t-signup-msg', 'Sending…', true);
      try {
        const r = await fetch(api('signup'), {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, turnstile: ts ? ts.value : '' }),
        });
        const d = await r.json();
        // The reason code names which link in the mail chain failed; without
        // it on screen, diagnosing a signup failure needs DevTools.
        const msg = (d.message || d.error || 'Something went wrong.') + (d.reason ? ' [' + d.reason + ']' : '');
        say('t-signup-msg', msg, r.ok);
      } catch { say('t-signup-msg', 'Network error. Try again.', false); }
    });

    async function saveProfile(msgId, doneMsg) {
      const answers = {};
      for (const q of QUESTIONS) {
        answers[q.key] = {
          selections: [...document.querySelectorAll(`input[data-q="${q.key}"]:checked`)].map((i) => i.value),
          na: !!document.querySelector(`input[data-qna="${q.key}"]:checked`),
          other: (document.querySelector(`input[data-qother="${q.key}"]`) || {}).value || '',
        };
      }
      const profile = {};
      for (const k of ['first_name', 'headline', 'location', 'availability', 'rate', 'summary', 'certifications', 'publications', 'awards']) profile[k] = $('p-' + k).value;
      profile.jobs = collectJobs();
      profile.education_items = collectEdu();
      const pii = {
        name_first: $('pii-name_first').value, name_middle: $('pii-name_middle').value,
        name_last: $('pii-name_last').value,
        phone_cc: $('pii-phone_cc').value, phone_area: $('pii-phone_area').value,
        phone_num: $('pii-phone_num').value,
        addr_street: $('pii-addr_street').value, addr_city: $('pii-addr_city').value,
        addr_region: $('pii-addr_region').value, addr_postal: $('pii-addr_postal').value,
        country: $('pii-country').value,
        links: [$('pii-link1').value, $('pii-link2').value, $('pii-link3').value].filter(Boolean),
      };
      const pw1 = $('t-pw1').value, pw2 = $('t-pw2').value;
      if (pw1 || pw2) {
        if (pw1 !== pw2) { say('t-pw-msg', 'Passwords do not match.', false); return; }
        if (pw1.length < 10) { say('t-pw-msg', 'Password must be at least 10 characters.', false); return; }
      }
      say(msgId, doneMsg === 'Saved.' ? 'Saving…' : 'Submitting…', true);
      try {
        const r = await fetch(api('submit'), {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ t: TOKEN, profile, answers, pii, share_pdf: $('p-share_pdf').checked, password: pw1 || '' }),
        });
        const d = await r.json();
        say(msgId, r.ok ? doneMsg : (d.error || 'Something went wrong.'), r.ok);
      } catch { say(msgId, 'Network error. Try again.', false); }
    }
    $('t-submit-btn').addEventListener('click', () => saveProfile('t-submit-msg', 'Submitted. Profiles are reviewed by a person before they go live.'));
    $('t-save-btn').addEventListener('click', () => saveProfile('t-save-msg', 'Saved.'));

    $('t-resume').addEventListener('change', async (e) => {
      const f = e.target.files && e.target.files[0];
      if (!f) return;
      if (f.size > 5 * 1024 * 1024) { say('t-resume-msg', 'PDF too large, 5 MB maximum.', false); return; }
      say('t-resume-msg', 'Uploading…', true);
      try {
        const r = await fetch(api('resume?t=' + encodeURIComponent(TOKEN)), {
          method: 'POST', headers: { 'content-type': 'application/pdf' }, body: f,
        });
        const d = await r.json();
        say('t-resume-msg', d.message || d.error || 'Upload failed.', r.ok);
      } catch { say('t-resume-msg', 'Network error. Try again.', false); }
    });

    $('t-photo').addEventListener('change', async (e) => {
      const f = e.target.files && e.target.files[0];
      if (!f) return;
      if (f.size > 2 * 1024 * 1024) { say('t-photo-msg', 'Image too large, 2 MB maximum.', false); return; }
      say('t-photo-msg', 'Uploading…', true);
      try {
        const r = await fetch(api('photo?t=' + encodeURIComponent(TOKEN)), {
          method: 'POST', headers: { 'content-type': f.type }, body: f,
        });
        const d = await r.json();
        say('t-photo-msg', d.message || d.error || 'Upload failed.', r.ok);
      } catch { say('t-photo-msg', 'Network error. Try again.', false); }
    });

    $('t-autofill-btn').addEventListener('click', autofillFromPaste);

    openSession();
  </script>

  {/* is:global because the skills questions are rendered at runtime via
      innerHTML: scoped rules demand Astro's cid attribute on every element,
      runtime-created nodes never carry it, and the entire question UI shipped
      unstyled - the checkbox spray Stephen saw. The classes are namespaced
      (.talent-card, .msel, .q-*) so global scope leaks nothing. */}
  <style is:global>
    .talent-card { border: 1px solid #e3e6ea; border-radius: 8px; padding: 1.25rem 1.5rem; margin: 1.5rem 0; }
    .talent-card label { display: block; margin: .6rem 0; font-weight: 600; }
    .talent-card input[type="email"], .talent-card input[type="password"], .talent-card input[type="text"],
    .talent-card input:not([type]), .talent-card select {
      display: block; width: 100%; max-width: 28rem; margin-top: .25rem; padding: .5rem .6rem;
      border: 1px solid #c7ced6; border-radius: 6px; font: inherit; font-weight: 400; }
    .talent-card button { margin-top: .75rem; background: #F07800; color: #fff; border: 0;
      border-radius: 6px; padding: .6rem 1.1rem; font: inherit; font-weight: 600; cursor: pointer; }
    .t-msg { min-height: 1.2em; font-weight: 600; }
    .p-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); gap: 0 1.4rem; }
    /* Fields line up across columns regardless of how far a label's hint text
       wraps: each cell is a column flexbox with its input pinned to the
       bottom edge. */
    .p-grid > label { display: flex; flex-direction: column; justify-content: flex-end; }
    .p-grid > label > input, .p-grid > label > select { margin-top: auto; }
    .locked { background: #f2f4f7 !important; color: #475467; cursor: not-allowed; }
    .ph-row { display: flex; gap: .5rem; max-width: 34rem; }
    .ph-row select { flex: 0 0 11rem; }
    .ph-row input { flex: 1; display: block; padding: .5rem .6rem; border: 1px solid #c7ced6;
      border-radius: 6px; font: inherit; font-weight: 400; margin-top: .25rem; }
    .ph-row select { padding: .5rem .4rem; border: 1px solid #c7ced6; border-radius: 6px;
      font: inherit; font-weight: 400; margin-top: .25rem; }
    #t-save-btn { margin-top: .9rem; }
    .hint { font-weight: 400; color: #667085; font-size: .88em; }
    .talent-card textarea { display: block; width: 100%; margin-top: .25rem; padding: .5rem .6rem;
      border: 1px solid #c7ced6; border-radius: 6px; font: inherit; font-weight: 400; resize: vertical; }
    .bg-label { max-width: 44rem; }
    .rb-card { border: 1px solid #e3e6ea; border-radius: 8px; padding: .9rem 1rem .6rem; margin: .6rem 0; max-width: 44rem; background: #fafbfc; }
    .rb-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem .9rem; }
    .rb-grid label, .rb-desc { display: block; font-weight: 600; font-size: .92em; }
    .rb-grid input, .rb-desc textarea { display: block; width: 100%; margin-top: .2rem; padding: .45rem .55rem; border: 1px solid #c7ced6; border-radius: 6px; font: inherit; font-weight: 400; }
    .rb-desc { margin-top: .5rem; }
    .rb-dates .rb-daterow { display: flex; gap: .4rem; align-items: center; font-weight: 400; }
    .rb-dash { color: #667085; }
    .rb-remove { background: none; border: none; color: #b42318; font: inherit; font-size: .85em; cursor: pointer; padding: .4rem 0 0; }
    .rb-remove:hover { text-decoration: underline; }
    #job-add, #edu-add { margin-top: .2rem; }
    @media (max-width: 40rem) { .rb-grid { grid-template-columns: 1fr; } }
    .t-secondary { background: #fff !important; color: #201868 !important; border: 1.5px solid #201868 !important; }
    .q-row { margin: .9rem 0; max-width: 44rem; }
    .q-label { display: block; font-weight: 600; margin-bottom: .25rem; }
    .msel { position: relative; }
    .msel summary { list-style: none; display: flex; justify-content: space-between; align-items: center;
      gap: .6rem; border: 1px solid #c7ced6; border-radius: 6px; padding: .5rem .7rem; cursor: pointer;
      background: #fff; font-weight: 400; }
    .msel summary::-webkit-details-marker { display: none; }
    .msel[open] summary { border-color: #201868; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
    .msel-value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .msel-value.placeholder { color: #667085; }
    .msel-caret { color: #667085; flex: none; }
    .msel-panel { position: absolute; z-index: 30; left: 0; right: 0; background: #fff;
      border: 1px solid #201868; border-top: 0; border-radius: 0 0 6px 6px;
      box-shadow: 0 8px 20px rgba(16, 24, 40, .12); padding: .5rem .7rem; }
    .msel-filter { display: block; width: 100%; margin: .1rem 0 .4rem; padding: .35rem .5rem;
      border: 1px solid #c7ced6; border-radius: 6px; font: inherit; }
    .msel-list { max-height: 15rem; overflow: auto; }
    .msel-foot { border-top: 1px solid #eceef4; margin-top: .4rem; padding-top: .4rem; }
    .q-opt { display: flex; gap: .45rem; align-items: baseline; font-weight: 400 !important; margin: .15rem 0 !important; }
    .q-other { font-weight: 400 !important; display: flex; gap: .4rem; align-items: center; }
    .q-other input { display: inline-block !important; width: 14rem !important; margin-top: 0 !important; }
  </style>
</Base>

---
import { readFileSync, existsSync } from 'node:fs';

// One page per LIVE, approved profile, from the pipeline-published directory.
// The page IS the resume: a single paper sheet, typeset like the PDF the
// Worker generates, with nothing around it but a way back to the site.
// Identity stays first-name-only, contact is relay-only, and the photo and
// downloads are served by the Worker so an expired profile takes them
// offline with it.
export async function getStaticPaths() {
  const f = 'content/talent/profiles.json';
  if (!existsSync(f)) return [];
  let dir;
  try { dir = JSON.parse(readFileSync(f, 'utf8')); } catch { return []; }
  return (dir.profiles || [])
    .filter((p) => p && p.tai_id)
    .map((p) => ({ params: { id: p.tai_id.toLowerCase() }, props: { p, generated: dir.generated || '' } }));
}
const { p, generated } = Astro.props;
const name = p.first_name || 'Anonymous';
const title = `${name}${p.headline ? ' — ' + p.headline : ''} — AI Talent Network`;
const desc = `${name}${p.headline ? ', ' + p.headline : ''}: verified AI skills profile ${p.tai_id} on The World of AI Talent Network.`;
const jsonld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'ProfilePage',
  name: `${name} — ${p.tai_id}`,
  url: `https://theworldofai.org/talent/${p.tai_id.toLowerCase()}/`,
  isPartOf: { '@type': 'WebSite', name: 'The World of AI', url: 'https://theworldofai.org/' },
});
const AV = { open: 'Open to work', freelance: 'Freelance / contract', 'not-looking': 'Not looking right now' };
const relay = `mailto:theworldofai@inkboxmail.com?subject=${encodeURIComponent('Talent inquiry ' + p.tai_id)}`;
const jobs = Array.isArray(p.jobs) ? p.jobs : [];
const edu = Array.isArray(p.education_items) ? p.education_items : [];
const certs = Array.isArray(p.certifications_items) ? p.certifications_items : [];
const pubs = Array.isArray(p.publications_items) ? p.publications_items : [];
const pats = Array.isArray(p.patents_items) ? p.patents_items : [];
const awards = Array.isArray(p.awards_items) ? p.awards_items : [];
const skills = Array.isArray(p.skills) ? p.skills : [];
const matches = Array.isArray(p.matches) ? p.matches : [];
const contactBits = [p.location, p.years ? `${p.years} years in AI/ML` : '', AV[p.availability] || '', p.rate || ''].filter(Boolean);
const jobLine = (j) => [j.title, j.employer].filter(Boolean).join(', ');
const jobMeta = (j) => [j.location, [j.start, j.end].filter(Boolean).join(' – ')].filter(Boolean).join(' | ');
const eduLine = (e) => {
  const deg = [e.degree || e.credential, e.major].filter(Boolean).join(', ');
  return [deg + (e.minor ? ` (minor: ${e.minor})` : ''), e.institution].filter(Boolean).join(' — ');
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={`https://theworldofai.org/talent/${p.tai_id.toLowerCase()}/`} />
  <link rel="icon" type="image/svg+xml" href="/brand/mark.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={jsonld} />
</head>
<body>
  <nav class="bar">
    <a class="back" href="https://theworldofai.org/talent/" aria-label="Back to The World of AI">&#8592; theworldofai.org</a>
    <span class="dl">
      <a href={`/api/talent/pdf/${p.tai_id}`} rel="nofollow">PDF</a>
      <a href={`/api/talent/docx/${p.tai_id}`} rel="nofollow">DOCX</a>
    </span>
  </nav>

  <main class="sheet">
    <header class="head">
      <div class="id">
        <h1>{name}</h1>
        {p.headline && <p class="headline">{p.headline}</p>}
        {contactBits.length > 0 && <p class="contact">{contactBits.join('  ·  ')}</p>}
        <p class="contact"><a href={relay}>Contact via The World of AI relay</a>  ·  Profile {p.tai_id}</p>
      </div>
      {p.has_photo && <img class="photo" src={`/api/talent/photo/${p.tai_id}`} alt={`${name}'s photo`} width="112" height="112" />}
    </header>

    {p.summary && (
      <section>
        <h2>Professional Summary</h2>
        <p>{p.summary}</p>
      </section>
    )}

    {skills.length > 0 && (
      <section>
        <h2>Core Competencies</h2>
        {skills.map((s) => (
          <p class="comp"><strong>{s.label}:</strong> {s.items.join(' · ')}</p>
        ))}
      </section>
    )}

    {(jobs.length > 0 || p.work_experience) && (
      <section>
        <h2>Professional Experience</h2>
        {jobs.map((j) => (
          <div class="job">
            <p class="job-head">{jobLine(j)}</p>
            {jobMeta(j) && <p class="job-meta">{jobMeta(j)}</p>}
            {j.description && <p class="job-desc">{j.description}</p>}
          </div>
        ))}
        {jobs.length === 0 && <p>{p.work_experience}</p>}
      </section>
    )}

    {(pubs.length > 0 || p.publications) && (
      <section>
        <h2>Publications</h2>
        <ul>
          {pubs.map((x) => <li>{[x.title, x.date].filter(Boolean).join(' — ')}</li>)}
          {pubs.length === 0 && <li>{p.publications}</li>}
        </ul>
      </section>
    )}

    {pats.length > 0 && (
      <section>
        <h2>Patents &amp; Trademarks</h2>
        <ul>{pats.map((x) => <li>{[x.title, x.date].filter(Boolean).join(' — ')}</li>)}</ul>
      </section>
    )}

    {(edu.length > 0 || p.education) && (
      <section>
        <h2>Education</h2>
        {edu.map((e) => (
          <div class="job">
            <p class="job-head">{eduLine(e)}</p>
            {e.years && <p class="job-meta">{e.years}</p>}
            {e.comments && <p class="job-desc">{e.comments}</p>}
          </div>
        ))}
        {edu.length === 0 && <p>{p.education}</p>}
      </section>
    )}

    {(certs.length > 0 || p.certifications) && (
      <section>
        <h2>Certifications</h2>
        <ul>
          {certs.map((c) => <li>{[c.name, c.year].filter(Boolean).join(' — ')}{c.expires ? `, expires ${c.expires}` : ''}</li>)}
          {certs.length === 0 && <li>{p.certifications}</li>}
        </ul>
      </section>
    )}

    {(awards.length > 0 || p.awards) && (
      <section>
        <h2>Awards &amp; Honors</h2>
        <ul>
          {awards.map((a) => <li>{[a.title, a.date].filter(Boolean).join(' — ')}</li>)}
          {awards.length === 0 && <li>{p.awards}</li>}
        </ul>
      </section>
    )}

    <p class="foot">Verified by email and reviewed by a person · The World of AI Talent Network · Last updated {p.updated || generated}</p>
  </main>

  {matches.length > 0 && (
    <details class="matches">
      <summary>Open roles matching this profile ({matches.length})</summary>
      <ul>
        {matches.map((m) => (
          <li><a href={m.url} rel="nofollow noopener">{m.title}</a> — {m.company}{m.location ? ` · ${m.location}` : ''}{m.remote ? ' · Remote' : ''}</li>
        ))}
      </ul>
      <p class="m-note">Matched nightly against live listings from company job boards; each link opens the original posting.</p>
    </details>
  )}

  <style is:global>
    :root { --navy:#201868; --orange:#F07800; --ink:#26272b; --gray:#7A8A9E; --paper:#ffffff; --desk:#eef0f4; }
    * { box-sizing: border-box; margin: 0; }
    body { background: var(--desk); font-family: 'Poppins', Arial, sans-serif; color: var(--ink); font-size: 15px; line-height: 1.55; }
    .bar { max-width: 860px; margin: 0 auto; padding: 14px 10px; display: flex; justify-content: space-between; align-items: center; }
    .bar a { color: var(--navy); text-decoration: none; font-weight: 500; font-size: .92rem; }
    .bar a:hover { color: var(--orange); }
    .dl a { margin-left: 14px; color: var(--gray); }
    .sheet { max-width: 860px; margin: 0 auto 28px; background: var(--paper); padding: 56px 64px; box-shadow: 0 2px 24px rgba(32,24,104,.12); border-top: 5px solid var(--orange); }
    .head { display: flex; justify-content: space-between; gap: 24px; border-bottom: 2px solid var(--navy); padding-bottom: 18px; margin-bottom: 8px; }
    h1 { font-family: 'Lora', Georgia, serif; color: var(--navy); font-size: 2.2rem; line-height: 1.15; }
    .headline { font-weight: 600; color: var(--navy); margin-top: 4px; }
    .contact { color: var(--gray); font-size: .9rem; margin-top: 6px; }
    .contact a { color: var(--orange); text-decoration: none; }
    .photo { border-radius: 8px; object-fit: cover; }
    section { margin-top: 26px; }
    h2 { font-family: 'Lora', Georgia, serif; color: var(--navy); font-size: 1.12rem; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 10px; }
    h2::after { content: ""; display: block; width: 44px; height: 3px; background: var(--orange); margin-top: 5px; }
    .comp { margin-bottom: 6px; }
    .comp strong { color: var(--navy); font-weight: 600; }
    .job { margin-bottom: 14px; }
    .job-head { font-weight: 600; color: var(--navy); }
    .job-meta { color: var(--gray); font-size: .88rem; }
    .job-desc { margin-top: 3px; }
    ul { padding-left: 1.15rem; }
    li { margin-bottom: 5px; }
    .foot { margin-top: 34px; padding-top: 14px; border-top: 1px solid #e3e6ec; color: var(--gray); font-size: .8rem; }
    .matches { max-width: 860px; margin: 0 auto 48px; background: #fff; padding: 18px 28px; box-shadow: 0 1px 10px rgba(32,24,104,.08); }
    .matches summary { cursor: pointer; font-weight: 600; color: var(--navy); }
    .matches ul { margin-top: 12px; }
    .matches a { color: var(--navy); }
    .m-note { color: var(--gray); font-size: .85rem; margin-top: 10px; }
    @media (max-width: 700px) { .sheet { padding: 32px 22px; } .head { flex-direction: column; } }
    @media print {
      body { background: #fff; }
      .bar, .matches { display: none; }
      .sheet { box-shadow: none; margin: 0; max-width: none; padding: 0; border-top: none; }
    }
  </style>
</body>
</html>

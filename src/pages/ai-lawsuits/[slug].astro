---
import Base from '../../layouts/Base.astro';
import KeepReading from '../../components/KeepReading.astro';
import { matchTerms, companiesNamedIn } from '../../lib/related';
import { readFileSync, existsSync } from 'node:fs';

export function getStaticPaths() {
  if (!existsSync('content/lawsuits/lawsuits.json')) return [];
  const s = JSON.parse(readFileSync('content/lawsuits/lawsuits.json', 'utf8'));
  const cases = s.cases ?? [];
  // The primary defendant, normalized to a match key. Most relatedness a reader
  // wants is "other cases against the same company", which category cannot give
  // (74 of 103 cases are copyright). Text before the first comma or semicolon,
  // corporate suffix stripped, so "OpenAI, Inc. et al." and "Anthropic PBC"
  // collapse to openai and anthropic. Inside getStaticPaths because Astro
  // extracts that function into its own scope.
  const defKey = (defendants) => {
    if (!defendants) return '';
    return String(defendants)
      .split(/[;,]/)[0]
      .replace(/\b(inc|corp|corporation|pbc|llc|ltd|co|plc|lp|et al)\b\.?/gi, '')
      .replace(/[^a-z0-9 ]/gi, '')
      .trim()
      .toLowerCase();
  };
  return cases.map((c) => {
    const key = defKey(c.defendants);
    // Same defendant is the strongest tie; fill the rest from the same
    // category so a case with no sibling still offers an onward path. Cap 6.
    const sameDefendant = key ? cases.filter((o) => o.slug !== c.slug && defKey(o.defendants) === key) : [];
    const seen = new Set([c.slug, ...sameDefendant.map((o) => o.slug)]);
    const sameCategory = cases.filter((o) => !seen.has(o.slug) && o.category === c.category);
    const related = [...sameDefendant, ...sameCategory].slice(0, 6);
    return { params: { slug: c.slug }, props: { c, generated: s.generated ?? '', related } };
  });
}
const { c, generated, related } = Astro.props;
// The parties, claims and docket text name companies we hold profiles on. A
// reader who lands here from a search for one of them had no route to it.
const krText = `${c.case_name ?? ''} ${c.plaintiffs ?? ''} ${c.defendants ?? ''} ${c.significance ?? ''} ${c.summary ?? ''}`;
const krCompanies = companiesNamedIn(krText);
const krTerms = matchTerms(`${c.case_name ?? ''} ${c.category ?? ''} ${c.significance ?? ''} ${c.summary ?? ''}`);
const lead = c.executive_summary || c.summary || `${c.case_name}, in the ${c.court}.`;
const desc = lead.length > 152 ? lead.slice(0, 149) + '...' : lead;
const timeline = Array.isArray(c.timeline) ? c.timeline : [];
const claims = Array.isArray(c.claims) ? c.claims : [];
// FAQ FROM THE DOCKET. Every answer is a field already on this page: who is
// suing whom, where it is being heard, what stage it has reached, why it
// matters. Nothing is characterised beyond what the record says - the status
// answer quotes the tracked status rather than predicting an outcome, which
// on live litigation is the only defensible way to answer "what is happening".
const faq = [
  ...(c.plaintiffs && c.defendants ? [{
    q: `Who is suing whom in ${c.case_name}?`,
    a: `${c.plaintiffs} brought the case against ${c.defendants}${c.court ? `, in the ${c.court}` : ''}${c.filed_date ? `, filed ${c.filed_date}` : ''}.`,
  }] : []),
  ...(c.status ? [{
    q: `What is the current status of ${c.case_name}?`,
    // Tracked status strings are authored without terminal punctuation, so
    // one is added rather than letting the next sentence run into it.
    a: `${String(c.status).replace(/[.;,]\s*$/, '')}.${c.latest_development_date ? ` The most recent tracked docket entry is dated ${c.latest_development_date}.` : ''}`,
  }] : []),
  ...(c.why_it_matters ? [{
    q: `Why does ${c.case_name} matter?`,
    a: c.why_it_matters,
  }] : []),
  ...(c.docket ? [{
    q: `What is the docket number for ${c.case_name}?`,
    a: `Docket ${c.docket}${c.court ? `, ${c.court}` : ''}${c.judge ? `, before ${c.judge}` : ''}.`,
  }] : []),
].filter((f) => f.a && String(f.a).trim().length > 0);

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [{
  '@type': 'Article',
  headline: `${c.case_name}: case tracker`,
  dateModified: generated,
  author: { '@type': 'Organization', name: 'The World of AI' },
  mainEntityOfPage: `https://theworldofai.org/ai-lawsuits/${c.slug}/`,
  }, ...(faq.length > 1 ? [{
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }] : [])],
});
---
<Base title={`${c.case_name} — AI lawsuit tracker`} description={desc} current="/ai-lawsuits/" jsonld={jsonld}>
  <h1>{c.case_name}</h1>
  <p class="meta-line"><span class="badge">{c.status_badge || c.status}</span> &nbsp; {c.category}
    {c.filed_date && <> · Filed <time datetime={c.filed_date}>{c.filed_date}</time></>}{generated && <> · Verified {generated}</>}</p>
  <p class="answer">{lead}</p>

  <table>
    <tbody>
      <tr><td><b>Court</b></td><td>{c.court}{c.judge && <> · Judge {c.judge}</>}</td></tr>
      {c.docket && <tr><td><b>Docket</b></td><td>{c.docket}</td></tr>}
      <tr><td><b>Plaintiffs</b></td><td>{c.plaintiffs}</td></tr>
      <tr><td><b>Defendants</b></td><td>{c.defendants}</td></tr>
      <tr><td><b>Status</b></td><td>{c.status}</td></tr>
      {c.latest_development && <tr><td><b>Latest</b></td>
        <td>{c.latest_development_date && <b>{c.latest_development_date}: </b>}{c.latest_development}</td></tr>}
    </tbody>
  </table>

  {c.why_it_matters && (<><h2>Why this case matters</h2><p>{c.why_it_matters}</p></>)}

  {claims.length > 0 && (
    <>
      <h2>Claims</h2>
      <ul>{claims.map((cl) => (<li>{typeof cl === 'string' ? cl : (cl.claim ?? JSON.stringify(cl))}</li>))}</ul>
    </>
  )}

  {/* The docket entry text is in `title`. This read `event` and then
      `description`, neither of which the pipeline has ever written, so every one
      of the 1,129 timeline rows across 103 cases rendered a date beside an empty
      cell. The fields actually present are date, title, doc_no and url.

      Entries are shown in full rather than truncated: a docket line is a legal
      record and cutting it mid-clause changes what it appears to say. The
      document number and the CourtListener link are rendered too, so a reader
      can verify the entry rather than take our word for it. */}
  {timeline.length > 0 && (
    <>
      <h2>Case timeline</h2>
      <table>
        <thead><tr><th>Date</th><th>Event</th></tr></thead>
        <tbody>
          {timeline.map((e) => (
            <tr>
              <td style="white-space:nowrap;">{e.date ?? ''}</td>
              <td>
                {e.doc_no && <span class="docno">#{e.doc_no}</span>}
                {e.url
                  ? <a href={e.url} rel="noopener">{e.title ?? e.event ?? e.description ?? ''}</a>
                  : (e.title ?? e.event ?? e.description ?? (typeof e === 'string' ? e : ''))}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  <p>
    {c.courtlistener_url && <a href={c.courtlistener_url} rel="noopener">Docket on CourtListener</a>}
    {c.courtlistener_url && c.source_url && ' · '}
    {c.source_url && <a href={c.source_url} rel="noopener">Primary source</a>}
  </p>
  {related.length > 0 && (
    <>
      <h2>Related cases</h2>
      <ul class="related-cases">
        {related.map((r) => (
          <li>
            <a href={`/ai-lawsuits/${r.slug}/`}>{r.case_name}</a>
            {(r.status_badge || r.status) && <span class="rc-badge">{r.status_badge || r.status}</span>}
          </li>
        ))}
      </ul>
    </>
  )}

  <p class="tracker-back"><a href="/ai-lawsuits/">&larr; All cases in the AI lawsuit tracker</a></p>

  {faq.length > 1 && (
    <>
      <h2>Frequently asked questions</h2>
      {faq.map((f) => (
        <div class="faq-item">
          <h3 style="font-family:Poppins;font-size:16.5px;font-weight:600;color:#201868;margin:0 0 .3rem;">{f.q}</h3>
          <p style="margin:0;line-height:1.7;">{f.a}</p>
        </div>
      ))}
    </>
  )}

  <div class="cite-box">Cite this page: <code>"{c.case_name}." The World of AI Lawsuit Tracker,
    theworldofai.org/ai-lawsuits/{c.slug}/.{generated ? ` Verified ${generated}.` : ''}</code></div>
  <KeepReading blocks={[
    { label: 'Companies named in this case',
      links: krCompanies.map((x) => ({ href: `/companies/${x.uid}/`, label: `${x.name} profile`, note: 'products, filings, other cases' })) },
    { label: 'Terms in this case, defined',
      links: krTerms.map((t) => ({ href: `/ai-glossary/${t.slug}/`, label: t.term, note: t.category })) },
    { label: 'Across the site', links: [
      { href: '/ai-lawsuits/', label: 'The full AI lawsuit tracker', note: 'every case, live from the dockets' },
      { href: '/ai-laws/', label: 'AI laws by state', note: 'what legislators are doing about it' },
      { href: '/ai-news/daily/', label: 'Today\u2019s briefing', note: 'what the field published today' },
    ] },
  ]} />
</Base>

<style>
  .related-cases { list-style: none; margin: .6em 0 0; padding: 0; }
  .related-cases li { padding: .5em 0; border-bottom: 1px solid #ececf2; display: flex;
    align-items: baseline; justify-content: space-between; gap: 1em; }
  .related-cases li:last-child { border-bottom: 0; }
  .related-cases a { color: var(--navy); text-decoration: none; font-weight: 600; }
  .related-cases a:hover { color: var(--orange, #F07800); }
  .rc-badge { flex: none; font-size: .72rem; font-weight: 600; color: #6b6b78;
    background: var(--cream, #FFF6EC); border-radius: 10px; padding: 1px 8px; white-space: nowrap; }
  .tracker-back { margin-top: 1.4em; font-size: .95rem; }
  .tracker-back a { color: var(--navy); text-decoration: none; font-weight: 600; }
  .tracker-back a:hover { color: var(--orange, #F07800); }
  .docno { display: inline-block; background: #f4f4f8; color: #201868; font-size: 11.5px;
    font-weight: 700; padding: 1px 7px; border-radius: 4px; margin-right: 8px; vertical-align: 1px; }
</style>

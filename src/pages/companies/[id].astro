---
/**
 * One company profile at /companies/{uid}/.
 *
 * Reads content/companies/{uid}.json, which fetch-content.mjs writes from R2.
 * The identifier is the short alphanumeric UID that pins the same organisation
 * across every page on this site, so a source that spells "OpenAI Global, LLC"
 * lands on the same page as one that spells "OpenAI, Inc."
 *
 * Two layers of data arrive in the document. `company` carries the facts this
 * site holds: profile fields verified from primary sources, the products we
 * track, lawsuits naming the company, MCP servers under its namespace. The
 * top-level `profile_text` and `website` are patched in by the company
 * harvester: a description written by a model from the company's own site
 * plus those held facts, regenerated when the site changes. Until 2026-08-30
 * this template read only `company`, so 248 written profiles never rendered
 * and 260 of 270 company pages measured under 300 words. Both layers render
 * now, and every section is a question with its answer under it.
 */
import Base from '../../layouts/Base.astro';
import Reading from '../../components/Reading.astro';
import StockBox from '../../components/StockBox.astro';
import { capParagraphs } from '../../lib/prose';
import { readFileSync, readdirSync, existsSync } from 'node:fs';
import { ownedServers } from '../../lib/mcpAttribution';

export function getStaticPaths() {
  if (!existsSync('content/companies')) return [];
  // Prices for every tracked instrument, keyed by company uid. Written by the
  // pipeline as companies/stocks.json; absent before its first run, in which
  // case no page renders a box - no entry, no box, never an empty frame.
  const stocks = existsSync('content/companies/stocks.json')
    ? JSON.parse(readFileSync('content/companies/stocks.json', 'utf8')) : { by_company: {} };
  // Instruments we track but have no prices for yet. A company registered as
  // an instrument today has no closes until twoai_stocks next runs, and
  // "absent from by_company" alone cannot tell that apart from a listing the
  // free feed will never cover - which is how AMD, on NASDAQ, came to claim
  // the opposite on 2026-09-11.
  const pendingByCompany = stocks.pending_by_company || {};
  return readdirSync('content/companies')
    .filter((f) => f.endsWith('.json') && f !== 'index.json' && f !== 'stocks.json')
    .map((f) => JSON.parse(readFileSync(`content/companies/${f}`, 'utf8')))
    .filter((d) => d && d.company && d.company.uid)
    .map((d) => ({
      params: { id: d.company.uid },
      props: { company: d.company, generated: d.generated, profileText: d.profile_text || null, siteUrl: d.website || '', reading: d.reading || null,
        lobbying: d.lobbying || null,
        stock: (stocks.by_company || {})[d.company.uid] || null,
        stockPending: pendingByCompany[d.company.uid] || null,
        operator: (() => {
          // DATA CENTER OPERATORS, Stephen 2026-09-22: "if it is thin, fix it".
          // Thirteen operators had a bare company page while the same uid carried
          // a full operator page in the data center atlas. The company page now
          // carries that record's summary, so it has something to say, and links
          // to the operator page for the facilities.
          const f = `content/tech/dc-op-${d.company.uid}.json`;
          if (!existsSync(f)) return null;
          try {
            const o = JSON.parse(readFileSync(f, 'utf8'));
            return { name: o.name, reading: o.reading || '', facilities: o.facility_count || 0, mw: o.known_mw || 0,
              hq: o.headquarters || '', type: o.operator_type || '', href: `/ai-ecosystem/technology-and-core-infrastructure/${o.uid}/` };
          } catch { return null; }
        })() },
    }));
}
const { company, generated, profileText, siteUrl, reading, stock, stockPending, lobbying, operator } = Astro.props;
const op = operator && (operator.reading || operator.facilities > 0) ? operator : null;
// Federal lobbying on AI, patched in by srj-pipeline twoai_politics_pages for
// a company whose Lobbying Disclosure Act client record Stephen confirmed as
// this company. Absent for every other company, so the section never renders
// empty. 2026-09-21.
const lobby = lobbying && Array.isArray(lobbying.filings) && lobbying.filings.length > 0 ? lobbying : null;
const profile = company.profile || {};
const products = company.products || [];
const cases = company.cases || [];
// Attribution is exact, never a substring: see src/lib/mcpAttribution.ts.
const mcp = ownedServers(company.mcp, company.name);
const categories = [...new Set(products.map((p) => p.category).filter(Boolean))];
// Category hub links, built from the same slug rule the category pages use, so
// the link lands on the page that lists this company's products rather than on
// the tools hub.
const catSlug = (n) => String(n).toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const catLinks = categories.map((n) => ({ name: n, slug: catSlug(n) }));
const website = profile.website || siteUrl || '';
// Was a plain split on blank lines. Audited 2026-09-10: company profiles are
// written into twoai_industry_analysis under metric='company-'||uid, the same
// table that carried 552 of the site's 612 over-length paragraphs, and this
// page read that field with its own inline split rather than through
// Reading.astro - so fixing that component alone would have missed every
// company page. capParagraphs enforces the five-sentence rule here too.
const paras = capParagraphs(profileText?.body);

// THIN-PAGE GATE. Stephen, 2026-09-11: asked directly whether the ETF-fund
// company pages are thin or real. They are thin by construction - a facts
// table from SEC EDGAR, no products, no prose, because no website was ever
// supplied to crawl - and this page had NO noindex protection at all, unlike
// research/paper, mcp-server and the jobs discipline pages, each of which
// learned this the hard way (129 of 135 empty paper pages triggered an
// AdSense low-value-content flag on 2026-08-29). Checked live before writing
// this: only 2 of 318 existing company pages were fully bare, so this was a
// dormant gap rather than an active problem - until 60-plus ticker-only pages
// were about to land through it with nothing to stop them being indexed.
//
// A page is thin when it has no products, no lawsuits, no MCP servers and no
// written profile: nothing but the bare facts table. It stays reachable and
// linked - the directory still lists it, the fact table still shows what SEC
// EDGAR verified - but it does not ask to be indexed until it clears that
// floor, the same discipline every other kind on this site already has.
// A CATALOG ROW IS NOT SUBSTANCE. 2026-09-18: Google's "crawled, currently not
// indexed" list named two company pages, and both HAD a product row. The old
// test treated one line from the tools catalog as enough to index a page. It
// is not: a page is worth indexing when it says something about the company
// that the reader could not get from the directory row, which means a written
// profile, a reading, a lawsuit or an MCP server. Products alone no longer
// count. Nothing is deleted: a thin page stays published and linked, carries
// noindex, and the sitemap step drops it by reading the built HTML.
const thin = cases.length === 0 && mcp.length === 0 && paras.length === 0 && !reading && !lobby && !op;

function fmtRevenue(usd) {
  if (typeof usd !== 'number') return null;
  if (usd >= 1e12) return `$${(usd / 1e12).toFixed(2)}T`;
  if (usd >= 1e9) return `$${(usd / 1e9).toFixed(1)}B`;
  if (usd >= 1e6) return `$${(usd / 1e6).toFixed(0)}M`;
  return `$${usd.toLocaleString()}`;
}
const revenue = fmtRevenue(profile.last_revenue_usd);
const orgLabels = {
  'public-company': 'public company',
  'startup': 'private company',
  'research-lab': 'research lab',
  'university-lab': 'university lab',
  'government-lab': 'government lab',
  'nonprofit': 'nonprofit',
  'open-source-foundation': 'open source foundation',
};
const orgLabel = orgLabels[profile.org_type] || null;
const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
const n = company.name;
const plural = (k, w) => `${k} ${w}${k === 1 ? '' : 's'}`;

// The answer, first: who the company is in one sentence built only from
// verified fields, then what this site tracks about it.
const who = [
  orgLabel ? `is a ${orgLabel}` : 'is an organisation',
  profile.headquarters ? `based in ${profile.headquarters}` : '',
  profile.founded ? `founded in ${profile.founded}` : '',
].filter(Boolean).join(' ');

// FAQ: only questions the data can answer. The same pairs feed the FAQPage
// schema, so the visible answer and the machine-readable one never differ.
const faqs = [];
if (paras.length) faqs.push({ q: `What does ${n} do?`, a: paras[0] });
else if (products.length) faqs.push({ q: `What does ${n} do?`, a: `${n} publishes ${plural(products.length, 'AI product')} this site tracks: ${products.map((p) => p.name).join(', ')}.` });
if (profile.headquarters) faqs.push({ q: `Where is ${n} headquartered?`, a: `${n} is headquartered in ${profile.headquarters}, as stated in the company's own published records.` });
if (profile.founded) faqs.push({ q: `When was ${n} founded?`, a: `${n} was founded in ${profile.founded}.` });
if (orgLabel) faqs.push({
  q: `Is ${n} a public company?`,
  a: profile.org_type === 'public-company'
    ? `Yes. ${n} is publicly traded${profile.ticker ? ` under the ticker ${profile.ticker}` : ''}${profile.cik ? `, SEC CIK ${profile.cik}` : ''}.`
    : `No. ${n} is a ${orgLabel}${profile.for_profit === false ? ', not for profit' : ''}.`,
});
faqs.push({
  q: `Is ${n} a defendant in any AI lawsuit?`,
  a: cases.length
    ? `${n} is named as a defendant in ${plural(cases.length, 'case')} on this site's AI lawsuit tracker: ${cases.map((c) => c.name).join('; ')}. Being named is not a finding of wrongdoing.`
    : `Not on this site's tracker. As of ${generated}, ${n} is not named as a defendant in any AI lawsuit followed here.`,
});
faqs.push({
  q: `Does ${n} publish MCP servers?`,
  a: mcp.length
    ? `Yes. ${plural(mcp.length, 'server')} under the ${n} namespace appear in the official Model Context Protocol registry: ${mcp.map((m) => m.name).join(', ')}.`
    : `No. As of ${generated}, no server under the ${n} namespace appears in the official Model Context Protocol registry.`,
});
const law = company.law_exposure || null;
if (law) faqs.push({ q: `Which state AI laws apply to ${n}?`, a: `${n} is headquartered in ${law.name}, where this site tracks ${law.count} AI bill${law.count === 1 ? '' : 's'}. State AI law reaches a company by where it operates and whom it serves, not only where it sits, so ${law.name}'s bills are the floor, not the whole exposure.` });
if (website) faqs.push({ q: `What is ${n}'s website?`, a: `${n}'s website is ${website}.` });

const desc = `${n} ${who}. ${plural(products.length, 'AI product')} tracked${cases.length ? `, ${plural(cases.length, 'lawsuit')}` : ''}${mcp.length ? `, ${plural(mcp.length, 'MCP server')}` : ''}: what ships, what is contested, what is published, verified from primary sources.`;

const org = {
  '@type': 'Organization',
  name: n,
  description: desc.slice(0, 300),
  identifier: company.uid,
  url: `https://theworldofai.org/companies/${company.uid}/`,
  ...(website ? { sameAs: [website, ...new Set(products.map((p) => p.url).filter(Boolean))] } : {}),
  ...(profile.founded ? { foundingDate: String(profile.founded) } : {}),
  ...(profile.headquarters ? { address: profile.headquarters } : {}),
};
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    org,
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question', name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---
<Base title={`${n}: AI products, lawsuits, and MCP servers`} description={desc.slice(0, 300)} current="/companies/" jsonld={jsonld} noindex={thin}>
  {/* The stock box lives in the rail, beside the prose, not in it. A public
      company with a tracked instrument gets its close, change, range and a
      sparkline; a public company whose listing the free feed cannot cover
      gets a box that says so; a private company gets nothing. */}
  {(stock || stockPending || (profile.org_type === 'public-company' && profile.ticker)) && (
    <Fragment slot="rail">
      <StockBox entry={stock} untracked={stock ? null : (stockPending
        ? { ticker: stockPending.ticker, exchange: stockPending.exchange, pending: true }
        : { ticker: profile.ticker, exchange: profile.exchange })} />
    </Fragment>
  )}
  <p class="meta-line"><a href="/companies/">AI Company Directory</a></p>
  <h1>{n}</h1>
  <p class="answer"><b>{n} {who}.</b> It publishes <b>{products.length}</b> AI product{products.length === 1 ? '' : 's'} this site tracks
    {cases.length > 0 && <>, is a defendant in <b>{cases.length}</b> lawsuit{cases.length === 1 ? '' : 's'} on the tracker</>}
    {mcp.length > 0 && <>, and has published <b>{mcp.length}</b> server{mcp.length === 1 ? '' : 's'} to the MCP registry</>}.
    {website && <> Website: <a href={website} rel="noopener">{website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a>.</>}
    {' '}Every fact below names its source; nothing here is taken from the company's marketing on trust.</p>
  {generated && <p class="meta-line">Last verified: <time datetime={generated}>{generated}</time> · Entity ID <code>{company.uid}</code></p>}

  {(orgLabel || profile.founded || profile.headquarters || profile.ticker || revenue || website) && (
    <table class="facts">
      <tbody>
        {orgLabel && <tr><th>Organisation</th><td>{cap(orgLabel)}{profile.for_profit === false && <> · not for profit</>}</td></tr>}
        {profile.founded && <tr><th>Founded</th><td>{profile.founded}</td></tr>}
        {profile.headquarters && <tr><th>Headquarters</th><td>{profile.headquarters}</td></tr>}
        {website && <tr><th>Website</th><td><a href={website} rel="noopener">{website}</a></td></tr>}
        {profile.ticker && <tr><th>Ticker</th><td>{profile.ticker}{profile.cik && <> · SEC CIK <a href={`https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${profile.cik}`} rel="noopener">{profile.cik}</a></>}</td></tr>}
        {revenue && (
          <tr>
            <th>Latest annual revenue</th>
            <td>{revenue}{profile.last_revenue_end && <> for the fiscal year ending {profile.last_revenue_end}</>}{profile.last_revenue_form && <> ({profile.last_revenue_form})</>}</td>
          </tr>
        )}
        {profile.verified_on && <tr><th>Company facts verified</th><td>{profile.verified_on} from primary sources</td></tr>}
      </tbody>
    </table>
  )}

  {paras.length > 0 && (
    <>
      <h2>What does {n} do?</h2>
      {paras.map((p) => <p>{p}</p>)}
      <p class="meta-line">Written {profileText.generated_on} from what {n} states on its own site
        and the facts this site holds, and rewritten when that site changes. Claims attributed to the
        company are its own; the numbers in the table above are verified separately.</p>
    </>
  )}

  <h2>What AI products does {n} make?</h2>
  {products.length > 0 ? (
    <table>
      <thead><tr><th>Product</th><th>Category</th><th>What it does</th></tr></thead>
      <tbody>
        {products.map((p) => (
          <tr>
            <td>{p.profile
              ? <a href={`/ai-tools/${p.profile}/`}>{p.name}</a>
              : (p.url ? <a href={p.url} rel="noopener nofollow">{p.name}</a> : p.name)}</td>
            <td>{p.category}</td>
            <td>{p.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <p>This site tracks no product from {n} yet. The company is in the directory because it
      appears in another record this site keeps, a lawsuit, an MCP namespace or a filing.</p>
  )}

  {/* ONE ANSWER, ONCE. Until 2026-09-18 a company with no lawsuit and no MCP
      server, which is 368 of 421, got a full heading and paragraph saying No
      for each, then the same two No answers again under Frequently asked
      questions, then 230 words on how the page is sourced that were identical
      on every company page. Beautiful.ai had 260 words about Beautiful.ai and
      800 words that appear on 400 other pages, and Google declined to index
      it. The thin page sweep of 2026-09-01 had counted words, and boilerplate
      has words. A section now renders only when it has something in it. The
      negative answers stay, once, in the FAQ, where a reader asking "is X
      being sued" finds them and where the FAQ schema carries them. */}
  {cases.length > 0 && (
    <>
      <h2>Is {n} named in any AI lawsuit this site tracks?</h2>
      <ul>{cases.map((c) => (
        <li><a href={`/ai-lawsuits/${c.slug}/`}>{c.name}</a>{c.court && <>, {c.court}</>}</li>
      ))}</ul>
      <p class="meta-line">Matched on the defendant field of the tracker. Being named as a
        defendant is not a finding of wrongdoing.</p>
    </>
  )}

  {op && (
    <section>
      <h2>What does {n} operate?</h2>
      <p>{n} is tracked in the data center atlas as {op.type ? `a ${op.type} operator` : 'a data center operator'}{op.hq ? `, headquartered in ${op.hq}` : ''},
        with <b>{op.facilities.toLocaleString()} {op.facilities === 1 ? 'facility' : 'facilities'}</b> on record{op.mw > 0 ? <>, {op.mw.toLocaleString()} MW of known capacity</> : ''}.
        See every site on <a href={op.href}>the {op.name} operator page</a>.</p>
      {op.reading && capParagraphs(op.reading).slice(0, 3).map((t) => <p>{t}</p>)}
    </section>
  )}

  {lobby && (
    <>
      <h2>Does {n} report lobbying the federal government on AI?</h2>
      <p>{n} is named as the client in <b>{plural(lobby.total, 'Lobbying Disclosure Act filing')}</b> reporting
        lobbying on artificial intelligence or machine learning, the latest posted {lobby.latest}.
        The most recent are below, each linked to the filing itself on lda.gov. A filing records that
        lobbying happened and on what issue; it does not record the position taken. See every client on
        {' '}<a href={lobby.section_href}>Lobbying on AI</a>.</p>
      <ul>{lobby.filings.map((f) => (
        <li>
          <a href={f.url} rel="noopener">{f.period} filing, posted {f.posted}</a>, by {f.registrant_href ? <a href={f.registrant_href}>{f.registrant}</a> : f.registrant}
          {f.bills && f.bills.length > 0 && <>. Bills named: {f.bills.join(', ')}</>}
          {f.lobbyists && f.lobbyists.length > 0 && <>. Lobbyists: {f.lobbyists.map((l, i) => (
            <>{i > 0 && ', '}{l.href ? <a href={l.href}>{l.name}</a> : l.name}</>
          ))}</>}.
          <span class="meta-line"> uid {f.uid}</span>
        </li>
      ))}</ul>
      <p class="meta-line">Filed under LDA client id {lobby.client_ids.join(', ')}. Matched to this company
        by a confirmed crosswalk, not by name alone.</p>
    </>
  )}

  {mcp.length > 0 && (
    <>
      <h2>Does {n} publish MCP servers?</h2>
      <ul>{mcp.map((m) => (
        <li><a href={`/mcp/${m.slug}/`}>{m.name}</a>{m.description && <> — {m.description}</>}</li>
      ))}</ul>
    </>
  )}

  {law && (
    <>
      <h2>Which state AI laws apply to {n}?</h2>
      <p>{n} is headquartered in {law.name}, where this site tracks
        {' '}<a href={`/ai-laws/${law.slug}/`}><b>{law.count} AI bill{law.count === 1 ? '' : 's'}</b></a>, each
        linked to its LegiScan record. That is the floor of the company's exposure, not the whole of
        it: state AI law reaches a company by where it operates and whom it serves, and federal
        action sits above all of it. Every capability a company ships still runs on compute,
        buildings and power, so the laws that matter most are increasingly the ones that decide
        where a data center can connect.</p>
    </>
  )}

  <h2>Where else does {n} appear on this site?</h2>
  <p>The pages that actually name {n}, so the same organisation can be seen from each angle
    this site tracks it from. Hubs are listed only where they carry an entry for it.</p>
  <ul>
    <li><a href={`/companies/#c-${company.uid}`}>{n} in the AI Company Directory</a></li>
    {products.filter((p) => p.profile).map((p) => (
      <li><a href={`/ai-tools/${p.profile}/`}>{p.name}</a> — full tool profile</li>
    ))}
    {catLinks.map((c) => (
      <li><a href={`/ai-tools/category/${c.slug}/`}>{c.name}</a> — the tools category {n} appears in</li>
    ))}
    {cases.map((c) => (
      <li><a href={`/ai-lawsuits/${c.slug}/`}>{c.name}</a> — case page naming {n}</li>
    ))}
    {mcp.map((m) => (
      <li><a href={`/mcp/${m.slug}/`}>{m.name}</a> — MCP server published by {n}</li>
    ))}
    {lobby && <li><a href={lobby.section_href}>Lobbying on AI</a> — the federal lobbying record naming {n}</li>}
  </ul>

  <h2>Frequently asked questions</h2>
  {faqs.map((f) => (
    <div class="faq">
      <h3>{f.q}</h3>
      <p>{f.a}</p>
    </div>
  ))}

  <h2>Where does the information on this page come from?</h2>
  <p>Each block has one source. Products come from this site's tool catalog, lawsuits from the
    {' '}<a href="/ai-lawsuits/">case tracker</a>, MCP servers from the official registry matched on an
    exact publisher namespace, and financial details from SEC EDGAR. A gap means this site holds no
    record, not that none exists, and nothing here was inferred to fill one. The full list is on
    {' '}<a href="/sources/">Sources and References</a>. If something is wrong or missing,
    {' '}<a href="/contact/">tell us</a>.</p>

  <Reading reading={reading} heading={`What does the record on ${n} show?`} />
  <div class="cite-box">Cite this page: <code>"{n}." AI Company Directory,
    The World of AI, theworldofai.org/companies/{company.uid}/.{generated ? ` Verified ${generated}.` : ''}</code></div>

  <p class="meta-line">Entity ID <code>{company.uid}</code>. That identifier is stable across
    this whole site, so the same company is the same record wherever it appears, whatever
    spelling a source used.</p>

  <p><a href="/companies/">All companies</a></p>
</Base>

<style>
  table { border-collapse: collapse; margin: 1em 0; width: 100%; }
  table th, table td { text-align: left; vertical-align: top; padding: .5em .7em;
    border-bottom: 1px solid #ececf2; }
  /* Row labels were INVISIBLE: Base.astro gives every th white text for the
     navy thead it expects, and this page overrides the background to light
     grey without overriding the colour. White on #f7f7fb. Stephen found it on
     Adobe's page on 2026-09-10 - Organisation, Founded, Headquarters all
     blank. Both must be set together whenever one is. */
  table th { font-weight: 600; background: #f7f7fb; color: var(--navy, #201868); }
  table.facts th { white-space: nowrap; width: 12em; }
  code { font-family: ui-monospace, monospace; font-size: .92em; }
  .faq h3 { margin: 1.1em 0 .3em; font-size: 1.05rem; }
  .faq p { margin: 0 0 .6em; }
  .cite-box { margin-top: 1.6em; padding: .9em 1em; background: #f7f7fb; border-left: 3px solid #201868; font-size: .9rem; }
  .cite-box code { display: block; margin-top: .3em; }
</style>

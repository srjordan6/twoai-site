---
/**
 * One company profile at /companies/{uid}/.
 *
 * Reads content/companies/{uid}.json, which fetch-content.mjs writes from R2.
 * The identifier is the short alphanumeric UID that pins the same organisation
 * across every page on this site, so a source that spells "OpenAI Global, LLC"
 * lands on the same page as one that spells "OpenAI, Inc."
 *
 * We show what the company publishes that we track, whether it is named as a
 * defendant in a lawsuit we follow, and whether it has published to the Model
 * Context Protocol registry. Everything is drawn from those records rather
 * than from the company's own marketing.
 */
import Base from '../../layouts/Base.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';
import { ownedServers } from '../../lib/mcpAttribution';

export function getStaticPaths() {
  if (!existsSync('content/companies')) return [];
  return readdirSync('content/companies')
    .filter((f) => f.endsWith('.json') && f !== 'index.json')
    .map((f) => JSON.parse(readFileSync(`content/companies/${f}`, 'utf8')))
    .filter((d) => d && d.company && d.company.uid)
    .map((d) => ({ params: { id: d.company.uid }, props: { company: d.company, generated: d.generated } }));
}
const { company, generated } = Astro.props;
const profile = company.profile || {};
const products = company.products || [];
const cases = company.cases || [];
// Attribution is exact, never a substring: see src/lib/mcpAttribution.ts.
const mcp = ownedServers(company.mcp, company.name);
const categories = [...new Set(products.map((p) => p.category).filter(Boolean))];
// Category hub links, built from the same slug rule the category pages use, so
// the link lands on the page that lists this company's products rather than on
// the tools hub.
const catSlug = (n) => String(n).toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const catLinks = categories.map((n) => ({ name: n, slug: catSlug(n) }));

function fmtRevenue(usd) {
  if (typeof usd !== 'number') return null;
  if (usd >= 1e12) return `$${(usd / 1e12).toFixed(2)}T`;
  if (usd >= 1e9) return `$${(usd / 1e9).toFixed(1)}B`;
  if (usd >= 1e6) return `$${(usd / 1e6).toFixed(0)}M`;
  return `$${usd.toLocaleString()}`;
}
const revenue = fmtRevenue(profile.last_revenue_usd);
const orgLabels = {
  'public-company': 'Public company',
  'startup': 'Private company',
  'research-lab': 'Research lab',
  'university-lab': 'University lab',
  'government-lab': 'Government lab',
  'nonprofit': 'Nonprofit',
  'open-source-foundation': 'Open source foundation',
};
const orgLabel = orgLabels[profile.org_type] || null;

const desc = `${company.name}: ${products.length} AI product${products.length === 1 ? '' : 's'} we track${cases.length ? `, ${cases.length} tracked lawsuit${cases.length === 1 ? '' : 's'}` : ''}${mcp.length ? `, ${mcp.length} MCP server${mcp.length === 1 ? '' : 's'}` : ''}. What ships, what is contested, and what is published, from the AI Company Directory.`;

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  description: desc,
  identifier: company.uid,
  url: `https://theworldofai.org/companies/${company.uid}/`,
  ...(products.some((p) => p.url) ? { sameAs: [...new Set(products.map((p) => p.url).filter(Boolean))] } : {}),
});
---
<Base title={`${company.name}: AI products, lawsuits, and MCP servers`} description={desc} current="/companies/" jsonld={jsonld}>
  <p class="meta-line"><a href="/companies/">AI Company Directory</a></p>
  <h1>{company.name}</h1>
  <p class="answer">{company.name} publishes <b>{products.length}</b> AI product{products.length === 1 ? '' : 's'} we track
    {cases.length > 0 && <>, is a defendant in <b>{cases.length}</b> lawsuit{cases.length === 1 ? '' : 's'} on our tracker</>}
    {mcp.length > 0 && <>, and has published <b>{mcp.length}</b> server{mcp.length === 1 ? '' : 's'} to the MCP registry</>}.
    Everything below is drawn from those records rather than from the company's own marketing.</p>
  {generated && <p class="meta-line">Last verified: <time datetime={generated}>{generated}</time> · Entity ID <code>{company.uid}</code></p>}

  {(orgLabel || profile.founded || profile.headquarters || profile.ticker || revenue) && (
    <table class="facts">
      <tbody>
        {orgLabel && <tr><th>Organisation</th><td>{orgLabel}{profile.for_profit === false && <> · not for profit</>}</td></tr>}
        {profile.founded && <tr><th>Founded</th><td>{profile.founded}</td></tr>}
        {profile.headquarters && <tr><th>Headquarters</th><td>{profile.headquarters}</td></tr>}
        {profile.ticker && <tr><th>Ticker</th><td>{profile.ticker}{profile.cik && <> · SEC CIK <a href={`https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=${profile.cik}`} rel="noopener">{profile.cik}</a></>}</td></tr>}
        {revenue && (
          <tr>
            <th>Latest annual revenue</th>
            <td>{revenue}{profile.last_revenue_end && <> for the fiscal year ending {profile.last_revenue_end}</>}{profile.last_revenue_form && <> ({profile.last_revenue_form})</>}</td>
          </tr>
        )}
        {profile.verified_on && <tr><th>Company facts verified</th><td>{profile.verified_on} from primary sources</td></tr>}
      </tbody>
    </table>
  )}

  {products.length > 0 && (
    <>
      <h2>Products</h2>
      <table>
        <thead><tr><th>Product</th><th>Category</th><th>What it does</th></tr></thead>
        <tbody>
          {products.map((p) => (
            <tr>
              <td>{p.profile
                ? <a href={`/ai-tools/${p.profile}/`}>{p.name}</a>
                : (p.url ? <a href={p.url} rel="noopener nofollow">{p.name}</a> : p.name)}</td>
              <td>{p.category}</td>
              <td>{p.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  {cases.length > 0 && (
    <>
      <h2>Lawsuits we track</h2>
      <ul>{cases.map((c) => (
        <li><a href={`/ai-lawsuits/${c.slug}/`}>{c.name}</a>{c.court && <>, {c.court}</>}</li>
      ))}</ul>
      <p class="meta-line">Matched on the defendant field of our tracker. Being named as a
        defendant is not a finding of wrongdoing.</p>
    </>
  )}

  {mcp.length > 0 && (
    <>
      <h2>MCP servers</h2>
      <ul>{mcp.map((m) => (
        <li><a href={`/mcp/${m.slug}/`}>{m.name}</a>{m.description && <> — {m.description}</>}</li>
      ))}</ul>
    </>
  )}

  <h2>Elsewhere on this site</h2>
  <p>The pages that actually name {company.name}, so you can see the same organisation from
    each angle we track it from. Hubs are listed only where they carry an entry for it.</p>
  <ul>
    <li><a href={`/companies/#c-${company.uid}`}>{company.name} in the AI Company Directory</a></li>
    {products.filter((p) => p.profile).map((p) => (
      <li><a href={`/ai-tools/${p.profile}/`}>{p.name}</a> — full tool profile</li>
    ))}
    {catLinks.map((c) => (
      <li><a href={`/ai-tools/category/${c.slug}/`}>{c.name}</a> — the tools category {company.name} appears in</li>
    ))}
    {cases.map((c) => (
      <li><a href={`/ai-lawsuits/${c.slug}/`}>{c.name}</a> — case page naming {company.name}</li>
    ))}
    {mcp.map((m) => (
      <li><a href={`/mcp/${m.slug}/`}>{m.name}</a> — MCP server published by {company.name}</li>
    ))}
  </ul>

  <div class="cite-box">Cite this page: <code>"{company.name}." AI Company Directory,
    The World of AI, theworldofai.org/companies/{company.uid}/.{generated ? ` Verified ${generated}.` : ''}</code></div>

  <p class="meta-line">Entity ID <code>{company.uid}</code>. That identifier is stable across
    this whole site, so the same company is the same record wherever it appears, whatever
    spelling a source used.</p>

  <p><a href="/companies/">All companies</a></p>
</Base>

<style>
  table { border-collapse: collapse; margin: 1em 0; width: 100%; }
  table th, table td { text-align: left; vertical-align: top; padding: .5em .7em;
    border-bottom: 1px solid #ececf2; }
  table th { font-weight: 600; background: #f7f7fb; }
  table.facts th { white-space: nowrap; width: 12em; }
  code { font-family: ui-monospace, monospace; font-size: .92em; }
  .cite-box { margin-top: 1.6em; padding: .9em 1em; background: #f7f7fb; border-left: 3px solid #201868; font-size: .9rem; }
  .cite-box code { display: block; margin-top: .3em; }
</style>

---
/**
 * The AI CVE tracker: every CVE that names an AI product, tool, model, MCP
 * server or framework the site covers, newest first. Nothing is deleted. The
 * ten newest also appear at the foot of /ai-news/; the rest live only here.
 *
 * Stephen, 2026-10-01. Sources: cve.org is the record of truth, NVD supplies
 * the score and affected products, CISA KEV marks the exploited ones.
 */
import Base from '../../../layouts/Base.astro';
import { cveList, severityClass } from '../../../lib/cves';
const d = cveList();
const cves = d.cves;
const bySev = (s: string) => cves.filter((c) => (c.cvss_severity || '').toUpperCase() === s).length;
const critical = bySev('CRITICAL');
const high = bySev('HIGH');
const products: Record<string, number> = {};
for (const c of cves) if (c.product) products[c.product] = (products[c.product] || 0) + 1;
// A TO Z BY PRODUCT. Stephen, 2026-10-03: keep the list newest first, and
// add an A to Z indexer after its heading. CVE ids all start with "CVE", so
// the letters index the products: each letter jumps to that letter's
// products in the section after the list, where every product opens to its
// CVEs, newest first. Static HTML, no script.
const byProduct: Record<string, typeof cves> = {};
for (const c of cves) (byProduct[c.product || 'Product not named'] ||= []).push(c);
const sortKey = (n: string) => String(n || '').trim().replace(/^the\s+/i, '').toLowerCase();
const letterOf = (n: string) => { const ch = sortKey(n).charAt(0).toUpperCase(); return ch >= 'A' && ch <= 'Z' ? ch : '0-9'; };
const productNames = Object.keys(byProduct).sort((a, b) => sortKey(a).localeCompare(sortKey(b)));
const azGroups: Record<string, string[]> = {};
for (const p of productNames) (azGroups[letterOf(p)] ||= []).push(p);
const azLetters = [...(azGroups['0-9'] ? ['0-9'] : []), ...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')];
// PRODUCT LINKS. Stephen, 2026-10-03: the most-named products should link
// to the products and to their CVEs. A product links to the page its CVEs
// are matched to when that page carries the product's own name (a tool page
// before a company page before a section entry); MCP is the whole category of
// MCP servers, so it links the MCP directory. A product with no page of its
// own stays plain text. The count links to the product's CVE list below.
const PRODUCT_OVERRIDE: Record<string, string> = { MCP: '/mcp/' };
const KIND_RANK: Record<string, number> = { tool: 0, company: 1, section_item: 2, mcp_server: 3 };
const normName = (x: string) => String(x || '').toLowerCase().replace(/[^a-z0-9]+/g, '');
const productHref: Record<string, string> = {};
for (const p of Object.keys(byProduct)) {
  if (PRODUCT_OVERRIDE[p]) { productHref[p] = PRODUCT_OVERRIDE[p]; continue; }
  const np = normName(p);
  let best = '', bestScore = 99;
  for (const c of byProduct[p]) for (const e of (c.entities || [])) {
    const ne = normName(e.name);
    if (!ne || !e.href) continue;
    const exact = ne === np;
    if (!exact && !ne.includes(np) && !np.includes(ne)) continue;
    const score = (exact ? 0 : 10) + (KIND_RANK[e.kind] ?? 5);
    if (score < bestScore) { bestScore = score; best = e.href; }
  }
  if (best) productHref[p] = best;
}
const prodId = (p: string) => `prod-${String(p).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
const azAnchor = (l: string) => (l === '0-9' ? 'p-0-9' : `p-${l.toLowerCase()}`);
const topProducts = Object.entries(products).sort((a, b) => b[1] - a[1]).slice(0, 12);
const desc = `${cves.length} CVEs naming AI tools, models, agents, MCP servers and frameworks, newest first, with CVSS severity and CISA's exploited-in-the-wild flag. ${critical} critical, ${high} high. Updated ${d.generated}.`;
const jsonld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'AI CVE tracker', description: desc.slice(0, 300), dateModified: d.generated,
  url: 'https://theworldofai.org/ai-news/cves/',
  isPartOf: { '@type': 'CollectionPage', name: 'AI News', url: 'https://theworldofai.org/ai-news/' },
});
---
<Base title="AI CVE tracker: vulnerabilities in AI tools, models and agents" description={desc.slice(0, 300)} current="/ai-news/" jsonld={jsonld}>
  <p class="meta-line"><a href="/ai-news/">AI News</a> · AI CVE tracker</p>
  <h1>AI CVE tracker</h1>
  <p class="answer"><b>{cves.length}</b> CVEs on record that name an AI product, tool, model, agent framework,
    MCP server or AI library the site covers: <b>{critical}</b> rated critical, <b>{high}</b> high, and
    <b>{d.kev}</b> on CISA's list of vulnerabilities exploited in the wild. Newest first. A CVE
    leaves the ten shown on the AI News page as newer ones arrive, but never leaves this list.</p>
  <p class="meta-line">Last verified: <time datetime={d.generated}>{d.generated}</time></p>

  <h2>What qualifies</h2>
  <p>A CVE is listed when the affected product is an AI tool, model, hardware item, MCP server or
    framework with a page on this site, or an AI product we track by name. A CVE that only names a
    company we profile is listed when its text is about AI. Each entry links to the product's own
    page, and that page lists its CVEs at the foot. The identifier and description come from
    cve.org, the CVE Program run by MITRE; the severity score, the weakness class and the affected
    product names come from NVD; the exploited flag comes from CISA.</p>

  {topProducts.length > 0 && (
    <>
      <h2>Most named products</h2>
      <p class="meta-line top-products">{topProducts.map(([p, n], i) => <>{i > 0 && ' · '}{productHref[p] ? <a href={productHref[p]}>{p}</a> : p} (<a href={`#${prodId(p)}`} title={`${p} CVEs`}>{n}</a>)</>)}</p>
    </>
  )}

  <h2>All AI CVEs, newest first</h2>
  <nav class="az-index" id="az-index" aria-label="AI CVEs by product, A to Z">
    <span class="az-label">Products A to Z</span>
    {azLetters.map((l) => (azGroups[l]
      ? <a href={`#${azAnchor(l)}`}>{l}</a>
      : <span class="az-empty" aria-hidden="true">{l}</span>))}
  </nav>
  <ul class="cve-list">
    {cves.map((c) => (
      <li>
        <a href={`/ai-news/cves/${c.cve_id}/`}>{c.headline ? c.headline : <code>{c.cve_id}</code>}</a>
        {c.headline && <code class="cve-id">{c.cve_id}</code>}
        {c.cvss_severity && <span class={`sev ${severityClass(c.cvss_severity)}`}>{c.cvss_severity}{c.cvss_score != null && <> {c.cvss_score}</>}</span>}
        {c.kev && <span class="kev">Exploited in the wild</span>}
        <span class="cve-date">{c.published}</span>
        {c.product && <span class="cve-prod">{c.product}</span>}
        <span class="cve-sum">{c.summary}</span>
        {c.entities?.length > 0 && (
          <span class="cve-ents">On this site: {c.entities.slice(0, 4).map((e, i) => <>{i > 0 && ', '}<a href={e.href}>{e.name}</a></>)}</span>
        )}
      </li>
    ))}
  </ul>

  <h2 id="by-product">AI CVEs by product, A to Z</h2>
  <p class="meta-line">{productNames.length} products. Open a product to see its CVEs, newest first.</p>
  {azLetters.filter((l) => azGroups[l]).map((l) => (
    <section class="az-group">
      <h3 id={azAnchor(l)}>{l}</h3>
      {azGroups[l].map((p) => (
        <details class="az-product">
          <summary>{p} <span class="az-n">{byProduct[p].length}</span></summary>
          {productHref[p] && <p class="az-prodlink"><a href={productHref[p]}>{p} on this site</a></p>}
          <ul id={prodId(p)}>
            {byProduct[p].map((c) => (
              <li><a href={`/ai-news/cves/${c.cve_id}/`}>{c.headline || c.cve_id}</a> <span class="cve-id">{c.cve_id}</span> <span class="cve-date">{c.published}</span></li>
            ))}
          </ul>
        </details>
      ))}
      <p class="az-top"><a href="#az-index">Back to top</a></p>
    </section>
  ))}

  <div class="cite-box">Cite this page: <code>"AI CVE tracker." The World of AI,
    theworldofai.org/ai-news/cves/. Retrieved {d.generated}.</code></div>

  <p class="meta-line">CVE records are published by the <a href="https://www.cve.org/" rel="noopener">CVE Program</a>
    (MITRE) and enriched by the <a href="https://nvd.nist.gov/" rel="noopener">National Vulnerability Database</a> (NIST);
    both are public US government data. The exploited flag is CISA's
    {' '}<a href="https://www.cisa.gov/known-exploited-vulnerabilities-catalog" rel="noopener">Known Exploited Vulnerabilities catalog</a>.
    Listing a CVE is a record that a flaw was reported, not an assessment of the product.</p>
</Base>

<style>
  code { font-family: 'Poppins', sans-serif; font-weight: 600; color: #201868; }

  .cve-list { list-style: none; padding: 0; margin: .6em 0 1em; }
  .cve-list li { padding: .7em 0; border-bottom: 1px solid rgba(122, 138, 158, 0.25); font-size: 14.5px; line-height: 1.6; }
  .cve-list code { font-weight: 700; color: #201868; }
  .cve-list .cve-id { font-weight: 400; color: #7A8A9E; margin-left: .5em; font-size: 13px; }
  .cve-sum { display: block; color: #201868; margin-top: 2px; }
  .cve-ents { display: block; font-size: 13px; color: #7A8A9E; margin-top: 2px; }
  .cve-date, .cve-prod { color: #7A8A9E; margin-left: .5em; font-size: 13px; }
  .sev { display: inline-block; margin-left: .5em; padding: 0 .45em; border-radius: 3px; font-size: 11.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #fff; background: #7A8A9E; }
  .sev-critical { background: #F07800; }
  .sev-high { background: #201868; }
  .sev-medium { background: #7A8A9E; }
  .sev-low { background: #FFFFFF; color: #7A8A9E; box-shadow: inset 0 0 0 1px #7A8A9E; }
  .kev { display: inline-block; margin-left: .5em; padding: 0 .45em; border-radius: 3px; font-size: 11.5px; font-weight: 700; color: #F07800; border: 1px solid #F07800; }
  .cite-box { margin: 1.6em 0; padding: .9em 1em; background: #FFF6EC; border-left: 3px solid #201868; font-size: .9rem; }
  .cite-box code { display: block; margin-top: .3em; }
  .az-index { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25em .5em; margin: .4em 0 1.2em; font-weight: 600; font-size: 15px; }
  .az-label { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #F07800; margin-right: .5em; }
  .az-index a { color: #201868; text-decoration: none; min-width: 1.4em; text-align: center; }
  .az-index a:hover { color: #F07800; }
  .az-empty { color: rgba(122, 138, 158, 0.45); min-width: 1.4em; text-align: center; }
  .az-group h3 { margin: 1.2em 0 .3em; color: #201868; scroll-margin-top: 80px; }
  .az-product { border-bottom: 1px solid rgba(122, 138, 158, 0.25); padding: .35em 0; }
  .az-product summary { cursor: pointer; color: #201868; font-weight: 600; }
  .az-n { display: inline-block; margin-left: .4em; padding: 0 .5em; border-radius: 10px; background: #FFF6EC; color: #201868; font-size: 12px; font-weight: 600; }
  .az-product ul { list-style: none; padding: 0 0 0 1em; margin: .4em 0; }
  .az-product li { padding: .2em 0; font-size: 14px; }
  .az-product .cve-id { margin-left: .4em; color: #7A8A9E; font-size: 13px; }
  .az-top { font-size: 13px; margin: .4em 0 0; }
  .az-prodlink { font-size: 13px; margin: .3em 0 0 1em; }
  .az-product ul { scroll-margin-top: 90px; }
  .top-products a { color: #201868; }
  .top-products a:hover { color: #F07800; }
</style>

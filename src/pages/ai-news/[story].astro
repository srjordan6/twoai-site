---
/**
 * One page per top story, mirroring the srjconsultingservices.com structure:
 * header with date and compile time, the pipeline-written summary, key
 * numbers, coverage sources, a day-level coverage timeline, and a sticky
 * contents rail. Both sites render the same news.json artifact.
 *
 * WHAT IS NOT HERE, AND WHY. The structure asks for intraday timestamps.
 * GDELT carries them; the pipeline stores only the date. Grouping by hour
 * would mean inventing times, so the timeline groups by DAY and says so.
 * "Why it matters" renders from s.Why when the pipeline supplies analysis,
 * and is otherwise absent rather than guessed.
 */
import Base from '../../layouts/Base.astro';
import KeepReading from '../../components/KeepReading.astro';
import { matchTerms, companyFor } from '../../lib/related';
import { categoryOf, coverageByDay, readingMinutes, titleCase, type Story } from '../../lib/newsTopics';

import { loadKnownEntities, resolveEntities } from '../../lib/knownEntities';
export async function getStaticPaths() {
  const mods = import.meta.glob('../../../content/news/news.json', { eager: true });
  const news: any = Object.values(mods)[0]?.default ?? null;
  const arch = import.meta.glob('../../../content/news/archive.json', { eager: true });
  const archive: any = Object.values(arch)[0]?.default ?? null;

  // Today's clustering first, so a story still in the news renders with the
  // live outlet counts; the archive then supplies every slug ever published.
  // news.json is fetched fresh from srj-content on every build and only ever
  // holds today, so without the archive a permalink lived exactly one day.
  const out: any[] = [];
  const seen = new Set<string>();
  for (const s of news?.stories ?? []) {
    if (!s.Slug || seen.has(s.Slug)) continue;
    seen.add(s.Slug);
    out.push({ params: { story: s.Slug }, props: { s, date: news.date, generated: news.generated } });
  }
  for (const raw of archive?.stories ?? []) {
    // The enactment trigger writes archive rows with lowercase keys (slug,
    // headline, summary, source_url) where the clustering pipeline writes
    // capitalised ones. The first version of this loop only read s.Slug, so
    // every enacted-law story was silently skipped and its permalink 404ed.
    // Normalise both shapes here rather than asking two Go writers to agree.
    const s = raw.Slug ? raw : {
      ...raw,
      Slug: raw.slug,
      Headline: raw.headline,
      Summary: raw.summary,
      SummaryURL: raw.source_url,
      SummaryDomain: raw.source_name,
      DomainCount: 1,
      ArticleCount: 1,
      Articles: raw.source_url ? [{ Title: raw.headline, URL: raw.source_url }] : [],
    };
    if (!s.Slug || seen.has(s.Slug)) continue;
    seen.add(s.Slug);
    out.push({
      params: { story: s.Slug },
      // An archived story dates itself from the day it ran, not from the day
      // the archive was last written.
      props: { s, date: s.ArchivedDate ?? s.published_on ?? archive.date, generated: s.ArchivedGenerated ?? archive.generated },
    });
  }
  return out;
}

const { s, date, generated } = Astro.props;

// Go marshals a nil slice to JSON null, not []. One story with Orgs: null
// took an entire site build down on 2026-07-28, because these pages are
// prerendered and a single bad record fails all of them. The pipeline now
// refuses to publish such a payload, but this guard stays.
const story: Story = {
  ...s,
  Orgs: s.Orgs ?? [],
  Persons: s.Persons ?? [],
  Domains: s.Domains ?? [],
  Articles: s.Articles ?? [],
};

const cat = categoryOf(story);
// Onward links: terms this story actually names, and the company pages for any
// organisation in it that we track. See src/lib/related.ts for why the matching
// is whole-word and exact-name rather than substring.
const krTerms = matchTerms(`${story.Title ?? ''} ${story.Summary ?? story.Description ?? ''}`);

// Entity chips and the sidebar list are restricted to organisations and people
// this site publishes a page for, and render as links to those pages. The raw
// Orgs and Persons arrays come from GDELT's extractor and are mostly fragments
// and generic phrases; highlighting them implied a depth of coverage that did
// not exist, and gave the reader nowhere to go. See lib/knownEntities.ts.
const knownEntityIndex = loadKnownEntities();
const knownOrgs = resolveEntities(story.Orgs, knownEntityIndex, 12);
const knownPersons = resolveEntities(story.Persons, knownEntityIndex, 12);
const known4 = [...knownOrgs, ...knownPersons].slice(0, 4);

const timeline = coverageByDay(story.Articles);
const stamp = generated ? `${new Date(generated).toUTCString().slice(0, 22)} UTC` : null;

// ENACTED-LAW ROWS ARE A DIFFERENT ANIMAL FROM A COVERAGE CLUSTER, and the page
// was treating them the same. A cluster is many outlets writing about an event;
// an enactment row is one legislative record with a bill number, a state and a
// LegiScan URL, and no outlets at all. That is why these pages rendered barely
// 235 words: every coverage-shaped section on the page had nothing to show.
//
// The two sections below are the parts a legislative record can actually
// support, and both are routing rather than commentary: this site already
// publishes every tracked bill for that state and a compliance reference
// verified against primary sources, and neither was linked from here.
const enacted = (story.kind ?? story.Kind) === 'enacted-law';
const billNo = story.bill ?? story.Bill ?? '';
const stateCode = String(story.state ?? story.State ?? '').toUpperCase();
const STATE_SLUG = {
  AL: 'alabama', AK: 'alaska', AZ: 'arizona', AR: 'arkansas', CA: 'california', CO: 'colorado',
  CT: 'connecticut', DE: 'delaware', DC: 'district-of-columbia', FL: 'florida', GA: 'georgia',
  HI: 'hawaii', ID: 'idaho', IL: 'illinois', IN: 'indiana', IA: 'iowa', KS: 'kansas',
  KY: 'kentucky', LA: 'louisiana', ME: 'maine', MD: 'maryland', MA: 'massachusetts',
  MI: 'michigan', MN: 'minnesota', MS: 'mississippi', MO: 'missouri', MT: 'montana',
  NE: 'nebraska', NV: 'nevada', NH: 'new-hampshire', NJ: 'new-jersey', NM: 'new-mexico',
  NY: 'new-york', NC: 'north-carolina', ND: 'north-dakota', OH: 'ohio', OK: 'oklahoma',
  OR: 'oregon', PA: 'pennsylvania', PR: 'puerto-rico', RI: 'rhode-island', SC: 'south-carolina',
  SD: 'south-dakota', TN: 'tennessee', TX: 'texas', UT: 'utah', VT: 'vermont', VA: 'virginia',
  WA: 'washington', WV: 'west-virginia', WI: 'wisconsin', WY: 'wyoming',
};
const stateSlug = STATE_SLUG[stateCode] ?? '';
const stateName = stateSlug ? stateSlug.split('-').map((w) => w[0].toUpperCase() + w.slice(1)).join(' ') : stateCode;
const minutes = readingMinutes(story.Headline, ...story.Articles.map((a) => a.Title));

// 58 + " | AI News" (10) keeps the whole title tag at or under 68 characters.
const title = story.Headline.length <= 58 ? story.Headline : `${story.Headline.slice(0, 57).replace(/\s+\S*$/, '')}…`;
const _fullDesc =
  `${story.Headline}. Covered by ${story.DomainCount} outlets across ${story.ArticleCount} ` +
  `articles: full source list, named entities, and coverage timeline.`;
const description = _fullDesc.length <= 158 ? _fullDesc : `${_fullDesc.slice(0, 157).replace(/\s+\S*$/, '')}…`;

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: story.Headline,
      url: `https://theworldofai.org/ai-news/${story.Slug}/`,
      description,
      datePublished: date,
      dateModified: generated,
    },
    {
      '@type': 'ItemList',
      name: `Sources covering: ${story.Headline}`,
      itemListElement: story.Articles.map((a, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: a.Title,
        url: a.URL,
      })),
    },
  ],
});
---
<Base title={`${title} | AI News`} description={description} current="/ai-news/" jsonld={jsonld} ogType="article">
  <p class="meta-line"><a href="/ai-news/">AI News</a> · <a href="/ai-news/daily/">Daily News</a></p>
  <h1>{story.Headline}</h1>
  <p class="dateline">
    <strong>Daily briefing</strong> · {date}
    {stamp && <> · compiled {stamp}</>}
    · {minutes}-minute read
  </p>
  <div class="pills">
    <a class="pill pill-cat" href={`/ai-news/daily/#${cat.slug}`}>{cat.name}</a>
    {known4.map((e) => <a class="pill" href={e.href}>{e.label}</a>)}
  </div>

  <Fragment slot="rail">
      <div class="panel sticky">
        <p class="box-label">On this page</p>
        <ul class="toc">
          {story.Summary && <li><a href="#the-story">The story</a></li>}
          {story.Why && <li><a href="#why">Why it matters</a></li>}
          <li><a href="#coverage">Coverage</a></li>
          {timeline.length > 0 && <li><a href="#timeline">Coverage timeline</a></li>}
          <li><a href="/ai-news/daily/">Back to the briefing</a></li>
        </ul>
      </div>

      <div class="panel">
        <p class="box-label">Key numbers</p>
        <table class="dash">
          <tbody>
            <tr><th scope="row">Outlets</th><td>{story.DomainCount}</td></tr>
            <tr><th scope="row">Articles in 36h</th><td>{story.ArticleCount}</td></tr>
            <tr><th scope="row">Days of coverage</th><td>{timeline.length}</td></tr>
            <tr><th scope="row">Category</th><td>{cat.name}</td></tr>
          </tbody>
        </table>
        {story.Domains.length > 0 && <p class="doms">{story.Domains.join(' · ')}</p>}
      </div>

      {(knownPersons.length > 0 || knownOrgs.length > 0) && (
        <div class="panel">
          <p class="box-label">Covered on this site</p>
          {knownPersons.length > 0 && (
            <p class="wl"><span>People</span>{knownPersons.map((e, i) => (
              <>{i > 0 && ', '}<a href={e.href}>{e.label}</a></>
            ))}</p>
          )}
          {knownOrgs.length > 0 && (
            <p class="wl"><span>Organizations</span>{knownOrgs.map((e, i) => (
              <>{i > 0 && ', '}<a href={e.href}>{e.label}</a></>
            ))}</p>
          )}
        </div>
      )}
  </Fragment>

  <div class="story-body">
    <div class="main">
      {story.Summary && (
        <div class="story-summary" id="the-story">
          <h2>The story</h2>
          {/* The summariser writes Markdown, and its output is stored as
              written: dozens of archive summaries begin "# Summary". Split on
              lines and printed verbatim, that hash reached the reader as a
              literal character at the top of the story - the same defect the
              ask box had. Heading lines are dropped rather than rendered,
              because the section already carries its own "The story" heading
              and a second one saying "Summary" adds nothing; bold and italic
              markers are unwrapped in place. */}
          {story.Summary.split('\n')
            .map((p: string) => p.trim())
            .filter((p: string) => p && !/^#{1,6}\s/.test(p))
            .map((p: string) => p.replace(/\*\*([^*]+)\*\*/g, '$1').replace(/(^|\s)\*([^*]+)\*/g, '$1$2'))
            .map((p: string) => <p>{p}</p>)}
          {story.SummaryURL && (
            <p class="summary-attribution">
              Summarized from reporting first published by {story.SummaryDomain}.
              <a href={story.SummaryURL} rel="nofollow noopener" target="_blank">Read the original coverage.</a>
            </p>
          )}
        </div>
      )}

      {story.Why && (
        <div class="why" id="why">
          <p class="box-label">Why it matters</p>
          <p>{story.Why}</p>
        </div>
      )}

      <section id="coverage">
        <h2>Coverage</h2>
        <div class="rule"></div>
        <p class="lead">
          This story was carried by <strong>{story.DomainCount}</strong> distinct outlets across
          <strong> {story.ArticleCount}</strong> articles in the past 36 hours. Every source the
          pipeline found is listed below, unedited.
        </p>
        <ul class="cov">
          {story.Articles.map((a) => (
            <li>
              <a href={a.URL} rel="noopener nofollow" target="_blank">{a.Title}</a>
              <span class="meta">{a.Domain}{a.Date ? ` · ${a.Date}` : ''}</span>
            </li>
          ))}
        </ul>
      </section>

      {timeline.length > 0 && (
        <section id="timeline">
          <h2>Coverage timeline</h2>
          <div class="rule"></div>
          <ol class="tl">
            {timeline.map((t) => (
              <li>
                <span class="tl-day">{t.day}</span>
                <span class="tl-body">
                  <strong>{t.count}</strong> {t.count === 1 ? 'article' : 'articles'} across
                  <strong> {t.outlets}</strong> {t.outlets === 1 ? 'outlet' : 'outlets'}
                </span>
              </li>
            ))}
          </ol>
          <p class="tl-note">
            Grouped by day. The pipeline records publication dates, not times, so
            hour-level sequencing is not shown rather than estimated.
          </p>
        </section>
      )}

      {enacted && (
        <section>
          <h2>What is this record, and what is it not?</h2>
          <p>
            This page reports that {billNo ? <b>{billNo}</b> : <>a bill</>}
            {stateName ? <> was enacted in {stateName}</> : <> was enacted</>}, and it links to the
            legislative record that says so. The record is the authority: bill text, version
            history, sponsors and roll-call votes all live at the source, and the summary above is
            drawn from the bill's own title and status rather than from anyone's reading of it.
          </p>
          <p>
            What this page is not is an interpretation. Enactment is a date, not a compliance
            obligation: most statutes carry an effective date later than the signing, many apply
            only to defined entities, and the operative requirements sit in sections the title does
            not name. Nothing here tells you whether the law reaches your organisation. For that,
            start from the text and then the reference pages below, which are verified against
            primary sources rather than assembled from coverage.
          </p>
          <p>
            Legislative tracking is also incomplete by nature. A bill that passed under a title
            with no artificial intelligence language in it can still regulate an automated system,
            and a bill whose title mentions AI can turn out to be a study committee. Treat the
            tracker as a floor on what a state has done, never as the whole of it.
          </p>

          <h2>Where does {stateName || 'this state'} stand overall?</h2>
          <p>
            One enactment is a data point, not a position.
            {stateSlug ? (
              <> Every bill this site tracks for the state is on the
                {' '}<a href={`/ai-laws/${stateSlug}/`}>{stateName} AI laws page</a>, most recent
                first, each linked to its own record, which is the view that shows whether this is
                a first move or one of a series.</>
            ) : (
              <> The <a href="/ai-laws/">state AI law tracker</a> carries every bill this site
                tracks, by state.</>
            )}
            {' '}The <a href="/ai-laws/">fifty-state tracker</a> puts it beside everyone else, and
            the <a href="/ai-compliance/">compliance reference</a> covers the frameworks and
            obligations that sit above the state layer.
          </p>
        </section>
      )}

      {!enacted && (
        <section>
          <h2>How was this story assembled?</h2>
          <p>
            By clustering, not by editing. The pipeline reads worldwide coverage, groups articles
            reporting the same event, and ranks the result by how many distinct outlets carried it.
            No article is reproduced here: every headline above links to its publisher, and the
            page holds titles, domains and dates only.
          </p>
          <p>
            Outlet breadth is a measure of how widely something was reported, which is not the same
            as how much it matters. A syndicated wire story reaches dozens of domains from one
            newsroom, and a significant technical development can surface in two publications and
            nowhere else. Named organisations and people are extracted mechanically from the
            coverage, which is why they appear in lower case and why a name occasionally belongs to
            the wrong entity. Where a name matches something this site actually tracks, it is
            linked; where it does not, it is left as text rather than guessed at.
          </p>
        </section>
      )}

      <p class="note">
        Coverage is discovery, never evidence. Where this story touches a law, framework, or
        requirement, the authoritative treatment lives in the
        <a href="/ai-compliance/">AI compliance reference pages</a>, verified against primary
        sources.
      </p>
    </div>
  </div>
  <KeepReading blocks={[
    { label: 'Terms in this story, defined',
      links: krTerms.map((t) => ({ href: `/ai-glossary/${t.slug}/`, label: t.term, note: t.category })) },
    { label: 'Organisations we track in this story',
      // knownOrgs are already resolved against our own entities by
      // resolveEntities, carrying {label, href}. Reusing that is more accurate
      // than re-matching the name here, and it is the same list the story chips
      // are built from, so the two cannot disagree.
      links: (knownOrgs ?? []).slice(0, 6).map((o: any) => ({ href: o.href, label: o.label })) },
    { label: 'Across the site', links: [
      { href: '/ai-news/daily/', label: 'Today\u2019s briefing', note: 'the whole day in one page' },
      { href: '/ai-news/vendor/', label: 'Vendor announcements', note: 'straight from the source' },
      { href: '/ai-glossary/', label: 'The AI glossary', note: '500+ terms in plain English' },
      { href: '/ai-lawsuits/', label: 'The AI lawsuit tracker', note: 'live case status from the dockets' },
    ] },
  ]} />
</Base>

<style>
  h1 { max-width: 28ch; line-height: 1.2; }
  .dateline { color: #7A8A9E; font-size: 14px; }
  .dateline strong { color: #201868; }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 26px; }
  .pill { display: inline-block; background: #201868; color: #fff; font-size: 12px; padding: 4px 12px; border-radius: 999px;
    text-decoration: none; }
  .pill:hover { background: #F07800; }
  .wl a { color: var(--navy, #201868); text-decoration: none; font-weight: 600; }
  .wl a:hover { color: #F07800; }
  .pill-cat { background: #F07800; text-decoration: none; }

  /* THE NESTED SECOND SIDEBAR IS GONE. This template used to open its own
     two-column grid INSIDE Base's main column, while Base was already
     reserving a 300px rail beside it. At 1440px that produced three columns
     and left the article text 374 pixels wide - narrower than the panels
     beside it - and below 960px the panels dropped underneath the article at
     full width, which is the layout Stephen photographed. The panels now go
     into Base's own rail slot, so the page has ONE right-hand rail like every
     other page on the site and the article keeps the full measure. */
  .story-body { max-width: 100%; }

  h2 { color: #201868; font-size: 24px; margin: 30px 0 4px; }
  .rule { width: 56px; height: 3px; background: #F07800; margin: 0 0 18px; }
  .box-label { font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #F07800; margin: 0 0 10px; }

  .why { background: #FFF6EC; border: 1px solid #F0D6B0; border-radius: 6px; padding: 20px 24px; margin: 6px 0 8px; scroll-margin-top: 80px; }
  .why p { font-size: 16px; line-height: 1.7; color: #2C2C2A; margin: 0; }

  .lead { font-size: 15px; line-height: 1.7; color: #2C2C2A; max-width: 70ch; }
  #coverage, #timeline, #the-story { scroll-margin-top: 80px; }
  .story-summary { margin: 0 0 2rem; }
  .story-summary p { font-size: 1.05rem; line-height: 1.7; }
  .summary-attribution { font-size: 0.85rem; color: #7A8A9E; }
  .summary-attribution a { color: #201868; margin-left: 4px; }

  .cov { list-style: none; margin: 0; padding: 0; max-width: 780px; }
  .cov li { padding: 13px 0; border-bottom: 1px solid #e8e6e0; }
  .cov li:last-child { border-bottom: none; }
  .cov a { color: #201868; text-decoration: none; font-weight: 500; }
  .cov a:hover { color: #F07800; }
  .cov .meta { display: block; font-size: 13px; color: #7A8A9E; margin-top: 3px; }

  .tl { list-style: none; margin: 0; padding: 0; max-width: 620px; }
  .tl li { display: flex; gap: 16px; align-items: baseline; padding: 11px 0; border-bottom: 1px solid #f0eee8; }
  .tl li:last-child { border-bottom: none; }
  .tl-day { font-size: 13px; font-weight: 700; color: #F07800; min-width: 96px; letter-spacing: .03em; }
  .tl-body { font-size: 14.5px; color: #2C2C2A; }
  .tl-body strong { color: #201868; }
  .tl-note { font-size: 12.5px; color: #7A8A9E; font-style: italic; margin: 10px 0 0; max-width: 62ch; }

  .note { margin-top: 34px; font-size: 14px; color: #7A8A9E; font-style: italic; max-width: 68ch; }
  .note a { color: #201868; }

  /* .side is retired with the nested grid; Base owns rail spacing now. */
  .panel { border: 1px solid #e6e4de; border-radius: 10px; padding: 18px 20px; background: #fafaf6; }
  .sticky { position: sticky; top: 20px; }
  .toc { list-style: none; margin: 0; padding: 0; }
  .toc li { margin: 0 0 7px; }
  .toc a { font-size: 13.5px; color: #201868; text-decoration: none; }
  .toc a:hover { color: #F07800; }
  .dash { width: 100%; border-collapse: collapse; }
  .dash th, .dash td { font-size: 13.5px; padding: 7px 0; border-bottom: 1px solid #eceae4; text-align: left; }
  /* Base styles every th in the site with a navy fill and white text, which
     is right for a data table and wrong for a two-column key-value panel: the
     local rule here overrode the COLOUR to grey but not the BACKGROUND, so the
     labels rendered grey-on-navy - unreadable bars down the side of the rail.
     Same shape as the footer icon defect: a global rule and a local one
     touching the same element, and only the rendered result shows it. */
  .dash th { color: #7A8A9E; font-weight: 500; background: transparent; padding-left: 0; }
  .dash td { color: #201868; font-weight: 700; text-align: right; }
  .dash tr:last-child th, .dash tr:last-child td { border-bottom: none; }
  .doms { font-size: 12px; color: #7A8A9E; line-height: 1.6; margin: 10px 0 0; }
  .wl { font-size: 13.5px; line-height: 1.6; margin: 0 0 10px; color: #2C2C2A; }
  .wl span { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: #201868; font-weight: 700; margin-bottom: 2px; }
</style>

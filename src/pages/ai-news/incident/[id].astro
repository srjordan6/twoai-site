---
/**
 * One page per logged harm, at /ai-news/incident/{AIID number}/.
 *
 * Stephen, 2026-08-31: a full page describing the report, with the link to
 * the publisher at the very bottom, so the reader is reading our content the
 * whole way down. The briefing used to send a reader straight out on the
 * headline, which is the opposite of that.
 *
 * Everything above the sources block is ours: the summary the pipeline
 * writes in its own words from the reporting, and the reading Sonnet writes
 * from those facts about what the incident shows. The publishers' headlines
 * and links sit in one block at the foot, where they credit the reporting
 * without being the reason to leave.
 *
 * The AIID incident number is the slug because it is stable, public and
 * citable: /ai-news/incident/1661/ is incident 1661 forever.
 */
import Base from '../../../layouts/Base.astro';
import { incidentUid } from '../../../lib/storyUid';
import { capParagraphs } from '../../../lib/prose';
import { translatedFrom } from '../../../lib/langs';

export function getStaticPaths() {
  const mods = import.meta.glob('../../../../content/news/incident-*.json', { eager: true });
  return Object.values(mods)
    .map((m: any) => m?.default)
    .filter((d: any) => d && d.incident_id && d.title)
    .map((d: any) => ({ params: { id: String(d.incident_id) }, props: { inc: d } }));
}
const { inc } = Astro.props;
// Every outlet's headline in English, with the language it was translated
// from (bridge row 508); the outlet's own wording is never shown.
const reports: any[] = (inc.reports ?? []).map((r: any) => ({
  ...r,
  fromLang: translatedFrom(r.title_lang, r.title_original, r.title),
}));
// THE HEADLINE IN ENGLISH. Stephen, 2026-09-11, on incident 1684: the H1
// was a Dutch parliamentary motion, verbatim, above an English summary. The
// summary and reading were always English because Claude wrote them; the
// title was copied from the feed and never touched. The pipeline now
// translates any non-English headline once and carries it as title_en with
// title_lang. The page leads with the English rendering and says it is a
// translation. Language names come from src/lib/langs.ts.
//
// EVERYTHING IN ENGLISH, 2026-10-06 (bridge row 508, after incident 1722 led
// with a Hindi headline because the translator had been silently off since
// 2026-09-17). Pages built since then carry the English in title and the
// publisher's headline in title_original; pages built before carry the
// original in title and the English in title_en. Both read the same way
// here. The original headline is no longer printed under the H1, and the
// source links at the foot carry the English too: the page names the
// language and keeps the original only in the JSON-LD.
const headline = inc.title_en || inc.title;
const originalTitle = inc.title_original || (inc.title_en && inc.title_en !== inc.title ? inc.title : '');
const langName = translatedFrom(inc.title_lang, originalTitle, headline);
const translated = !!langName;
const paras = (t: string) => capParagraphs(t);
const dates = reports.map((r) => r.published).filter(Boolean).sort();
const first = dates[0];
const last = dates[dates.length - 1];

// THE STAMP. This page had none at all - no date, no time, no uid - so the one
// kind of record on this site that is a report of real harm was the one nobody
// could cite. Stephen, 2026-09-06.
//
// The uid shown is the INCIDENT's, sha256("incident:" + AIID number), which is
// what twoai_entities registers. NOT inc.page_uid, which is minted from the
// document path and identifies the page rather than the incident; the two are
// different strings and only one of them means anything to the register or to
// a reader citing the harm.
const stampDoc = {
  page_uid: incidentUid(inc.incident_id, inc.uid),
  built_at: inc.built_at ?? inc.generated,
  generated: inc.published ?? inc.generated,
};

const desc = `${headline}. A logged harm from a deployed AI system, catalogued by the AI Incident Database as incident ${inc.incident_id}, reported by ${inc.outlet_count || reports.length} ${(inc.outlet_count || reports.length) === 1 ? 'outlet' : 'outlets'}. What happened, what kind of failure it was, and what is not established.`;

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: headline,
  ...(translated ? { alternativeHeadline: originalTitle, inLanguage: 'en' } : {}),
  description: desc.slice(0, 300),
  datePublished: inc.published || inc.generated,
  dateModified: inc.generated,
  url: `https://theworldofai.org/ai-news/incident/${inc.incident_id}/`,
  isPartOf: { '@type': 'CollectionPage', name: 'AI News', url: 'https://theworldofai.org/ai-news/' },
  citation: reports.map((r) => ({ '@type': 'CreativeWork', name: r.title, url: r.url })),
});
import { citeUID } from '../../../lib/cite';
// The uid every citation of this page carries (Stephen, 2026-10-08).
const citeUid = citeUID(Astro.url.pathname, incidentUid(inc.incident_id, inc.uid));
---
<Base title={`${headline} — logged harm — The World of AI`} description={desc.slice(0, 300)} current="/ai-news/" jsonld={jsonld} doc={stampDoc} stampLabel="Incident recorded">
  <p class="meta-line"><a href="/ai-news/">AI News</a> ·
    <a href="/ai-news/daily/#incidents">When AI goes wrong</a></p>
  <h1>{headline}</h1>
  {translated && (
    <p class="meta-line original-title">Translated from {langName}</p>
  )}

  <p class="answer">A report of real-world harm from a deployed AI system, catalogued by the
    AI Incident Database as <b>incident {inc.incident_id}</b> and carried by
    {' '}<b>{inc.outlet_count || reports.length}</b>
    {(inc.outlet_count || reports.length) === 1 ? ' outlet' : ' outlets'}
    {first && <> between {first} and {last}</>}. Listing an incident is a record that the harm
    was reported, not a finding of fault.</p>
  <p class="meta-line">Last verified: <time datetime={inc.generated}>{inc.generated}</time>
    {' '}&middot; <span class="uid" title="This incident's identifier on theworldofai.org">uid {incidentUid(inc.incident_id, inc.uid)}</span></p>

  {inc.summary && (
    <>
      <h2>What happened</h2>
      {paras(inc.summary).map((p) => <p>{p}</p>)}
      {inc.summary_domain === 'incidentdatabase.ai' ? (
        <p class="meta-line">Written here in our own words from the AI Incident Database's own
          description of this incident, because the reporting listed at the foot of this page sits
          behind a paywall or blocks automated reading. The articles and the database's write-up
          belong to their authors.</p>
      ) : (
      <p class="meta-line">Written here from the reporting listed at the foot of this page,
        first published by {inc.summary_domain}. We publish the facts in our own words; the
        articles and the database's own write-ups belong to their authors.</p>
      )}
    </>
  )}

  {inc.reading?.body && (
    <>
      <h2>What this incident shows</h2>
      {paras(inc.reading.body).map((p) => <p>{p}</p>)}
      <p class="meta-line">Written {inc.reading.generated_on} from the facts above and nothing
        else. It is rewritten whenever the reporting changes.</p>
    </>
  )}

  <h2>How widely was it reported?</h2>
  <p>{reports.length} {reports.length === 1 ? 'report' : 'reports'} from
    {' '}{inc.outlet_count || reports.length}
    {(inc.outlet_count || reports.length) === 1 ? ' outlet' : ' outlets'}
    {first && last && first !== last
      ? <>, the first on {first} and the most recent on {last}</>
      : first && <> on {first}</>}. Breadth of coverage measures how far a report travelled,
    not how serious the harm was.</p>

  <h2>Where this sits in the record</h2>
  <p>An incident is one reported event. The recurring failure modes underneath incidents are
    catalogued in <a href="/ai-ecosystem/enterprise-applications-governance-and-tools/0ff57218/#avid">AVID,
    the AI Vulnerability Database</a>; the adversary behaviour behind deliberate ones is in
    {' '}<a href="/ai-ecosystem/enterprise-applications-governance-and-tools/0ff57218/#atlas">MITRE ATLAS</a>;
    and the risk classes a builder is expected to design against are the
    {' '}<a href="/ai-ecosystem/enterprise-applications-governance-and-tools/0ff57218/#owasp">OWASP Top 10
    for LLM Applications</a>. Where a harm has become litigation, it appears on the
    {' '}<a href="/ai-lawsuits/">AI lawsuit tracker</a>.</p>

  <div class="cite-box">Cite this page: <code>"{headline}." AI Incident {inc.incident_id},
    The World of AI, theworldofai.org/ai-news/incident/{inc.incident_id}/. Retrieved {inc.generated}.{' '}UID {citeUid}.</code></div>

  <h2>Sources</h2>
  <p class="meta-line">Everything above is written here. These are the records and the
    reporting it was written from.</p>
  <ul class="sources">
    <li>AI Incident Database, incident {inc.incident_id}
      <span class="src-meta">incidentdatabase.ai · Responsible AI Collaborative · CC BY-SA 4.0</span></li>
    {reports.map((r) => (
      <li>{r.title}
        <span class="src-meta">{r.domain}{r.published && <> · {r.published}</>}{r.fromLang && <> · translated from {r.fromLang}</>}</span></li>
    ))}
  </ul>

  <p><a href="/ai-news/daily/#incidents">← All logged harms</a></p>
</Base>

<style>
  .sources { list-style: none; padding: 0; margin: 1em 0 1.6em; }
  .sources li { padding: .5em 0; border-bottom: 1px solid #ececf2; }
  .src-meta { display: block; font-size: 12.5px; color: #7A8A9E; margin-top: 2px; }
  .cite-box { margin: 1.6em 0; padding: .9em 1em; background: #f7f7fb; border-left: 3px solid #201868; font-size: .9rem; }
  .cite-box code { display: block; margin-top: .3em; }
  .original-title { margin-top: -.4em; font-style: italic; }
</style>

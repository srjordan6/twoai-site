---
/**
 * AI News section hub at /ai-news/, with its two sections:
 *
 *   Daily News, at /ai-news/daily/: what's happening in the world of AI,
 *   the day's top stories ranked by breadth of worldwide press coverage.
 *
 *   AI Vendor News, at /ai-news/vendor/: announcements from the companies,
 *   labs, and institutes building AI, in their own words.
 *
 * The hub previews both so it is useful in itself, not just navigation:
 * today's top three stories and the latest vendor posts, each with its
 * date and compile time per the standing date-stamp directive.
 */
import Base from '../../layouts/Base.astro';
import { categoryOf, type Story } from '../../lib/newsTopics';

const newsMods = import.meta.glob('../../../content/news/news.json', { eager: true });
const news: any = Object.values(newsMods)[0]?.default ?? null;
const stories: Story[] = (news?.stories ?? []).map((s: any) => ({
  ...s,
  Domains: s.Domains ?? [],
  Orgs: s.Orgs ?? [],
  Persons: s.Persons ?? [],
  Articles: s.Articles ?? [],
}));
const top3 = stories.slice(0, 3);

// WHAT HAPPENED TODAY, ON THE HUB. Stephen, 2026-08-31: there is supposed to
// be a box that tells me in a couple of minutes what happened. The hub was
// previewing three headlines and sending the reader elsewhere for the rest,
// which is navigation, not a briefing.
//
// Every story already carries a written summary, so the digest costs nothing
// but rendering it: the first sentence of each is the day in one line, and
// ten of them is the day. Counts come from the data rather than a claim, and
// when the pipeline has not run yet the box does not render at all rather
// than showing an empty frame.
const firstSentence = (t: string) => {
  const clean = String(t || '').split(/\s+/).join(' ').trim();
  const cut = clean.indexOf('. ');
  return cut > 40 ? clean.slice(0, cut + 1) : clean.slice(0, 220);
};
const digest = stories.map((s: any) => ({
  slug: s.Slug,
  headline: s.Headline,
  line: firstSentence(s.Summary),
  outlets: s.DomainCount,
  category: categoryOf(s).name,
}));
const articleTotal = stories.reduce((n: number, s: any) => n + (s.ArticleCount || 0), 0);
const outletTotal = new Set(stories.flatMap((s: any) => s.Domains)).size;
const widest = stories[0];

// The AI Incident Database section has rendered on /ai-news/daily/ since it
// shipped, and this hub never mentioned it: the hub described itself as
// "two sections" while the section it summarises had three. Stephen looked
// for AIID here twice. Same news.json, same field the daily page reads.
const incidents: any[] = news?.incidents ?? [];
const top3Incidents = incidents.slice(0, 3);
const incidentOutlets = new Set(incidents.map((i: any) => i.domain).filter(Boolean)).size;

const vendMods = import.meta.glob('../../../content/news/vendor.json', { eager: true });
const vn: any = Object.values(vendMods)[0]?.default ?? null;
const vendors: any[] = (vn?.vendors ?? []).map((v: any) => ({ ...v, items: v.items ?? [] }));
const vendorTotalShown = vendors.reduce((n, v) => n + v.items.length, 0);
const latestVendorPosts = vendors
  .flatMap((v) => v.items.map((it: any) => ({ ...it, vendor: v.vendor })))
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''))
  .slice(0, 3);

const generated = news?.generated ? new Date(news.generated) : null;
const stamp = generated ? `${generated.toUTCString().slice(0, 22)} UTC` : null;

const title = `AI News: Daily Briefing and Vendor Announcements`;
const description =
  `AI news in three sections: a daily briefing of the top stories ranked by breadth of coverage, ` +
  `announcements from the labs building AI in their own words, and the logged real-world harms ` +
  `catalogued by the AI Incident Database.`;

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'AI News',
      url: 'https://theworldofai.org/ai-news/',
      description,
    },
    {
      '@type': 'ItemList',
      name: 'AI News sections',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Daily News',
          url: 'https://theworldofai.org/ai-news/daily/',
          description: "What's happening in the world of AI: top stories ranked by breadth of coverage.",
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'AI Vendor News',
          url: 'https://theworldofai.org/ai-news/vendor/',
          description: 'Announcements from the companies, labs, and institutes building AI.',
        },
        ...(incidents.length > 0
          ? [{
              '@type': 'ListItem',
              position: 3,
              name: 'When AI Goes Wrong',
              url: 'https://theworldofai.org/ai-news/daily/#incidents',
              description: 'Reports of real-world harm from deployed AI systems, catalogued by the AI Incident Database.',
            }]
          : []),
      ],
    },
  ],
});
---
<Base title={title} description={description} current="/ai-news/" jsonld={jsonld}>
  <p class="meta-line"><a href="/ai-ecosystem/ai-news/">AI News in the ecosystem</a></p>
  <h1>AI News</h1>
  {news && (
    <p class="dateline">
      <strong>Updated daily</strong> · {news.date}
      {stamp && <> · last compiled {stamp}</>}
    </p>
  )}

  <div class="answer-box">
    <p class="answer-label">{incidents.length > 0 ? "Three sections" : "Two sections"}</p>
    <p>
      <a href="/ai-news/daily/">Daily News</a> is what&rsquo;s happening in the world of AI: the
      day&rsquo;s top stories, discovered from worldwide press coverage and ranked by how many
      independent outlets carried each one. <a href="/ai-news/vendor/">AI Vendor News</a> is what
      the builders said themselves: announcements from the companies, labs, and institutes
      building and governing AI, drawn from their own feeds, every link to the original post.
    </p>
    {incidents.length > 0 && (
      <p>
        <b><a href="/ai-news/daily/#incidents">When AI Goes Wrong</a></b> is what it cost:
        reports of real-world harm from deployed AI systems, catalogued by the AI Incident
        Database, each with its incident number and the outlet that reported it.
      </p>
    )}
  </div>

  {digest.length > 0 && (
    <section class="today">
      <p class="sec-kicker">What&rsquo;s happening in AI today</p>
      <h2>{news.date}, in a couple of minutes</h2>
      <p class="today-lede">
        <b>{digest.length} {digest.length === 1 ? 'story' : 'stories'}</b> today, drawn from
        {' '}{articleTotal} articles across {outletTotal} outlets worldwide
        {widest && <>. The most widely carried is
          {' '}<a href={`/ai-news/${widest.Slug}/`}>{widest.Headline}</a>, reported by
          {' '}{widest.DomainCount} independent outlets</>}. Stories rank by how many outlets
        carried them, which measures how far a story travelled rather than how much it matters.
      </p>
      <ol class="today-list">
        {digest.map((d) => (
          <li>
            <a href={`/ai-news/${d.slug}/`}>{d.headline}</a>
            <span class="pmeta">{d.category} &middot; {d.outlets} {d.outlets === 1 ? 'outlet' : 'outlets'}</span>
            {d.line && <p>{d.line}</p>}
          </li>
        ))}
      </ol>
      <a class="go" href="/ai-news/daily/">The full briefing, with every source &rarr;</a>
    </section>
  )}

  <div class="sections">
    <section class="sec">
      <p class="sec-kicker">Section one</p>
      <h2><a href="/ai-news/daily/">Daily News</a></h2>
      <p class="sec-sub">What&rsquo;s happening in the world of AI</p>
      <p class="sec-desc">
        {stories.length > 0
          ? `${stories.length} stories today, ranked by breadth of coverage across ${new Set(stories.flatMap((s) => s.Domains)).size} outlets worldwide.`
          : `Today's briefing publishes with the pipeline's next morning run.`}
      </p>
      {top3.length > 0 && (
        <ol class="preview">
          {top3.map((s) => (
            <li>
              <a href={`/ai-news/${s.Slug}/`}>{s.Headline}</a>
              <span class="pmeta">{categoryOf(s).name} · {s.DomainCount} outlets</span>
            </li>
          ))}
        </ol>
      )}
      <a class="go" href="/ai-news/daily/">Read the full briefing &rarr;</a>
    </section>

    <section class="sec">
      <p class="sec-kicker">Section two</p>
      <h2><a href="/ai-news/vendor/">AI Vendor News</a></h2>
      <p class="sec-sub">From the companies building AI, in their own words</p>
      <p class="sec-desc">
        {vendors.length > 0
          ? `${vendorTotalShown} recent announcements from ${vendors.length} sources, including ${vendors.slice(0, 4).map((v) => v.vendor).join(', ')}.`
          : `Vendor announcements publish with the pipeline's next run.`}
      </p>
      {latestVendorPosts.length > 0 && (
        <ol class="preview">
          {latestVendorPosts.map((it) => (
            <li>
              <a href={it.url} rel="noopener nofollow" target="_blank">{it.title}</a>
              <span class="pmeta">{it.vendor} · surfaced {it.date}</span>
            </li>
          ))}
        </ol>
      )}
      <a class="go" href="/ai-news/vendor/">All vendor announcements &rarr;</a>
      <p class="meta-line">Looking for an older story? The <a href="/ai-news/archive/">story
        archive</a> and the <a href="/ai-news/vendor/archive/1/">vendor announcement archive</a>
        list every page ever published here.</p>
    </section>

    {/* Full width, below the two. A third card inside a two-column grid
        takes one cell and leaves the other empty, which is what shipped:
        the harms sat in a narrow column with a blank space beside them.
        This one spans both columns and lays its own content out
        horizontally, so it reads as the footing under the two sections
        rather than a third of them. A comment cannot be the first child
        inside the parentheses of an expression, which is what broke the
        build the first time. */}
    {incidents.length > 0 && (
      <section class="sec sec-wide">
        <div class="wide-intro">
          <p class="sec-kicker">Section three</p>
          <h2><a href="/ai-news/daily/#incidents">When AI Goes Wrong</a></h2>
          <p class="sec-sub">The harms a deployed system actually caused</p>
          <p class="sec-desc">
            {`${incidents.length} logged harms from ${incidentOutlets} outlets, each catalogued by the AI Incident Database with its incident number.`}
          </p>
          <a class="go" href="/ai-news/daily/#incidents">All logged harms &rarr;</a>
          <p class="sec-desc">An incident is one reported event. The recurring failure modes
            underneath them are catalogued in
            {' '}<a href="/ai-ecosystem/enterprise-applications-governance-and-tools/0ff57218/#avid">AVID, the AI Vulnerability Database</a>, alongside
            MITRE ATLAS and the OWASP Top 10 for LLM Applications.</p>
        </div>
        <div class="wide-list">
          <ol class="preview">
            {top3Incidents.map((inc: any) => (
              <li>
                <a href={inc.url} rel="noopener nofollow" target="_blank">{inc.title}</a>
                <span class="pmeta">{inc.domain}
                  {inc.published && <> &middot; {inc.published}</>} &middot; AIID #{inc.incident_id}</span>
              </li>
            ))}
          </ol>
        </div>
        <p class="meta-line wide-foot">Incident records from the <a href="https://incidentdatabase.ai/"
          rel="noopener">AI Incident Database</a>, Responsible AI Collaborative, licensed
          CC BY-SA 4.0. Headlines and articles belong to the publishers linked. Listing an
          incident is not a finding of fault, it is a record that the harm was reported.</p>
      </section>
    )}
  </div>

  <p class="also">
    Looking for the policy and litigation week in review? That lives at
    <a href="/this-week-in-ai/"> This Week in AI</a>.
  </p>
</Base>

<style>
  .dateline { color: #7A8A9E; font-size: 14px; letter-spacing: .02em; }
  .dateline strong { color: #201868; }

  .answer-box { background: #FFF6EC; border: 1px solid #F0D6B0; border-radius: 6px; padding: 22px 26px; margin: 18px 0 30px; }
  .answer-box p { font-size: 16px; line-height: 1.75; color: #2C2C2A; margin: 0; }
  .answer-box a { color: #201868; font-weight: 700; }
  .answer-label { font-size: 11px !important; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #F07800; margin: 0 0 8px !important; }

  .sections { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media (max-width: 860px) { .sections { grid-template-columns: 1fr; } }

  .sec { border: 1px solid #e6e4de; border-top: 4px solid #F07800; border-radius: 10px; background: #fafaf6; padding: 24px 26px; }
  /* WHAT HAPPENED TODAY. The panel a reader should be able to finish in a
     couple of minutes and know the day: the lede states the shape of the
     coverage, then every story with its first sentence. Wider line length
     than the section cards because this is prose, not a preview. */
  .today { border: 1px solid #e6e4de; border-top: 4px solid #201868; border-radius: 10px;
    background: #fff; padding: 24px 26px; margin: 0 0 24px; }
  .today h2 { font-size: 24px; margin: 0 0 10px; color: #201868; }
  .today-lede { font-size: 16px; line-height: 1.6; margin: 0 0 16px; }
  .today-list { margin: 0; padding-left: 22px; }
  .today-list li { margin: 0 0 14px; }
  .today-list li > a { font-weight: 600; color: #201868; text-decoration: none; }
  .today-list li > a:hover { color: #F07800; text-decoration: underline; }
  .today-list li p { margin: 3px 0 0; font-size: 14.5px; line-height: 1.55; color: #3a3a42; }
  .today .pmeta { display: block; font-size: 12px; color: #7A8A9E; margin-top: 2px; }

  /* The harms box spans the full width under the two section cards, and
     splits internally: the framing on the left, the three most recent on the
     right, the licence note across the bottom. */
  .sec-wide { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: 34px; row-gap: 10px; align-items: start; }
  .sec-wide .wide-intro { min-width: 0; }
  .sec-wide .wide-list { min-width: 0; }
  .sec-wide .wide-list .preview { margin-top: 0; }
  .sec-wide .wide-foot { grid-column: 1 / -1; margin-top: 4px; }
  @media (max-width: 860px) { .sec-wide { grid-template-columns: 1fr; } }
  .sec-kicker { font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #F07800; margin: 0 0 6px; }
  .sec h2 { font-size: 26px; margin: 0 0 2px; }
  .sec h2 a { color: #201868; text-decoration: none; }
  .sec h2 a:hover { color: #F07800; }
  .sec-sub { font-size: 14px; color: #7A8A9E; margin: 0 0 12px; }
  .sec-desc { font-size: 14.5px; line-height: 1.65; color: #2C2C2A; margin: 0 0 14px; }

  .preview { margin: 0 0 16px; padding-left: 20px; }
  .preview li { margin: 0 0 10px; }
  .preview a { font-size: 15px; color: #201868; text-decoration: none; font-weight: 600; line-height: 1.4; }
  .preview a:hover { color: #F07800; }
  .pmeta { display: block; font-size: 12.5px; color: #7A8A9E; }

  .go { font-size: 14px; color: #201868; text-decoration: none; font-weight: 700; }
  .go:hover { color: #F07800; }

  .also { margin-top: 30px; font-size: 14px; color: #7A8A9E; }
  .also a { color: #201868; font-weight: 600; }
</style>

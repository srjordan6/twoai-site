---
/**
 * AI News section hub at /ai-news/, with its two sections:
 *
 *   Daily News, at /ai-news/daily/: what's happening in the world of AI,
 *   the day's top stories ranked by breadth of worldwide press coverage.
 *
 *   AI Vendor News, at /ai-news/vendor/: announcements from the companies,
 *   labs, and institutes building AI, in their own words.
 *
 * The hub previews both so it is useful in itself, not just navigation:
 * today's top three stories and the latest vendor posts, each with its
 * date and compile time per the standing date-stamp directive.
 */
import Base from '../../layouts/Base.astro';
import { categoryOf, type Story } from '../../lib/newsTopics';

const newsMods = import.meta.glob('../../../content/news/news.json', { eager: true });
const news: any = Object.values(newsMods)[0]?.default ?? null;
const stories: Story[] = (news?.stories ?? []).map((s: any) => ({
  ...s,
  Domains: s.Domains ?? [],
  Orgs: s.Orgs ?? [],
  Persons: s.Persons ?? [],
  Articles: s.Articles ?? [],
}));
const top3 = stories.slice(0, 3);

const vendMods = import.meta.glob('../../../content/news/vendor.json', { eager: true });
const vn: any = Object.values(vendMods)[0]?.default ?? null;
const vendors: any[] = (vn?.vendors ?? []).map((v: any) => ({ ...v, items: v.items ?? [] }));
const vendorTotalShown = vendors.reduce((n, v) => n + v.items.length, 0);
const latestVendorPosts = vendors
  .flatMap((v) => v.items.map((it: any) => ({ ...it, vendor: v.vendor })))
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''))
  .slice(0, 3);

const generated = news?.generated ? new Date(news.generated) : null;
const stamp = generated ? `${generated.toUTCString().slice(0, 22)} UTC` : null;

const title = `AI News: Daily Briefing and Vendor Announcements`;
const description =
  `AI news in two sections: a daily briefing of the top stories ranked by breadth of worldwide ` +
  `coverage, and announcements from the companies and labs building AI, in their own words.`;

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'AI News',
      url: 'https://theworldofai.org/ai-news/',
      description,
    },
    {
      '@type': 'ItemList',
      name: 'AI News sections',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Daily News',
          url: 'https://theworldofai.org/ai-news/daily/',
          description: "What's happening in the world of AI: top stories ranked by breadth of coverage.",
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'AI Vendor News',
          url: 'https://theworldofai.org/ai-news/vendor/',
          description: 'Announcements from the companies, labs, and institutes building AI.',
        },
      ],
    },
  ],
});
---
<Base title={title} description={description} current="/ai-news/" jsonld={jsonld}>
  <p class="meta-line"><a href="/ai-ecosystem/ai-news/">AI News in the ecosystem</a></p>
  <h1>AI News</h1>
  {news && (
    <p class="dateline">
      <strong>Updated daily</strong> · {news.date}
      {stamp && <> · last compiled {stamp}</>}
    </p>
  )}

  <div class="answer-box">
    <p class="answer-label">Two sections</p>
    <p>
      <a href="/ai-news/daily/">Daily News</a> is what&rsquo;s happening in the world of AI: the
      day&rsquo;s top stories, discovered from worldwide press coverage and ranked by how many
      independent outlets carried each one. <a href="/ai-news/vendor/">AI Vendor News</a> is what
      the builders said themselves: announcements from the companies, labs, and institutes
      building and governing AI, drawn from their own feeds, every link to the original post.
    </p>
  </div>

  <div class="sections">
    <section class="sec">
      <p class="sec-kicker">Section one</p>
      <h2><a href="/ai-news/daily/">Daily News</a></h2>
      <p class="sec-sub">What&rsquo;s happening in the world of AI</p>
      <p class="sec-desc">
        {stories.length > 0
          ? `${stories.length} stories today, ranked by breadth of coverage across ${new Set(stories.flatMap((s) => s.Domains)).size} outlets worldwide.`
          : `Today's briefing publishes with the pipeline's next morning run.`}
      </p>
      {top3.length > 0 && (
        <ol class="preview">
          {top3.map((s) => (
            <li>
              <a href={`/ai-news/${s.Slug}/`}>{s.Headline}</a>
              <span class="pmeta">{categoryOf(s).name} · {s.DomainCount} outlets</span>
            </li>
          ))}
        </ol>
      )}
      <a class="go" href="/ai-news/daily/">Read the full briefing &rarr;</a>
    </section>

    <section class="sec">
      <p class="sec-kicker">Section two</p>
      <h2><a href="/ai-news/vendor/">AI Vendor News</a></h2>
      <p class="sec-sub">From the companies building AI, in their own words</p>
      <p class="sec-desc">
        {vendors.length > 0
          ? `${vendorTotalShown} recent announcements from ${vendors.length} sources, including ${vendors.slice(0, 4).map((v) => v.vendor).join(', ')}.`
          : `Vendor announcements publish with the pipeline's next run.`}
      </p>
      {latestVendorPosts.length > 0 && (
        <ol class="preview">
          {latestVendorPosts.map((it) => (
            <li>
              <a href={it.url} rel="noopener nofollow" target="_blank">{it.title}</a>
              <span class="pmeta">{it.vendor} · surfaced {it.date}</span>
            </li>
          ))}
        </ol>
      )}
      <a class="go" href="/ai-news/vendor/">All vendor announcements &rarr;</a>
    </section>
  </div>

  <p class="also">
    Looking for the policy and litigation week in review? That lives at
    <a href="/this-week-in-ai/"> This Week in AI</a>.
  </p>
</Base>

<style>
  .dateline { color: #7A8A9E; font-size: 14px; letter-spacing: .02em; }
  .dateline strong { color: #201868; }

  .answer-box { background: #FFF6EC; border: 1px solid #F0D6B0; border-radius: 6px; padding: 22px 26px; margin: 18px 0 30px; }
  .answer-box p { font-size: 16px; line-height: 1.75; color: #2C2C2A; margin: 0; }
  .answer-box a { color: #201868; font-weight: 700; }
  .answer-label { font-size: 11px !important; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #F07800; margin: 0 0 8px !important; }

  .sections { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media (max-width: 860px) { .sections { grid-template-columns: 1fr; } }

  .sec { border: 1px solid #e6e4de; border-top: 4px solid #F07800; border-radius: 10px; background: #fafaf6; padding: 24px 26px; }
  .sec-kicker { font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #F07800; margin: 0 0 6px; }
  .sec h2 { font-size: 26px; margin: 0 0 2px; }
  .sec h2 a { color: #201868; text-decoration: none; }
  .sec h2 a:hover { color: #F07800; }
  .sec-sub { font-size: 14px; color: #7A8A9E; margin: 0 0 12px; }
  .sec-desc { font-size: 14.5px; line-height: 1.65; color: #2C2C2A; margin: 0 0 14px; }

  .preview { margin: 0 0 16px; padding-left: 20px; }
  .preview li { margin: 0 0 10px; }
  .preview a { font-size: 15px; color: #201868; text-decoration: none; font-weight: 600; line-height: 1.4; }
  .preview a:hover { color: #F07800; }
  .pmeta { display: block; font-size: 12.5px; color: #7A8A9E; }

  .go { font-size: 14px; color: #201868; text-decoration: none; font-weight: 700; }
  .go:hover { color: #F07800; }

  .also { margin-top: 30px; font-size: 14px; color: #7A8A9E; }
  .also a { color: #201868; font-weight: 600; }
</style>

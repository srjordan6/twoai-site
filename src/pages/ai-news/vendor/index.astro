---
/**
 * AI Vendor News at /ai-news/vendor/: announcements from the companies,
 * labs, and institutes building and governing AI, in their own words, from
 * their own feeds. Each item links to its own page on this site, which
 * carries the vendor's published description (the reason to click) and the
 * outbound link to the original post.
 *
 * Data is news/vendor.json. The page is ordered by DATE, not grouped by
 * vendor: grouping meant this morning's post sat below a month-old one
 * because its vendor sorted higher, which reads as a directory of sources
 * rather than a news page. `latest` is the date-ordered slice; `vendors`
 * still drives the source index in the rail.
 *
 * Posts carry entity_uid where the publisher has a profile on this site, so
 * each item links to /companies/{uid}/. The company directory and this page
 * were two lists of the same organisations with nothing joining them.
 *
 * Only first-party sources: the organisation's own feed, never press
 * aggregation. Press coverage of the field lives in the Daily News briefing;
 * this page is what the builders said themselves. Coverage is stated on the
 * page, because 27 of the 62 companies publish a discoverable feed and a
 * reader should see that gap rather than read silence as no news.
 */
import Base from '../../../layouts/Base.astro';

const mods = import.meta.glob('../../../../content/news/vendor.json', { eager: true });
const vn: any = Object.values(mods)[0]?.default ?? null;
const vendors: any[] = (vn?.vendors ?? []).map((v: any) => ({ ...v, items: v.items ?? [] }));
const latest: any[] = vn?.latest ?? [];
const coverage = vn?.coverage ?? null;

// Group the date-ordered list by day so the page reads as a timeline.
const byDate: { date: string; items: any[] }[] = [];
for (const it of latest) {
  const d = it.date || 'Undated';
  const last = byDate[byDate.length - 1];
  if (last && last.date === d) last.items.push(it);
  else byDate.push({ date: d, items: [it] });
}
const fmtDate = (d: string) =>
  d === 'Undated'
    ? 'Undated'
    : new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', {
        year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
      });
const entityHref = (it: any) =>
  it.entity_uid && it.entity_kind === 'company' ? `/companies/${it.entity_uid}/` : null;
const linkedVendors = new Set(latest.filter((i) => entityHref(i)).map((i) => i.vendor));

const totalShown = latest.length;
const totalTracked = vn?.archive?.length ?? latest.length;
const generated = vn?.generated ? new Date(vn.generated) : null;
const stamp = generated ? `${generated.toUTCString().slice(0, 22)} UTC` : null;
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// The source index is every vendor that has ever published here, not just
// those inside the intel window.
const sourceCounts = new Map<string, number>();
for (const it of vn?.archive ?? []) sourceCounts.set(it.vendor, (sourceCounts.get(it.vendor) ?? 0) + 1);
const sources = [...sourceCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const title = `AI Vendor News: Announcements from the Companies Building AI`;
const description =
  `Announcements from AI companies, labs, and institutes in their own words, newest first, ` +
  `cross-referenced to their company profiles. Every link goes to the original post.`;

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'AI Vendor News',
      url: 'https://theworldofai.org/ai-news/vendor/',
      description,
      dateModified: vn?.generated,
    },
    {
      '@type': 'ItemList',
      name: 'Latest vendor announcements',
      itemListElement: latest.slice(0, 50).map((it: any, i: number) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: it.title,
        url: `https://theworldofai.org/ai-news/vendor/${it.slug}/`,
      })),
    },
  ],
});
---
<Base title={title} description={description} current="/ai-news/" jsonld={jsonld}>
  <p class="meta-line"><a href="/ai-news/">AI News</a> · <a href="/ai-news/daily/">Daily News</a> · AI Vendor News</p>
  <h1>AI Vendor News</h1>
  {vn && (
    <p class="dateline">
      <strong>From the builders</strong> · {vn.date}
      {stamp && <> · last updated {stamp}</>}
      · past {vn.window_days} days
    </p>
  )}

  <div class="answer-box">
    <p class="answer-label">What this page is</p>
    <p>
      Announcements from the organisations building AI, in their own words, drawn from their own
      feeds rather than press coverage, newest first: {totalShown} recent posts
      from {sources.length} sources, {totalTracked} archived in total. Where the publisher has a
      profile on this site, its name links to it. For how the field is being covered by the
      press, read the <a href="/ai-news/daily/">Daily News briefing</a>.
    </p>
    {coverage && (
      <p class="cov">
        Coverage: {coverage.feeds} of the {coverage.companies} organisations in the
        {' '}<a href="/companies/">AI Company Directory</a> publish a first-party feed we can
        follow. The rest publish no discoverable feed, so their absence here means we cannot
        see their announcements, not that they made none.
      </p>
    )}
  </div>

  {latest.length === 0 && (
    <p class="empty">Vendor announcements publish with the pipeline&rsquo;s next run.</p>
  )}

  <div class="cols">
    <div class="main">
      {byDate.map((day) => (
        <section class="day">
          <h2 class="daylabel">{fmtDate(day.date)}</h2>
          <div class="rule"></div>
          <ul class="items">
            {day.items.map((it: any) => (
              <li>
                {it.slug
                  ? <a href={`/ai-news/vendor/${it.slug}/`}>{it.title}</a>
                  : <a href={it.url} rel="noopener nofollow" target="_blank">{it.title}</a>}
                <span class="meta">
                  {entityHref(it)
                    ? <a class="vlink" href={entityHref(it)}>{it.vendor}</a>
                    : <span class="vplain">{it.vendor}</span>}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))}
      {latest.length > 0 && (
        <p class="note">
          Dates are the vendor&rsquo;s own publication date where the feed supplies one, and
          otherwise the date the watch surfaced the post. Being listed is not an endorsement, and
          announcements are the vendor&rsquo;s claims, not verified facts.
        </p>
      )}
    </div>

    <aside class="side">
      <div class="panel sticky">
        <p class="box-label">Sources</p>
        <ul class="toc">
          {sources.slice(0, 30).map(([v, n]) => <li><span>{v}</span> <span class="n">{n}</span></li>)}
          <li><a href="/companies/">AI Company Directory &rarr;</a></li>
          <li><a href="/ai-news/daily/">Daily News briefing &rarr;</a></li>
        </ul>
      </div>
      <div class="panel">
        <p class="box-label">The numbers</p>
        <table class="dash">
          <tbody>
            <tr><th scope="row">Sources</th><td>{sources.length}</td></tr>
            <tr><th scope="row">Posts shown</th><td>{totalShown}</td></tr>
            <tr><th scope="row">Posts archived</th><td>{totalTracked}</td></tr>
            {coverage && <tr><th scope="row">Feeds followed</th><td>{coverage.feeds} of {coverage.companies}</td></tr>}
          </tbody>
        </table>
      </div>
    </aside>
  </div>
</Base>

<style>
  .dateline { color: #7A8A9E; font-size: 14px; letter-spacing: .02em; }
  .dateline strong { color: #201868; }

  .answer-box { background: #FFF6EC; border: 1px solid #F0D6B0; border-radius: 6px; padding: 22px 26px; margin: 18px 0 28px; }
  .answer-box p { font-size: 16px; line-height: 1.75; color: #2C2C2A; margin: 0; }
  .answer-box a { color: #201868; font-weight: 600; }
  .answer-label { font-size: 11px !important; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #F07800; margin: 0 0 8px !important; }

  .cols { display: grid; grid-template-columns: minmax(0,1fr) 280px; gap: 40px; align-items: start; }
  @media (max-width: 960px) { .cols { grid-template-columns: 1fr; } }

  .box-label { font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #F07800; margin: 0 0 10px; }

  .vend { margin: 0 0 40px; scroll-margin-top: 80px; }
  .vend h2 { font-size: 24px; color: #201868; margin: 0 0 2px; }
  .vend .count { font-size: 13px; color: #fff; background: #F07800; border-radius: 999px; padding: 2px 9px; vertical-align: middle; margin-left: 6px; }
  .day { margin: 0 0 30px; }
  .daylabel { font-size: 17px; color: #201868; margin: 0 0 2px; letter-spacing: .01em; }
  .cov { font-size: .92rem; color: #45454f; margin: .6em 0 0; }
  .vlink { font-weight: 600; }
  .vplain { color: #6b6b78; }
  .toc .n { color: #6b6b78; font-variant-numeric: tabular-nums; }
  .rule { width: 56px; height: 3px; background: #F07800; margin: 0 0 14px; }

  .items { list-style: none; margin: 0; padding: 0; max-width: 780px; }
  .items li { padding: 12px 0; border-bottom: 1px solid #e8e6e0; }
  .items li:last-child { border-bottom: none; }
  .items a { color: #201868; text-decoration: none; font-weight: 500; }
  .items a:hover { color: #F07800; }
  .items .meta { display: block; font-size: 13px; color: #7A8A9E; margin-top: 3px; }

  .note { margin-top: 30px; font-size: 14px; color: #7A8A9E; font-style: italic; max-width: 68ch; }

  .side { display: flex; flex-direction: column; gap: 20px; }
  .panel { border: 1px solid #e6e4de; border-radius: 10px; padding: 18px 20px; background: #fafaf6; }
  .sticky { position: sticky; top: 20px; }
  .toc { list-style: none; margin: 0; padding: 0; }
  .toc li { margin: 0 0 7px; }
  .toc a { font-size: 13.5px; color: #201868; text-decoration: none; }
  .toc a:hover { color: #F07800; }
  .dash { width: 100%; border-collapse: collapse; }
  .dash th, .dash td { font-size: 13.5px; padding: 7px 0; border-bottom: 1px solid #eceae4; text-align: left; }
  .dash th { color: #7A8A9E; font-weight: 500; }
  .dash td { color: #201868; font-weight: 700; text-align: right; }
  .dash tr:last-child th, .dash tr:last-child td { border-bottom: none; }

  .empty { color: #7A8A9E; font-style: italic; font-size: 14px; }
</style>

---
/**
 * One vendor announcement at /ai-news/vendor/{slug}/: our page for the post,
 * carrying the vendor's own published description so a reader knows why the
 * outbound link is worth their click before they leave the site. The summary
 * is the vendor's og:description, quoted as their words and labelled as
 * such; where a vendor publishes no per-post description, the page says what
 * it verifiably can (who posted it, when we surfaced it) and does not invent
 * a summary. Slugs are name + 6 chars of the URL hash, permanent once
 * published per the standing URL rule.
 *
 * Paths come from `archive`, which is every post the pipeline has ever seen,
 * not from the hub's `vendors` blocks. Those are capped at 25 per vendor for
 * display, and building paths from them meant a permalink died the moment a
 * busier vendor pushed it off its own list. `vendors` is a fallback for the
 * first build after this change, before the pipeline has written an archive.
 */
import Base from '../../../layouts/Base.astro';
import { readFileSync, existsSync } from 'node:fs';

export function getStaticPaths() {
  const m = import.meta.glob('../../../../content/news/vendor.json', { eager: true });
  const data: any = Object.values(m)[0]?.default ?? null;
  const out: any[] = [];
  const seen = new Set<string>();
  for (const a of data?.archive ?? []) {
    if (!a.slug || seen.has(a.slug)) continue;
    // has_page is the pipeline's judgement that there is enough here to fill a
    // page. Undefined means an older file from before the flag existed, and
    // those posts already have live URLs, so they keep them.
    if (a.has_page === false) continue;
    seen.add(a.slug);
    out.push({ params: { post: a.slug }, props: { it: a, vendor: a.vendor } });
  }
  // The vendors blocks are a fallback for the first build after the archive
  // landed. They must not resurrect a slug the archive has judged too thin for
  // a page, or the threshold does nothing.
  const suppressed = new Set(
    (data?.archive ?? []).filter((a: any) => a.has_page === false).map((a: any) => a.slug)
  );
  for (const v of data?.vendors ?? []) {
    for (const it of v.items ?? []) {
      if (!it.slug || seen.has(it.slug) || suppressed.has(it.slug)) continue;
      seen.add(it.slug);
      out.push({ params: { post: it.slug }, props: { it, vendor: v.vendor } });
    }
  }
  return out;
}

const { it, vendor } = Astro.props;

/* WHY THIS PAGE GREW A "KEEP READING" SECTION.
 *
 * It used to be a summary and a button that sends the reader away. That is
 * honest but it is also a dead end: the reader arrives from search, reads two
 * sentences of the vendor's own words, leaves for the vendor's site, and never
 * sees that we track the vendor, define the terms, or hold 100+ related posts.
 *
 * The outbound link stays exactly where it is. Nothing here hides it or makes
 * the reader hunt for it; sending people to the primary source is the point of
 * the page. What is added sits BELOW it, so a reader who wants the source gets
 * it in one click and a reader who wants more has somewhere to go.
 *
 * MATCHING RULE, and this needs stating because the same mistake was made
 * elsewhere on this site today. Glossary terms are matched against our own
 * headline and the vendor's summary on WHOLE WORDS only, case-insensitive,
 * minimum four characters. A substring test would put "Agent" inside
 * "agentic", "RAG" inside "storage", and "Box" inside "toolbox", which is
 * exactly how 101 false MCP attributions happened. Text matching inside our
 * own prose is a much weaker claim than attributing a product to a company, so
 * the bar is lower here, but the word boundary is not optional.
 */
const load = (path: string) => {
  try {
    return existsSync(path) ? JSON.parse(readFileSync(path, 'utf8')) : null;
  } catch {
    return null;
  }
};

const g: any = globalThis as any;
if (!g.__twoaiVendorRelated) {
  const vend = load('content/news/vendor.json');
  const gloss = load('content/glossary/glossary.json');
  const comps = load('content/companies/index.json');
  const byName: Record<string, any> = {};
  for (const c of comps?.companies ?? []) {
    if (c?.name) byName[String(c.name).toLowerCase().replace(/[^a-z0-9]/g, '')] = c;
  }
  g.__twoaiVendorRelated = {
    archive: vend?.archive ?? [],
    // Only terms long enough to match safely, longest first so "Agent Swarm"
    // wins over "Agent" when both appear.
    terms: (gloss?.terms ?? [])
      .filter((t: any) => t?.term && t?.slug && t.term.length >= 4)
      .sort((a: any, b: any) => b.term.length - a.term.length),
    byName,
  };
}
const rel = g.__twoaiVendorRelated;

/* More from the same vendor: newest first, this post excluded, and only posts
 * that actually have a page of their own. A link to a slug the build suppressed
 * as too thin would be a 404 we shipped deliberately. */
const moreFromVendor = rel.archive
  .filter((a: any) => a.vendor === vendor && a.slug && a.slug !== it.slug && a.has_page !== false)
  .slice(0, 5);

const haystack = `${it.title} ${it.summary ?? ''}`.toLowerCase();
const relatedTerms: any[] = [];
const usedSpans: string[] = [];
for (const t of rel.terms) {
  if (relatedTerms.length >= 4) break;
  const word = t.term.toLowerCase().replace(/\s*\(.*?\)\s*/g, '').trim();
  if (word.length < 4) continue;
  // Whole-word match, punctuation-safe at both ends.
  const re = new RegExp(`(^|[^a-z0-9])${word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}([^a-z0-9]|$)`, 'i');
  if (!re.test(haystack)) continue;
  // Skip a term already covered by a longer one we matched, so "Agent Swarm"
  // does not drag "Agent" in beside it.
  if (usedSpans.some((u) => u.includes(word))) continue;
  usedSpans.push(word);
  relatedTerms.push(t);
}

/* The vendor's own company profile, when the vendor is one we track. Exact
 * normalised equality, the same rule as the MCP attribution fix. */
const vendorCompany = rel.byName[String(vendor).toLowerCase().replace(/[^a-z0-9]/g, '')] ?? null;
const host = new URL(it.url).hostname.replace(/^www\./, '');
// Titles are clamped to 65 characters including the vendor suffix; a headline
// that would push past it is cut at a word boundary with an ellipsis, because
// search engines truncate long titles anyway and do it worse.
const suffix = ` — ${vendor}`;
const headMax = 65 - suffix.length;
const head = it.title.length <= headMax ? it.title : `${it.title.slice(0, headMax - 1).replace(/\s+\S*$/, '')}…`;
// Vendors title posts as bluntly as "GPT-4" or "Jukebox", which composes to a
// 14-character title that wastes most of the SERP line and says nothing about
// what the page is. Where the short form is under 30 characters, say what the
// page actually is instead. Longer heads keep the compact form and Base
// clamps them to the pixel budget.
const shortForm = `${head}${suffix}`;
const longForm = `${head} — an announcement from ${vendor}`;
const title = shortForm.length < 30 && longForm.length <= 60 ? longForm : shortForm;
const description = (it.summary || `An announcement from ${vendor}, surfaced ${it.date}, with a link to the original post at ${host}.`).slice(0, 158);

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: it.title,
  datePublished: it.date,
  publisher: { '@type': 'Organization', name: 'The World of AI' },
  isBasedOn: it.url,
  description,
});
---
<Base title={title} description={description} current="/ai-news/" jsonld={jsonld} ogType="article">
  <p class="meta-line"><a href="/ai-news/">AI News</a> · <a href="/ai-news/vendor/">AI Vendor News</a> · {vendor}</p>
  <h1>{it.title}</h1>
  <p class="dateline"><span class="pill">{vendor}</span> Surfaced {it.date} · Announcement · {host}</p>

  <div class="answer-box">
    <p class="answer-label">{it.summary ? `In ${vendor}\u2019s words` : 'What this is'}</p>
    {it.summary ? (
      <p>{it.summary}</p>
    ) : (
      <p>
        An announcement published by {vendor} on its own site. {vendor} did not publish a
        per-post description for this one, so rather than inventing a summary, this page sends
        you straight to the source.
      </p>
    )}
  </div>

  <p class="cta-wrap">
    <a class="cta" href={it.url} rel="noopener" target="_blank">Read the original at {host} &rarr;</a>
  </p>

  <p class="note">
    {it.summary && <>The summary above is {vendor}&rsquo;s own published description of the post,
    quoted from its page metadata, not our analysis. </>}
    This is the vendor&rsquo;s announcement in the vendor&rsquo;s words: claims in it are
    theirs, not verified facts, and being covered here is not an endorsement. The surfaced date
    is when our intel watch first saw the post, which for a newly added feed can trail the
    vendor&rsquo;s own publication date.
  </p>

  <section class="keep-reading">
    <h2>Keep reading here</h2>

    {relatedTerms.length > 0 && (
      <div class="kr-block">
        <p class="kr-label">Terms in this announcement, defined</p>
        <ul class="kr-terms">
          {relatedTerms.map((t: any) => (
            <li><a href={`/ai-glossary/${t.slug}/`}>{t.term}</a><span class="kr-cat">{t.category}</span></li>
          ))}
        </ul>
      </div>
    )}

    {moreFromVendor.length > 0 && (
      <div class="kr-block">
        <p class="kr-label">More from {vendor}</p>
        <ul class="kr-posts">
          {moreFromVendor.map((a: any) => (
            <li><a href={`/ai-news/vendor/${a.slug}/`}>{a.title}</a><span class="kr-date">{a.date}</span></li>
          ))}
        </ul>
      </div>
    )}

    <div class="kr-block">
      <p class="kr-label">Across the site</p>
      <ul class="kr-links">
        {vendorCompany && (
          <li><a href={`/companies/${vendorCompany.uid}/`}>{vendor} company profile</a> — what
            {' '}{vendor} ships, what is contested, and what is on the public record</li>
        )}
        <li><a href="/ai-news/vendor/">All vendor announcements</a> — every post our watch has surfaced</li>
        <li><a href="/ai-news/daily/">Today&rsquo;s briefing</a> — what the whole field published today</li>
        <li><a href="/ai-glossary/">The AI glossary</a> — 500+ terms in plain English, each with an example</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .dateline { color: #7A8A9E; font-size: 14px; letter-spacing: .02em; }
  .pill { display: inline-block; background: #201868; color: #fff; font-size: 11px; padding: 2px 10px; border-radius: 999px; margin-right: 8px; vertical-align: 1px; }

  .answer-box { background: #FFF6EC; border: 1px solid #F0D6B0; border-radius: 6px; padding: 22px 26px; margin: 18px 0 24px; max-width: 760px; }
  .answer-box p { font-size: 16.5px; line-height: 1.75; color: #2C2C2A; margin: 0; }
  .answer-label { font-size: 11px !important; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #F07800; margin: 0 0 8px !important; }

  .cta-wrap { margin: 22px 0; }
  .cta { display: inline-block; background: #201868; color: #fff; font-weight: 600; font-size: 15px; padding: 12px 22px; border-radius: 6px; text-decoration: none; }
  .cta:hover { background: #F07800; }

  .note { font-size: 13.5px; color: #7A8A9E; font-style: italic; max-width: 68ch; }
  /* Sits below the outbound link, never above it: a reader who came for the
     source still gets it in one click. */
  .keep-reading { margin-top: 34px; border-top: 1px solid #ececf2; padding-top: 22px; max-width: 760px; }
  .keep-reading h2 { font-size: 1.15rem; margin: 0 0 18px; }
  .kr-block { margin: 0 0 22px; }
  .kr-label { font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
    color: #F07800; margin: 0 0 8px; }
  .kr-terms, .kr-posts, .kr-links { list-style: none; margin: 0; padding: 0; }
  .kr-terms li, .kr-posts li, .kr-links li { padding: 7px 0; border-bottom: 1px solid #f4f4f8;
    font-size: 14.5px; line-height: 1.6; }
  .kr-terms a, .kr-posts a, .kr-links a { color: #201868; text-decoration: none; font-weight: 600; }
  .kr-terms a:hover, .kr-posts a:hover, .kr-links a:hover { color: #F07800; }
  .kr-cat, .kr-date { color: #7A8A9E; font-size: 12.5px; margin-left: 10px; font-weight: 400; }
</style>

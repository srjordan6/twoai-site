---
/**
 * One vendor announcement at /ai-news/vendor/{slug}/: our page for the post,
 * carrying the vendor's own published description so a reader knows why the
 * outbound link is worth their click before they leave the site. The summary
 * is the vendor's og:description, quoted as their words and labelled as
 * such; where a vendor publishes no per-post description, the page says what
 * it verifiably can (who posted it, when we surfaced it) and does not invent
 * a summary. Slugs are name + 6 chars of the URL hash, permanent once
 * published per the standing URL rule.
 *
 * Paths come from `archive`, which is every post the pipeline has ever seen,
 * not from the hub's `vendors` blocks. Those are capped at 25 per vendor for
 * display, and building paths from them meant a permalink died the moment a
 * busier vendor pushed it off its own list. `vendors` is a fallback for the
 * first build after this change, before the pipeline has written an archive.
 */
import Base from '../../../layouts/Base.astro';
import KeepReading from '../../../components/KeepReading.astro';
import { matchTerms, moreFromVendor, companyFor } from '../../../lib/related';

export function getStaticPaths() {
  const m = import.meta.glob('../../../../content/news/vendor.json', { eager: true });
  const data: any = Object.values(m)[0]?.default ?? null;
  const out: any[] = [];
  const seen = new Set<string>();
  for (const a of data?.archive ?? []) {
    if (!a.slug || seen.has(a.slug)) continue;
    // has_page is the pipeline's judgement that there is too little here to be
    // worth indexing. It used to skip the path entirely, which DELETED 2,948
    // permalinks - and Search Console found thirteen of them already indexed
    // and now returning 404, because the threshold was applied to posts that
    // had already been published. Existing published URLs never move.
    //
    // Thin posts therefore keep their page and carry noindex,follow instead.
    // Google drops them from the index without ever seeing a 404, the outbound
    // link still works for anyone holding the URL, and link equity still
    // flows. This is the same treatment the /mcp/ section already gives its
    // one-sentence server pages, decided 2026-08-13.
    seen.add(a.slug);
    out.push({ params: { post: a.slug }, props: { it: a, vendor: a.vendor, thin: a.has_page === false } });
  }
  for (const v of data?.vendors ?? []) {
    for (const it of v.items ?? []) {
      if (!it.slug || seen.has(it.slug)) continue;
      seen.add(it.slug);
      out.push({ params: { post: it.slug }, props: { it, vendor: v.vendor } });
    }
  }
  return out;
}

const { it, vendor, thin = false } = Astro.props;

/* Onward links come from src/lib/related.ts, shared by every page type, so the
 * matching rule lives in one place. The outbound link to the vendor stays
 * exactly where it is: this sits below it. */
const relatedTerms = matchTerms(`${it.title} ${it.summary ?? ''}`);
const moreHere = moreFromVendor(vendor, it.slug);
const vendorCompany = companyFor(vendor);
const host = new URL(it.url).hostname.replace(/^www\./, '');
// Titles are clamped to 65 characters including the vendor suffix; a headline
// that would push past it is cut at a word boundary with an ellipsis, because
// search engines truncate long titles anyway and do it worse.
const suffix = ` — ${vendor}`;
const headMax = 65 - suffix.length;
const head = it.title.length <= headMax ? it.title : `${it.title.slice(0, headMax - 1).replace(/\s+\S*$/, '')}…`;
// Vendors title posts as bluntly as "GPT-4" or "Jukebox", which composes to a
// 14-character title that wastes most of the SERP line and says nothing about
// what the page is. Where the short form is under 30 characters, say what the
// page actually is instead. Longer heads keep the compact form and Base
// clamps them to the pixel budget.
const shortForm = `${head}${suffix}`;
const longForm = `${head} — an announcement from ${vendor}`;
const title = shortForm.length < 30 && longForm.length <= 60 ? longForm : shortForm;
const description = (it.summary || `An announcement from ${vendor}, surfaced ${it.date}, with a link to the original post at ${host}.`).slice(0, 158);

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: it.title,
  datePublished: it.date,
  publisher: { '@type': 'Organization', name: 'The World of AI' },
  isBasedOn: it.url,
  description,
});
---
<Base title={title} description={description} current="/ai-news/" jsonld={jsonld} ogType="article" noindex={thin}>
  <p class="meta-line"><a href="/ai-news/">AI News</a> · <a href="/ai-news/vendor/">AI Vendor News</a> · {vendor}</p>
  <h1>{it.title}</h1>
  <p class="dateline">
    {/* The pill reads as a link because it looks like one. Where the vendor is a
        company we track it now IS one; otherwise it falls back to the vendor hub
        rather than sitting there inert. */}
    {vendorCompany
      ? <a class="pill" href={`/companies/${vendorCompany.uid}/`}>{vendor}</a>
      : <a class="pill" href="/ai-news/vendor/">{vendor}</a>}
    Surfaced <time datetime={it.date}>{it.date}</time> · Announcement · {host}</p>

  <div class="answer-box">
    <p class="answer-label">{it.summary ? `In ${vendor}\u2019s words` : 'What this is'}</p>
    {it.summary ? (
      <p>{it.summary}</p>
    ) : (
      <p>
        An announcement published by {vendor} on its own site. {vendor} did not publish a
        per-post description for this one, so rather than inventing a summary, this page sends
        you straight to the source.
      </p>
    )}
  </div>

  {it.reader_note && (
    <div class="reader-note">
      <p class="rn-label">What this could mean for readers of The World of AI</p>
      {it.reader_note.split('\n\n').filter(Boolean).map((p: string) => <p>{p.trim()}</p>)}
      <p class="rn-foot">This section is this site&rsquo;s own reading, written by us and clearly
        separated from the vendor&rsquo;s words above. It is analysis rather than sourced fact,
        and it is the part of this page to argue with.</p>
    </div>
  )}

  <p class="cta-wrap">
    <a class="cta" href={it.url} rel="noopener" target="_blank">Read the original at {host} &rarr;</a>
  </p>

  <p class="note">
    {it.summary && <>The summary above is {vendor}&rsquo;s own published description of the post,
    quoted from its page metadata, not our analysis. </>}
    This is the vendor&rsquo;s announcement in the vendor&rsquo;s words: claims in it are
    theirs, not verified facts, and being covered here is not an endorsement. The surfaced date
    is when our intel watch first saw the post, which for a newly added feed can trail the
    vendor&rsquo;s own publication date.
  </p>

  <KeepReading blocks={[
    { label: 'Terms in this announcement, defined',
      links: relatedTerms.map((t) => ({ href: `/ai-glossary/${t.slug}/`, label: t.term, note: t.category })) },
    { label: `More from ${vendor}`,
      links: moreHere.map((a) => ({ href: `/ai-news/vendor/${a.slug}/`, label: a.title, note: a.date })) },
    { label: 'Across the site', links: [
      ...(vendorCompany ? [{ href: `/companies/${vendorCompany.uid}/`, label: `${vendor} company profile`, note: 'products, lawsuits, filings' }] : []),
      { href: '/ai-news/vendor/', label: 'All vendor announcements', note: 'every post our watch has surfaced' },
      { href: '/ai-news/daily/', label: 'Today\u2019s briefing', note: 'what the field published today' },
      { href: '/ai-glossary/', label: 'The AI glossary', note: '500+ terms in plain English' },
    ] },
  ]} />
</Base>

<style>
  .dateline { color: #7A8A9E; font-size: 14px; letter-spacing: .02em; }
  .pill { display: inline-block; background: #201868; color: #fff; font-size: 11px; padding: 2px 10px; border-radius: 999px; margin-right: 8px; vertical-align: 1px; }

  .answer-box { background: #FFF6EC; border: 1px solid #F0D6B0; border-radius: 6px; padding: 22px 26px; margin: 18px 0 24px; max-width: 760px; }
  .answer-box p { font-size: 16.5px; line-height: 1.75; color: #2C2C2A; margin: 0; }
  .answer-label { font-size: 11px !important; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #F07800; margin: 0 0 8px !important; }

  .reader-note { border-left: 3px solid #201868; padding: 4px 0 4px 20px; margin: 22px 0; max-width: 760px; }
  .rn-label { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: #201868; margin: 0 0 10px; }
  .reader-note p { font-size: 16px; line-height: 1.7; color: #2C2C2A; margin: 0 0 12px; }
  .rn-foot { font-size: 13px !important; color: #7A8A9E; font-style: italic; margin-bottom: 0 !important; }

  .cta-wrap { margin: 22px 0; }
  .cta { display: inline-block; background: #201868; color: #fff; font-weight: 600; font-size: 15px; padding: 12px 22px; border-radius: 6px; text-decoration: none; }
  .cta:hover { background: #F07800; }

  .note { font-size: 13.5px; color: #7A8A9E; font-style: italic; max-width: 68ch; }
</style>

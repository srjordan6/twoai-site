---
/**
 * The AI CWE tracker: what a CWE is, and every weakness class that an AI CVE
 * on this site's tracker is filed under, ranked by how many AI CVEs it holds.
 *
 * theworldofai bridge row 385 and Stephen, 2026-10-03: "there should be a
 * page explaining cwe and a listing of all the cwe numbers associated with
 * AI". Names and definitions are MITRE's; counts are the tracker's.
 */
import Base from '../../../layouts/Base.astro';
import CweTable from '../../../components/CweTable.astro';
import CweVsCve from '../../../components/CweVsCve.astro';
import { cweList } from '../../../lib/cwes';
const d = cweList();
const top = d.cwes.slice(0, 6);
// The "old web flaws" line holds only while the top three are classic web
// weaknesses; if the ranking changes, the sentence goes rather than lies.
const CLASSIC = new Set([918, 22, 94, 78, 79, 89, 862, 502, 306, 639, 400, 20, 287, 863, 200, 352, 77, 434, 284, 285]);
const classicTop = top.length >= 3 && top.slice(0, 3).every((c) => CLASSIC.has(c.num));
const topShare = d.cves_classed > 0 ? Math.round((top.reduce((s, c) => s + c.count, 0) / d.cves_classed) * 100) : 0;
const desc = `${d.total} CWE weakness classes behind ${d.cves_classed} AI CVEs, ranked. What a CWE is, how it differs from a CVE, and which old software mistakes dominate AI vulnerabilities. Updated ${d.generated}.`;
const jsonld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'AI CWE tracker', description: desc.slice(0, 300), dateModified: d.generated,
  url: 'https://theworldofai.org/ai-news/cwes/',
  isPartOf: { '@type': 'CollectionPage', name: 'AI News', url: 'https://theworldofai.org/ai-news/' },
});
---
<Base title="AI CWE tracker: the weaknesses behind AI vulnerabilities" description={desc.slice(0, 300)} current="/ai-news/" jsonld={jsonld} noindex={d.total === 0}>
  <p class="meta-line"><a href="/ai-news/">AI News</a> · <a href="/ai-news/cves/">AI CVE tracker</a> · AI CWE tracker</p>
  <h1>AI CWE tracker</h1>
  <p class="answer">A CWE, Common Weakness Enumeration, names a kind of mistake that makes software
    vulnerable. The <b>{d.cves_classed}</b> AI CVEs on this site's tracker fall into <b>{d.total}</b>
    weakness classes, and the six most common account for {topShare} percent of them.
    {classicTop && <>The leaders are {top[0].name}, {top[1].name} and {top[2].name}: old, well-known
    web flaws, not exotic attacks on models.</>}</p>
  <p class="meta-line">Last verified: <time datetime={d.generated}>{d.generated}</time></p>

  <CweVsCve />

  <h2>What a CWE is</h2>
  <p>MITRE maintains the CWE list, a catalogue of {d.mitre_total > 0 ? d.mitre_total : 'about 940'} software
    weaknesses, each with a number, a definition, the damage it can do and the ways to prevent it. Every CVE
    record that the National Vulnerability Database analyses is assigned the CWE that best describes its root
    cause, so a flaw in a web framework and a flaw in an MCP server can be filed under the same weakness.
    Counting CVEs by CWE shows which mistakes keep being made, which is the question a security program can
    act on: fix a class of mistake once and many future CVEs never happen.</p>
  <p>Weaknesses come at different levels of detail. A <b>Pillar</b> or <b>Class</b> is broad, such as
    improper access control; a <b>Base</b> is specific enough to test for, such as path traversal; a
    <b>Variant</b> is tied to one language or technology. Each page here says which level its weakness is.</p>

  <h2>Every weakness class in AI CVEs</h2>
  <CweTable />
  {d.unlisted.length > 0 && (
    <p class="meta-line">Also on the tracker: {d.unlisted.map((u, i) => <>{i > 0 && ', '}{u.cwe_id} ({u.count})</>)},
      a CWE category rather than a weakness, so MITRE's weakness list has no entry for it.
      {d.cves_unclassed > 0 && <> {d.cves_unclassed} AI CVEs have no CWE assigned yet.</>}</p>
  )}

  <div class="cite-box">Cite this page: <code>"AI CWE tracker." The World of AI,
    theworldofai.org/ai-news/cwes/. Retrieved {d.generated}.</code></div>

  <p class="meta-line">CWE names, definitions and mitigations are from the <a href="https://cwe.mitre.org/" rel="noopener">CWE
    List</a>, copyright The MITRE Corporation, reproduced under its terms of use. CWE is a trademark of The MITRE
    Corporation. Counts and rankings are this site's, from its <a href="/ai-news/cves/">AI CVE tracker</a>.</p>
</Base>

<style>
  .cite-box { margin: 1.6em 0; padding: .9em 1em; background: #f7f7fb; border-left: 3px solid #201868; font-size: .9rem; }
  .cite-box code { display: block; margin-top: .3em; }
</style>

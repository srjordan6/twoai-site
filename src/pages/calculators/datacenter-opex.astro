---
import Base from '../../layouts/Base.astro';
const desc = 'Free data center OpEx calculator: annual and monthly energy cost from IT load, PUE and electricity tariff, including demand charges and cost per kW of IT.';
const jsonld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'WebApplication',
  name: 'Data Center Energy Cost Calculator', applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: 'https://theworldofai.org/calculators/datacenter-opex/',
});
---
<Base title="Data Center Energy Cost Calculator: annual OpEx from load and tariff — The World of AI" description={desc} current="/calculators/" jsonld={jsonld}>
  <h1>Data Center Energy Cost Calculator</h1>
  <p class="answer">Annual energy cost is IT load times PUE times 8,760 hours times the price per kilowatt-hour, plus demand charges billed on peak kilowatts rather than consumption. At $0.08/kWh a single megawatt of IT at a PUE of 1.3 costs roughly $911,000 a year to power before demand charges.</p>
  <p class="meta-line">Formula and defaults last reviewed: 2026-08-31.</p>

  <div class="calc">
    <label>IT load (kW) <input type="number" id="it" value="1000" step="10" min="0" /></label>
    <label>PUE <input type="number" id="pue" value="1.3" step="0.01" min="1" /></label>
    <label>Energy price ($/kWh) <input type="number" id="rate" value="0.08" step="0.005" min="0" /></label>
    <label>Demand charge ($ per kW of peak, per month) <input type="number" id="demand" value="12" step="1" min="0" /></label>
    <label>Average utilisation of that load (%) <input type="number" id="util" value="85" step="5" min="1" /></label>
    <div class="out" id="out" aria-live="polite"></div>
  </div>

  <h2>How the math works</h2>
  <p>Facility kW = IT kW × PUE. Annual kWh = facility kW × 8,760 hours, adjusted for how fully
    the load is actually used. Demand charges are billed separately on the highest peak in a
    billing period, which is why they are calculated here against full load rather than average:
    one hour at peak sets the charge for the month.</p>
  <h2>Why AI changes this line</h2>
  <p>Training runs hold load close to peak for weeks, so the gap between average and peak that
    protects a conventional facility's bill largely disappears. That raises both the energy
    charge, because utilisation is high, and the demand charge, because the peak is sustained.
    It is also why utilities increasingly price large AI loads on separate tariffs with minimum
    take commitments rather than standard industrial rates.</p>

  <div class="cite-box">Cite this tool: <code>"Data Center Energy Cost Calculator." The World of AI,
    theworldofai.org/calculators/datacenter-opex/.</code></div>

  <script is:inline>
  (function () {
    function n(i) { return parseFloat(document.getElementById(i).value) || 0; }
    function f(v, d) { return v.toLocaleString(undefined, { maximumFractionDigits: d === undefined ? 0 : d }); }
    var IDS = ['it','pue','rate','demand','util'];
    function calc() {
      var avg = n('it') * (n('util') / 100);
      var facPeak = n('it') * n('pue');
      var facAvg = avg * n('pue');
      var kwh = facAvg * 8760;
      var energy = kwh * n('rate');
      var dem = facPeak * n('demand') * 12;
      var total = energy + dem;
      document.getElementById('out').innerHTML =
        'Facility energy: <b>' + f(kwh / 1000) + ' MWh/yr</b><br>' +
        'Energy charges: <b>$' + f(energy) + '</b> a year<br>' +
        'Demand charges: $' + f(dem) + ' a year on a ' + f(facPeak) + ' kW peak<br>' +
        'Total: <b>$' + f(total) + '</b> a year, $' + f(total / 12) + ' a month<br>' +
        '<span class="sub">$' + f(n('it') > 0 ? total / n('it') : 0) + ' per kW of IT per year. Cutting PUE to 1.2 would save about $' +
        f((facAvg - avg * 1.2) * 8760 * n('rate')) + ' a year in energy alone.</span>';
    }
    IDS.forEach(function (i) {
      document.getElementById(i).addEventListener('input', calc);
      document.getElementById(i).addEventListener('change', calc);
    });
    calc();
  })();
  </script>
  <style>
    .calc { border: 1px solid #e6e4de; border-radius: 10px; padding: 18px 20px; background: #fafaf6; margin: 1.4em 0; }
    .calc label { display: block; margin: 0 0 12px; font-size: 14px; color: #26262b; }
    .calc input, .calc select { display: block; margin-top: 4px; padding: 7px 9px; font-size: 15px;
      border: 1px solid #cfcdc6; border-radius: 6px; width: 220px; max-width: 100%; }
    .out { margin-top: 14px; padding-top: 14px; border-top: 1px solid #e6e4de; font-size: 16px; line-height: 1.7; }
    .out b { color: #201868; }
    .sub { color: #7A8A9E; font-size: 13.5px; }
  </style>
</Base>

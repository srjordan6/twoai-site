---
import Base from '../../layouts/Base.astro';
const desc = 'Free AI ROI calculator: compare the hours a deployment saves against licence, build, and running costs, with payback period and a break-even adoption rate.';
const jsonld = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'WebApplication',
  name: 'AI ROI Calculator', applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: 'https://theworldofai.org/calculators/roi/',
});
---
<Base title="AI ROI Calculator: payback period and break-even adoption — The World of AI" description={desc} current="/calculators/" jsonld={jsonld}>
  <h1>AI ROI Calculator</h1>
  <p class="answer">An AI deployment pays for itself when <b>hours saved times the loaded cost of
    an hour</b> exceeds licences, build, and running costs. The number most business cases get
    wrong is not the saving per person, it is <b>adoption</b>: a tool that saves two hours a week
    for the 30 percent of staff who actually use it returns less than a third of what the
    proposal claimed. This calculator makes adoption explicit and tells you the rate at which
    the project breaks even.</p>

  <div class="calc">
    <label>People with a licence <input type="number" id="seats" value="100" step="10" min="1" /></label>
    <label>Adoption, share who use it regularly (%) <input type="number" id="adopt" value="40" step="5" min="1" max="100" /></label>
    <label>Hours saved per active user per week <input type="number" id="hours" value="2" step="0.5" min="0" /></label>
    <label>Loaded cost per hour (USD) <input type="number" id="rate" value="75" step="5" min="0" /></label>
    <label>Share of saved time actually redeployed (%) <input type="number" id="realise" value="60" step="5" min="0" max="100" /></label>
    <label>Licence cost per seat per month (USD) <input type="number" id="lic" value="30" step="5" min="0" /></label>
    <label>One-off build and rollout cost (USD) <input type="number" id="build" value="120000" step="10000" min="0" /></label>
    <label>Annual running cost: support, governance, infrastructure (USD) <input type="number" id="run" value="60000" step="10000" min="0" /></label>
    <div class="out" id="out" aria-live="polite"></div>
  </div>

  <h2>Why two of these inputs decide the answer</h2>
  <p><b>Adoption.</b> Licences bought is not people using. Measure it from actual usage
    telemetry rather than from the rollout plan, and revisit it quarterly, because adoption
    curves flatten far below 100 percent in most organisations.</p>
  <p><b>Realisation.</b> An hour saved is only a return if it is spent on something valuable.
    If the work simply absorbs the slack, the saving is real for the person and invisible on the
    financials. Setting realisation to 100 percent is the most common way a business case
    overstates itself; 50 to 70 percent is a defensible planning assumption unless you can point
    to headcount you did not hire or backlog you cleared.</p>
  <p>Not modelled here: revenue gains, quality and error-rate changes, risk and compliance cost,
    and the cost of a failed deployment. This is a labour-saving model, which is the easiest case
    to defend and the least complete.</p>

  <div class="cite-box">Cite this tool: <code>"AI ROI Calculator." The World of AI,
    theworldofai.org/calculators/roi/.</code></div>

  <p class="meta-line">This is a planning tool, not financial advice. See our
    <a href="/disclaimer/">disclaimer</a>.</p>

  <script is:inline>
  (function () {
    function usd(n) { return '$' + Math.round(n).toLocaleString(); }
    function calc() {
      var seats = parseFloat(document.getElementById('seats').value) || 0;
      var adopt = (parseFloat(document.getElementById('adopt').value) || 0) / 100;
      var hrs = parseFloat(document.getElementById('hours').value) || 0;
      var rate = parseFloat(document.getElementById('rate').value) || 0;
      var real = (parseFloat(document.getElementById('realise').value) || 0) / 100;
      var lic = parseFloat(document.getElementById('lic').value) || 0;
      var build = parseFloat(document.getElementById('build').value) || 0;
      var run = parseFloat(document.getElementById('run').value) || 0;

      var active = seats * adopt;
      var benefit = active * hrs * 46 * rate * real; // 46 working weeks
      var annualCost = seats * lic * 12 + run;
      var net = benefit - annualCost;
      var firstYear = benefit - annualCost - build;
      var roi = (annualCost + build) > 0 ? (firstYear / (annualCost + build)) * 100 : 0;
      var payback = net > 0 ? build / (net / 12) : 0;

      // Adoption at which year-one net is zero.
      var perPoint = seats * 0.01 * hrs * 46 * rate * real;
      var beAdopt = perPoint > 0 ? ((annualCost + build) / perPoint) : 0;

      var verdict = firstYear > 0
        ? 'Positive in year one.'
        : net > 0
          ? 'Negative in year one, positive thereafter once the build is behind you.'
          : 'Does not pay back at these inputs. The saving never covers the running cost.';

      document.getElementById('out').innerHTML =
        '<b>' + usd(benefit) + '</b> of time released a year from ' + Math.round(active) +
        ' active users<br>' +
        usd(annualCost) + ' annual cost, ' + usd(build) + ' one-off<br>' +
        'Year one net: <b>' + usd(firstYear) + '</b> (' + roi.toFixed(0) + '% return)<br>' +
        (payback > 0 && payback < 60
          ? 'Payback on the build in about ' + payback.toFixed(1) + ' months.<br>'
          : '') +
        'Break-even adoption: <b>' + (beAdopt > 100 ? 'above 100%, unreachable' : beAdopt.toFixed(0) + '%') +
        '</b><br><span class="note">' + verdict + '</span>';
    }
    ['seats', 'adopt', 'hours', 'rate', 'realise', 'lic', 'build', 'run'].forEach(function (id) {
      document.getElementById(id).addEventListener('input', calc);
      document.getElementById(id).addEventListener('change', calc);
    });
    calc();
  })();
  </script>
</Base>

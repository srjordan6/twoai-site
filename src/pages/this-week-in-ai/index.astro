---
/**
 * This Week in AI, the weekly digest hub.
 *
 * The hub is a summary of the whole archive, not a table of contents for it:
 * how much has moved, what the recurring subjects are, and which weeks were
 * busy. Everything on it is computed by the pipeline from the items in the
 * weeks below, so the numbers here and the pages they link to cannot disagree.
 */
import Base from '../../layouts/Base.astro';
import { readFileSync, existsSync } from 'node:fs';

const idx = existsSync('content/week/index.json')
  ? JSON.parse(readFileSync('content/week/index.json', 'utf8'))
  : { weeks: [], themes: [], total_items: 0, generated: '' };
const weeks = idx.weeks || [];

// The pipeline's index carries a recent window, but a week page lives
// forever. Any week file the index no longer mentions still gets a row, or
// its page is reachable only through the sitemap - an orphan, per the crawl.
const known = new Set(weeks.map((w) => w.slug));
const weekMods = import.meta.glob('../../../content/week/*.json', { eager: true });
for (const [p, mod] of Object.entries(weekMods)) {
  if (p.endsWith('/index.json')) continue;
  const w: any = (mod as any).default ?? mod;
  const slug = w.slug || p.split('/').pop().replace('.json', '');
  if (known.has(slug)) continue;
  known.add(slug);
  weeks.push({
    slug,
    label: w.label || slug,
    start: w.start || '', end: w.end || '',
    bills: w.bills?.length ?? w.bills ?? 0,
    federal: w.federal?.length ?? w.federal ?? 0,
    courts: w.courts?.length ?? w.courts ?? 0,
    top_theme: w.top_theme || null,
    total: w.total || 0,
  });
}
weeks.sort((a, b) => (b.slug || '').localeCompare(a.slug || ''));
const themes = idx.themes || [];
const latest = weeks[0];
const total = idx.total_items || 0;
const plural = (n, s, p) => `${n} ${n === 1 ? s : p || s + 's'}`;
const busiest = weeks.reduce((m, w) => (!m || w.total > m.total ? w : m), null);

const lede = weeks.length
  ? `Over the last ${plural(weeks.length, 'week')} we recorded ${plural(total, 'change')} across American AI policy and litigation: state and congressional bills that moved, documents published in the Federal Register, and lawsuits whose dockets saw activity. ${themes.length ? `The subject that came up most was ${themes[0].name.toLowerCase()}.` : ''}`
  : 'The first weekly digest publishes on the next pipeline run.';
const desc =
  'A weekly record of what moved in AI policy and litigation: bills that changed status, federal documents published, and lawsuits with new docket activity.';
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'This Week in AI',
  description: desc,
  url: 'https://theworldofai.org/this-week-in-ai/',
  dateModified: idx.generated,
});
---
<Base title="This Week in AI: what actually moved in policy and litigation" description={desc} current="/this-week-in-ai/" jsonld={jsonld}>
  <h1>This Week in AI</h1>
  <p class="answer">{lede}</p>
  {idx.generated && <p class="meta-line">Last verified: {idx.generated} · Sources: LegiScan, the Federal Register, CourtListener</p>}

  <p>Nothing here is aggregated from other people's coverage. Each entry is a record we
    hold and check ourselves, and each links to the primary document. A quiet week is
    reported as a quiet week, because a tracker that always claims a busy one is useless
    for telling the difference.</p>

  {themes.length > 0 && (
    <>
      <h2>What American AI policy is actually about</h2>
      <p>Across every week in this archive, bills and federal documents fall into a small
        number of recurring subjects. This is the shape of the field as legislators are
        treating it, counted from their own language rather than from commentary.</p>
      <dl class="themes">
        {themes.map((t) => (
          <>
            <dt>{t.name} <span class="n">{t.count}</span></dt>
            <dd>{t.blurb}</dd>
          </>
        ))}
      </dl>
    </>
  )}

  {latest && (
    <>
      <h2>Most recent week</h2>
      <p><a href={`/this-week-in-ai/${latest.slug}/`}>{latest.label}, {latest.start} to {latest.end}</a>
        {latest.total === 0
          ? ': nothing recorded yet.'
          : `: ${plural(latest.bills, 'bill')} across ${plural(latest.jurisdictions || 0, 'jurisdiction')}, ${plural(latest.federal, 'federal document')}, and ${plural(latest.courts, 'case update')}.`}
        {latest.top_theme && <> Leading subject: {latest.top_theme.toLowerCase()}.</>}
      </p>
      {busiest && busiest.slug !== latest.slug && (
        <p>The busiest week in the archive was <a href={`/this-week-in-ai/${busiest.slug}/`}>{busiest.label}</a>,
          with {plural(busiest.total, 'recorded change')}.</p>
      )}
    </>
  )}

  {weeks.length > 1 && (
    <>
      <h2>Every week</h2>
      <table>
        <thead><tr><th>Week</th><th>Dates</th><th>Bills</th><th>Federal</th><th>Courts</th><th>Leading subject</th></tr></thead>
        <tbody>
          {weeks.map((w) => (
            <tr>
              <td><a href={`/this-week-in-ai/${w.slug}/`}>{w.label}</a></td>
              <td>{w.start} to {w.end}</td>
              <td>{w.bills}</td>
              <td>{w.federal}</td>
              <td>{w.courts}</td>
              <td>{w.top_theme || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  <p class="meta-line">Prefer the underlying records? The archive is available as
    <a href="/api/weeks.json">weeks.json</a>, and the sources behind it as
    <a href="/api/laws.json">laws.json</a> and <a href="/api/lawsuits.json">lawsuits.json</a>.</p>
</Base>

<style>
  .themes { margin: 0 0 1.4em; }
  .themes dt { font-weight: 600; margin-top: .9em; }
  .themes dt .n {
    display: inline-block; margin-left: .4em; padding: 1px 8px;
    background: var(--cream); border-radius: 10px;
    font-size: .8rem; font-weight: 600; color: var(--navy);
  }
  .themes dd { margin: .2em 0 0; color: #3d3d46; }
</style>

---
/**
 * This Week in AI: the week's news (Stephen, 2026-10-09).
 *
 * "Everything moves from the daily headline to the weekly headline and then
 * it is archived." Each day's stories, vendor posts and incidents appear on
 * the daily pages; the ones readers opened most, or that mattered most, carry
 * into this week's page; when the week ends its page stays as the archive.
 * The weekly policy digest that used to live here is now This Week in AI
 * Laws and Compliance, under AI Compliance, Law and Regulation.
 */
import Base from '../../layouts/Base.astro';
import NewsWeekLists from '../../components/NewsWeekLists.astro';
import { loadNewsWeeks, plural } from '../../lib/newsWeeks';
import { citeUID } from '../../lib/cite';

const weeks = loadNewsWeeks();
const cur = weeks[0];
const lede = cur
  ? `${cur.current ? 'This week so far' : cur.label}: ${plural(cur.counts.stories, 'headline story', 'headline stories')}, ${plural(cur.counts.vendor, 'vendor announcement')} and ${plural(cur.counts.incidents, 'logged AI harm')}. Below are the ones readers opened most and the ones covered most widely, each with its own page.`
  : 'The first week publishes with the next pipeline run.';
const desc = 'The week in AI news: the top headline stories, vendor announcements and AI incidents, chosen by traffic and importance from the daily briefing, then archived week by week.';
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'This Week in AI',
  description: desc,
  url: 'https://theworldofai.org/this-week-in-ai/',
  dateModified: cur?.generated,
});
const citeUid = citeUID(Astro.url.pathname, undefined);
---
<Base title="This Week in AI: the week's top AI news, vendor announcements and AI incidents" description={desc} current="/this-week-in-ai/" jsonld={jsonld}>
  <h1>This Week in AI</h1>
  <p class="answer">{lede}</p>
  <p class="meta-line">{cur?.generated && <>Last verified: {cur.generated} · </>}From the
    {' '}<a href="/ai-news/daily/">AI Headline News</a>, <a href="/ai-news/vendor/">AI Vendor News</a>
    {' '}and <a href="/ai-news/daily/#incidents">When AI Goes Wrong</a>. The week in AI law is at
    {' '}<a href="/ai-ecosystem/enterprise-applications-governance-and-tools/8ec3f244/">This Week in AI Laws and Compliance</a>.</p>

  {cur && (
    <>
      <h2 class="nw-week"><a href={`/this-week-in-ai/${cur.slug}/`}>{cur.label}</a> <span class="meta-line">{cur.start} to {cur.end}</span></h2>
      <NewsWeekLists w={cur} limit={5} headingLevel={3} />
      <p><a href={`/this-week-in-ai/${cur.slug}/`}>The whole week &rarr;</a></p>
    </>
  )}

  {weeks.length > 1 && (
    <>
      <h2>The archive, week by week</h2>
      <div class="tbl-scroll">
        <table>
          <thead><tr><th>Week</th><th>Dates</th><th>Lead story</th><th class="num">Stories</th><th class="num">Vendor</th><th class="num">Incidents</th></tr></thead>
          <tbody>
            {weeks.map((w) => (
              <tr>
                <td><a href={`/this-week-in-ai/${w.slug}/`}>{w.label}</a></td>
                <td>{w.start} to {w.end}</td>
                <td>{w.stories[0] ? <a href={w.stories[0].href}>{w.stories[0].title}</a> : '—'}</td>
                <td class="num">{w.counts.stories}</td>
                <td class="num">{w.counts.vendor}</td>
                <td class="num">{w.counts.incidents}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <p class="meta-line">How a week is chosen: every item of the week is ranked by how many readers
    opened its page here and by how widely it was covered, and the top twelve stories, ten vendor
    posts and six incidents carry into the week. Nothing leaves the daily archive. RSS:
    {' '}<a href="/this-week-in-ai/feed.xml">this-week-in-ai/feed.xml</a>.</p>

  <div class="cite-box">Cite this page: <code>"This Week in AI." The World of AI,
    theworldofai.org/this-week-in-ai/.{cur?.generated ? ` Verified ${cur.generated}.` : ''}{' '}UID {citeUid}.</code></div>
</Base>

<style>
  .nw-week { margin-top: 1.4em; }
  .nw-week .meta-line { font-weight: 400; font-size: .85rem; margin-left: .4em; }
  .cite-box { margin: 1.6em 0; padding: .9em 1em; background: #FFF6EC; border-left: 3px solid #201868; font-size: .9rem; }
  .cite-box code { display: block; margin-top: .3em; font-family: 'Poppins', sans-serif; font-weight: 600; color: #201868; }
</style>

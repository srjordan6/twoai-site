---
/**
 * This Week in AI, the weekly digest hub.
 *
 * Reads content/week/index.json, which the pipeline builds from our own
 * verified tables: state legislative movement, Federal Register documents, and
 * lawsuit docket movement. There is no news feed behind this page, which is
 * why every line on it can be traced to a primary source.
 */
import Base from '../../layouts/Base.astro';
import { readFileSync, existsSync } from 'node:fs';

const idx = existsSync('content/week/index.json')
  ? JSON.parse(readFileSync('content/week/index.json', 'utf8'))
  : { weeks: [], generated: '' };
const weeks = idx.weeks || [];
const latest = weeks[0];
const desc =
  'A weekly record of what actually moved in AI policy and litigation: state bills that changed status, federal documents published, and lawsuits with new docket activity. Built from primary sources, quiet weeks included.';
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'This Week in AI',
  description: desc,
  url: 'https://theworldofai.org/this-week-in-ai/',
  dateModified: idx.generated,
});
---
<Base title="This Week in AI: what actually moved in policy and litigation" description={desc} current="/this-week-in-ai/" jsonld={jsonld}>
  <h1>This Week in AI</h1>
  <p class="answer">Each week we publish what genuinely changed in American AI policy and
    litigation: state bills that moved, documents the federal government published, and
    lawsuits with new docket activity. Every entry links to the primary record. Nothing here
    is aggregated from other people's coverage, and a quiet week is reported as a quiet week
    rather than padded out.</p>
  {idx.generated && <p class="meta-line">Last verified: {idx.generated} · Sources: LegiScan, the Federal Register, CourtListener</p>}

  {latest && (
    <>
      <h2>Latest: {latest.label}</h2>
      <p><a href={`/this-week-in-ai/${latest.slug}/`}>{latest.start} to {latest.end}</a>
        {latest.total === 0
          ? ', nothing recorded yet this week.'
          : `, ${latest.bills} bill${latest.bills === 1 ? '' : 's'}, ${latest.federal} federal document${latest.federal === 1 ? '' : 's'}, ${latest.courts} case update${latest.courts === 1 ? '' : 's'}.`}
      </p>
    </>
  )}

  {weeks.length > 1 && (
    <>
      <h2>Archive</h2>
      <table>
        <thead><tr><th>Week</th><th>Dates</th><th>Bills</th><th>Federal</th><th>Courts</th></tr></thead>
        <tbody>
          {weeks.map((w) => (
            <tr>
              <td><a href={`/this-week-in-ai/${w.slug}/`}>{w.label}</a></td>
              <td>{w.start} to {w.end}</td>
              <td>{w.bills}</td>
              <td>{w.federal}</td>
              <td>{w.courts}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  {weeks.length === 0 && <p>The first weekly digest publishes on the next pipeline run.</p>}

  <p class="meta-line">Want the underlying records instead? Every week is assembled from
    <a href="/api/laws.json">the laws API</a> and <a href="/api/lawsuits.json">the lawsuits API</a>.</p>
</Base>

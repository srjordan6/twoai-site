---
import Base from '../../../layouts/Base.astro';
import Reading from '../../../components/Reading.astro';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

export function getStaticPaths() {
  if (!existsSync('content/tools')) return [];
  const profiledSlugs = new Set(
    readdirSync('content/tools')
      .filter((f) => f.endsWith('.json') && f !== 'index.json' && !f.startsWith('cat-'))
      .map((f) => JSON.parse(readFileSync(`content/tools/${f}`, 'utf8')))
      .map((t) => [String(t.name).toLowerCase(), t.slug])
  );
  const nameToSlug = new Map([...profiledSlugs]);
  return readdirSync('content/tools')
    .filter((f) => f.startsWith('cat-'))
    .map((f) => {
      const c = JSON.parse(readFileSync(`content/tools/${f}`, 'utf8'));
      return { params: { cat: c.slug }, props: { c, nameToSlug: Object.fromEntries(nameToSlug) } };
    });
}
const { c, nameToSlug } = Astro.props;
const desc = `${c.tools.length} AI tools in ${c.name}, with vendors, what each one does, and links to full profiles where we have them.`;
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${c.name} AI Tools`,
  description: desc,
  url: `https://theworldofai.org/ai-tools/category/${c.slug}/`,
  dateModified: c.generated,
});
---
<Base title={`${c.name}: ${c.tools.length} AI tools compared`} description={desc} current="/ai-tools/" jsonld={jsonld}>
  <h1>{c.name}</h1>
  <p class="answer">This category tracks <b>{c.tools.length} AI tools</b> in {c.name.toLowerCase()}.
    Each entry names the vendor and what the tool actually does. Where we have researched a tool
    in depth, the name links to a full profile with pricing, weaknesses, and governance notes.</p>
  {c.generated && <p class="meta-line">Last verified: {c.generated} · Source: SRJ tool catalog</p>}

  {/* The category's own account of itself: what it is, what buyers choose
      between, how it moved in the last year. Written into
      twoai_tool_category_intros; absent until it is written, because a
      generated sentence about a category is worth less than silence. */}
  {c.intro && (
    <section>
      <h2>What this category is</h2>
      {String(c.intro).split(/\n{2,}/).map((para) => <p>{para}</p>)}
      {Array.isArray(c.intro_sources) && c.intro_sources.length > 0 && (
        <p class="meta-line">Sources: {c.intro_sources.map((s, i) => (
          <>{i > 0 && ' · '}{s.url
            ? <a href={s.url} rel="noopener">{s.title || s.publisher || s.url}</a>
            : (s.title || s.publisher)}</>
        ))}{c.intro_updated_on && <> · Written {c.intro_updated_on}</>}</p>
      )}
    </section>
  )}

  <table>
    <thead><tr><th>Tool</th><th>Vendor</th><th>What it does</th></tr></thead>
    <tbody>
      {c.tools.map((t) => {
        const slug = nameToSlug[String(t.name).toLowerCase()];
        return (
          <tr>
            <td>{slug
              ? <a href={`/ai-tools/${slug}/`}>{t.name}</a>
              : (t.url ? <a href={t.url} rel="noopener nofollow">{t.name}</a> : t.name)}</td>
            <td>{t.vendor}</td>
            <td>{t.note}</td>
          </tr>
        );
      })}
    </tbody>
  </table>

  <Reading reading={c.reading} heading={`What should a buyer know about ${c.name.toLowerCase()}?`} />

  <p><a href="/ai-tools/">All AI tool categories</a></p>
  <p class="meta-line">How this directory is funded, and what that never changes:
    <a href="/disclosure/">disclosure</a>.</p>
</Base>

---
import Base from '../../layouts/Base.astro';
import KeepReading from '../../components/KeepReading.astro';
import { matchTerms, companyFor, vendorPostsNaming, companiesNamedIn } from '../../lib/related';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

export function getStaticPaths() {
  if (!existsSync('content/tools')) return [];
  return readdirSync('content/tools')
    .filter((f) => f.endsWith('.json') && f !== 'index.json' && !f.startsWith('cat-'))
    .map((f) => {
      const t = JSON.parse(readFileSync(`content/tools/${f}`, 'utf8'));
      return { params: { tool: t.slug }, props: { t } };
    });
}
const { t } = Astro.props;
const desc = (t.tagline || t.value || t.name).slice(0, 155);
const krTerms = matchTerms(`${t.name} ${t.tagline ?? ''} ${t.value ?? ''} ${t.category ?? ''}`);
const krCompany = companyFor(t.vendor || t.name);
const krPosts = vendorPostsNaming(t.vendor || t.name, 4);
// Alternatives and integrations named in the profile are companies too; the
// vendor alone left 23 tool pages naming OpenAI with no route to it.
const krNamed = companiesNamedIn(JSON.stringify(t ?? {}), { limit: 4, exclude: t.vendor || t.name });
// FAQ FROM THE PROFILE, NOT FROM IMAGINATION. Each answer is a field this
// page already shows: what the tool is for, what the cheapest tier costs,
// what it is weakest at, what to use instead. An entry is skipped when its
// field is empty, so a thin profile gets a short FAQ instead of a padded one.
//
// The cost answer deliberately quotes the LOWEST tier and names it, because
// "what does it cost" answered with an enterprise figure is misleading, and
// answered with "it depends" is useless.
const cheapest = Array.isArray(t.pricing) && t.pricing.length > 0 ? t.pricing[0] : null;
const faq = [
  ...(t.value ? [{
    q: `What is ${t.name} used for?`,
    a: t.value,
  }] : []),
  ...(cheapest?.model ? [{
    q: `How much does ${t.name} cost?`,
    // limits text is authored without terminal punctuation, so it is
    // sentence-ended here rather than run into the tier count behind it.
    a: [
      `The ${cheapest.tier || 'entry'} tier is ${cheapest.model}.`,
      cheapest.limits ? String(cheapest.limits).replace(/[.;,]\s*$/, '') + '.' : '',
      t.pricing.length > 1 ? `There are ${t.pricing.length} tiers listed on this page; check the vendor for current terms.` : '',
    ].filter(Boolean).join(' '),
  }] : []),
  ...(Array.isArray(t.cons) && t.cons.length > 0 ? [{
    q: `What are the drawbacks of ${t.name}?`,
    a: t.cons[0],
  }] : []),
  ...(Array.isArray(t.alternatives) && t.alternatives.length > 0 ? [{
    q: `What are the alternatives to ${t.name}?`,
    a: `${t.alternatives.join(', ')}${t.category ? `, in the same category, ${t.category}` : ''}.`,
  }] : []),
].filter((f) => f.a && String(f.a).trim().length > 0);

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [{
  '@type': 'SoftwareApplication',
  name: t.name,
  description: t.tagline || t.value,
  applicationCategory: t.category || 'Artificial Intelligence',
  url: `https://theworldofai.org/ai-tools/${t.slug}/`,
  ...(t.vendor ? { author: { '@type': 'Organization', name: t.vendor } } : {}),
  }, ...(faq.length > 1 ? [{
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }] : [])],
});
---
<Base title={`${t.name}: what it does, what it costs, and where it falls short`} description={desc} current="/ai-tools/" jsonld={jsonld}>
  <h1>{t.name}</h1>
  {t.tagline && <p class="answer">{t.tagline}</p>}
  <p class="meta-line">
    {t.vendor && <>Vendor: {t.vendor} · </>}
    {t.status && <>Status: {t.status} · </>}
    {t.generated && <>Last verified: <time datetime={t.generated}>{t.generated}</time></>}
  </p>
  {t.url && <p><a href={t.url} rel="noopener nofollow">Visit the {t.name} site</a></p>}

  {t.value && (<><h2>What it is for</h2><p>{t.value}</p></>)}

  {t.use_cases?.length > 0 && (
    <><h2>Where it fits</h2><ul>{t.use_cases.map((u) => <li>{u}</li>)}</ul></>
  )}

  {(t.pros?.length > 0 || t.cons?.length > 0) && (
    <>
      <h2>Strengths and weaknesses</h2>
      {t.pros?.length > 0 && (<><h3>Strengths</h3><ul>{t.pros.map((p) => <li>{p}</li>)}</ul></>)}
      {t.cons?.length > 0 && (<><h3>Weaknesses</h3><ul>{t.cons.map((c) => <li>{c}</li>)}</ul></>)}
    </>
  )}

  {t.pricing?.length > 0 && (
    <>
      <h2>Pricing</h2>
      <table>
        <thead><tr><th>Tier</th><th>Model</th><th>Includes</th><th>Limits</th></tr></thead>
        <tbody>
          {t.pricing.map((p) => (
            <tr><td>{p.tier}</td><td>{p.model}</td><td>{p.includes}</td><td>{p.limits}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="meta-line">Pricing changes often. Confirm with the vendor before you buy.</p>
    </>
  )}

  {(t.engine || t.quality || t.latency || t.files || t.api) && (
    <>
      <h2>How it works</h2>
      {t.engine && <p><b>Engine.</b> {t.engine}</p>}
      {t.quality && <p><b>Quality.</b> {t.quality}</p>}
      {t.latency && <p><b>Speed.</b> {t.latency}</p>}
      {t.files && <p><b>Files and context.</b> {t.files}</p>}
      {t.api && <p><b>API.</b> {t.api}</p>}
    </>
  )}

  {(t.governance_note || t.training_optout) && (
    <>
      <h2>Governance and data</h2>
      {t.governance_note && <p>{t.governance_note}</p>}
      {t.training_optout && <p><b>Training opt-out.</b> {t.training_optout}</p>}
    </>
  )}

  {t.integrations?.length > 0 && (
    <><h2>Integrations</h2><ul>{t.integrations.map((i) => <li>{i}</li>)}</ul></>
  )}

  {t.alternatives?.length > 0 && (
    <><h2>Alternatives</h2><p>{t.alternatives.join(', ')}</p></>
  )}

  {t.audience?.length > 0 && (
    <p class="meta-line">Best suited to: {t.audience.join(', ')}
      {t.tags?.length > 0 && <> · {t.tags.join(' · ')}</>}</p>
  )}

  {faq.length > 1 && (
    <>
      <h2>Frequently asked questions</h2>
      {faq.map((f) => (
        <div class="faq-item">
          <h3 style="font-family:Poppins;font-size:16.5px;font-weight:600;color:#201868;margin:0 0 .3rem;">{f.q}</h3>
          <p style="margin:0;line-height:1.7;">{f.a}</p>
        </div>
      ))}
    </>
  )}

  <div class="cite-box">Cite this profile: <code>"{t.name}." The World of AI Tools Directory,
    theworldofai.org/ai-tools/{t.slug}/.{t.generated ? ` Verified ${t.generated}.` : ''}</code></div>

  <p class="meta-line">We are not paid by the vendors we profile. Verdicts are never for sale:
    <a href="/disclosure/">disclosure</a>.</p>
  <KeepReading blocks={[
    { label: 'Terms this tool works with, defined',
      links: krTerms.map((t) => ({ href: `/ai-glossary/${t.slug}/`, label: t.term, note: t.category })) },
    { label: 'Announcements from this vendor',
      links: krPosts.map((a: any) => ({ href: `/ai-news/vendor/${a.slug}/`, label: a.title, note: a.date })) },
    { label: 'Other companies named here',
      links: krNamed.map((x) => ({ href: `/companies/${x.uid}/`, label: `${x.name} profile` })) },
    { label: 'Across the site', links: [
      ...(krCompany ? [{ href: `/companies/${krCompany.uid}/`, label: `${krCompany.name} company profile`, note: 'products, lawsuits, filings' }] : []),
      { href: '/ai-tools/', label: 'The AI tools directory', note: 'everything we track, by category' },
      { href: '/ai-glossary/', label: 'The AI glossary', note: '500+ terms in plain English' },
    ] },
  ]} />
</Base>

---
/**
 * One MCP server, as its publisher declared it to the official registry.
 *
 * Nothing on this page is our assessment. We report the declared name,
 * publisher, description, version, transport, repository, and dates, and say
 * plainly that we have not tested it.
 */
import Base from '../../layouts/Base.astro';
import KeepReading from '../../components/KeepReading.astro';
import { matchTerms, companyFor } from '../../lib/related';
import { readFileSync, readdirSync, existsSync } from 'node:fs';

export function getStaticPaths() {
  if (!existsSync('content/mcp')) return [];
  return readdirSync('content/mcp')
    .filter((f) => f.endsWith('.json') && f !== 'index.json')
    .map((f) => {
      const d = JSON.parse(readFileSync(`content/mcp/${f}`, 'utf8'));
      return { params: { server: d.server.slug }, props: { s: d.server, generated: d.generated } };
    });
}
const { s, generated } = Astro.props;
const label = s.title || s.name;
const krTerms = matchTerms(`${s.title ?? ''} ${s.name} ${s.description ?? ''}`);
const krCompany = companyFor(s.vendor || '');
const desc = `${label}: an MCP server published by ${s.vendor || 'its author'} to the official Model Context Protocol registry. ${s.description}`.slice(0, 300);
/* INDEXABLE IS COMPUTED IN THE PIPELINE, not decided here. A page earns a place
   in the index by carrying enough to stand alone: what the server does, a real
   way to connect to it, and a source to verify against. The 1,900 MCP pages
   were blanket-noindexed on 2026-08-13 because they were a name and a sentence,
   which was the right call for a page with nothing on it and the wrong call
   forever. Now the ones with substance are indexable and the rest stay out.

   The honest fix for a thin page is to make it useful or keep it out of the
   index, never to pad it. */
const indexable = s.indexable === true;

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: label,
  description: s.description,
  applicationCategory: 'DeveloperApplication',
  softwareVersion: s.version,
  url: `https://theworldofai.org/mcp/${s.slug}/`,
  ...(s.repo_url ? { codeRepository: s.repo_url } : {}),
  ...(s.vendor ? { author: { '@type': 'Organization', name: s.vendor } } : {}),
});
---
<Base title={`${label} — MCP server — The World of AI`} description={desc} current="/mcp/" jsonld={jsonld} noindex={!indexable}>
  <p class="meta-line"><a href="/">AI Ecosystem</a> ·
    <a href="/ai-ecosystem/technology-and-core-infrastructure/">Technology and Core Infrastructure</a> ·
    <a href="/mcp/">MCP Servers</a></p>

  <h1>{label}</h1>
  <p class="answer">{s.description}</p>
  <p class="meta-line">
    {s.vendor && <>Published by {s.vendor} · </>}
    {s.version && <>Version {s.version} · </>}
    {s.transport && <>Runs as a {s.transport} · </>}
    {generated && <>Last verified: {generated}</>}
  </p>

  {(s.remote_url || s.package_id) && (
    <>
      <h2>How to connect to it</h2>
      <p>
        {s.remote_url
          ? <>This server is hosted by its publisher, so nothing is installed locally. It speaks
              {' '}<b>{s.remote_type || 'HTTP'}</b> at the endpoint below, and an MCP client is pointed
              at that URL. Whatever the endpoint can reach, the agent can reach.</>
          : <>This server runs on your own machine or container. It is published to
              {' '}<b>{s.package_registry || 'a package registry'}</b> as
              {' '}<code>{s.package_id}</code>{s.package_version && <> at version {s.package_version}</>},
              and communicates over <b>{s.remote_type || 'stdio'}</b>. Code you install runs with
              your permissions, not the model's.</>}
      </p>
      <div class="tw">
        <table>
          <tbody>
            {s.remote_url && <tr><th>Endpoint</th><td><code>{s.remote_url}</code></td></tr>}
            {s.remote_type && <tr><th>Transport</th><td><code>{s.remote_type}</code></td></tr>}
            {s.package_id && <tr><th>Package</th><td><code>{s.package_id}</code></td></tr>}
            {s.package_registry && <tr><th>Registry</th><td>{s.package_registry}</td></tr>}
            {s.package_version && <tr><th>Version</th><td><code>{s.package_version}</code></td></tr>}
          </tbody>
        </table>
      </div>
      <h2>Before you connect it</h2>
      <p>
        An MCP server is a set of capabilities an agent can invoke on your behalf, so the questions
        worth asking are about authority rather than features.
        {s.remote_url
          ? <> This one is remote, so your data leaves your environment to reach it: check what the
              publisher retains, what credentials the endpoint asks for, and whether those
              credentials can be scoped down.</>
          : <> This one runs locally, so the questions are supply chain: who publishes the package,
              what it pulls in, and what it can touch on the machine that runs it.</>}
        {' '}The general treatment is in
        {' '}<a href="/ai-ecosystem/enterprise-applications-governance-and-tools/">AI Security and Risk</a>,
        and the protocol-specific one under MCP security.
      </p>
    </>
  )}

  {s.siblings && s.siblings.length > 0 && (
    <>
      <h2>Others from the same publisher</h2>
      <p class="sub">Servers published under <code>{s.namespace}</code>, which the registry treats as
        one publisher.</p>
      <ul class="sibs">
        {s.siblings.map((t: string, i: number) => (
          <li><a href={`/mcp/${s.sibling_slugs[i]}/`}>{t}</a></li>
        ))}
      </ul>
    </>
  )}

  <h2>Registry record</h2>
  <table>
    <tbody>
      <tr><th>Registry name</th><td><code>{s.name}</code></td></tr>
      {s.vendor && <tr><th>Publisher</th><td>{s.vendor}</td></tr>}
      {s.version && <tr><th>Latest version</th><td>{s.version}</td></tr>}
      {s.transport && <tr><th>How it runs</th><td>{s.transport === 'remote'
        ? 'Hosted endpoint, connect over the network'
        : 'Package you install and run yourself'}</td></tr>}
      {s.repo_url && <tr><th>Repository</th><td><a href={s.repo_url} rel="noopener nofollow">{s.repo_url}</a></td></tr>}
      {s.website && <tr><th>Website</th><td><a href={s.website} rel="noopener nofollow">{s.website}</a></td></tr>}
      {s.published && <tr><th>First published</th><td>{s.published}</td></tr>}
      {s.updated && <tr><th>Registry updated</th><td>{s.updated}</td></tr>}
    </tbody>
  </table>

  <h2>Before you connect this to anything</h2>
  <p>We have not installed or tested this server. Its presence in the official registry means
    its publisher registered it, not that it is safe, maintained, or does what the description
    says. An MCP server runs with whatever access you grant it, so read the repository, check
    when it was last updated, and understand what data it can reach before connecting it to a
    system that matters.</p>

  <div class="cite-box">Cite this page: <code>"{label}." MCP Server Directory, The World of AI,
    theworldofai.org/mcp/{s.slug}/.{generated ? ` Verified ${generated}.` : ''}</code></div>

  <p><a href="/mcp/">All MCP servers</a></p>
  <KeepReading blocks={[
    { label: 'Terms this server works with, defined',
      links: krTerms.map((t) => ({ href: `/ai-glossary/${t.slug}/`, label: t.term, note: t.category })) },
    { label: 'Across the site', links: [
      ...(krCompany ? [{ href: `/companies/${krCompany.uid}/`, label: `${krCompany.name} company profile`, note: 'products, lawsuits, filings' }] : []),
      { href: '/mcp/', label: 'The MCP server directory', note: 'every server in the official registry' },
      { href: '/ai-glossary/model-context-protocol/', label: 'Model Context Protocol, defined', note: 'what MCP actually is' },
      { href: '/ai-glossary/', label: 'The AI glossary', note: '500+ terms in plain English' },
    ] },
  ]} />
</Base>

<style>
  table th { width: 30%; text-align: left; vertical-align: top; }
  code { word-break: break-all; }
  .sub { font-size: 14px; color: #7A8A9E; margin: 0 0 10px; }
  .sibs { list-style: none; margin: 0; padding: 0; }
  .sibs li { padding: 6px 0; border-bottom: 1px solid #f4f4f8; font-size: 14.5px; }
  .sibs a { color: #201868; text-decoration: none; font-weight: 600; }
  .sibs a:hover { color: #F07800; }
  .tw { overflow-x: auto; }
</style>

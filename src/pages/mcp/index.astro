---
/**
 * MCP server directory hub.
 *
 * Everything here mirrors the official registry at
 * registry.modelcontextprotocol.io. We do not rate servers and do not claim any
 * of them work; the value is that the list is complete, current, and browsable,
 * which the registry API alone is not.
 */
import Base from '../../layouts/Base.astro';
import { readFileSync, existsSync } from 'node:fs';

const idx = existsSync('content/mcp/index.json')
  ? JSON.parse(readFileSync('content/mcp/index.json', 'utf8'))
  : { servers: [], total: 0, profiled: 0, remote: 0, local: 0, generated: '' };
const servers = idx.servers || [];
// A TO Z. Stephen, 2026-09-19: he wants an index above All servers. 2,347 rows
// in one table is a scroll, not a directory, and the only way in was the
// browser's own find.
//
// The index is keyed on what the Server column actually shows, the publisher's
// title where there is one and the registry name where there is not, because an
// index that sorts by something invisible sends the reader to the wrong place.
// That is also why the table is now sorted by that same text: it was sorted by
// slug, so ac.* came before Aard, and no letter index could have agreed with it.
//
// A holds 943 of the 2,347, and that is real rather than a bug: 728 of them are
// untitled servers whose registry name begins with the ai. or agency. or app.
// namespace convention. The count sits beside each letter so the reader knows
// what they are jumping into. Anything not starting with a letter, digits and
// the handful of Cyrillic and CJK names, groups under #.
const LETTERS = ['#', ...Array.from({ length: 26 }, (_, i) => String.fromCharCode(65 + i))];
const shown = (s) => s.title || s.name || '';
const letterOf = (s) => {
  const c = shown(s).trim().charAt(0).toUpperCase();
  return c >= 'A' && c <= 'Z' ? c : '#';
};
const byLetter = new Map(LETTERS.map((l) => [l, []]));
for (const s of servers) byLetter.get(letterOf(s)).push(s);
for (const list of byLetter.values()) {
  list.sort((a, b) => shown(a).localeCompare(shown(b), 'en', { sensitivity: 'base' }));
}
const groups = LETTERS.map((l) => ({ letter: l, id: l === '#' ? 'srv-other' : `srv-${l.toLowerCase()}`, list: byLetter.get(l) }))
  .filter((g) => g.list.length > 0);

// A SECOND LEVEL, BECAUSE A IS 943. Stephen, 2026-09-19. One letter holding
// 40% of the directory is a scroll with a label on it, so a letter that runs
// past TARGET is cut into ranges the way a dictionary is, and the ranges carry
// guide words rather than a number.
//
// The cut follows the data instead of a fixed depth. Entries are grouped by a
// prefix of the sorted text, consecutive prefix groups are run together while
// they fit, and a single prefix group that is too big on its own is cut again
// one character deeper. That matters here: ai.smithery/ alone publishes 213
// servers and ai.getvda/ another 95, so a fixed two-character rule would have
// produced one bucket of 666 and called it AI.
//
// Guide words are the shortest prefix that tells a range from its neighbours,
// which is what a dictionary header does and why "ai.smithery/f to
// ai.smithery/p" is the right label rather than a wrong-but-tidy "Ai".
const TARGET = 90;
const MAX_DEPTH = 24;
const LABEL_CAP = 18;
const sortText = (s) => shown(s).trim();
const sortKey = (s) => sortText(s).toLowerCase();

function splitRuns(items, depth) {
  if (items.length <= TARGET || depth > MAX_DEPTH) return [items];
  const runs = new Map();
  for (const s of items) {
    const k = sortKey(s).slice(0, depth);
    if (!runs.has(k)) runs.set(k, []);
    runs.get(k).push(s);
  }
  // Every entry shares this prefix, so cutting here buys nothing; go deeper.
  if (runs.size === 1) return splitRuns(items, depth + 1);
  const out = [];
  let cur = [];
  for (const run of runs.values()) {
    if (run.length > TARGET) {
      if (cur.length) { out.push(cur); cur = []; }
      out.push(...splitRuns(run, depth + 1));
      continue;
    }
    if (cur.length && cur.length + run.length > TARGET) { out.push(cur); cur = []; }
    cur = cur.concat(run);
  }
  if (cur.length) out.push(cur);
  // A range of one or two entries beside a big one reads as a mistake. Fold a
  // stray back into the range before it where the two still fit.
  const merged = [];
  for (const b of out) {
    const prev = merged[merged.length - 1];
    if (prev && prev.length + b.length <= TARGET && Math.min(prev.length, b.length) < TARGET / 3) {
      merged[merged.length - 1] = prev.concat(b);
    } else merged.push(b);
  }
  return merged;
}

const commonLen = (a, b) => {
  let n = 0;
  while (n < Math.min(a.length, b.length) && a[n].toLowerCase() === b[n].toLowerCase()) n++;
  return n;
};

for (const g of groups) {
  const buckets = splitRuns(g.list, 2);
  g.ranges = buckets.length < 2 ? null : buckets.map((b, i) => {
    const first = sortText(b[0]);
    const last = sortText(b[b.length - 1]);
    const prevLast = i > 0 ? sortText(buckets[i - 1][buckets[i - 1].length - 1]) : '';
    const nextFirst = i + 1 < buckets.length ? sortText(buckets[i + 1][0]) : '';
    const a = first.slice(0, Math.min(LABEL_CAP, Math.max(2, commonLen(first, prevLast) + 1)));
    const z = last.slice(0, Math.min(LABEL_CAP, Math.max(2, a.length, commonLen(last, nextFirst) + 1)));
    return {
      id: `${g.id}-${i + 1}`,
      label: a.toLowerCase() === z.toLowerCase() ? a : `${a} to ${z}`,
      list: b,
    };
  });
}
const desc =
  `A browsable directory of ${idx.total} active Model Context Protocol servers from the official ` +
  `MCP registry: who publishes each one, what it does, and where to get it.`;
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'MCP Server Directory',
  description: desc,
  url: 'https://theworldofai.org/mcp/',
  dateModified: idx.generated,
});
---
<Base title="MCP Server Directory: every active Model Context Protocol server" description={desc} current="/mcp/" jsonld={jsonld}>
  <p class="meta-line"><a href="/">AI Ecosystem</a> ·
    <a href="/ai-ecosystem/technology-and-core-infrastructure/">Technology and Core Infrastructure</a></p>
  <h1>MCP Server Directory</h1>
  <p class="answer">The Model Context Protocol is how AI assistants connect to tools and data:
    a server exposes something, a client consumes it. This directory tracks
    <b>{idx.total.toLocaleString()} active servers</b> from the official MCP registry,
    {idx.remote.toLocaleString()} reachable as hosted endpoints and {idx.local.toLocaleString()}
    distributed as packages you run yourself. Every entry is what its publisher declared to the
    registry, refreshed daily.</p>
  {idx.generated && <p class="meta-line">Last verified: {idx.generated} · Source: registry.modelcontextprotocol.io</p>}

  <p><b>What this list is not.</b> We have not installed these servers and we do not rate them.
    Nothing here says a server is safe, maintained, or does what it claims. Treat it as a
    catalog of what exists, then check the repository before you connect anything to your data.</p>

  <h2 id="srv-index">All servers</h2>
  {groups.length > 0 && (
    <>
      <nav class="az" aria-label="Servers by first letter">
        {groups.map((g) => (
          <a href={`#${g.id}`}>{g.letter}<span class="az-n">{g.list.length}</span></a>
        ))}
      </nav>
      <p class="meta-line">Sorted by the name each publisher gave the server. Servers whose
        name is not a letter, mostly numbers, are under the hash.</p>
    </>
  )}

  {groups.map((g) => (
    <section>
      <h3 id={g.id}>{g.letter === '#' ? 'Other' : g.letter}
        <span class="az-count">{g.list.length} server{g.list.length === 1 ? '' : 's'}</span>
        <a class="az-back" href="#srv-index">Back to the index</a></h3>
      {g.ranges && (
        <nav class="az az-sub" aria-label={`${g.letter} by range`}>
          {g.ranges.map((r) => (
            <a href={`#${r.id}`}>{r.label}<span class="az-n">{r.list.length}</span></a>
          ))}
        </nav>
      )}
      {(g.ranges || [{ id: null, label: null, list: g.list }]).map((r) => (
        <>
          {r.id && <h4 id={r.id} class="az-range">{r.label}
            <span class="az-count">{r.list.length} servers</span>
            <a class="az-back" href={`#${g.id}`}>Back to {g.letter === '#' ? 'Other' : g.letter}</a></h4>}
          <table>
            <thead><tr><th>Server</th><th>Publisher</th><th>What it does</th><th>Runs as</th></tr></thead>
            <tbody>
              {r.list.map((s) => (
                <tr>
                  <td>{s.description
                    ? <a href={`/mcp/${s.slug}/`}>{s.title || s.name}</a>
                    : (s.title || s.name)}</td>
                  <td>{s.vendor}</td>
                  <td>{s.description}</td>
                  <td>{s.transport}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      ))}
    </section>
  ))}

  {servers.length === 0 && <p>The directory publishes on the next pipeline run.</p>}

  <p class="meta-line">Machine-readable: <a href="/api/mcp.json">mcp.json</a>. Building with MCP?
    The protocol specification lives at
    <a href="https://modelcontextprotocol.io/" rel="noopener">modelcontextprotocol.io</a>.</p>
</Base>

<style>
  /* The letter index. A row of targets big enough to hit on a phone, with the
     count beside each so a reader knows A is 943 before they jump into it. */
  .az { display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0 6px; }
  .az a { display: inline-flex; align-items: baseline; gap: 5px; min-width: 2.4em;
    justify-content: center; padding: 7px 10px; border: 1px solid #dcdce6; border-radius: 6px;
    font-weight: 700; color: var(--navy); text-decoration: none; }
  .az a:hover, .az a:focus-visible { border-color: var(--orange); color: var(--orange); }
  .az-n { font-size: 11.5px; font-weight: 500; color: #7A8A9E; }
  .az a:hover .az-n, .az a:focus-visible .az-n { color: var(--orange); }
  /* scroll-margin so a letter heading does not land under the sticky topbar. */
  h3[id^="srv-"] { scroll-margin-top: 90px; display: flex; align-items: baseline;
    flex-wrap: wrap; gap: 12px; margin-top: 1.8em; }
  .az-count { font-family: 'Poppins', system-ui, sans-serif; font-size: 12.5px;
    font-weight: 500; color: #7A8A9E; }
  .az-back { font-family: 'Poppins', system-ui, sans-serif; font-size: 12.5px; font-weight: 500; }
  /* The second level. Ranges read as guide words, so the chips are wider and
     lighter than the letter row above and sit left-aligned rather than centred. */
  .az-sub { margin: 10px 0 4px; }
  .az-sub a { min-width: 0; justify-content: flex-start; font-weight: 600; font-size: 13.5px;
    background: #fafaff; }
  h4[id^="srv-"] { scroll-margin-top: 90px; display: flex; align-items: baseline;
    flex-wrap: wrap; gap: 12px; margin-top: 1.4em; font-size: 1rem; }
  .az-range { color: var(--navy); }
</style>

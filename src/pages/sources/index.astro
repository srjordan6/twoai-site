---
/**
 * The central Sources & References page at /sources/.
 *
 * Reads content/sources/index.json, which the pipeline writes from
 * twoai_sources, twoai_data_sources, twoai_vendor_feeds, and the book library.
 *
 * A bibliography answers "where did this claim come from". It does not answer
 * "what is this site made of", and the page used to stop at the first
 * question. The live data sources are now listed too, with a record count read
 * from the table each one fills, so the figure is checkable rather than
 * asserted; then every vendor feed by name, because "27 company blogs" is a
 * summary of a source list and not one; then our own published titles.
 */
import Base from '../../layouts/Base.astro';
import OnetAttribution from '../../components/OnetAttribution.astro';
import { readFileSync, existsSync } from 'node:fs';

const hub = existsSync('content/sources/index.json')
  ? JSON.parse(readFileSync('content/sources/index.json', 'utf8'))
  : { sections: [], total: 0, generated: '' };

const sections = hub.sections || [];
const total = hub.total || 0;
const dataSources = hub.data_sources || [];
const vendorFeeds = hub.vendor_feeds || [];
const books = hub.books || [];

// Group the live sources by what they are for, so the list reads as an
// inventory rather than an alphabet.
const CATS: Record<string, string> = {
  legislation: 'Legislation and rulemaking',
  litigation: 'Courts and litigation',
  news: 'Press coverage',
  research: 'Research',
  tools: 'Tools and infrastructure',
  jobs: 'Job listings',
  market: 'Labour market data',
  books: 'Our own publications',
};
const byCat = Object.entries(CATS)
  .map(([key, label]) => ({ key, label, items: dataSources.filter((d: any) => d.category === key) }))
  .filter((c) => c.items.length > 0);
const liveTotal = dataSources.reduce((n: number, d: any) => n + (d.records || 0), 0);
const usesOnet = dataSources.some((d: any) => d.key === 'onet');

const desc =
  `Every source behind The World of AI: ${total} cited primary instruments and papers, ` +
  `${dataSources.length} live data feeds and APIs, ${vendorFeeds.length} company feeds, ` +
  `and our own published titles. Links go to the issuing authority.`;
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Sources & References',
  description: desc,
  url: 'https://theworldofai.org/sources/',
  dateModified: hub.generated,
  isPartOf: { '@type': 'CollectionPage', name: 'The World of AI', url: 'https://theworldofai.org/' },
});
---
<Base title={`Sources & References — ${total} cited sources and ${dataSources.length} live feeds — The World of AI`} description={desc} current="/sources/" jsonld={jsonld}>
  <p class="meta-line">
    <a href="/ai-ecosystem/research-knowledge-and-learning/">Research, Knowledge and Learning</a>
  </p>

  <h1>Sources &amp; References</h1>

  <p class="answer">
    Every fact on The World of AI traces to a primary instrument — a statute, a
    regulation, an enforcement release, an official framework — or to a
    peer-reviewed paper. This page lists <b>{total.toLocaleString()} cited sources</b>
    across <b>{sections.length} sections</b>, the
    {' '}<b>{dataSources.length} live data feeds</b> the site is built from, all
    {' '}<b>{vendorFeeds.length} company feeds</b> we follow by name, and our own
    {' '}<b>{books.length} published titles</b>. Links go directly to the issuing
    authority wherever one exists.
  </p>

  {hub.generated && <p class="meta-line">Last verified: {hub.generated}</p>}

  {sections.length > 0 && (
    <>
      <h2 id="toc">On this page</h2>
      <ul class="toc">
        {sections.map((s) => (
          <li>
            <a href={`#${s.key}`}>{s.label}</a>
            <span class="count"> · {s.items.length}</span>
          </li>
        ))}
      </ul>

      {sections.map((s) => (
        <section class="src-section" id={s.key}>
          <h2>{s.label}</h2>
          <ul class="src-list">
            {s.items.map((it) => (
              <li>
                {it.url ? <a href={it.url} rel="noopener">{it.title}</a> : <b>{it.title}</b>}
                {(it.authors || it.year || it.journal) && (
                  <span class="meta">
                    {it.authors && <> · {it.authors}</>}
                    {it.journal && <> · <i>{it.journal}</i></>}
                    {it.year > 0 && <> · {it.year}</>}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </>
  )}

  {sections.length === 0 && (
    <p>The sources index is being generated by the next pipeline run.</p>
  )}

  {byCat.length > 0 && (
    <section class="src-section" id="live-data">
      <h2>Live data sources</h2>
      <p>
        The feeds and APIs this site is built from, with the number of records
        each one currently accounts for, read from the database at build time
        rather than written down. {liveTotal.toLocaleString()} records in total.
      </p>
      {byCat.map((c) => (
        <div class="cat">
          <h3>{c.label}</h3>
          <table class="srcs">
            <thead><tr><th>Source</th><th>What we use it for</th><th>Terms</th><th class="num">Records</th></tr></thead>
            <tbody>
              {c.items.map((d: any) => (
                <tr>
                  <td><a href={d.url} rel="noopener">{d.name}</a>{d.publisher && d.publisher !== d.name && <span class="pub"><br />{d.publisher}</span>}</td>
                  <td>{d.what_we_use}</td>
                  <td class="terms">{d.terms}</td>
                  <td class="num">{d.records ? d.records.toLocaleString() : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </section>
  )}

  {vendorFeeds.length > 0 && (
    <section class="src-section" id="company-feeds">
      <h2>Company feeds</h2>
      <p>
        The {vendorFeeds.length} organisations whose own announcement feeds we
        follow for <a href="/ai-news/vendor/">AI Vendor News</a>. Every one is
        the company publishing about itself, never press aggregation.
      </p>
      <ul class="src-list feeds">
        {vendorFeeds.map((v: any) => (
          <li>
            {v.entity_uid
              ? <a href={`/companies/${v.entity_uid}/`}>{v.vendor}</a>
              : <b>{v.vendor}</b>}
            {' — '}<a href={v.url} rel="noopener" class="feedurl">{v.url.replace(/^https?:\/\//, '')}</a>
            {!v.healthy && <span class="meta"> (not yet fetched)</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {books.length > 0 && (
    <section class="src-section" id="books">
      <h2>Books by SRJ Consulting &amp; Services</h2>
      <p>
        Our own titles on AI audit, governance, and security.
        {' '}{books.filter((b: any) => b.status === 'available').length} available,
        {' '}{books.filter((b: any) => b.status !== 'available').length} forthcoming.
        These are listed here as publications, not as evidence: nothing on this
        site cites them as a source for a factual claim.
      </p>
      <ol class="src-list bookl">
        {books.map((b: any) => (
          <li>
            {b.amazon_url
              ? <a href={b.amazon_url} rel="noopener">{b.title}</a>
              : <b>{b.title}</b>}
            <span class="meta">
              <br />{b.pillar}
              {b.published ? ` · published ${b.published}` : ' · forthcoming'}
              {b.pages ? ` · ${b.pages} pages` : ''}
            </span>
          </li>
        ))}
      </ol>
    </section>
  )}

  <div class="cite-box">
    Cite this page: <code>"Sources &amp; References." The World of AI, theworldofai.org/sources/.{hub.generated ? ` Verified ${hub.generated}.` : ''}</code>
  </div>

  {usesOnet && <OnetAttribution />}

  <p class="api-line">
    Machine readable: <a href="/api/sources.json">/api/sources.json</a>
  </p>
</Base>

<style>
  .answer { font-size: 1.05rem; line-height: 1.55; }
  .toc { list-style: none; padding: 0; margin: 1em 0 2em; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: .5em 1.5em; }
  .toc a { font-weight: 600; }
  .toc .count { color: #6b6b78; font-size: .9rem; }
  .src-section { margin-top: 2.4em; padding-top: 1.2em; border-top: 2px solid #201868; }
  .src-section h2 { margin: 0 0 .8em; color: #201868; }
  .src-list { list-style: none; padding: 0; }
  .src-list li { margin: 0 0 .8em; line-height: 1.45; }
  .src-list a { font-weight: 500; }
  .src-list .meta { color: #6b6b78; font-size: .9rem; }
  .cite-box { margin-top: 2em; padding: .9em 1em; background: #f7f7fb; border-left: 3px solid #201868; font-size: .9rem; }
  .cite-box code { display: block; margin-top: .35em; }
  .api-line { margin-top: .8em; font-size: .87rem; color: #6b6b78; }
  .cat { margin: 1.4em 0; }
  .cat h3 { color: #201868; font-size: 1.05rem; margin: 0 0 .5em; }
  .srcs { width: 100%; border-collapse: collapse; font-size: .92rem; }
  .srcs th { text-align: left; border-bottom: 2px solid #201868; padding: .4em .6em .4em 0; color: #201868; }
  .srcs td { border-bottom: 1px solid #e8e6e0; padding: .55em .6em .55em 0; vertical-align: top; }
  .srcs .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .srcs .terms { color: #6b6b78; }
  .srcs .pub { color: #6b6b78; font-size: .86rem; }
  .feeds li { margin-bottom: .5em; }
  .feedurl { color: #6b6b78; font-size: .88rem; word-break: break-all; }
  .bookl { padding-left: 1.2em; }
  .bookl li { margin-bottom: .8em; }
</style>

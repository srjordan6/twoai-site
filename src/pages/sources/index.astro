---
/**
 * The central Sources & References page at /sources/.
 *
 * Reads content/sources/index.json, which the pipeline writes from twoai_sources.
 * Every fact on the site traces to a primary instrument or a peer-reviewed
 * paper; this page is the bibliography where every one of them is listed and
 * linked, in the same six sections used across the SRJ AI Governance Reference
 * Library. If a source is cited anywhere on this site, it is discoverable here.
 */
import Base from '../../layouts/Base.astro';
import { readFileSync, existsSync } from 'node:fs';

const hub = existsSync('content/sources/index.json')
  ? JSON.parse(readFileSync('content/sources/index.json', 'utf8'))
  : { sections: [], total: 0, generated: '' };

const sections = hub.sections || [];
const total = hub.total || 0;
const desc = `The complete bibliography of every primary source and peer-reviewed paper cited on The World of AI. ${total} sources across six sections: EU and Council of Europe, US federal, US state and city, other jurisdictions, standards bodies, and peer-reviewed research.`;
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Sources & References',
  description: desc,
  url: 'https://theworldofai.org/sources/',
  dateModified: hub.generated,
  isPartOf: { '@type': 'CollectionPage', name: 'The World of AI', url: 'https://theworldofai.org/' },
});
---
<Base title={`Sources & References — ${total} sources across ${sections.length} sections — The World of AI`} description={desc} current="/sources/" jsonld={jsonld}>
  <p class="meta-line">
    <a href="/ai-ecosystem/research-knowledge-and-learning/">Research, Knowledge and Learning</a>
  </p>

  <h1>Sources &amp; References</h1>

  <p class="answer">
    Every fact on The World of AI traces to a primary instrument — a statute, a
    regulation, an enforcement release, an official framework — or to a
    peer-reviewed paper. This page lists <b>{total.toLocaleString()} sources</b>
    across <b>{sections.length} sections</b>. Links go directly to the issuing
    authority wherever one exists.
  </p>

  {hub.generated && <p class="meta-line">Last verified: {hub.generated}</p>}

  {sections.length > 0 && (
    <>
      <h2 id="toc">On this page</h2>
      <ul class="toc">
        {sections.map((s) => (
          <li>
            <a href={`#${s.key}`}>{s.label}</a>
            <span class="count"> · {s.items.length}</span>
          </li>
        ))}
      </ul>

      {sections.map((s) => (
        <section class="src-section" id={s.key}>
          <h2>{s.label}</h2>
          <ul class="src-list">
            {s.items.map((it) => (
              <li>
                {it.url ? <a href={it.url} rel="noopener">{it.title}</a> : <b>{it.title}</b>}
                {(it.authors || it.year || it.journal) && (
                  <span class="meta">
                    {it.authors && <> · {it.authors}</>}
                    {it.journal && <> · <i>{it.journal}</i></>}
                    {it.year > 0 && <> · {it.year}</>}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </>
  )}

  {sections.length === 0 && (
    <p>The sources index is being generated by the next pipeline run.</p>
  )}

  <div class="cite-box">
    Cite this page: <code>"Sources &amp; References." The World of AI, theworldofai.org/sources/.{hub.generated ? ` Verified ${hub.generated}.` : ''}</code>
  </div>

  <p class="api-line">
    Machine readable: <a href="/api/sources.json">/api/sources.json</a>
  </p>
</Base>

<style>
  .answer { font-size: 1.05rem; line-height: 1.55; }
  .toc { list-style: none; padding: 0; margin: 1em 0 2em; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: .5em 1.5em; }
  .toc a { font-weight: 600; }
  .toc .count { color: #6b6b78; font-size: .9rem; }
  .src-section { margin-top: 2.4em; padding-top: 1.2em; border-top: 2px solid #201868; }
  .src-section h2 { margin: 0 0 .8em; color: #201868; }
  .src-list { list-style: none; padding: 0; }
  .src-list li { margin: 0 0 .8em; line-height: 1.45; }
  .src-list a { font-weight: 500; }
  .src-list .meta { color: #6b6b78; font-size: .9rem; }
  .cite-box { margin-top: 2em; padding: .9em 1em; background: #f7f7fb; border-left: 3px solid #201868; font-size: .9rem; }
  .cite-box code { display: block; margin-top: .35em; }
  .api-line { margin-top: .8em; font-size: .87rem; color: #6b6b78; }
</style>

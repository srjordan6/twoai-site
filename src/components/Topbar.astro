---
/**
 * Navy topbar: language selector, site search, and the consultation CTA.
 *
 * Ported from srj-site/src/components/Header.astro, where this tier is the
 * production WordPress announce bar rebuilt from Stephen's screenshot. Three
 * things carry over exactly, because they were arrived at by iteration and
 * re-deriving them would only reintroduce the bugs they fixed:
 *
 *  - The language selector is a type-ahead input driving a HIDDEN Google
 *    Translate combo. The stock widget is unreadable on a navy bar; this shows
 *    a plain "English" field, opens the full list on click, filters as you
 *    type, and clears the googtrans cookie when you pick English again, which
 *    is the only reliable way back to the original text.
 *  - Pagefind loads LAZILY on first open. The index is generated by the
 *    postbuild step already in package.json, and a reader who never searches
 *    pays nothing for it.
 *  - The topbar is position:sticky. Google Translate injects a banner frame
 *    and shifts the body; pinning the bar means translation can never push the
 *    language control out of reach, which is exactly how it breaks otherwise.
 *
 * TWO DEPARTURES FROM SRJ, both deliberate.
 *
 *  1. The CTA points at srjconsultingservices.com rather than a local path.
 *     This site has no consultation page and should not pretend to; the funnel
 *     is the whole point of the link, and sending a reader to a 404 on the way
 *     to it would be worse than no link.
 *  2. The search hint names what this site actually indexes, laws, glossary,
 *     lawsuits, tools, weekly digests, rather than SRJ's sections.
 */
---
<div class="topbar">
  <div class="wrap topbar-inner">
    <div class="topbar-left">
      <span class="topbar-translate notranslate" translate="no"><input id="twoai-lang-input" value="English" autocomplete="off" role="combobox" aria-expanded="false" aria-label="Translate this page. All languages shown on click; type to filter" /><span class="lang-caret" aria-hidden="true">&#9662;</span><ul id="twoai-lang-panel" class="lang-panel" hidden></ul><span id="google_translate_element" class="gt-hidden"></span></span>
    </div>
    <div class="topbar-actions">
      <button type="button" class="search-toggle" aria-expanded="false" aria-controls="twoai-search-panel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" width="15" height="15">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.3" y2="16.3"></line>
        </svg>
        <span>Search</span>
      </button>
      <a class="topbar-cta" href="https://srjconsultingservices.com/schedule-consultation/" rel="noopener">
        Schedule a Free AI Consultation <span class="arrow">&rarr;</span>
      </a>
    </div>
  </div>
</div>

<div id="twoai-search-panel" class="search-panel" hidden>
  <div class="wrap">
    <div id="twoai-search-box"></div>
    <p class="search-hint">Searches the full text of every published page, all built from the same
      database: state AI laws, the lawsuit tracker, the glossary, the tools directory, AI companies,
      the research library, the MCP server registry, compliance frameworks, sources, people, the
      calculators, and the weekly digests.</p>
  </div>
</div>

<script is:inline>
// Lazy Pagefind. Assets live under /pagefind/ in the build output, generated
// by the postbuild step; nothing is fetched until the first open.
(function () {
  var toggle = document.querySelector('.search-toggle');
  var panel = document.getElementById('twoai-search-panel');
  if (!toggle || !panel) return;
  var loaded = false;

  function loadPagefind() {
    if (loaded) return Promise.resolve();
    loaded = true;
    return new Promise(function (resolve) {
      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(css);
      var s = document.createElement('script');
      s.src = '/pagefind/pagefind-ui.js';
      s.onload = function () {
        /* global PagefindUI */
        new PagefindUI({
          element: '#twoai-search-box',
          showSubResults: true,
          showImages: false,
          translations: { placeholder: 'Search theworldofai.org' },
        });
        resolve();
      };
      s.onerror = function () {
        panel.querySelector('#twoai-search-box').textContent =
          'Search could not load. Please try again, or browse from the navigation above.';
        resolve();
      };
      document.head.appendChild(s);
    });
  }

  function openPanel() {
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    loadPagefind().then(function () {
      var input = panel.querySelector('input');
      if (input) input.focus();
    });
  }
  function closePanel() {
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
  }

  toggle.addEventListener('click', function () {
    panel.hidden ? openPanel() : closePanel();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !panel.hidden) { closePanel(); toggle.focus(); }
  });
})();
</script>

<script is:inline>
  function googleTranslateElementInit(){new google.translate.TranslateElement({pageLanguage:'en'},'google_translate_element')}
</script>
<script is:inline defer src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
<script is:inline>
  (function(){var langs={"English":"en","Afrikaans":"af","Albanian":"sq","Arabic":"ar","Bengali":"bn","Bulgarian":"bg","Chinese (Simplified)":"zh-CN","Chinese (Traditional)":"zh-TW","Croatian":"hr","Czech":"cs","Danish":"da","Dutch":"nl","Estonian":"et","Filipino":"tl","Finnish":"fi","French":"fr","German":"de","Greek":"el","Gujarati":"gu","Hebrew":"iw","Hindi":"hi","Hungarian":"hu","Indonesian":"id","Italian":"it","Japanese":"ja","Kannada":"kn","Korean":"ko","Latvian":"lv","Lithuanian":"lt","Malay":"ms","Marathi":"mr","Norwegian":"no","Persian":"fa","Polish":"pl","Portuguese":"pt","Punjabi":"pa","Romanian":"ro","Russian":"ru","Serbian":"sr","Slovak":"sk","Slovenian":"sl","Spanish":"es","Swahili":"sw","Swedish":"sv","Tamil":"ta","Telugu":"te","Thai":"th","Turkish":"tr","Ukrainian":"uk","Urdu":"ur","Vietnamese":"vi"};var inp=document.getElementById("twoai-lang-input");var panel=document.getElementById("twoai-lang-panel");if(!inp||!panel)return;var names=Object.keys(langs);function combo(){return document.querySelector("select.goog-te-combo");}function choose(n){inp.value=n;panel.hidden=true;inp.setAttribute("aria-expanded","false");var c=langs[n];if(!c)return;if(c==="en"){document.cookie="googtrans=;path=/;max-age=0";document.cookie="googtrans=;path=/;domain=."+location.hostname+";max-age=0";location.reload();return;}var tries=0;(function go(){var s=combo();if(s){s.value=c;s.dispatchEvent(new Event("change"));}else if(tries++<10){setTimeout(go,400);}})();}function render(f){panel.innerHTML="";var q=(f||"").toLowerCase();var list=["English"].concat(names.filter(function(n){return n!=="English"&&(!q||n.toLowerCase().indexOf(q)>-1);}));list.forEach(function(n){var li=document.createElement("li");li.textContent=n;if(n==="English"){li.className="en";}li.addEventListener("mousedown",function(e){e.preventDefault();choose(n);});panel.appendChild(li);});}function show(f){render(f);panel.hidden=false;inp.setAttribute("aria-expanded","true");}inp.addEventListener("focus",function(){inp.select();show("");});inp.addEventListener("click",function(){show("");});inp.addEventListener("input",function(){show(inp.value);});inp.addEventListener("blur",function(){setTimeout(function(){panel.hidden=true;inp.setAttribute("aria-expanded","false");},160);});inp.addEventListener("keydown",function(e){if(e.key==="Enter"){e.preventDefault();var q=inp.value.toLowerCase();var m=names.filter(function(n){return n.toLowerCase().indexOf(q)>-1;})[0];if(m){choose(m);}}else if(e.key==="Escape"){panel.hidden=true;}});})();
</script>

<style>
  .topbar {
    position: sticky; top: 0; z-index: 1100;
    background: var(--navy-deep);
    color: #fafaf6;
    padding: 11px 0;
    font-size: 13px;
    letter-spacing: .01em;
  }
  .topbar-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 30px; flex-wrap: wrap;
  }
  .topbar-left { display: flex; align-items: center; gap: 24px; }
  .topbar-actions { display: flex; align-items: center; gap: 22px; }

  .search-toggle {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 10px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 4px;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    transition: background .15s ease, border-color .15s ease;
  }
  .search-toggle svg { display: block; width: 14px; height: 14px; }
  .search-toggle:hover, .search-toggle:focus-visible {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.45);
    outline: none;
  }
  .search-toggle[aria-expanded="true"] { background: var(--orange); border-color: var(--orange); }

  .topbar-cta {
    font-family: 'Poppins', sans-serif;
    font-size: 11.5px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--orange);
    font-weight: 600;
    display: inline-flex; align-items: center; gap: 8px;
    text-decoration: none;
    transition: opacity .2s ease;
    white-space: nowrap;
  }
  .topbar-cta:hover { opacity: .75; text-decoration: none; }
  .topbar-cta .arrow { font-size: 14px; letter-spacing: 0; }

  .search-panel {
    background: var(--navy-deep);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 22px 0 26px;
  }
  .search-hint { margin: 10px 0 0; font-size: 12.5px; color: rgba(255, 255, 255, 0.6); }
  .search-panel :global(.pagefind-ui) {
    --pagefind-ui-primary: #F07800;
    --pagefind-ui-text: #ffffff;
    --pagefind-ui-background: #1A1357;
    --pagefind-ui-border: rgba(255, 255, 255, 0.25);
    --pagefind-ui-tag: #201868;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: 'Poppins', sans-serif;
  }
  .search-panel :global(.pagefind-ui__result-link) { color: #F07800; }
  .search-panel :global(.pagefind-ui__result-excerpt) { color: rgba(255, 255, 255, 0.8); }

  @media (max-width: 1080px) {
    .topbar-left { gap: 12px; }
  }
  @media (max-width: 640px) {
    /* On phones the bar yields the CTA so the selector and search keep their
       full width. The consultation link stays reachable from the footer. */
    .topbar-cta { display: none; }
  }
</style>

<style is:global>
  .topbar-translate { display: inline-flex; align-items: center; position: relative; }
  .topbar-translate input {
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.35);
    border-radius: 5px; color: #fff; font-weight: 700; font-size: 12.5px;
    line-height: 1.5; font-family: inherit; padding: 2px 9px; width: 150px;
  }
  .lang-caret { color: rgba(255,255,255,.75); margin-left: -20px; pointer-events: none;
    font-size: 11px; position: relative; z-index: 2; }
  .lang-panel {
    position: absolute; top: calc(100% + 5px); left: 0; z-index: 1200;
    background: #1A1357; border: 1px solid rgba(255,255,255,.25); border-radius: 6px;
    max-height: 320px; overflow: auto; width: 215px; margin: 0; padding: 4px 0;
    list-style: none; box-shadow: 0 8px 24px rgba(0,0,0,.35);
  }
  .lang-panel li { padding: 5px 13px; color: #fff; font-size: 12.5px; cursor: pointer; }
  .lang-panel li:hover { background: #F07800; }
  .lang-panel li.en { font-weight: 700; }
  .gt-hidden { position: absolute !important; left: -9999px; top: 0; visibility: hidden; }
  /* Google Translate shifts the body and injects a banner; undo both, or the
     sticky bars land in the wrong place on every translated page. */
  body { top: 0 !important; position: static !important; }
  .goog-te-banner-frame, #goog-gt-tt, iframe.skiptranslate { display: none !important; }
  @media (max-width: 1080px) {
    .topbar-translate input { width: 116px; font-size: 12px; }
  }
  /* The translate control read 91x14: wide enough to hit, too short. Its
     visible size is unchanged; only the box grows. */
  .topbar-translate input { min-height: 26px; }
</style>

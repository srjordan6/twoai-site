---
/**
 * Navy topbar: language selector, site search, and the consultation CTA.
 *
 * Ported from srj-site/src/components/Header.astro, where this tier is the
 * production WordPress announce bar rebuilt from Stephen's screenshot. Three
 * things carry over exactly, because they were arrived at by iteration and
 * re-deriving them would only reintroduce the bugs they fixed:
 *
 *  - The language selector is a type-ahead input. It shows a plain "English"
 *    field, opens the full list on click and filters as you type. Until
 *    2026-09-19 it drove a HIDDEN Google Website Translator combo. That night
 *    Google's widget stopped translating everywhere, this site, W3Schools'
 *    own demo and example.com through translate.goog alike, because its
 *    browser script (release TE_20260916) throws before it requests a word,
 *    and Google has said the widget is unsupported from 2026-10-01. The field
 *    now posts the page's text to /api/translate on this site's Worker, which
 *    calls Microsoft Translator and caches every string. See src/translate.ts.
 *  - Pagefind loads LAZILY on first open. The index is generated by the
 *    postbuild step already in package.json, and a reader who never searches
 *    pays nothing for it.
 *  - The topbar is position:sticky, so the language control is always in
 *    reach, including on a page that has just been translated.
 *
 * TWO DEPARTURES FROM SRJ, both deliberate.
 *
 *  1. The CTA points at srjconsultingservices.com rather than a local path.
 *     This site has no consultation page and should not pretend to; the funnel
 *     is the whole point of the link, and sending a reader to a 404 on the way
 *     to it would be worse than no link.
 *  2. The search hint names what this site actually indexes, laws, glossary,
 *     lawsuits, tools, weekly digests, rather than SRJ's sections.
 */
---
<div class="topbar">
  <div class="wrap topbar-inner">
    <div class="topbar-left">
      <span class="topbar-translate notranslate" translate="no"><input id="twoai-lang-input" value="English" autocomplete="off" role="combobox" aria-expanded="false" aria-label="Translate this page. All languages shown on click; type to filter" /><span class="lang-caret" aria-hidden="true">&#9662;</span><ul id="twoai-lang-panel" class="lang-panel" hidden></ul></span>
    </div>
    <a class="topbar-talent" href="/talent/login/">AI Talent Network Login</a>
    <div class="topbar-actions">
      <button type="button" class="search-toggle" aria-expanded="false" aria-controls="twoai-search-panel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" width="15" height="15">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.3" y2="16.3"></line>
        </svg>
        <span>Search</span>
      </button>
      <a class="topbar-cta" href="https://srjconsultingservices.com/schedule-consultation/" rel="noopener">
        Schedule a Free AI Consultation <span class="arrow">&rarr;</span>
      </a>
    </div>
  </div>
</div>

<div id="twoai-search-panel" class="search-panel" hidden>
  <div class="wrap">
    <div id="twoai-search-box"></div>
    <p class="search-hint">Searches the full text of every published page, all built from the same
      database: state AI laws, the lawsuit tracker, the glossary, the tools directory, AI companies,
      the research library, the MCP server registry, compliance frameworks, sources, people, the
      calculators, and the weekly digests.</p>
  </div>
</div>

<script is:inline>
// Lazy Pagefind. Assets live under /pagefind/ in the build output, generated
// by the postbuild step; nothing is fetched until the first open.
(function () {
  var toggle = document.querySelector('.search-toggle');
  var panel = document.getElementById('twoai-search-panel');
  if (!toggle || !panel) return;
  var loaded = false;

  function loadPagefind() {
    if (loaded) return Promise.resolve();
    loaded = true;
    return new Promise(function (resolve) {
      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(css);
      var s = document.createElement('script');
      s.src = '/pagefind/pagefind-ui.js';
      s.onload = function () {
        /* global PagefindUI */
        new PagefindUI({
          element: '#twoai-search-box',
          showSubResults: true,
          showImages: false,
          translations: { placeholder: 'Search theworldofai.org' },
        });
        resolve();
      };
      s.onerror = function () {
        panel.querySelector('#twoai-search-box').textContent =
          'Search could not load. Please try again, or browse from the navigation above.';
        resolve();
      };
      document.head.appendChild(s);
    });
  }

  function openPanel() {
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    loadPagefind().then(function () {
      var input = panel.querySelector('input');
      if (input) input.focus();
    });
  }
  function closePanel() {
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
  }

  toggle.addEventListener('click', function () {
    panel.hidden ? openPanel() : closePanel();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !panel.hidden) { closePanel(); toggle.focus(); }
  });
})();
</script>

<script is:inline>
  (function () {
    // Microsoft Translator codes. src/translate.ts holds the same set and
    // refuses anything else, so a language added here must be added there.
    var langs = {"English":"en","Afrikaans":"af","Albanian":"sq","Arabic":"ar","Bengali":"bn","Bulgarian":"bg","Chinese (Simplified)":"zh-Hans","Chinese (Traditional)":"zh-Hant","Croatian":"hr","Czech":"cs","Danish":"da","Dutch":"nl","Estonian":"et","Filipino":"fil","Finnish":"fi","French":"fr","German":"de","Greek":"el","Gujarati":"gu","Hebrew":"he","Hindi":"hi","Hungarian":"hu","Indonesian":"id","Italian":"it","Japanese":"ja","Kannada":"kn","Korean":"ko","Latvian":"lv","Lithuanian":"lt","Malay":"ms","Marathi":"mr","Norwegian":"nb","Persian":"fa","Polish":"pl","Portuguese":"pt","Punjabi":"pa","Romanian":"ro","Russian":"ru","Serbian":"sr-Cyrl","Slovak":"sk","Slovenian":"sl","Spanish":"es","Swahili":"sw","Swedish":"sv","Tamil":"ta","Telugu":"te","Thai":"th","Turkish":"tr","Ukrainian":"uk","Urdu":"ur","Vietnamese":"vi"};
    var RTL = { ar: 1, he: 1, fa: 1, ur: 1 };
    var STORE = "twoai-lang";
    // One page view may send at most this much to the server. /mcp/ alone is a
    // quarter of a million characters; without a ceiling one reader on one
    // page could spend an eighth of the month. Navigation and footer go first
    // because they are cached site wide and cost nothing after the first time.
    var PAGE_CHARS = 60000, BATCH_STRINGS = 150, BATCH_CHARS = 18000, UNIT_MAX = 8000;
    var INLINE = { A:1, B:1, STRONG:1, EM:1, I:1, U:1, SPAN:1, CODE:1, ABBR:1, SUP:1, SUB:1, SMALL:1, MARK:1, CITE:1, Q:1, TIME:1, BR:1, WBR:1, KBD:1, SAMP:1, VAR:1, S:1, DEL:1, INS:1, FONT:1 };
    var SKIP = { SCRIPT:1, STYLE:1, NOSCRIPT:1, PRE:1, TEXTAREA:1, INPUT:1, SELECT:1, OPTION:1, SVG:1, MATH:1, IFRAME:1, CANVAS:1, TEMPLATE:1 };

    var inp = document.getElementById("twoai-lang-input");
    var panel = document.getElementById("twoai-lang-panel");
    if (!inp || !panel) return;
    var names = Object.keys(langs);
    var originals = [];   // { el, html } for every element this run rewrote
    var banner = null, run = 0;

    function nameOf(code) { for (var n in langs) if (langs[n] === code) return n; return "English"; }
    function stored() { try { return localStorage.getItem(STORE) || "en"; } catch (e) { return "en"; } }
    function store(c) { try { if (c === "en") localStorage.removeItem(STORE); else localStorage.setItem(STORE, c); } catch (e) {} }

    function skipped(el) {
      if (SKIP[el.nodeName.toUpperCase()]) return true;
      if (el.getAttribute("translate") === "no") return true;
      return !!(el.classList && el.classList.contains("notranslate"));
    }
    function hasLetters(s) { return /[A-Za-z]{2}/.test(s || ""); }
    function directText(el) {
      for (var c = el.firstChild; c; c = c.nextSibling) if (c.nodeType === 3 && hasLetters(c.nodeValue)) return true;
      return false;
    }
    function allInline(el) {
      var all = el.getElementsByTagName("*");
      for (var i = 0; i < all.length; i++) if (!INLINE[all[i].nodeName.toUpperCase()]) return false;
      return true;
    }

    // A UNIT IS A WHOLE SENTENCE, MARKUP INCLUDED. Translating text nodes one by
    // one hands the translator "This library covers", then "76 frameworks",
    // then "that govern how", and gets back three fragments in the wrong order
    // for most languages. So the unit is the smallest block whose children are
    // all inline, sent as HTML, and Microsoft moves the <b> and <a> to where
    // they belong in the target sentence. Text sitting loose beside block
    // children, which is rare, is wrapped in a span so it can be a unit too.
    function collect(root, out) {
      if (!root || skipped(root)) return;
      if (directText(root) && allInline(root)) { out.push(root); return; }
      var kids = [], c;
      for (c = root.firstChild; c; c = c.nextSibling) kids.push(c);
      for (var i = 0; i < kids.length; i++) {
        c = kids[i];
        if (c.nodeType === 1) collect(c, out);
        else if (c.nodeType === 3 && hasLetters(c.nodeValue)) {
          var s = document.createElement("span");
          root.replaceChild(s, c); s.appendChild(c); out.push(s);
        }
      }
    }

    // What is sent is a copy with code marked untranslatable, so a command or
    // an identifier inside a sentence comes back as it went.
    function payload(el) {
      var copy = el.cloneNode(true), marks = copy.querySelectorAll("code,kbd,samp,var"), i;
      for (i = 0; i < marks.length; i++) marks[i].setAttribute("translate", "no");
      return copy.innerHTML;
    }

    function ensureBanner() {
      if (banner) return banner;
      banner = document.createElement("div");
      banner.className = "tr-note";
      banner.innerHTML = '<p class="tr-note-t">This page is machine translated by Microsoft Translator. The English page is the record for every law, date and figure.</p>' +
        '<p class="tr-note-e" translate="no"><span class="tr-note-s"></span> <button type="button" class="tr-note-b">Show original English</button></p>';
      banner.querySelector(".tr-note-b").addEventListener("click", function () { choose("English"); });
      var main = document.querySelector("main") || document.body;
      main.insertBefore(banner, main.firstChild);
      return banner;
    }
    function status(text) { if (banner) banner.querySelector(".tr-note-s").textContent = text; }

    function restore() {
      run++;
      for (var i = 0; i < originals.length; i++) {
        originals[i].el.innerHTML = originals[i].html;
        if (originals[i].dir === null) originals[i].el.removeAttribute("dir"); else originals[i].el.setAttribute("dir", originals[i].dir);
      }
      originals = [];
      if (banner && banner.parentNode) banner.parentNode.removeChild(banner);
      banner = null;
      document.documentElement.lang = "en";
      document.documentElement.removeAttribute("dir");
    }

    function post(to, texts) {
      return fetch("/api/translate", { method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ to: to, texts: texts }) }).then(function (r) {
          if (!r.ok) throw new Error("translate " + r.status);
          return r.json();
        });
    }

    function translate(to) {
      restore();
      var mine = ++run;
      ensureBanner();
      status("Translating…");
      var units = [], main = document.querySelector("main"), i, c;
      // Everything outside <main> first, then <main>. See PAGE_CHARS above.
      for (c = document.body.firstChild; c; c = c.nextSibling) if (c.nodeType === 1 && c !== main) collect(c, units);
      if (main) collect(main, units);

      var batches = [], cur = [], curChars = 0, total = 0, truncated = false;
      for (i = 0; i < units.length; i++) {
        var html = payload(units[i]);
        if (html.length > UNIT_MAX) continue;
        if (total + html.length > PAGE_CHARS) { truncated = true; break; }
        if (cur.length >= BATCH_STRINGS || curChars + html.length > BATCH_CHARS) { batches.push(cur); cur = []; curChars = 0; }
        cur.push({ el: units[i], html: html }); curChars += html.length; total += html.length;
      }
      if (cur.length) batches.push(cur);

      var partial = "", later = [], wait = 20;
      // RIGHT TO LEFT IS SET ON THE SENTENCE, NEVER ON THE PAGE. Stephen,
      // 2026-09-19, with a screenshot: the whole screen is crazy. He had picked
      // Persian. The first version set dir=rtl on <html> when it finished, which
      // mirrors the entire layout: the section menu jumped to the left, the logo
      // slid on top of the navigation, and because Microsoft had throttled most
      // of the page the text was still English, now right aligned with its full
      // stops at the front. This site's layout is not built to mirror and does
      // not need to be. A block that really was translated into Arabic, Hebrew,
      // Persian or Urdu gets dir=rtl itself, so its text reads correctly, and
      // everything else, the grid, the menus, any block still in English, stays
      // exactly where it was.
      function finish() {
        document.documentElement.lang = to;
        status(partial || (truncated ? "This is a long page, so only the first part is translated." : ""));
      }
      // MICROSOFT'S FREE TIER IS METERED BY THE MINUTE, NOT ONLY BY THE MONTH.
      // Stephen, 2026-09-19: Czech does not work. It did, most of it: he had
      // just tried Spanish and Kannada on the same page, and the third page
      // inside a minute got a 429 from Microsoft for its second batch, so 22 of
      // 106 blocks stayed English under a note saying the translator did not
      // answer. That is a wait, not a failure. Blocks refused for that reason
      // are kept and sent again after the pause Microsoft asks for, up to four
      // times, and the note says the page is still being finished meanwhile.
      function next(b, attempt) {
        if (mine !== run) return;   // the reader picked something else meanwhile
        if (b >= batches.length) {
          if (later.length && attempt < 4) {
            var again = later; later = [];
            batches = []; cur = []; curChars = 0;
            for (var a = 0; a < again.length; a++) {
              if (cur.length >= BATCH_STRINGS || curChars + again[a].html.length > BATCH_CHARS) { batches.push(cur); cur = []; curChars = 0; }
              cur.push(again[a]); curChars += again[a].html.length;
            }
            if (cur.length) batches.push(cur);
            document.documentElement.lang = to;
            status("Still translating the rest of this page. The free translation service limits how fast it works.");
            setTimeout(function () { next(0, attempt + 1); }, wait * 1000);
            return;
          }
          if (later.length) partial = "Part of this page is still in English. The translation service is busy, try again in a minute.";
          finish();
          return;
        }
        var batch = batches[b];
        post(to, batch.map(function (u) { return u.html; })).then(function (res) {
          if (mine !== run) return;
          var tr = res.translations || [];
          var busy = res.partial && res.reason === "translator busy";
          if (busy && res.retry_after) wait = Math.min(60, Math.max(5, res.retry_after));
          for (var k = 0; k < batch.length; k++) {
            if (typeof tr[k] !== "string") { if (busy) later.push(batch[k]); continue; }
            originals.push({ el: batch[k].el, html: batch[k].el.innerHTML, dir: batch[k].el.getAttribute("dir") });
            batch[k].el.innerHTML = tr[k];
            if (RTL[to]) batch[k].el.setAttribute("dir", "rtl");
          }
          if (res.partial && !busy) partial = "Part of this page is still in English. " + (res.reason === "monthly allowance used" ? "This month's translation allowance is used up." : "The translator did not answer.");
          next(b + 1, attempt);
        }).catch(function () {
          if (mine !== run) return;
          // Nothing translated at all: say so, go back to English, and do not
          // keep retrying on every page the reader opens next.
          if (originals.length === 0) { store("en"); inp.value = "English"; restore(); ensureBanner(); status("Translation is not available right now."); banner.querySelector(".tr-note-t").textContent = ""; }
          else status("Part of this page is still in English. The translator stopped answering.");
        });
      }
      next(0, 0);
    }

    function choose(n) {
      inp.value = n; panel.hidden = true; inp.setAttribute("aria-expanded", "false");
      var c = langs[n];
      if (!c) return;
      store(c);
      if (c === "en") { restore(); return; }
      translate(c);
    }

    function render(f) {
      panel.innerHTML = "";
      var q = (f || "").toLowerCase();
      var list = ["English"].concat(names.filter(function (n) { return n !== "English" && (!q || n.toLowerCase().indexOf(q) > -1); }));
      list.forEach(function (n) {
        var li = document.createElement("li");
        li.textContent = n;
        if (n === "English") li.className = "en";
        li.addEventListener("mousedown", function (e) { e.preventDefault(); choose(n); });
        panel.appendChild(li);
      });
    }
    function show(f) { render(f); panel.hidden = false; inp.setAttribute("aria-expanded", "true"); }
    inp.addEventListener("focus", function () { inp.select(); show(""); });
    inp.addEventListener("click", function () { show(""); });
    inp.addEventListener("input", function () { show(inp.value); });
    inp.addEventListener("blur", function () { setTimeout(function () { panel.hidden = true; inp.setAttribute("aria-expanded", "false"); }, 160); });
    inp.addEventListener("keydown", function (e) {
      if (e.key === "Enter") {
        e.preventDefault();
        var q = inp.value.toLowerCase();
        var m = names.filter(function (n) { return n.toLowerCase().indexOf(q) > -1; })[0];
        if (m) choose(m);
      } else if (e.key === "Escape") { panel.hidden = true; }
    });

    // The choice follows the reader from page to page, as the old cookie did,
    // and the field says what is actually in force rather than "English".
    var start = stored();
    if (start !== "en" && nameOf(start) !== "English") {
      inp.value = nameOf(start);
      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", function () { translate(start); });
      else translate(start);
    }
  })();
</script>

<style>
  .topbar {
    position: sticky; top: 0; z-index: 1100;
    background: var(--navy-deep);
    color: #fafaf6;
    padding: 11px 0;
    font-size: 13px;
    letter-spacing: .01em;
  }
  .topbar-inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 30px; flex-wrap: wrap;
  }
  .topbar-left { display: flex; align-items: center; gap: 24px; }
  .topbar-talent {
    font-family: 'Poppins', sans-serif;
    font-size: 11.5px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    transition: color .2s ease;
  }
  .topbar-talent:hover { color: var(--orange); }
  .topbar-actions { display: flex; align-items: center; gap: 22px; }

  .search-toggle {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 10px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 4px;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    transition: background .15s ease, border-color .15s ease;
  }
  .search-toggle svg { display: block; width: 14px; height: 14px; }
  .search-toggle:hover, .search-toggle:focus-visible {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.45);
    outline: none;
  }
  .search-toggle[aria-expanded="true"] { background: var(--orange); border-color: var(--orange); }

  .topbar-cta {
    font-family: 'Poppins', sans-serif;
    font-size: 11.5px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--orange);
    font-weight: 600;
    display: inline-flex; align-items: center; gap: 8px;
    text-decoration: none;
    transition: opacity .2s ease;
    white-space: nowrap;
  }
  .topbar-cta:hover { opacity: .75; text-decoration: none; }
  .topbar-cta .arrow { font-size: 14px; letter-spacing: 0; }

  .search-panel {
    background: var(--navy-deep);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 22px 0 26px;
  }
  .search-hint { margin: 10px 0 0; font-size: 12.5px; color: rgba(255, 255, 255, 0.6); }
  .search-panel :global(.pagefind-ui) {
    --pagefind-ui-primary: #F07800;
    --pagefind-ui-text: #ffffff;
    --pagefind-ui-background: #1A1357;
    --pagefind-ui-border: rgba(255, 255, 255, 0.25);
    --pagefind-ui-tag: #201868;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: 'Poppins', sans-serif;
  }
  .search-panel :global(.pagefind-ui__result-link) { color: #F07800; }
  .search-panel :global(.pagefind-ui__result-excerpt) { color: rgba(255, 255, 255, 0.8); }

  @media (max-width: 1080px) {
    .topbar-left { gap: 12px; }
  }
  @media (max-width: 640px) {
    /* On phones the bar yields the CTA so the selector and search keep their
       full width. The consultation link stays reachable from the footer. */
    .topbar-cta { display: none; }
    .topbar-talent { display: none; }
  }
</style>

<style is:global>
  .topbar-translate { display: inline-flex; align-items: center; position: relative; }
  .topbar-translate input {
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.35);
    border-radius: 5px; color: #fff; font-weight: 700; font-size: 12.5px;
    line-height: 1.5; font-family: inherit; padding: 2px 9px; width: 150px;
  }
  .lang-caret { color: rgba(255,255,255,.75); margin-left: -20px; pointer-events: none;
    font-size: 11px; position: relative; z-index: 2; }
  .lang-panel {
    position: absolute; top: calc(100% + 5px); left: 0; z-index: 1200;
    background: #1A1357; border: 1px solid rgba(255,255,255,.25); border-radius: 6px;
    max-height: 320px; overflow: auto; width: 215px; margin: 0; padding: 4px 0;
    list-style: none; box-shadow: 0 8px 24px rgba(0,0,0,.35);
  }
  .lang-panel li { padding: 5px 13px; color: #fff; font-size: 12.5px; cursor: pointer; }
  .lang-panel li:hover { background: #F07800; }
  .lang-panel li.en { font-weight: 700; }
  /* The note a translated page carries. Set apart from the page's own prose
     so nobody takes a machine's sentence for this site's. is:global because
     the script creates it, so it never gets this component's scope id. */
  :global(.tr-note) { background: #FFF6EC; border: 1px solid #F0D6B0; border-radius: 8px;
    padding: 12px 16px; margin: 0 0 18px; font-size: 14px; color: #2C2C2A; }
  :global(.tr-note p) { margin: 0; }
  :global(.tr-note-e) { margin-top: 6px !important; font-size: 13px; color: #5d6470; }
  :global(.tr-note-b) { background: none; border: 0; padding: 0; font: inherit; font-weight: 600;
    color: #201868; text-decoration: underline; cursor: pointer; }
  :global(.tr-note-b:hover) { color: #F07800; }
  @media (max-width: 1080px) {
    .topbar-translate input { width: 116px; font-size: 12px; }
  }
  /* The translate control read 91x14: wide enough to hit, too short. Its
     visible size is unchanged; only the box grows. */
  .topbar-translate input { min-height: 26px; }
</style>

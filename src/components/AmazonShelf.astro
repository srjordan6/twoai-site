---
/**
 * AmazonShelf: the sitewide Amazon Associates unit. Renders on every page,
 * directly above the footer, so every URL on the site carries Associates
 * content with its disclosure beside the links (the operating agreement
 * requires the disclosure where the links are, not on a policy page alone).
 *
 * Content is not typed here: the book list is read at build time from
 * content/learn/books.json, which the pipeline renders from press_books in
 * SQL. The Associates tag is applied by the pipeline; the guard below adds
 * it only if a link arrives untagged, so the unit is correct either way.
 * If the content file is missing the component renders nothing and the
 * build never fails on it.
 */
import { readFileSync, existsSync } from 'node:fs';

const TAG = 'theworldofa0b-20';
// Cover art shipped as optimized static assets in public/covers/ (brand
// assets, like the logo kit - not pipeline content). Matched on title
// keywords so a press_books retitle degrades to a text link, never a
// broken image.
// Order matters: the first keyword that appears in a title wins, so a
// narrow keyword must sit above any broader one it would collide with.
const COVERS = [
  ['enablement', '/covers/enablement-audit.jpg', 480],
  ['readiness', '/covers/readiness-assessment.jpg', 512],
  ['lawyer', '/covers/ai-lawyer.jpg', 512],
  ['risk', '/covers/risk-governance-review.jpg', 512],
  ['efficiency', '/covers/efficiency-optimization.jpg', 512],
  ['security audit', '/covers/it-security-audit.jpg', 500],
];
function coverFor(title) {
  const t = (title || '').toLowerCase();
  for (const [kw, src, h] of COVERS) if (t.includes(kw)) return { src, h };
  return null;
}
let books = [];
try {
  if (existsSync('content/learn/books.json')) {
    const d = JSON.parse(readFileSync('content/learn/books.json', 'utf8'));
    books = (d.srj_books || [])
      .filter((b) => b.status === 'available' && b.amazon)
      .map((b) => {
        let a = b.amazon;
        if (a.includes('amazon.com/') && !a.includes('tag=')) {
          a += (a.includes('?') ? '&' : '?') + 'tag=' + TAG;
        }
        return { title: b.title, amazon: a, pillar: b.pillar, published: b.published, cover: coverFor(b.title) };
      });
  }
} catch { books = []; }

// The announcement line for the first work of fiction. It is derived from the
// data rather than written into the markup, so it appears only while such a
// book is actually on the shelf and it follows a retitle. Fiction is marked by
// the pillar in press_books, which is the same field the books listing prints.
const fiction = books.find((b) => (b.pillar || '').toLowerCase().includes('fiction'));
const pubDate = fiction?.published
  ? new Date(`${fiction.published}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
  : null;
---

{books.length > 0 && (
  <aside class="amz-shelf" aria-label="Books from the publisher, on Amazon">
    <div class="wrap">
      {/* The shelf carries the Operating Discipline for AI Library volumes and,
          since The AI Lawyer published on 2026-08-17, standalone titles that are
          not part of that series. The heading names the series without claiming
          every book on the row belongs to it. */}
      <h2>Books by Stephen R. Jordan, including &ldquo;The Operating Discipline for AI Library&trade;&rdquo; series, now available on Amazon</h2>
      {fiction && (
        <p class="amz-news">New: SRJ Consulting &amp; Services has published its first work of
          fiction on AI, <a href={fiction.amazon} rel="noopener sponsored" target="_blank">{fiction.title}</a>,
          a novel{pubDate ? `, out ${pubDate}` : ''}.</p>
      )}
      <p class="amz-disclosure">Disclosure: these are affiliate links. As an Amazon Associate,
        SRJ Consulting &amp; Services LLC, the publisher of this site, earns from qualifying
        purchases. The price you pay is unchanged, and nothing on this site is ranked, rated,
        or written differently because of it — <a href="/disclosure/">full policy</a>.</p>
      <div class="amz-covers">
        {books.map((b) => (
          <a class="amz-book" href={b.amazon} rel="noopener sponsored" target="_blank" title={b.title}>
            {b.cover && <img src={b.cover.src} alt={`${b.title} book cover`} width="320" height={b.cover.h} loading="lazy" decoding="async" />}
            <span class="amz-caption">{b.title}</span>
          </a>
        ))}
      </div>
    </div>
  </aside>
)}

<style>
  .amz-shelf {
    background: #f6f7fa;
    border-top: 1px solid #e3e6ee;
    padding: 1.4rem 0 1.6rem;
    font-family: var(--sans, 'Poppins', sans-serif);
  }
  .amz-shelf .wrap { max-width: 1100px; margin: 0 auto; padding: 0 1.2rem; }
  .amz-shelf h2 {
    font-family: var(--serif, 'Lora', serif);
    color: #201868;
    font-size: 1.05rem;
    margin: 0 0 .35rem;
  }
  .amz-news { color: #201868; font-size: .86rem; line-height: 1.5; margin: 0 0 .45rem; }
  .amz-news a { color: #201868; text-decoration: none; border-bottom: 1px solid #f07800; }
  .amz-news a:hover { color: #f07800; }
  .amz-disclosure { color: #7a8a9e; font-size: .78rem; line-height: 1.5; margin: 0 0 .7rem; }
  .amz-disclosure a { color: #7a8a9e; text-decoration: underline; }
  .amz-covers { display: flex; flex-wrap: wrap; gap: 1.1rem; margin: 0; align-items: flex-start; }
  .amz-book { display: flex; flex-direction: column; width: 132px; text-decoration: none; }
  .amz-book img { width: 132px; height: auto; display: block; border: 1px solid #e3e6ee; border-radius: 6px; }
  .amz-book:hover img { border-color: #f07800; }
  .amz-caption { margin-top: .45rem; font-size: .78rem; line-height: 1.3; color: #201868; text-align: center; border-bottom: 1px solid #f07800; padding-bottom: .2rem; }
  .amz-book:hover .amz-caption { color: #f07800; }
  @media (max-width: 640px) { .amz-book, .amz-book img { width: 100px; } }
</style>

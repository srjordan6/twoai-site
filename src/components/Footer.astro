---
/**
 * Site footer for theworldofai.org.
 *
 * Structurally modeled on srj-site/src/components/Footer.astro, which is itself
 * the accumulation of a dozen deliberate revisions to the WordPress footer.
 * What carries over: the four-column grid, header-as-destination pattern, the
 * numbered resource list with rotated-arrow sub-items, brand-coloured social
 * icons, and the bottom bar with legal links. What does not carry over:
 *
 *  - No newsletter band yet. The SRJ band posts to /api/newsletter, which is a
 *    Worker route that exists on that site. This site is static assets only and
 *    the Beehiiv publication for The World of AI is not created yet, so a form
 *    here would collect addresses that go nowhere. The band lands with F5.
 *  - No cookie preferences button yet. The SRJ one calls window.srjConsent,
 *    which ships with that site's consent manager. This site has no analytics
 *    or advertising tags in the head, so there is nothing to withdraw consent
 *    from. It gets added in the same commit as the AdSense and GA4 tags, since
 *    withdrawal must be as easy as giving consent.
 *  - Social accounts belong to SRJ Consulting, not to this publication, and are
 *    labeled that way rather than implying accounts this site does not have.
 *
 * Every link is root-relative for the same reason as the SRJ footer: absolute
 * URLs on a preview deploy send every footer click off the deploy.
 */
const year = new Date().getFullYear();
// Build date, rendered in the bottom bar of EVERY page. The per-page "Last
// verified" stamps say when the data behind a page was produced; this one says
// when the site itself was last rebuilt, and it is the universal safety net
// that makes the sentence above ("carries the date it was last verified") true
// on pages with no data stamp of their own: the home page, 404, calculators,
// /api/, and any future template that forgets. Standing directive 2026-08-10.
const rebuilt = new Date().toISOString().slice(0, 10);
const EMAIL = 'info@srjconsultingservices.com';
// The publication's own address. Mail here lands in theworldofai's project
// mailbox (via the Inkbox gateway), so page questions and corrections reach the
// atlas directly. info@ stays as the consulting practice's line.
const PUB_EMAIL = 'theworldofai@inkboxmail.com';

// Most-visited pages, from content/meta/popular-pages.json (the twoai_ga_top
// pipeline stage reading the GA4 Data API, refreshed daily over a trailing
// 7-day window; the home page and utility paths are excluded at the stage).
// Guarded: while the file does not exist yet, or GA has no qualifying
// traffic, the footer keeps the hand-picked category links below as the
// fallback, so this column never renders empty. Titles fall back to a
// humanised last path segment when the registry had none.
import { readFileSync } from 'node:fs';
let popular: { path: string; title: string }[] = [];
try {
  const pop = JSON.parse(readFileSync('content/meta/popular-pages.json', 'utf8'));
  popular = (pop.pages ?? []).slice(0, 5).map((p: any) => ({
    path: p.path,
    title:
      p.title?.replace(/ [—|-] The World of AI.*$/, '') ||
      p.path.replace(/\/$/, '').split('/').pop().replace(/-/g, ' ')
        .replace(/\b\w/g, (c: string) => c.toUpperCase()),
  }));
} catch { /* file absent until the GA stage first runs; fallback renders */ }
---

<footer class="site-foot">
  <div class="wrap">
    <div class="f-grid">

      {/* Column 1: identity */}
      <div>
        <div class="f-mark"><slot name="logo" /></div>
        <p class="f-about">
          The atlas of artificial intelligence: what the law says, who is suing whom, and what the
          words mean. Every page is rebuilt daily from primary sources and carries the date it was
          last verified. Free to read, free to cite, free to query.
        </p>
        <div class="f-social" aria-label="SRJ Consulting, the publisher, on social platforms">
          <a class="ic-li" href="https://www.linkedin.com/company/srjconsultingandservices/" target="_blank" rel="noopener noreferrer" aria-label="SRJ Consulting on LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.94 8.99v11.46H3.37V8.99h3.57zM5.16 3.5c1.22 0 2.21.99 2.21 2.21 0 1.22-.99 2.21-2.21 2.21-1.23 0-2.22-.99-2.22-2.21 0-1.22.99-2.21 2.22-2.21zM20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V8.99h3.42v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29z"/></svg>
          </a>
          <a class="ic-yt" href="https://www.youtube.com/@srjconsvcs" target="_blank" rel="noopener noreferrer" aria-label="SRJ Consulting on YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.5 5.5v13l11-6.5-11-6.5z"/></svg>
          </a>
          <a class="ic-g" href="https://maps.app.goo.gl/gPJgc2nvcHRdtvJM7" target="_blank" rel="noopener noreferrer" aria-label="SRJ Consulting on Google">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/></svg>
          </a>
        </div>
      </div>

      {/* Column 2: the reference sections, numbered like the SRJ resources list */}
      <nav aria-label="Reference">
        <h3>Reference</h3>
        <ul>
          <li class="sub"><a href="/ai-ecosystem/technology-and-core-infrastructure/">01. Technology &amp; Infrastructure</a></li>
          <li class="sub"><a href="/ai-ecosystem/ecosystem-entities-market-and-operations/">02. Market &amp; Entities</a></li>
          <li class="sub"><a href="/ai-ecosystem/research-knowledge-and-learning/">03. Research &amp; Learning</a></li>
          <li class="sub"><a href="/ai-ecosystem/enterprise-applications-governance-and-tools/">04. Enterprise &amp; Governance</a></li>
          <li class="sub"><a href="/ai-news/">05. AI News</a></li>
        </ul>
        {popular.length > 0 ? (
          <>
            <h3 class="spaced">Most visited this week</h3>
            <ul>
              {popular.map((p) => (
                <li class="sub"><a href={p.path}>{p.title}</a></li>
              ))}
            </ul>
          </>
        ) : (
          <>
            <h3 class="spaced"><a href="/ai-tools/">Popular tool categories</a></h3>
            <ul>
              <li class="sub"><a href="/ai-tools/category/chat-and-general-llms/">Chat and general LLMs</a></li>
              <li class="sub"><a href="/ai-tools/category/coding-and-developer-tools/">Coding and developer tools</a></li>
              <li class="sub"><a href="/ai-tools/category/ai-governance-and-risk-management-platforms/">AI governance platforms</a></li>
            </ul>
          </>
        )}
      </nav>

      {/* Column 3: the machine-readable side, which is the citation strategy */}
      <nav aria-label="For developers and researchers">
        <h3>Data and citation</h3>
        <ul>
          <li class="sub"><a href="/api/laws.json">AI laws API</a></li>
          <li class="sub"><a href="/api/glossary.json">Glossary API</a></li>
          <li class="sub"><a href="/api/lawsuits.json">Lawsuits API</a></li>
          <li class="sub"><a href="/api/tools.json">Tools API</a></li>
          <li class="sub"><a href="/api/weeks.json">Weekly digest API</a></li>
        </ul>
        <h3 class="spaced">This publication</h3>
        <ul>
          <li><a href="/about/">About and method</a></li>
          <li><a href="/contact/">Contact and corrections</a></li>
          <li><a href="/disclosure/">How this is funded</a></li>
        </ul>
      </nav>

      {/* Column 4: publisher, sources, and the one commercial link */}
      <div>
        <h3>Published by</h3>
        <div class="f-contact">
          <strong>Publisher</strong>
          <span>SRJ Consulting &amp; Services LLC</span>
        </div>
        <div class="f-contact">
          <strong>Email</strong>
          <a href={`mailto:${PUB_EMAIL}`}>{PUB_EMAIL}</a>
        </div>
        <div class="f-contact">
          <strong>Consulting</strong>
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </div>
        <div class="f-contact">
          <strong>Office</strong>
          <span>13054 Cinderella Lane<br>Frisco, TX 75035-5194<br>United States</span>
        </div>
        <div class="f-contact">
          <strong>Sources</strong>
          <span>LegiScan, CourtListener, the Federal Register, and arXiv.</span>
        </div>
        <a class="f-cta" href="https://srjconsultingservices.com/" rel="noopener">
          AI governance advisory <span class="arrow">&rarr;</span>
        </a>
      </div>
    </div>

    <div class="f-bottom">
      <div>&copy; {year} SRJ Consulting &amp; Services LLC. All rights reserved. · Site rebuilt {rebuilt}</div>
      <div class="f-legal">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/disclaimer/">Disclaimer</a>
        <a href="/disclosure/">Disclosure</a>
        <a href="/contact/">Contact</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-foot {
    background: var(--navy-deep);
    color: rgba(255, 255, 255, 0.82);
    font-size: 14.5px;
    margin-top: 70px;
    padding: 0 0 26px;
  }

  .f-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.1fr;
    gap: 44px;
    padding: 46px 0 0;
  }

  .f-mark { margin-bottom: 14px; }
  .f-mark :global(svg) { display: block; width: 190px; height: auto; }

  .f-about {
    font-size: 13.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.76);
    margin: 0;
    max-width: 34em;
  }

  .f-social { display: flex; gap: 10px; margin-top: 20px; }
  /* One quiet treatment for all three: frosted tiles with white marks that
     warm to orange on hover. The old brand-colored tiles (blue, red, and a
     white Google box) fought each other on the navy footer. */
  .f-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.22);
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .f-social a:hover {
    transform: translateY(-2px);
    background: var(--orange, #F07800);
    border-color: var(--orange, #F07800);
  }
  .f-social a svg { width: 20px; height: 20px; display: block; }

  .f-grid h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #fff;
    margin: 0 0 10px;
  }
  .f-grid h3.spaced { margin-top: 24px; }
  .f-grid h3 a { color: inherit; text-decoration: none; }
  .f-grid h3 a:hover { color: var(--orange); }

  .f-grid ul { list-style: none; margin: 0; padding: 0; }
  .f-grid li { margin-bottom: 6px; }
  .f-grid li a {
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
  }
  .f-grid li a:hover { color: var(--orange); text-decoration: none; }

  /* Rotated-arrow sub-item, carried from the SRJ footer. The glyph is written
     literally rather than as a CSS escape: in an Astro style block a \\21B3
     escape emits the characters instead of the arrow. */
  .f-grid li.sub { padding-left: 16px; position: relative; }
  .f-grid li.sub::before {
    content: '↳';
    position: absolute;
    left: 0;
    color: var(--orange);
    opacity: 0.7;
    font-size: 12px;
    line-height: 1.6;
  }
  .f-grid li.sub a { font-size: 13px; color: rgba(255, 255, 255, 0.72); }

  .f-contact { margin-bottom: 14px; font-size: 13.5px; line-height: 1.55; }
  .f-contact strong {
    display: block;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    font-weight: 600;
    margin-bottom: 3px;
  }
  .f-contact a { color: rgba(255, 255, 255, 0.9); text-decoration: none; }
  .f-contact a:hover { color: var(--orange); }
  .f-contact span { color: rgba(255, 255, 255, 0.82); }

  .f-cta {
    display: inline-flex;
    align-items: center;
    margin-top: 6px;
    padding: 12px 20px;
    border: 2px solid var(--orange);
    border-radius: 3px;
    color: #fff;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .f-cta:hover { background: var(--orange); color: #fff; text-decoration: none; }
  .f-cta .arrow { margin-left: 7px; }

  .f-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    margin-top: 44px;
    padding-top: 20px;
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.6);
  }
  .f-legal { display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: center; }
  .f-legal a { color: rgba(255, 255, 255, 0.6); font-size: 12.5px; text-decoration: underline; }
  .f-legal a:hover { color: var(--orange); }

  @media (max-width: 1000px) {
    .f-grid { grid-template-columns: 1fr 1fr; gap: 36px; }
  }
  @media (max-width: 700px) {
    .f-grid { grid-template-columns: 1fr; }
    .f-bottom { flex-direction: column; align-items: flex-start; }
  }
  /* MINIMUM TAP TARGET. Measured at 390px, footer and nav links rendered 14 to
     19px tall against a 24px floor, so roughly 40 targets per page were below
     the threshold on the device most of this traffic arrives on. The text size
     is right for a footer; the HIT AREA was not. Padding fixes it without
     changing a single visible dimension. */
  .site-foot a { display: inline-block; min-height: 24px; padding-top: 4px; padding-bottom: 4px; }
  /* The API and machine-readable links sit in dense rows where a 24px box
     would open gaps in the layout, so the hit area is grown with padding while
     the visible text keeps its size and rhythm. */
  .site-foot .api-links a, .site-foot .amz-book { min-height: 26px; padding-top: 5px; padding-bottom: 5px; }
</style>

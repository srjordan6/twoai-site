---
/**
 * The State AI Laws map. The CSS, markup, copy and behaviour below are taken
 * value for value from the file ChatGPT produced for Stephen on 2026-09-17
 * (state_ai_laws_map.html): the pale wrap, grey eyebrow, navy title, white
 * stage, flat grey states with white 1.1 strokes, orange hover with a navy
 * edge, the navy info card with its orange "View State AI Laws" button that
 * follows the pointer, and the dot, instruction and count in the footer.
 *
 * Three things are not from that file, each because the file could not ship:
 *
 * 1. GEOMETRY. Its 50 paths weigh 1.1 MB and draw the country upside down,
 *    Texas at the top and Florida at the lower right, with no source or
 *    licence stated. These outlines are US Census, public domain, via
 *    us-atlas, 21 KB, the same Albers USA projection as the design preview.
 *    The viewBox is 975 x 610 to fit them.
 * 2. LINKS. It pointed at /ai-compliance/state-ai-laws/{state}/, which does
 *    not exist for most states. Stephen's instruction: every state goes to
 *    /ai-laws/{state}/. The slug is read from content/laws/index.json, so a
 *    link can only point at a page this build emits. DC is included.
 * 3. REAL ANCHORS. Each state is an <a>, not a path with a click handler, so
 *    the map works with JavaScript off, by keyboard, and for crawlers. The
 *    script only drives the info card, as in the original.
 *
 * It replaces the hand-coloured SVG that was pasted into the prose of
 * /ai-compliance/state-ai-laws/ and went stale the day after it was drawn.
 */
import { readFileSync, existsSync } from 'node:fs';
import { STATE_SHAPES } from '../data/usStatesAlbers';

interface Props { title?: string }
const { title = 'State AI Laws' } = Astro.props;

const idx = existsSync('content/laws/index.json')
  ? JSON.parse(readFileSync('content/laws/index.json', 'utf8'))
  : { states: [] };
const drawn = (idx.states || [])
  .filter((s: any) => STATE_SHAPES[s.code])
  .map((s: any) => ({ ...s, d: STATE_SHAPES[s.code].d, href: `/ai-laws/${s.slug}/` }));
const stateCount = drawn.filter((s: any) => s.code !== 'DC').length;
---
{drawn.length > 0 && (
  <div class="ai-laws-map">
    <div class="ai-map-wrap">
      <div class="ai-map-head"><div>
        <div class="ai-map-eyebrow">AI Compliance · United States</div>
        <h2 class="ai-map-title">{title}</h2>
        <div class="ai-map-sub">Select a state to explore its enacted AI legislation.</div>
      </div></div>
      <div class="ai-map-stage">
        <svg class="map-svg" viewBox="0 0 975 610" xmlns="http://www.w3.org/2000/svg" role="group"
          aria-label="Interactive map of United States state AI laws">
          <g fill-rule="evenodd">
            {drawn.map((s: any) => (
              <a href={s.href} aria-label={`${s.name} AI laws`} data-state={s.name}>
                <path id={`map-${s.code}`} class="state" d={s.d} />
              </a>
            ))}
          </g>
        </svg>
        <div class="ai-map-info" aria-live="polite">
          <div class="ai-map-state-name"></div>
          <div class="ai-map-hint">Explore this state's AI legislation.</div>
          <a class="ai-map-link" href="/ai-laws/">View State AI Laws →</a>
        </div>
      </div>
      <div class="ai-map-footer">
        <span class="ai-map-dot"></span>
        <span>Click any state to view its AI laws</span>
        <span class="ai-map-count">Interactive map · {stateCount} states</span>
      </div>
    </div>
  </div>
)}

<script>
  // The info card, as in the original: it names the state, follows the
  // pointer, and on keyboard focus sits at the top right of the stage.
  document.querySelectorAll<HTMLElement>('.ai-laws-map').forEach((root) => {
    const svg = root.querySelector<SVGSVGElement>('.map-svg');
    const info = root.querySelector<HTMLElement>('.ai-map-info');
    const nameEl = root.querySelector<HTMLElement>('.ai-map-state-name');
    const linkEl = root.querySelector<HTMLAnchorElement>('.ai-map-link');
    const box = root.querySelector<HTMLElement>('.ai-map-stage');
    if (!svg || !info || !nameEl || !linkEl || !box) return;
    const move = (ev?: MouseEvent) => {
      if (!ev || window.matchMedia('(max-width:650px)').matches) return;
      const r = box.getBoundingClientRect();
      let x = ev.clientX - r.left + 15;
      let y = ev.clientY - r.top + 15;
      if (x + 220 > r.width) x = ev.clientX - r.left - 225;
      if (y + 105 > r.height) y = ev.clientY - r.top - 110;
      info.style.left = `${x}px`;
      info.style.right = 'auto';
      info.style.top = `${y}px`;
    };
    const show = (a: Element, ev?: MouseEvent) => {
      nameEl.textContent = a.getAttribute('data-state') || '';
      linkEl.href = a.getAttribute('href') || '/ai-laws/';
      info.classList.add('show');
      if (ev) move(ev);
    };
    const hide = () => info.classList.remove('show');
    svg.querySelectorAll('a[data-state]').forEach((a) => {
      a.addEventListener('mouseenter', (e) => show(a, e as MouseEvent));
      a.addEventListener('mousemove', (e) => move(e as MouseEvent));
      a.addEventListener('mouseleave', hide);
      a.addEventListener('focus', () => { info.style.left = ''; info.style.right = ''; info.style.top = ''; show(a); });
      a.addEventListener('blur', hide);
      a.addEventListener('click', () => {
        svg.querySelectorAll('.state.selected').forEach((s) => s.classList.remove('selected'));
        a.querySelector('.state')?.classList.add('selected');
      });
    });
  });
</script>

<style>
  .ai-laws-map{width:100%;max-width:1100px;margin:28px auto;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:#172033}
  .ai-map-wrap{background:#f7f8fb;border:1px solid #e2e5eb;border-radius:18px;padding:22px;overflow:hidden}
  .ai-map-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:12px}
  .ai-map-eyebrow{font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#7a8a9e;margin-bottom:5px}
  .ai-map-title{font-family:inherit;font-size:27px;line-height:1.15;margin:0;font-weight:750;letter-spacing:-.025em;color:#201868}
  .ai-map-sub{font-size:14px;color:#667085;margin-top:6px}
  .ai-map-stage{position:relative;background:#fff;border-radius:14px;border:1px solid #e6e8ed;min-height:390px;padding:8px}
  .map-svg{display:block;width:100%;height:auto}
  .map-svg a{outline:none}
  .state{fill:#dfe3e8;stroke:#fff;stroke-width:1.1;stroke-linejoin:round;cursor:pointer;transition:fill .16s ease,stroke .16s ease,filter .16s ease}
  .map-svg a:hover .state,.map-svg a:focus .state{fill:#f07800;stroke:#201868;stroke-width:1.7;outline:none;filter:drop-shadow(0 2px 2px rgba(32,24,104,.18))}
  .map-svg a:focus-visible .state{stroke:#201868;stroke-width:2.2}
  .state.selected{fill:#201868;stroke:#f07800;stroke-width:1.8}
  .ai-map-info{position:absolute;right:18px;top:18px;width:205px;background:#201868;color:#fff;border-radius:12px;padding:15px 16px;box-shadow:0 8px 25px rgba(32,24,104,.2);display:none;z-index:2;pointer-events:none}
  .ai-map-info.show{display:block}
  .ai-map-state-name{font-size:20px;font-weight:750}
  .ai-map-hint{font-size:12px;opacity:.78;margin-top:3px}
  .ai-map-info a{display:block;margin-top:12px;background:#f07800;color:#fff;text-decoration:none;text-align:center;padding:9px 11px;border-radius:7px;font-size:13px;font-weight:700}
  .ai-map-footer{display:flex;align-items:center;gap:8px;margin-top:12px;font-size:12px;color:#7a8a9e}
  .ai-map-dot{width:10px;height:10px;border-radius:50%;background:#dfe3e8;border:1px solid #cbd0d7;flex:0 0 auto}
  .ai-map-count{margin-left:auto}
  @media(max-width:650px){.ai-map-wrap{padding:14px}.ai-map-title{font-size:22px}.ai-map-stage{min-height:270px;padding:4px}.ai-map-info{position:relative;right:auto;top:auto;width:auto;margin:8px;pointer-events:auto}.ai-map-count{display:none}}
</style>

---
/* THE ASK BOX, IN ONE PLACE. Stephen, 2026-08-31: everything on this website
   and in SQL should be accessible in Ask this site a question, and /sources/
   should have this box too. It lived inline on the home page, markup, script
   and stylesheet all in index.astro, so a second copy on another page would
   have been a fork that drifts the first time either is touched.

   Props let a page set its own heading and example question without changing
   anything else. The ids stay fixed because the script binds to them, so this
   component must appear at most once on a page. */
interface Props { heading?: string; placeholder?: string; note?: string; }
const {
  heading = 'Ask Stephen a Question',
  placeholder = 'What are the AI laws in Texas?',
  note = '',
} = Astro.props;
---
  <!-- The ask box is front and centre on Stephen's instruction, above the map.
       It answers from this site's pages and its research index, and says so in
       the sub-line rather than hiding it: the limitation is the reason to trust
       the answer, and a visitor who expects a general chatbot and gets a
       refusal has been misled by us, not failed by the tool.

       Progressive enhancement: without JavaScript the box is inert and the
       ecosystem map directly below is unaffected. Nothing on this page depends
       on the assistant being up. -->
  <section class="ask" id="ask">
    <h2 class="ask-h">{heading}</h2>
    <div class="ask-row">
      <input id="ask-q" type="text" autocomplete="off" size="1"
        placeholder={placeholder}
        aria-label="Ask Stephen a question about AI, answered from this site" maxlength="500" />
      <button id="ask-go" type="button">Ask</button>
    </div>
    <p class="ask-note">Answered from this site's pages and its research index of academic papers,
      with links to every source used. When we have not covered something, it says so rather than
      guessing.{note ? ' ' + note : ''}</p>
    <div id="ask-out" class="ask-out" hidden></div>
  </section>

  <script is:inline>
    (function () {
      var q = document.getElementById('ask-q');
      var go = document.getElementById('ask-go');
      var out = document.getElementById('ask-out');
      if (!q || !go || !out) return;
      var busy = false;
      function esc(s) {
        return String(s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      // A URL THAT ARRIVES FROM OUTSIDE IS NOT A URL UNTIL IT IS CHECKED.
      // Escaping makes a string safe as TEXT; it does nothing about the scheme
      // of a link. "javascript:alert(1)" survives esc() unchanged and runs on
      // click. Everything below that reaches an href comes from Wikidata, a
      // third-party lookup tier, or an open-web search result, so only http
      // and https are allowed through and anything else renders as inert text.
      // Relative paths are allowed because our own source links are relative.
      function safeUrl(u) {
        var s = String(u == null ? '' : u).trim();
        if (/^\//.test(s) && !/^\/\//.test(s)) return esc(s);
        return /^https?:\/\//i.test(s) ? esc(s) : '';
      }
      // The model answers in Markdown. Until now the answer was escaped and
      // then only split on blank lines, so every "#" and "**" printed as a
      // literal character: the reader saw "# Texas AI Law" and "**HB 149**"
      // and the whole box read like a debug view next to the polished header
      // search. This turns the small subset of Markdown the assistant actually
      // uses into HTML.
      //
      // ORDER MATTERS AND IS THE SECURITY PROPERTY: esc() runs FIRST on the
      // raw answer, so any angle bracket in the model output is already inert
      // before a single tag is introduced here. Everything below then operates
      // on escaped text and can only produce the tags it writes itself.
      function render(md) {
        var lines = esc(md || '').split('\n');
        var html = '', inList = false;
        function inline(t) {
          return t
            .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
            .replace(/(^|[\s(])\*([^*\n]+)\*/g, '$1<em>$2</em>')
            .replace(/`([^`]+)`/g, '<code>$1</code>');
        }
        for (var i = 0; i < lines.length; i++) {
          var line = lines[i].trim();
          var m;
          if (!line) { if (inList) { html += '</ul>'; inList = false; } continue; }
          if ((m = line.match(/^(#{1,4})\s+(.*)$/))) {
            if (inList) { html += '</ul>'; inList = false; }
            // Headings inside an answer start at h3: the page already has an
            // h1 and the section carries the h2.
            var level = Math.min(m[1].length + 2, 5);
            html += '<h' + level + '>' + inline(m[2]) + '</h' + level + '>';
            continue;
          }
          if ((m = line.match(/^[-*]\s+(.*)$/))) {
            if (!inList) { html += '<ul>'; inList = true; }
            html += '<li>' + inline(m[1]) + '</li>';
            continue;
          }
          if (inList) { html += '</ul>'; inList = false; }
          html += '<p>' + inline(line) + '</p>';
        }
        if (inList) html += '</ul>';
        return html;
      }
      function ask(mode) {
        var text = q.value.trim();
        if (!text || busy) return;
        busy = true;
        go.disabled = true;
        go.textContent = mode === 'research' ? 'Researching' : 'Reading';
        out.hidden = false;
        // RESEARCH MODE, 2026-09-25: several searches and model calls, 20 to
        // 40 seconds, so the reader is told what is happening as it happens.
        var stepsTimer = null;
        if (mode === 'research') {
          var steps = ['Breaking the question into parts\u2026', 'Searching this site, the research index, Wikidata and the web\u2026', 'Reading the pages found\u2026', 'Writing a sourced answer\u2026'];
          var si = 0;
          out.innerHTML = '<p class="ask-wait">' + steps[0] + '</p>';
          stepsTimer = setInterval(function () { si = Math.min(si + 1, steps.length - 1); out.innerHTML = '<p class="ask-wait">' + steps[si] + '</p>'; }, 7000);
        } else {
          out.innerHTML = '<p class="ask-wait">Searching this site\u2026</p>';
        }
        // The question travels through the hero. See Hero.astro.
        if (window.__twoaiRipple) window.__twoaiRipple();
        fetch('/api/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question: text, from: location.pathname, mode: mode || undefined })
        }).then(function (r) { return r.json(); }).then(function (d) {
          if (stepsTimer) clearInterval(stepsTimer);
          if (d.error) { out.innerHTML = '<p class="ask-wait">' + esc(d.error) + '</p>'; return; }
          if (d.mode === 'research') { out.innerHTML = renderResearch(d); return; }
          var html = '<div class="ask-answer">' + render(d.answer) + '</div>';
          // General-knowledge context, when the model offers it, renders in
          // its own labelled block. It is not from our sources and the label
          // says so; keeping it visually separate is the condition under
          // which it is allowed to exist at all.
          // The open web, when this site has nothing. Its own block, its own
          // label, its own link list. It must never merge into "Sources on
          // this site" - that list is the reason the box is worth trusting.
          // Wikidata and the other free structured tiers share one renderer:
          // a label/value table with the source named and linked. Same shape,
          // different source line, so a reader always knows which outside
          // service a fact came from and can go check it.
          var structured = [];
          if (d.wikidata) structured.push({
            label: 'From Wikidata, not this site', title: d.wikidata.title,
            description: d.wikidata.description, facts: d.wikidata.facts,
            url: d.wikidata.url, linkText: d.wikidata.qid + ' on Wikidata',
            note: 'Public domain (CC0) structured data' +
              (d.lookupCached && d.lookupFetchedAt
                ? ', retrieved ' + new Date(d.lookupFetchedAt).toISOString().slice(0, 10) + ' and served from our record since. '
                : ', retrieved just now. ')
          });
          if (d.lookup) structured.push({
            label: 'From ' + d.lookup.sourceLabel + ', not this site', title: d.lookup.title,
            description: d.lookup.description, facts: d.lookup.facts,
            url: d.lookup.url, linkText: 'View on ' + d.lookup.sourceLabel,
            note: (d.lookupCached && d.lookupFetchedAt
              ? 'Retrieved ' + new Date(d.lookupFetchedAt).toISOString().slice(0, 10) + ' from ' + d.lookup.sourceLabel + ' and served from our record since. '
              : 'Retrieved just now from ' + d.lookup.sourceLabel + '. ') +
              'Not verified or published by us. '
          });
          structured.forEach(function (s) {
            // EVERY VALUE HERE IS ESCAPED. These blocks render Wikidata and
            // third-party lookup data, and Wikidata is editable by anyone on
            // the internet: a label, a description or a fact value containing
            // an <img onerror> would have executed in the reader's browser.
            // The sources and papers lists below always escaped; these two
            // did not, which is the whole bug - sanitisation applied in some
            // branches and not others is the same as none.
            var rows = s.facts.map(function (f) {
              return '<tr><th>' + esc(f.label) + '</th><td>' + esc(f.value) + '</td></tr>';
            }).join('');
            var href = safeUrl(s.url);
            html += '<div class="ask-wd"><p class="ask-wd-label">' + esc(s.label) + '</p>' +
              '<p class="ask-wd-title">' + esc(s.title) +
              (s.description ? ' \u2014 ' + esc(s.description) : '') + '</p>' +
              '<table class="ask-wd-facts">' + rows + '</table>' +
              '<p class="ask-wd-note">' + esc(s.note) +
              (href
                ? '<a href="' + href + '" rel="nofollow noopener" target="_blank">' + esc(s.linkText) + '</a>'
                : esc(s.linkText)) +
              '</p></div>';
          });
          if (d.web) {
            var wsrc = '';
            if (d.webSources && d.webSources.length) {
              wsrc = '<ul class="ask-web-src">' + d.webSources.map(function (s) {
                // Open-web results: the least trusted input on the page, and
                // it was going into an href unchecked.
                var u = safeUrl(s.url);
                var label = esc(s.title || s.url);
                return '<li>' + (u
                  ? '<a href="' + u + '" rel="nofollow noopener" target="_blank">' + label + '</a>'
                  : label) + '</li>';
              }).join('') + '</ul>';
            }
            var wnote = 'We have not verified or published this. Your question was recorded; topics asked often get researched and added.';
            if (d.webFetchedAt) {
              // Every page on this site shows when its data was gathered, and
              // a retrieved-from-the-web block needs it more than most: a
              // cached answer can be up to 30 days old and the reader is
              // entitled to know that before relying on it.
              var wd = new Date(d.webFetchedAt);
              wnote = 'Retrieved ' + wd.toISOString().slice(0, 10) +
                (d.webCached ? ' and served from our record since.' : '.') + ' ' + wnote;
            }
            html += '<div class="ask-web"><p class="ask-web-label">From the open web, not this site</p>' +
              render(d.web) + wsrc +
              '<p class="ask-web-note">' + wnote + '</p></div>';
          }
          if (d.beyond) {
            html += '<div class="ask-beyond"><p class="ask-beyond-label">Not from our sources</p>' +
              render(d.beyond) + '</div>';
          }
          if (d.sources && d.sources.length) {
            html += '<p class="ask-src-label">Sources on this site</p><ul class="ask-src">';
            for (var i = 0; i < d.sources.length; i++) {
              html += '<li><a href="' + safeUrl(d.sources[i].url) + '">' + esc(d.sources[i].title) + '</a></li>';
            }
            html += '</ul>';
          }
          // Papers are listed SEPARATELY and labelled as not being pages here,
          // because an answer that mixed them silently would be claiming the
          // site covers work it has only indexed. Links go to the DOI.
          if (d.papers && d.papers.length) {
            html += '<p class="ask-src-label">Research papers (not pages on this site)</p><ul class="ask-src">';
            for (var j = 0; j < d.papers.length; j++) {
              var pp = d.papers[j];
              html += '<li><a href="' + safeUrl(pp.url) + '" rel="nofollow noopener">' + esc(pp.title) + '</a>' +
                (pp.year ? ' <span class="ask-src-meta">' + esc(pp.year) + '</span>' : '') + '</li>';
            }
            html += '</ul>';
          }
          out.innerHTML = html + '<p class="ask-more"><button type="button" class="ask-research">Research this more thoroughly</button> <span class="ask-more-note">Checks this site, the research index, Wikidata and the web together. About 30 seconds.</span></p>';
          var rb = out.querySelector('.ask-research');
          if (rb) rb.addEventListener('click', function () { ask('research'); });
        }).catch(function () {
          if (stepsTimer) clearInterval(stepsTimer);
          out.innerHTML = '<p class="ask-wait">The assistant is unavailable right now.</p>';
        }).then(function () {
          busy = false; go.disabled = false; go.textContent = 'Ask';
        });
      }
      // Research results: the answer with its [S1] [W2] keys, then each list
      // of sources under its own label, site sources never mixed with outside
      // ones. Every value escaped; the web list is the least trusted input.
      function renderResearch(d) {
        var html = '<p class="ask-mode">Researched answer</p><div class="ask-answer">' + render(d.answer) + '</div>';
        if (d.unconfirmed) html += '<p class="ask-unconfirmed"><strong>Not confirmed:</strong> ' + esc(d.unconfirmed) + '</p>';
        function list(label, items, external) {
          if (!items || !items.length) return '';
          var h = '<p class="ask-src-label">' + label + '</p><ul class="ask-src">';
          items.forEach(function (s) {
            var u = safeUrl(s.url);
            h += '<li>' + (s.key ? '<span class="ask-key">[' + esc(s.key) + ']</span> ' : '') +
              (u ? '<a href="' + u + '"' + (external ? ' rel="nofollow noopener" target="_blank"' : '') + '>' + esc(s.title || s.url) + '</a>' : esc(s.title || '')) +
              (s.year ? ' <span class="ask-src-meta">' + esc(s.year) + '</span>' : '') + '</li>';
          });
          return h + '</ul>';
        }
        html += list('Sources on this site', d.sources, false);
        html += list('Research papers (not pages on this site)', d.papers, true);
        if (d.wikidata) html += list('From Wikidata, not this site', [{ key: d.wikidata.key, title: d.wikidata.title, url: d.wikidata.url }], true);
        html += list('From the open web, not this site', d.outside, true);
        if (d.parts && d.parts.length > 1) {
          html += '<p class="ask-parts-label">Researched as</p><ul class="ask-parts">' + d.parts.map(function (p) { return '<li>' + esc(p) + '</li>'; }).join('') + '</ul>';
        }
        html += '<p class="ask-web-note">Outside sources are not verified or published by us. Every sentence carries the key of the source it came from.</p>';
        return html;
      }
      go.addEventListener('click', function () { ask(''); });
      q.addEventListener('keydown', function (e) { if (e.key === 'Enter') ask(''); });
    })();
  </script>

<style>
  .ask { max-width: 860px; margin: 0 auto 2.6em; padding: 26px 26px 22px; text-align: center;
    background: #fcfbf7; border: 1px solid #e3e6ee; border-radius: 12px; }
  .ask-h { font-size: 1.25rem; margin: 0 0 14px; }
  /* THE INPUT RAN OFF THE RIGHT OF THE SCREEN ON A PHONE. Stephen, 2026-09-20,
     with a screenshot: the field extended past the card and past the viewport,
     and the Ask button was pushed off-screen entirely.

     `flex: 1` sets the basis to 0, so the field looks like it should shrink to
     fit. It does not. A flex item also gets `min-width: auto`, which floors it
     at its own intrinsic width, and for an <input> that is derived from the
     `size` attribute, about 20 characters by default. Below that width the
     item stops shrinking and overflows its container instead.

     Two changes, because either alone leaves a way for it to come back:
     `min-width: 0` lets the item shrink, and `size="1"` on the input removes
     the intrinsic width so CSS alone decides. size="1" looks wrong and is
     correct: the width is set here, not by a character count in the markup.

     The row also wraps now. On a narrow phone with a large system font the
     button drops below the field rather than squeezing it to nothing, and
     box-sizing keeps the padding inside the measured width. */
  .ask-row { display: flex; flex-wrap: wrap; gap: 10px; max-width: 640px; margin: 0 auto; }
  #ask-q { flex: 1 1 12em; min-width: 0; box-sizing: border-box;
    font-family: 'Poppins', system-ui, sans-serif; font-size: 15px;
    padding: 12px 14px; border: 1px solid #cfd4e4; border-radius: 8px; color: #201868; background: #fff; }
  #ask-q:focus { outline: 2px solid #F07800; outline-offset: 1px; border-color: #F07800; }
  #ask-go { flex: 0 0 auto; font-family: 'Poppins', system-ui, sans-serif; font-size: 15px; font-weight: 600;
    color: #fff; background: #201868; border: 0; border-radius: 8px; padding: 12px 24px; cursor: pointer; }
  #ask-go:hover { background: #F07800; }
  #ask-go:disabled { background: #7A8A9E; cursor: default; }
  .ask-note { font-size: 13px; color: #7A8A9E; margin: 12px auto 0; max-width: 600px; line-height: 1.6; }
  .ask-out { margin: 20px auto 0; max-width: 640px; text-align: left; }
  .ask-wait { font-size: 14px; color: #7A8A9E; font-style: italic; }
  .ask-more { margin: 12px 0 0; font-size: 13px; color: #7A8A9E; }
  .ask-research { font: inherit; font-weight: 600; color: #201868; background: #fff; border: 1px solid #201868;
    border-radius: 6px; padding: 5px 12px; cursor: pointer; }
  .ask-research:hover { background: #201868; color: #fff; }
  .ask-mode { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #F07800; margin: 0 0 6px; }
  .ask-unconfirmed { font-size: 14px; color: #33404f; margin: 8px 0 0; padding: 8px 12px; border-left: 3px solid #F07800; background: #fff8f0; }
  .ask-key { font-family: ui-monospace, monospace; font-size: 12px; color: #7A8A9E; }
  .ask-parts-label { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #7A8A9E; margin: 12px 0 4px; }
  .ask-parts { margin: 0; padding-left: 18px; }
  .ask-parts li { font-size: 13px; color: #7A8A9E; line-height: 1.5; }
  .ask-answer p { font-size: 15px; line-height: 1.7; margin: 0 0 .8em; }
  /* The assistant answers in Markdown and it is now rendered as such. These
     keep a heading inside an answer subordinate to the section it sits in:
     an h3 here is a paragraph label, not a page division. */
  .ask-answer h3, .ask-answer h4, .ask-answer h5 {
    font-family: var(--font-body); font-size: 15px; font-weight: 600;
    color: var(--navy, #201868); margin: 1.2em 0 .4em; line-height: 1.4;
  }
  .ask-answer h3:first-child, .ask-answer h4:first-child { margin-top: 0; }
  .ask-answer ul { margin: 0 0 .8em; padding-left: 1.2em; }
  .ask-answer li { font-size: 15px; line-height: 1.7; margin: 0 0 .3em; }
  .ask-answer code {
    font-size: 13px; background: rgba(32,24,104,.06);
    padding: .1em .35em; border-radius: 3px;
  }
  .ask-wd { margin: 14px 0 0; padding: 12px 14px; border: 1px solid #c9d4e2;
    border-left: 3px solid #201868; background: rgba(32,24,104,.04); border-radius: 0 6px 6px 0; }
  .ask-wd-label { font-size: 11px; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: #201868 !important; margin: 0 0 6px !important; }
  .ask-wd-title { font-size: 14px; font-weight: 600; color: #201868; margin: 0 0 8px; }
  .ask-wd-facts { border-collapse: collapse; width: 100%; margin: 0 0 8px; }
  .ask-wd-facts th { text-align: left; font-size: 12px; font-weight: 600; color: #7A8A9E;
    padding: 3px 12px 3px 0; white-space: nowrap; vertical-align: top; }
  .ask-wd-facts td { font-size: 14px; color: #33404f; padding: 3px 0; }
  .ask-wd-note { font-size: 12px; color: #7A8A9E; margin: 0; }
  .ask-wd-note a { color: #201868; }
  .ask-web { margin: 14px 0 0; padding: 12px 14px; border: 1px solid #e2c9a8;
    border-left: 3px solid #F07800; background: rgba(240,120,0,.05); border-radius: 0 6px 6px 0; }
  .ask-web p { font-size: 14px; line-height: 1.65; color: #33404f; margin: 0 0 .6em; }
  .ask-web-label { font-size: 11px; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: #F07800 !important; margin: 0 0 6px !important; }
  .ask-web-src { margin: 8px 0 0; padding-left: 18px; }
  .ask-web-src li { font-size: 13px; line-height: 1.5; margin-bottom: 3px; }
  .ask-web-src a { color: #201868; }
  .ask-web-note { font-size: 12px !important; color: #7A8A9E !important; margin: 8px 0 0 !important; }
  .ask-beyond { margin: 14px 0 0; padding: 10px 14px; border-left: 3px solid #cfd4e4;
    background: rgba(122,138,158,.07); border-radius: 0 6px 6px 0; }
  .ask-beyond p { font-size: 14px; line-height: 1.65; color: #4a5568; margin: 0 0 .6em; }
  .ask-beyond p:last-child { margin-bottom: 0; }
  .ask-beyond-label { font-size: 11px; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: #7A8A9E !important; margin: 0 0 6px !important; }
  .ask-src-label { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: #F07800; margin: 14px 0 6px; }
  .ask-src { list-style: none; margin: 0; padding: 0; }
  .ask-src li { padding: 5px 0; border-bottom: 1px solid #f0f0f5; font-size: 14.5px; }
  .ask-src a { color: #201868; text-decoration: none; font-weight: 600; }
  .ask-src a:hover { color: #F07800; }
  .ask-src-meta { color: #7A8A9E; font-weight: 400; font-size: 13px; }
  /* The card's own padding was 26px a side, which on a 360px phone spends 52px
     of a narrow screen on whitespace before the field gets any. */
  @media (max-width: 520px) {
    .ask { padding: 18px 14px 16px; }
    #ask-go { flex: 1 1 100%; }
  }
</style>

---
// Site chrome for theworldofai.org. Brand: SRJ system (navy #201868, orange
// #F07800, Lora headlines, Poppins body), fonts self-hosted via Fontsource.
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/lora/600.css';
import '@fontsource/lora/700.css';

import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import AmazonShelf from '../components/AmazonShelf.astro';
import PillarBox from '../components/PillarBox.astro';
import Topbar from '../components/Topbar.astro';
import DataStamp from '../components/DataStamp.astro';
import AskBox from '../components/AskBox.astro';
import { readFileSync, existsSync } from 'node:fs';
import { createHash } from 'node:crypto';

interface Props { title: string; description: string; current?: string; jsonld?: string; canonicalOverride?: string; noindex?: boolean; ogType?: string; rail?: boolean; titleTail?: string; doc?: Record<string, any>; stampLabel?: string; redirect?: string; }
/* rail=false drops the section-index card and lets the content run full width.
   The home page opts out: it IS the ecosystem map, so a card listing the same
   five categories beside it is the page repeating itself in miniature, and it
   pushed the hero, the ask box and everything below off centre. */
const { title, description, current = '', jsonld, canonicalOverride, noindex = false, ogType = 'website', rail = true, titleTail, doc: docProp, stampLabel, redirect } = Astro.props;

// THE ASK BOX ON EVERY PAGE. Stephen, 2026-09-23: put it on as many pages as
// possible. Visitors land deep in the site from search and answer engines, so
// a box on the home page alone was seen by almost nobody. The layout adds it
// at the foot of the content on every page, with an example question suited
// to the section. It is left off where a page already places its own copy
// (the component binds fixed ids, so two on one page would break both), on a
// page that exists only to redirect, and on embeds and the talent sign-in.
const askPath = Astro.url.pathname;
const ASK_OWN = [/^\/$/, /^\/sources\/?$/, /^\/ai-lawsuits\/?$/, /^\/ai-lawsuits\/(?!state\/)[^/]+\/?$/, /^\/ai-laws(\/[^/]+)?\/?$/];
const ASK_NEVER = [/^\/embed\//, /^\/talent\/login\//, /^\/404/];
const showAsk = !redirect && !ASK_OWN.some((r) => r.test(askPath)) && !ASK_NEVER.some((r) => r.test(askPath));
const ASK_EXAMPLES: [RegExp, string][] = [
  [/^\/ai-lawsuits\/state\//, 'Which AI lawsuits have been filed in this state?'],
  [/^\/ai-glossary\//, 'What is the difference between RAG and fine tuning?'],
  [/^\/ai-compliance\//, 'Does the EU AI Act apply to a US company?'],
  [/^\/state-of-ai-laws\//, 'Which states passed AI laws this year?'],
  [/^\/companies\//, 'Which AI companies are building data centers in Texas?'],
  [/^\/ai-news\//, 'What happened in AI regulation this week?'],
  [/^\/this-week-in-ai\//, 'What were the biggest AI stories this week?'],
  [/^\/ai-tools\//, 'What AI tools help a small accounting firm?'],
  [/^\/research\//, 'What papers cover AI governance?'],
  [/^\/mcp\//, 'What does an MCP server do?'],
  [/^\/benchmarks\//, 'Which models lead on coding benchmarks?'],
  [/^\/calculators\//, 'How much does it cost to run an AI model?'],
  [/^\/ai-prompts\//, 'How do I write a good prompt for a contract review?'],
  [/^\/compute\//, 'What does GPU compute cost per hour?'],
  [/^\/skills\//, 'What skills does an AI engineer need?'],
  [/^\/talent\//, 'Which AI jobs are open in Texas?'],
  [/^\/ai-ecosystem\/enterprise-applications-governance-and-tools\//, 'How is AI changing legal and accounting work?'],
  [/^\/ai-ecosystem\/technology-and-core-infrastructure\//, 'Which data centers are planned in Georgia?'],
  [/^\/ai-ecosystem\/ecosystem-entities-market-and-operations\//, 'Who are the leading AI companies in healthcare?'],
  [/^\/ai-ecosystem\/research-knowledge-and-learning\//, 'What is the best way to start learning AI?'],
];
const askExample = (ASK_EXAMPLES.find(([r]) => r.test(askPath)) || [null, 'What are the AI laws in Texas?'])[1];

// EVERY PAGE SHOWS ITS UID AND ITS DATE, INCLUDING THE HUBS. Stephen,
// 2026-09-18: do not see a uid for /ai-laws/. He was right, and it was not
// one page. A check of the live site that evening found 27 hub and tool pages
// with no stamp at all: the home page, AI Compliance, the glossary, tools,
// prompts, benchmarks, companies, compute, downloads, MCP, research, skills,
// sources, this week, every news hub, the API index, the calculators and the
// talent pages. The stamp only renders when a template hands this layout a
// `doc`, and the item templates did while the hub templates never had.
//
// Every one of those hubs already HAS a record in SQL with a uid, stamped by
// the pipeline on every write; the page just never read it. So the layout now
// finds the record itself when a template passes none. Fixing it here rather
// than in 27 templates is the DataStamp argument again: a convention repeated
// 27 times drifts, and the next new hub would forget it.
//
// A page with no record anywhere, a calculator or the API index, is computed
// rather than stored, so its uid is derived from its own path: the first eight
// hex characters of a SHA-256, the way the lawsuit case pages do it. That is
// stable for as long as the URL is, and URLs here never change. It is applied
// ONLY to the listed paths, never as a general fallback: an item page whose
// record carries a real uid must show that one, and a derived uid beside it
// would give one page two identifiers.
const HUB_RECORD: Record<string, string> = {
  '/': 'ecosystem/index.json',
  '/ai-laws/': 'laws/index.json',
  '/ai-compliance/': 'compliance/index.json',
  '/ai-glossary/': 'glossary/glossary.json',
  '/ai-tools/': 'tools/index.json',
  '/ai-prompts/': 'prompts/index.json',
  '/benchmarks/': 'benchmarks/index.json',
  '/companies/': 'companies/index.json',
  '/compute/': 'compute/index.json',
  '/downloads/': 'downloads/index.json',
  '/mcp/': 'mcp/index.json',
  '/research/': 'research/index.json',
  '/research/watch/': 'research/watch.json',
  '/skills/': 'skills/index.json',
  '/sources/': 'sources/index.json',
  '/this-week-in-ai/': 'week/index.json',
  '/ai-news/archive/': 'news/archive.json',
  '/ai-news/timeline/': 'timeline/index.json',
};
const DERIVED_UID = /^\/(api|talent|ai-news|ai-news\/daily|ai-news\/vendor)\/$|^\/calculators\/[a-z0-9-]+\/$|^\/talent\/[a-z0-9-]+\/$/;
let doc = docProp;
if (!doc && !redirect) {
  const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
  const rec = HUB_RECORD[here];
  if (rec && existsSync(`content/${rec}`)) {
    try {
      const r = JSON.parse(readFileSync(`content/${rec}`, 'utf8'));
      // Only the four stamp fields are kept. Some of these files are large,
      // and nothing else in the layout needs them.
      if (r && (r.page_uid || r.uid)) doc = { page_uid: r.page_uid || r.uid, built_at: r.built_at, generated: r.generated, refresh_every_days: r.refresh_every_days };
    } catch { /* a hub whose record cannot be read shows no stamp, as before */ }
  } else if (DERIVED_UID.test(here)) {
    const now = new Date().toISOString();
    doc = { page_uid: createHash('sha256').update('page:' + here).digest('hex').slice(0, 8), generated: now.slice(0, 10) };
  }
}
const nav = [
  { href: '/ai-ecosystem/technology-and-core-infrastructure/', label: 'Technology & Infrastructure', short: 'Technology' },
  { href: '/ai-ecosystem/ecosystem-entities-market-and-operations/', label: 'Market & Entities', short: 'Market' },
  { href: '/ai-ecosystem/research-knowledge-and-learning/', label: 'Research & Learning', short: 'Research' },
  { href: '/ai-ecosystem/enterprise-applications-governance-and-tools/', label: 'Enterprise & Governance', short: 'Enterprise' },
  { href: '/ai-news/', label: 'AI News', short: 'News' },
];
// Canonical defaults to this page's own URL. A page may override it while a
// copy elsewhere is still the indexed original, which is how the governance
// library migrates from srjconsultingservices.com without the two sites
// competing with each other in the meantime.
const canonical = canonicalOverride || new URL(Astro.url.pathname, Astro.site).href;

// A BASELINE OF STRUCTURED DATA ON EVERY PAGE. Stephen, 2026-09-18, after
// running an answer engine audit across the site: I am seeing the same things
// missing everywhere, what can you apply to all pages. Three of the things it
// names are true of most pages and can be fixed once, here:
//
//   no structured data   jsonld is emitted only when a template builds some,
//                        and most hubs and many item templates never did.
//   no author            nothing in the head or the schema said who publishes
//                        the page.
//   no date              hubs showed none until the stamp fix earlier today,
//                        and no page said so in machine readable form.
//
// So every page now declares, as one @graph: the publishing Organization, the
// WebSite, and a WebPage for itself with its uid, its date when the record
// has one, author and publisher, and a short breadcrumb. A template's own
// jsonld is still emitted beside it and is the richer statement; this is the
// floor under it. Two guards stop the floor contradicting the template: no
// WebPage node when the template already declares one, and no breadcrumb when
// the template has its own, since two trails for one page is worse than none.
//
// WHAT THIS DELIBERATELY DOES NOT DO. The same audit asks every page for an
// FAQ, expert quotations and more statistics. Those cannot be applied from a
// layout without inventing them, and an invented FAQ on 5,800 pages is the
// boilerplate Google declined to index on the company pages this same day.
const ORG_ID = 'https://theworldofai.org/#publisher';
const SITE_ID = 'https://theworldofai.org/#website';
const stampDate = doc ? String(doc.built_at || doc.generated || '').slice(0, 10) : '';
const pageUid = doc ? String(doc.page_uid || doc.uid || '') : '';
const humanize = (seg: string) => seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())
  .replace(/\bAi\b/g, 'AI').replace(/\bMcp\b/g, 'MCP').replace(/\bApi\b/g, 'API');
const herePath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const crumbs: { name: string; url: string }[] = [{ name: 'The World of AI', url: 'https://theworldofai.org/' }];
if (current && current !== '/' && current !== herePath) {
  const seg = current.replace(/\/$/, '').split('/').pop() || '';
  if (seg) crumbs.push({ name: humanize(seg), url: new URL(current, Astro.site).href });
}
if (herePath !== '/') crumbs.push({ name: String(title).replace(/\s+[\u2014|-]\s+The World of AI.*$/, '').slice(0, 110), url: canonical });
const tplLd = typeof jsonld === 'string' ? jsonld : '';
const baseGraph: Record<string, any>[] = [
  { '@type': 'Organization', '@id': ORG_ID, name: 'The World of AI', url: 'https://theworldofai.org/',
    logo: 'https://theworldofai.org/brand/icon-512.png',
    parentOrganization: { '@type': 'Organization', name: 'SRJ Consulting & Services LLC', url: 'https://srjconsultingservices.com/' } },
  { '@type': 'WebSite', '@id': SITE_ID, name: 'The World of AI', url: 'https://theworldofai.org/', inLanguage: 'en', publisher: { '@id': ORG_ID } },
];
if (!/"@type"\s*:\s*"WebPage"/.test(tplLd)) {
  baseGraph.push({
    '@type': 'WebPage', '@id': canonical + '#webpage', url: canonical, name: String(title).slice(0, 200), description: String(description).slice(0, 300),
    inLanguage: 'en', isPartOf: { '@id': SITE_ID }, author: { '@id': ORG_ID }, publisher: { '@id': ORG_ID }, isAccessibleForFree: true,
    ...(pageUid ? { identifier: pageUid } : {}),
    ...(stampDate ? { dateModified: stampDate } : {}),
  });
}
if (!/BreadcrumbList/.test(tplLd) && crumbs.length > 1) {
  baseGraph.push({ '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })) });
}
// \u003c for every "<": the JSON sits inside a <script> element, and a page
// title containing a tag would otherwise be able to close it.
const baseLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': baseGraph }).replace(/</g, '\\u003c');

// Final safety net on the two tags every page emits, applied here so no
// individual template can ship a tag outside the band the audits check.
// Descriptions clamp to 158, and anything under 110 gains a true site-wide
// sentence rather than shipping a stub the SERP pads with whatever it scrapes.
const wordClamp = (s: string, n: number) => (s.length <= n ? s : `${s.slice(0, n - 1).replace(/\s+\S*$/, '')}…`);

// TITLE BUDGET. A title has two independent limits and the character count is
// the weaker one: Google truncates on RENDERED WIDTH, so "Computer and
// Information Systems Managers" busts the pixel budget at 69 characters while
// "Ollama: what it does..." is fine at 61. Both are enforced here.
//
// TW is a per-character advance-width table for the font the SERP audit
// measures in, fitted by least squares against 119 measured (title, pixel
// width) pairs from the 2026-08-18 crawl export. Max error on that sample is
// 1.6px and mean error 0.41px, so this is the audit's own metric rather than
// an approximation of it. Characters the sample never contained carry
// Arial-derived values; anything still unknown falls back to DEFAULT_TW,
// which is deliberately generous so an unmeasured glyph clamps early rather
// than shipping over budget.
const TW={' ':5.5,'!':5.6,'"':7.1,'#':11.1,'$':11.1,'%':17.8,'&':10.95,'\'':6.3,'(':7.09,')':7.09,'*':7.8,'+':11.7,',':3.69,'-':8.24,'.':6.32,'/':8.65,'0':10.43,'1':10.81,'2':11.36,'3':10.45,'4':10.43,'5':10.11,'7':10.46,'8':10.54,'9':9.68,':':6.01,';':5.6,'<':11.7,'=':11.7,'>':11.7,'?':11.3,'@':20.3,'A':13.03,'B':12.27,'C':12.93,'D':12.33,'E':11.18,'F':10.2,'G':13.18,'H':13.96,'I':5.71,'K':12.04,'L':10.25,'M':16.73,'N':13.13,'O':12.95,'P':12.4,'Q':12.85,'R':12.33,'S':11.62,'T':12.01,'U':12.55,'V':12.01,'W':16.68,'X':11.87,'Z':10.71,'[':5.6,']':5.6,'`':6.7,'a':10.83,'b':11.48,'c':10.11,'d':11.24,'e':10.95,'f':6.93,'g':11.34,'h':10.51,'i':5.1,'j':6.25,'k':10.75,'l':5.01,'m':17.92,'n':10.79,'o':11.45,'p':11.19,'q':10.54,'r':6.9,'s':10.3,'t':6.26,'u':10.5,'v':9.69,'w':14.24,'x':9.51,'y':9.46,'z':9.45,'|':7.21,'~':11.7,'—':15.59,'‘':3.9,'’':3.9,'“':7.1,'”':7.1,'…':13.24,'™':18};
const DEFAULT_TW = 11;
const titlePx = (s: string) => [...s].reduce((n, c) => n + ((TW as any)[c] ?? DEFAULT_TW), 0);
const MAX_CH = 60, MAX_PX = 561, MIN_CH = 30;
const overBudget = (s: string) => s.length > MAX_CH || titlePx(s) > MAX_PX;

// Readable names for the four ecosystem pillars, used to give a too-short
// title real context instead of padding it with filler. "GPUs" alone wastes
// most of the SERP line; "GPUs — AI Technology" says which shelf it sits on.
const PILLAR_LABEL: Record<string, string> = {
  'technology-and-core-infrastructure': 'AI Technology',
  'ecosystem-entities-market-and-operations': 'AI Market',
  'research-knowledge-and-learning': 'AI Research & Learning',
  'enterprise-applications-governance-and-tools': 'AI Governance',
};

let pageTitle = title;
/* PROTECTED DISCRIMINATOR. A page whose title is not unique on its own passes
   the distinguishing part as titleTail, and the clamp below eats the head
   instead of the tail.

   Without this the clamp defeats the disambiguation it is handed. The MCP
   pages append the registry name to separate servers that share a display
   title, and on 2026-08-28 two of them still shipped byte-identical titles:
   "AutEng MCP - Markdown Publishing & Document Share Links" is 54 characters
   before any suffix, so the name was clamped straight back off and both pages
   emitted the same truncated string. Clamping from the right is correct when
   the right is the least informative part, and wrong the moment it is the only
   informative part. */
if (titleTail) {
  let head = title.replace(/\s+[—|-]\s+The World of AI\s*$/, '');
  let candidate = `${head} ${titleTail}`;
  while (overBudget(candidate) && head.length > 12) {
    head = wordClamp(head, Math.min(MAX_CH, head.length - 1));
    candidate = `${head} ${titleTail}`;
  }
  pageTitle = candidate;
} else {
// Over budget: drop the site-name suffix first, since it is the least
// informative part, then cut at a word boundary until both limits are met.
if (overBudget(pageTitle)) pageTitle = pageTitle.replace(/\s+[—|-]\s+The World of AI\s*$/, '');
while (overBudget(pageTitle) && pageTitle.length > 12) {
  pageTitle = wordClamp(pageTitle, Math.min(MAX_CH, pageTitle.length - 1));
}
// Under budget: add the pillar, but only when the result still fits. Utility
// pages such as /contact/ carry no pillar and are left short on purpose, a
// short title being correct for them rather than a defect to pad away.
if (pageTitle.length < MIN_CH) {
  const seg = Astro.url.pathname.split('/').filter(Boolean);
  const label = seg[0] === 'ai-ecosystem' && seg[1] ? PILLAR_LABEL[seg[1]] : undefined;
  if (label && !pageTitle.includes(label)) {
    const withPillar = pageTitle.replace(/\s+[—|-]\s+The World of AI\s*$/, ` — ${label} — The World of AI`);
    if (!overBudget(withPillar)) pageTitle = withPillar;
  }
  // Pages outside the four pillars have no shelf to name, so a one-word title
  // like "Contact" or "Disclaimer" stays short. Say what the site is instead,
  // which is true of every page here and is what a searcher seeing the bare
  // word would want to know.
  if (pageTitle.length < MIN_CH) {
    const withSite = `${pageTitle.replace(/\s+[—|-]\s+The World of AI\s*$/, '')} — The World of AI, an atlas of AI`;
    if (!overBudget(withSite)) pageTitle = withSite;
  }
}
}
// 155, not 158. A Screaming Frog crawl on 2026-09-13 flagged 134 pages, 29%
// of the sample, for descriptions over 155 characters; the site's clamp was
// three characters looser than the tool's threshold and every page that
// landed in the gap was reported. Google truncates on pixel width, not
// characters, so neither figure is exact - but 155 is the figure every audit
// tool checks, and being three characters over it buys nothing.
const DESC_MAX = 155;
let metaDesc = wordClamp(description, DESC_MAX);
if (metaDesc.length < 110) {
  const long = `${metaDesc} From The World of AI, an atlas of artificial intelligence rebuilt daily from primary sources.`.trim();
  const short = `${metaDesc} From The World of AI, rebuilt daily from primary sources.`.trim();
  metaDesc = long.length <= DESC_MAX ? long : short.length <= DESC_MAX ? short : wordClamp(short, DESC_MAX);
}

// GA4 custom dimensions, resolved at build time so every page reports which
// pillar and section it belongs to. This is what makes the factory-level
// question answerable ("which pillar earns impressions") instead of only
// having page paths, which say nothing about how the site is organised.
const _seg = Astro.url.pathname.split('/').filter(Boolean);
const gaPillar = _seg[0] === 'ai-ecosystem' && _seg[1] ? _seg[1] : (_seg[0] || 'home');
const gaSection = _seg[0] === 'ai-ecosystem' ? (_seg[2] ? 'detail' : 'category') : (_seg[1] ? _seg.slice(0, 2).join('/') : _seg[0] || 'home');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDesc} />
  <link rel="canonical" href={canonical} />
  <meta name="author" content="The World of AI, published by SRJ Consulting &amp; Services LLC" />
  <link rel="author" href="https://theworldofai.org/about/" />
  {stampDate && <meta property="article:modified_time" content={stampDate} />}
  {stampDate && <meta property="og:updated_time" content={stampDate} />}
  {noindex && <meta name="robots" content="noindex,follow" />}
  {/* A page that has moved. Static hosting cannot issue a 301 for a URL
      that is not in the redirects file, and that file is capped at two
      thousand lines, so a moved page is a real page that says where it went:
      meta refresh for browsers, canonical for search engines, noindex so
      the old address drops out of the index in favour of the new one. The
      story routes use this for slug URLs after the move to uids. */}
  {redirect && <meta http-equiv="refresh" content={`0; url=${redirect}`} />}
  <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#201868" />
  {/* AdSense site-verification signal. The ad loader itself is deferred to
      idle/first-interaction for performance, so the script tag is not in the
      static HTML for Google's verification crawler to find. This meta tag and
      ads.txt are Google's two supported no-script verification methods, and
      both are static. */}
  <meta name="google-adsense-account" content="ca-pub-4489551395134574" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDesc} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="The World of AI" />
  <meta property="og:image" content="https://theworldofai.org/brand/og.png" />
  {/* Feed discovery for readers and for Google News, 2026-09-25. */}
  <link rel="alternate" type="application/rss+xml" title="The World of AI, daily AI news" href="https://theworldofai.org/ai-news/feed.xml" />
  <link rel="alternate" type="application/rss+xml" title="The World of AI, vendor announcements" href="https://theworldofai.org/ai-news/vendor/feed.xml" />
  <link rel="alternate" type="application/rss+xml" title="This Week in AI" href="https://theworldofai.org/this-week-in-ai/feed.xml" />
  <meta name="twitter:card" content="summary_large_image" />
  {/* Google AdSense. The tag is sitewide because AdSense verification and ad
      serving both require it on every page. Auto ads stay OFF in the AdSense
      console: units are placed deliberately and never above the answer block.
      EEA and UK consent is handled by Google's own certified message, enabled
      under Privacy and messaging in the AdSense console, which is what makes
      this tag lawful there without a separate CMP on our side. */}
  {/* Consent Mode v2 defaults, set BEFORE gtag.js loads so the first hit
      already carries the right signal. Storage is denied by default in the
      EEA, UK, and Switzerland, where consent is required, and granted
      elsewhere. Google's certified message (the same one AdSense uses) calls
      gtag('consent','update',...) when a visitor answers, so GA4 and ads
      upgrade from pings to full measurement only on consent in those regions.
      wait_for_update holds the first events briefly so a returning visitor's
      stored choice is applied before anything fires. */}
  {/* Owner opt-out. Visiting any page once with ?noanalytics=1 sets a
      persistent flag in this browser; ?noanalytics=0 clears it. While set,
      GA4, Clarity, and StatCounter are not loaded at all, so the site owner
      never inflates his own numbers from any device he has flagged. Runs
      before every tag below and is the single gate all three check. */}
  <script is:inline>
    (function(){
      try{
        var q=new URLSearchParams(location.search).get('noanalytics');
        if(q==='1')localStorage.setItem('twoai_noanalytics','1');
        else if(q==='0')localStorage.removeItem('twoai_noanalytics');
        window.__twoaiNoAnalytics=localStorage.getItem('twoai_noanalytics')==='1';
      }catch(e){window.__twoaiNoAnalytics=false;}
      // THE SQUARE SCREEN BOTS, 2026-09-24. Stephen: numbers went way up
      // again. GA4 for Sep 17 to 23 showed 11,825 users, 11,377 of them in
      // Singapore, nearly all direct, one page, about six seconds. On Sep 18
      // their fingerprint was a 1366 x 1366 screen (7,047 of 7,374 users),
      // with 1280 x 1280 and 800 x 600 behind it. No real desktop or laptop
      // reports a square screen, so a square screen of 1000 pixels or more
      // loads no analytics and no ads. Blocking at Cloudflare stops most of
      // them; this keeps the ones that slip through out of the numbers, and

<body>
  <!-- The topbar and the masthead are ONE sticky unit, not two.

       Both used to be position:sticky with top:0 independently, so on scroll
       the masthead pinned to y=0 underneath the topbar, which sits above it at
       z-index 1100 and is 48px tall. The top 48px of the 84px masthead was
       covered: the logo lost its globe and the nav labels lost their first
       line, on every page, as soon as you scrolled a pixel.

       Giving the masthead top:48px would fix it at one breakpoint and break it
       at the next, because the topbar's height changes with its own media
       queries. Wrapping both in a single sticky element means they move
       together whatever either one measures. -->
  <script is:inline>
    /* Publishes the scrollbar width as --sb so full-bleed sections can reach the
       window edge without a vw unit fighting a scrollbar the browser has already
       reserved. One line, runs before paint, no layout read after render. */
    document.documentElement.style.setProperty('--sb',
      (window.innerWidth - document.documentElement.clientWidth) + 'px');
  </script>
  {/* THE FURNITURE IS NOT THE PAGE, FOR SEARCH ENGINES EITHER. On 2026-09-18 a
      web search returned our Andersen v. Stability page with this as its
      description: "Searches the full text of every published page, all built
      from the same database...", which is the search box blurb in the header.
      Another case page was described by its affiliate disclosure. The header,
      rail, shelf and footer are identical on every page and come first or last
      in the markup, so an engine choosing a snippet, or an answer engine
      choosing a passage to quote, was picking furniture over content.
      data-nosnippet is honoured by Google and Bing: the text stays crawlable
      and the links still count, it just cannot be shown as the description.
      Same idea as data-pagefind-body below, for the engines we do not run. */}
  <div class="site-sticky" data-nosnippet>
  <Topbar />
  <header class="site-head">
    <div class="wrap bar">
      <a href="/" class="logo" aria-label="The World of AI home">
        <Logo variant="horizontal" />
      </a>
      <nav aria-label="Primary" class="main-nav">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={current === n.href ? 'page' : undefined}><span class="nav-full">{n.label}</span><span class="nav-short">{n.short}</span></a></li>
          ))}
        </ul>
      </nav>
      <button class="nav-toggle" id="nav-toggle" type="button" aria-label="Open menu"
        aria-expanded="false" aria-controls="mobile-panel">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>
  </div>
  <script is:inline>
    /* Publishes the sticky header's measured height as --sticky-h so anything
       that pins below it (the rail's section card) clears it at every
       breakpoint. The topbar and masthead heights both change with their own
       media queries, which is exactly why they were wrapped in one sticky
       unit; the same reasoning forbids hardcoding their sum here. Without
       this, the rail pinned at 1.2rem and slid underneath the header the
       moment the page scrolled, hiding the card's title and first entries. */
    (function () {
      var s = document.querySelector('.site-sticky');
      if (!s) return;
      var set = function () {
        document.documentElement.style.setProperty('--sticky-h', s.offsetHeight + 'px');
      };
      set();
      if (window.ResizeObserver) new ResizeObserver(set).observe(s);
      else window.addEventListener('resize', set);
    })();
  </script>
  <div class="scrim" id="scrim"></div>
  <script is:inline>
    (function () {
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var els = document.querySelectorAll('main h2, main section, main .kr-block, main article');
      if (!els.length || els.length > 400) return; // long index pages stay static
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('reveal-in');
          io.unobserve(e.target);       // once, never again
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.02 });
      /* FAILSAFE. Arming an element sets opacity to 0, so if the observer never
         fires - a browser quirk, a script error above this one, a page restored
         from bfcache mid-scroll - the content stays invisible forever. That is a
         content-blocking bug wearing a design costume, and it is worth more than
         the animation it protects. After three seconds everything is revealed
         regardless of whether it was ever observed. */
      setTimeout(function () {
        document.querySelectorAll('.reveal-armed').forEach(function (el) {
          el.classList.add('reveal-in');
        });
      }, 3000);

      els.forEach(function (el, i) {
        // Anything already on screen at load is left alone: animating what the
        // reader is already looking at is motion for its own sake.
        if (el.getBoundingClientRect().top < window.innerHeight * 0.9) return;
        el.classList.add('reveal-armed');
        io.observe(el);
      });
    })();
  </script>
  <nav class="mobile-panel" id="mobile-panel" aria-label="Mobile navigation" aria-hidden="true" data-nosnippet>
    <ul>
      {nav.map((n) => (
        <li><a href={n.href} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a></li>
      ))}
    </ul>
  </nav>

  <!-- Full-bleed slot, OUTSIDE the content grid.
       A hero cannot escape a grid column with negative margins: 50% resolves
       against the column, not the window, so the first attempt left the stage
       694px wide on a 1440px screen and, when forced with 100vw, added a
       horizontal scrollbar because 100vw includes the scrollbar the browser has
       already reserved. Both measured, both wrong.
       Rendering outside the grid is the fix that needs no arithmetic. -->
  <slot name="bleed" />

  <main class={`wrap main-wrap${rail ? "" : " no-rail"}`}>
    {rail && (
      <div class="rail-col" data-nosnippet>
        <PillarBox />
        <slot name="rail" />
      </div>
    )}
    {/* SEARCH READS THE PAGE, NOT THE FURNITURE. Stephen, 2026-09-18: a search
        for Amazon Web Services returned 4,248 results, every one matching the
        same sentence, because Pagefind indexed the whole body and the Amazon
        book shelf under every page says "now available on Amazon" and "SRJ
        Consulting & Services". The header, the rail, the shelf and the footer
        are identical on every page, so indexing them makes every page match
        the words they contain and buries the pages that are actually about
        the query. data-pagefind-body limits the index to this column. */}
    <div class="main-col" data-pagefind-body>
      <slot />
      {/* READ NEXT, NEAR THE TOP. Stephen, 2026-09-24: Clarity showed one page
          per session and 25 percent scroll depth. Visitors take the opening
          answer and leave before reaching Keep reading at the foot. This
          copies the first three of those links into a short line placed after
          the page's opening paragraph, so the next page is in view while the
          reader still is. It runs as the page is parsed, before first paint
          on almost every load, so it does not shift the layout, and it only
          acts on pages that have a Keep reading block and a real opening. */}
      <script is:inline>
        (function(){
          var kr=document.querySelector('main .keep-reading');
          if(!kr) return;
          var links=[].slice.call(kr.querySelectorAll('a')).slice(0,3);
          if(links.length<2) return;
          var ps=document.querySelectorAll('main p');
          var first=null;
          for(var i=0;i<ps.length;i++){
            if(kr.contains(ps[i])) break;
            if((ps[i].textContent||'').length>=160){first=ps[i];break;}
          }
          if(!first) return;
          var box=document.createElement('p');
          box.className='read-next';
          box.setAttribute('data-nosnippet','');
          box.setAttribute('data-pagefind-ignore','');
          var lab=document.createElement('span');
          lab.className='read-next-label';
          lab.textContent='Read next';
          box.appendChild(lab);
          links.forEach(function(a){
            var c=document.createElement('a');
            c.href=a.getAttribute('href');
            c.textContent=(a.textContent||'').trim();
            box.appendChild(c);
          });
          first.parentNode.insertBefore(box, first.nextSibling);
        })();
      </script>
      <style is:inline>
        .read-next { margin: 14px 0 22px; padding: 10px 14px; border-left: 3px solid #F07800;
          background: #f7f7fb; font-size: 14px; line-height: 1.6; }
        .read-next-label { font-family: Poppins, system-ui, sans-serif; font-size: 11px; font-weight: 700;
          letter-spacing: .14em; text-transform: uppercase; color: #F07800; margin-right: 10px; }
        .read-next a { color: #201868; font-weight: 600; text-decoration: none; margin-right: 14px; display: inline-block; }
        .read-next a:hover { color: #F07800; }
        @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .read-next { background: rgba(255,255,255,.05); } }
      </style>
      {/* data-pagefind-ignore: the box reads the same on every page, and
          indexing it would make every page match its words in site search. */}
      {showAsk && <div class="ask-foot" data-pagefind-ignore><AskBox placeholder={askExample} /></div>}
      {/* EVERY PAGE CARRIES A DATE, A TIME AND A UID. Stephen's standing rule
          of 2026-09-06. Rendering it here rather than in each of the 65 page
          templates is the only way it stays true: a convention repeated 65
          times drifts, and before today only three of 4,928 pages carried a
          time. A page passes its document as `doc` and the stamp appears at
          the foot of the content; a page that has not been wired yet simply
          shows nothing here, so this can be adopted template by template
          without a flag day. */}
      {doc && <DataStamp doc={doc} label={stampLabel ?? 'Generated'} />}
    </div>
  </main>

  <div data-nosnippet>
  <AmazonShelf />
  <Footer>
    <Logo slot="logo" variant="stacked-navy" />
  </Footer>
  </div>
  <noscript><div class="statcounter"><a title="Web Analytics"
    href="https://statcounter.com/" target="_blank" rel="noopener noreferrer"><img
    class="statcounter"
    src="https://c.statcounter.com/13342610/0/1a5584ba/1/"
    alt="Web Analytics"
    width="1" height="1"
    referrerpolicy="no-referrer-when-downgrade"></a></div></noscript>

  <script is:inline>
  (function () {
    var t = document.getElementById('nav-toggle'), p = document.getElementById('mobile-panel'),
        s = document.getElementById('scrim');
    if (!t || !p || !s) return;
    function set(o) {
      p.classList.toggle('open', o); s.classList.toggle('open', o); t.classList.toggle('open', o);
      t.setAttribute('aria-expanded', o ? 'true' : 'false');
      p.setAttribute('aria-hidden', o ? 'false' : 'true');
      document.body.classList.toggle('locked', o);
    }
    t.addEventListener('click', function () { set(!p.classList.contains('open')); });
    s.addEventListener('click', function () { set(false); });
    p.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
  })();
  </script>

  <style is:global>
    :root {
      --navy: #201868; --navy-deep: #1A1357; --orange: #F07800;
      --gray: #7A8A9E; --cream: #FFF6EC; --ink: #26262b;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    /* Keyboard focus is visible everywhere, not just on the search toggle. Uses
       :focus-visible so a mouse click does not draw the ring, only keyboard or
       programmatic focus does. Orange on navy and on white both clear WCAG
       contrast. The QA audit found only the search button had a focus style,
       leaving keyboard users unable to see their position in the nav, the bill
       tables, or any link. */
    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible,
    [tabindex]:focus-visible {
      outline: 2px solid var(--orange);
      outline-offset: 2px;
      border-radius: 2px;
    }
    body { margin: 0; font-family: 'Poppins', system-ui, sans-serif; font-size: 16px;
      line-height: 1.65; color: var(--ink); background: #fff; }
    /* Selected text is brand navy, and the letters on it are pure white.
       Without the explicit colour the browser keeps each element's own
       colour, so a muted grey label, the metadata and table row headers all
       over this site, stayed grey on navy and became hard to read the moment
       a reader dragged over it. Caught 2026-08-30 on the Today's numbers
       panel of the daily briefing. */
    ::selection { background: var(--navy, #201868); color: #ffffff; }
    ::-moz-selection { background: var(--navy, #201868); color: #ffffff; }
    body.locked { overflow: hidden; }
    .wrap { max-width: 1080px; margin: 0 auto; padding: 0 22px; }
    /* Two-column grid at desktop widths: the page content in column one, the
       pillar card in column two. A grid track cannot overlap its neighbour,
       so the card is structurally incapable of sitting on top of the prose,
       which the earlier floated and absolutely-positioned versions both did
       at some widths. Below 1040px it collapses to a single column and the
       card renders above the content. */
    .main-wrap { position: relative; }
    .main-col { min-width: 0; }
    /* Collapsed layout. The rail dissolves so its children become siblings
       of the content, and order puts the pillar card above the article as
       before while any page panels the rail carries drop below it. Without
       this the whole rail stacks on top and pushes the headline a screen
       and a half down the page on a phone. */
    @media (max-width: 1039.98px) {
      .main-wrap { display: flex; flex-direction: column; }
      .rail-col { display: contents; }
      .rail-col > .pillar-box { order: 1; }
      .main-col { order: 2; }
      .rail-col > *:not(.pillar-box) { order: 3; margin-top: 1.6rem; }
    }
    /* The right rail: the pillar card, plus whatever a page puts in the
       "rail" slot beneath it. One column-two grid item holding both, so a
       page's own side panels stack under the card in normal flow instead of
       fighting the grid for a row. Sticky and the rightward slide live here
       rather than on the card, since they now apply to the whole rail.

       The slide uses the dead margin a 1080px wrap leaves on a wide monitor,
       capped at the space available less a 40px gutter so it can never reach
       the viewport edge, and clamping to zero below about 1160px. Transform,
       not layout: the content column does not move and nothing reflows.

       Below 1040px the grid collapses and the rail renders above the content
       as a normal block. */
    @media (min-width: 1040px) {
      .main-wrap {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 268px;
        column-gap: 34px;
        align-items: start;
      }
      .main-col { grid-column: 1; grid-row: 1; }
      /* No rail: one column, centred, with a comfortable measure rather than a
         1,080px line length nobody can read. */
      .main-wrap.no-rail { grid-template-columns: minmax(0, 1fr); }
      .main-wrap.no-rail .main-col { max-width: 880px; margin: 0 auto; }
      .rail-col {
        grid-column: 2;
        grid-row: 1;
        position: sticky;
        /* Below the sticky header, whatever it measures at this breakpoint;
           the fallback matches the header's typical desktop height so the
           first paint is right even before the inline script runs. */
        top: calc(var(--sticky-h, 132px) + 1.2rem);
        transform: translateX(clamp(0px, calc((100vw - 1080px) / 2 - 40px), 260px));
        /* A STICKY RAIL TALLER THAN THE WINDOW HIDES ITS OWN BOTTOM. Stephen,
           2026-09-22: Enterprise and Governance grew to twelve sections, the
           card grew past the bottom of the window, and because the rail is
           sticky it never scrolled up to show items eleven and twelve, The
           Politics of AI and Knowledge Based Professions and their Future.
           They were in the page and could not be reached. The rail is now
           capped at the window height below the header and scrolls inside
           itself when it is longer. */
        max-height: calc(100vh - var(--sticky-h, 132px) - 2.4rem);
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: thin;
      }
    }
    @media (min-width: 1400px) {
      .main-wrap { grid-template-columns: minmax(0, 1fr) 300px; column-gap: 42px; }
    }
    /* The rail's top edge must never sit higher than the top of the page
       headline. Most pages open with a breadcrumb line before the h1, and
       because the rail is a grid item in row 1 it would otherwise start
       level with that breadcrumb, i.e. above the headline. Where a page
       opens that way, drop the rail by exactly the breadcrumb's own height:
       14px text at the body line-height of 1.65 is 23.1px, plus its 18px
       bottom margin, so 41px puts the rail's top on the headline's top.
       Pages with no breadcrumb need no offset. Stated as a :has() rule so it
       is driven by the markup that is actually there, not set per template. */
    @media (min-width: 1040px) {
      .main-wrap:has(.main-col > .meta-line:first-child) .rail-col { margin-top: 41px; }
    }
    h1, h2, h3 { font-family: 'Lora', Georgia, serif; color: var(--navy); line-height: 1.22;
      margin: 0 0 .5em; }
    h1 { font-size: clamp(1.7rem, 4vw, 2.5rem); }
    h2 { font-size: clamp(1.3rem, 3vw, 1.7rem); margin-top: 1.6em; }
    a { color: var(--orange); text-decoration: none; }
    a:hover { text-decoration: underline; }
    /* NO ORANGE TEXT AT REST. ORANGE MEANS "THERE IS MORE HERE", ON HOVER.
       Stephen, 2026-09-17: on any word, sentence, paragraph, page I do not
       want anything in orange. If you roll over the text with your mouse and
       we have additional content then turn that text to orange. Do this for
       the whole website, no exceptions.

       So every link reads in navy like the text around it, and turns orange
       under the pointer or keyboard focus. Orange therefore has exactly one
       meaning on this site: the thing under your cursor leads somewhere. The
       few places that coloured text orange for emphasis - the current nav
       item, card counts, the calculator verdict, the refresh-due stamp - go
       to navy weight instead, because orange emphasis and orange links were
       two meanings for one colour.

       !important is deliberate and this is the one place it belongs. Sixty
       five page templates carry their own scoped link colours, and "no
       exceptions" cannot be kept by editing sixty five files and hoping the
       sixty sixth remembers. Brand orange stays where it is not text: the
       masthead rule, the answer box edge, the badge outline, focus rings,
       buttons. */
    a, a:link, a:visited { color: var(--navy) !important; }
    a:hover, a:focus-visible { color: var(--orange) !important; text-decoration: underline; }
    /* White-on-navy links keep their white and still go orange on hover.
       Pills are white text on a navy block whose BACKGROUND goes orange, so
       their text stays white in both states. */
    .calc-answer a, .mobile-panel a, .site-head .main-nav a, th a { color: #fff !important; }
    a.pill, a.pill:link, a.pill:visited, a.pill:hover, a.pill:focus-visible { color: #fff !important; text-decoration: none; }
    .site-head .main-nav a { color: var(--navy) !important; }
    /* THE FOOTER. Stephen, 2026-09-18, with a screenshot: every footer link had
       vanished. The rule above turns every link navy with !important and named
       its white-on-navy exceptions, the mobile panel, table headers, the
       calculator answer, and left out the footer, which sits on navy-deep. Navy
       on navy: the section links, the API links, the email addresses, About,
       Contact, and the advisory button were all there and all invisible.
       Footer.astro already had the right colours; they were being overridden.
       Same contract as everywhere else: readable at rest, orange under the
       pointer. The legal line stays a step quieter, and the advisory button
       keeps white text when its background goes orange. */
    .site-foot a, .site-foot a:link, .site-foot a:visited { color: rgba(255, 255, 255, 0.86) !important; }
    .site-foot .f-grid h3 a, .site-foot .f-grid h3 a:link, .site-foot .f-grid h3 a:visited { color: #fff !important; }
    .site-foot .f-legal a, .site-foot .f-legal a:link, .site-foot .f-legal a:visited { color: rgba(255, 255, 255, 0.66) !important; }
    .site-foot a:hover, .site-foot a:focus-visible,
    .site-foot .f-grid h3 a:hover, .site-foot .f-grid h3 a:focus-visible,
    .site-foot .f-legal a:hover, .site-foot .f-legal a:focus-visible { color: var(--orange) !important; }
    /* THE TOP BAR AND THE SEARCH PANEL, the same fault as the footer. Stephen,
       2026-09-18, with a screenshot of a search: the result titles, the AI
       Talent Network Login link and the consultation link were all navy on
       navy-deep. I fixed the footer that morning and should have audited every
       navy block then instead of the one in the screenshot. This time the
       shared layout was searched for every navy background: top bar, search
       panel, language list, mobile panel, table headers, calculator answer,
       footer. The last four were already handled; these three were not.
       Search result titles are white at rest and orange under the pointer,
       not orange at rest as Topbar.astro asks, because of the rule above. */
    .topbar a, .topbar a:link, .topbar a:visited,
    .search-panel a, .search-panel a:link, .search-panel a:visited,
    .lang-panel a, .lang-panel a:link, .lang-panel a:visited { color: #fff !important; }
    .search-panel .pagefind-ui__result-link { font-weight: 600; }
    .topbar a:hover, .topbar a:focus-visible,
    .search-panel a:hover, .search-panel a:focus-visible,
    .lang-panel a:hover, .lang-panel a:focus-visible { color: var(--orange) !important; }
    /* The home page hero is navy too. Its count links carry the big numbers,
       which inherit the link colour, so under the navy rule the numbers were
       navy on navy while their grey labels stayed visible. Found 2026-09-18
       when the strip was widened from four counts to eight. */
    .stage a, .stage a:link, .stage a:visited { color: #fff !important; }
    .stage a:hover, .stage a:focus-visible { color: var(--orange) !important; text-decoration: none; }
    /* The state maps carry a white-on-orange button inside their navy hover
       card. It is a button, so its text stays white in every state. */
    .ai-map-info a, .ai-map-info a:link, .ai-map-info a:visited,
    .ai-map-info a:hover, .ai-map-info a:focus-visible { color: #fff !important; text-decoration: none; }
    .site-foot a.f-cta, .site-foot a.f-cta:link, .site-foot a.f-cta:visited,
    .site-foot a.f-cta:hover, .site-foot a.f-cta:focus-visible { color: #fff !important; text-decoration: none; }
    .calc-answer a:hover, .mobile-panel a:hover, .site-head .main-nav a:hover, th a:hover,
    .calc-answer a:focus-visible, .mobile-panel a:focus-visible, .site-head .main-nav a:focus-visible { color: var(--orange) !important; }
    /* Buttons are not text links. They keep the brand block. */
    a.btn, a.btn:link, a.btn:visited { color: var(--navy) !important; }
    /* Orange-as-emphasis becomes weight, not colour. */
    .card .n, .calc-answer .verdict b, .ds-overdue, .ds-current { color: inherit !important; font-weight: 700; }
    /* THE CURRENT SECTION IN THE TOP NAV. Stephen, 2026-09-22: it rendered in
       near-black at weight 700, because it shared the rule above and inherited
       the body colour, so it read as a different font beside the navy items.
       It stays navy, one step heavier, with an orange underline as the marker:
       orange as a line, never as resting text. */
    .site-head .main-nav a[aria-current="page"] { color: var(--navy) !important; font-weight: 600;
      /* ONE LINE UNDER THE WHOLE LABEL. Stephen, 2026-09-25, with a screenshot:
         at a large text size the labels wrap ("Enterprise &" over
         "Governance") and text-decoration underlined each line separately,
         two orange dashes instead of one marker. A bottom border on the
         inline-block link draws once beneath the block however it wraps. */
      display: inline-block; text-decoration: none; padding-bottom: 3px;
      border-bottom: 2px solid var(--orange); }
    .mobile-panel a[aria-current="page"] { color: #fff !important; }
    main { min-height: 55vh; padding: 34px 22px 64px; }

    /* Sticky lives on the wrapper now, so the masthead is a plain block inside
       it and cannot pin itself underneath the topbar. */
    .site-sticky { position: sticky; top: 0; z-index: 1100; }
    .site-head { border-bottom: 3px solid var(--orange); background: #fff; }
    /* The topbar keeps position:sticky in its own component for the case where
       it is used outside this wrapper. Inside it, sticky-within-sticky would
       pin it against a parent that is exactly its own height, which is a no-op
       at best and a rounding-error jitter at worst. Specificity beats the
       component's scoped rule. */
    body .site-sticky .topbar { position: static; }
    .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px;
      padding-top: 14px; padding-bottom: 14px; }
    .logo svg { display: block; }
    .main-nav ul { display: flex; gap: 26px; list-style: none; margin: 0; padding: 0; }
    /* The full names carry meaning the one-word versions lose, so they show
       wherever there is room and collapse to the short form on narrow screens
       rather than wrapping the bar onto two lines. */
    .nav-short { display: none; }
    @media (max-width: 1180px) {
      .main-nav ul { gap: 20px; }
      .nav-full { display: none; }
      .nav-short { display: inline; }
    }
    .main-nav a { font-weight: 500; font-size: 15px; color: var(--navy); }
    .main-nav a[aria-current="page"] { color: var(--orange); }
    .nav-toggle { display: none; background: none; border: 0; cursor: pointer; padding: 8px; }
    .nav-toggle span { display: block; width: 24px; height: 2px; background: var(--navy);
      margin: 5px 0; transition: transform .25s, opacity .2s; }
    .nav-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle.open span:nth-child(2) { opacity: 0; }
    .nav-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .scrim { position: fixed; inset: 0; background: rgba(16,12,52,.55); opacity: 0;
      visibility: hidden; transition: opacity .25s; z-index: 998; }
    .scrim.open { opacity: 1; visibility: visible; }
    /* The closed panel sits off-screen at translateX(100%). A fixed element
       still contributes to scrollWidth there, so every mobile page could be
       dragged 69px sideways: measured 459px of scroll width in a 390px window.
       Nothing looked broken, the page just felt loose, which is the kind of
       defect that never gets reported and always gets noticed.

       overflow-x: clip rather than hidden, because hidden would make body a
       scroll container and break the sticky header above it. clip stops the
       overflow without creating one. */
    /* Applied to BOTH html and body. The panel is position:fixed, so it is
       contained by the viewport rather than by body, and clipping body alone
       left the document still 459px wide in a 390px window. Verified after. */
    html, body { overflow-x: clip; }
    .mobile-panel { position: fixed; top: 0; right: 0; height: 100%; width: min(84vw, 340px);
      background: var(--navy); transform: translateX(100%); transition: transform .3s;
      z-index: 999; padding: 70px 0 0; visibility: hidden; }
    .mobile-panel.open { transform: none; visibility: visible; }
    .mobile-panel ul { list-style: none; margin: 0; padding: 0; }
    .mobile-panel a { display: block; padding: 15px 26px; color: rgba(255,255,255,.9);
      font-weight: 500; border-left: 3px solid transparent; }
    .mobile-panel a[aria-current="page"], .mobile-panel a:hover { color: var(--orange);
      border-left-color: var(--orange); text-decoration: none; background: rgba(255,255,255,.05); }
    @media (max-width: 900px) { .main-nav { display: none; } .nav-toggle { display: block; } }

    .answer { background: var(--cream); border-left: 4px solid var(--orange); padding: 16px 20px;
      margin: 0 0 26px; font-size: 17px; }
    .meta-line { color: var(--gray); font-size: 14px; margin: 0 0 18px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px;
      list-style: none; margin: 22px 0; padding: 0; }
    .card { border: 1px solid #e6e6ee; border-top: 3px solid var(--navy); padding: 16px 18px;
      transition: border-color .15s, transform .15s; }
    .card:hover { border-top-color: var(--orange); transform: translateY(-2px); }
    .card a { color: var(--navy); font-weight: 600; }
    .card .n { color: var(--orange); font-weight: 700; }
    .card p { margin: 6px 0 0; font-size: 14px; color: var(--gray); }
    /* A WIDE TABLE MUST NOT ESCAPE ITS COLUMN. The content column is
       minmax(0, 1fr), but a table's intrinsic minimum width can still exceed
       that, and a table wider than its column paints out to the right and
       slides under the section rail: Stephen caught the MCP directory doing
       exactly that on 2026-08-31, with the rail card sitting on top of the
       description text.

       Two rules stopped it without touching a single page. Cells are allowed to
       break inside a long word, so a package id or a domain cannot force the
       table wide on its own. The second rule gave every table its own
       horizontal scroller by setting display:block on it, and that is the rule
       the block below had to undo: it bought the scroller by destroying the
       table box, which is too high a price. A table that is too wide now wraps.
       .tbl-scroll still exists for pages that wrap a table by hand, and that
       remains the correct way to get a scroller - a wrapper around the table,
       never a change to the table itself. */
    /* A TABLE MUST STAY ONE TABLE. The rule above set display:block on the
       table, which stops it being a table box at all: thead and tbody then take
       display:table each and become two INDEPENDENT tables that size their
       columns separately. On Andrew Ng's career timeline the header row put
       "Why it mattered" above the Event column, because the header text and the
       body text are different lengths and each half chose its own widths.
       Stephen, 2026-09-06: titles and data do not line up. It was every table
       in .main-col on the site, not one page.

       The table stays a table so one shared column model governs both halves.
       A table that is too wide now wraps rather than scrolls, which the rules
       below make it good at. Restoring a scroller means wrapping the table in
       its own element, never breaking the table box to get one.

       overflow-wrap:anywhere also has to go. It let the browser treat "2002" as
       having a min-content width of one character, so auto layout handed the
       year column almost no room and then shredded the year to fit what it had
       given: "20 / 02". The same thing broke a facility count into "24 / 8" on
       the operators table, in the SECOND column, which is why this is fixed for
       every cell rather than for the first one.

       break-word is the right value and anywhere is not. Both break a word that
       cannot fit, but only anywhere shrinks the column's min-content width to a
       single character first, which is what invites the shredding. With
       break-word a column is sized as though its words were unbreakable, so
       "2002" and "248" keep their natural width, and a genuinely unbreakable
       string - a long URL - still breaks rather than overflowing.

       No white-space:nowrap anywhere here. An earlier version of this fix put
       nowrap on the first column to protect years, which would have forced
       "Amazon Web Services" onto one line and made the operators table wider
       than the page. Sizing is the fix; pinning is not. Same fault as the
       operator tables in a7eef39, in a second and third place. */
    .main-col table { display: table; width: 100%; max-width: 100%; }
    th, td { overflow-wrap: break-word; }
    table { width: 100%; border-collapse: collapse; margin: 18px 0; font-size: 15px; }
    th { text-align: left; background: var(--navy); color: #fff; padding: 9px 12px;
      font-weight: 600; font-size: 13.5px; }
    td { padding: 9px 12px; border-bottom: 1px solid #ececf2; vertical-align: top; }
    tr:hover td { background: var(--cream); }
    /* Short cells stay on one line: a bill number, an ISO date, a count. The
       class is set per cell at build time by the cap-paragraphs pass in
       astro.config.mjs, only on cells of 14 characters or fewer, which is what
       keeps this from becoming the whole-column nowrap the note above warns
       against. From 700px up only: on a phone a wide table needs every break
       it can get. */
    @media (min-width: 700px) { td.nw, th.nw { white-space: nowrap; } }
    /* A table never leaves its column. The wrapper is added around every table
       at build time by the same pass in astro.config.mjs. The table inside is
       still a real table, so header and body share one column model; when it
       is wider than the column it scrolls here instead of sliding under the
       section menu, which is what it did on /mcp/ on 2026-09-18. The margin
       moves to the wrapper so spacing is unchanged. */
    .tbl-scroll { overflow-x: auto; max-width: 100%; margin: 18px 0; -webkit-overflow-scrolling: touch; }
    .tbl-scroll > table { margin: 0; }
    /* AND THE READER IS TOLD IT SCROLLS. Stephen, 2026-09-19, with a screenshot
       of /mcp/: text on the right is cut off. The wrapper added on 2026-09-18
       was doing its job, the All servers table scrolls inside its box rather
       than sliding under the section menu, but a clipped sentence with no edge,
       no shadow and no scrollbar until you touch it looks exactly like a bug.
       The reader cannot tell a scroller from a broken layout.

       Pure CSS, no script. Two background layers: a white pair pinned to each
       end that hides the shadow when there is nothing more that way, and a
       gradient pair on the table itself that shows through only while there is.
       background-attachment:local on the shadows is what does it; they move
       with the content, the covers do not. A table that fits shows neither.
       The scrollbar is also made permanent where the platform allows it, so on
       a trackpad Mac the bar does not fade out and leave the same doubt. */
    .tbl-scroll {
      background:
        linear-gradient(to right, #fff 30%, rgba(255,255,255,0)) left center / 40px 100% no-repeat,
        linear-gradient(to left, #fff 30%, rgba(255,255,255,0)) right center / 40px 100% no-repeat,
        radial-gradient(farthest-side at 0 50%, rgba(32,24,104,.22), rgba(32,24,104,0)) left center / 16px 100% no-repeat,
        radial-gradient(farthest-side at 100% 50%, rgba(32,24,104,.22), rgba(32,24,104,0)) right center / 16px 100% no-repeat;
      background-attachment: local, local, scroll, scroll;
      scrollbar-width: thin;
    }
    .tbl-scroll::-webkit-scrollbar { height: 10px; }
    .tbl-scroll::-webkit-scrollbar-thumb { background: #c9cddc; border-radius: 6px; }
    .tbl-scroll::-webkit-scrollbar-track { background: #f1f2f7; border-radius: 6px; }
    /* One long token with no space in it, a server id or a URL. Only these
       cells may break anywhere; every other cell keeps break-word, for the
       reason given in the long note above. */
    td.tok, th.tok { overflow-wrap: anywhere; }
    .badge { display: inline-block; background: var(--cream); color: var(--navy);
      border: 1px solid var(--orange); font-size: 12.5px; font-weight: 600; padding: 2px 10px;
      border-radius: 20px; }
    /* CALCULATORS. Stephen, 2026-08-31: the styling and formatting are
       terrible, walk the viewer through it, assume they know nothing. The
       old markup was a stack of bare labels, so the page read as one run-on
       line of jargon: "People with a licence Adoption, share who use it
       regularly (%) Hours saved per active user per week". Nothing told a
       reader what to type or why it mattered.

       The shape here is a form that teaches. Numbered steps, one question
       each, a plain-English hint under every field saying where the number
       comes from, and an answer panel that leads with the single figure the
       reader came for before showing the workings. These live in the layout
       so every calculator gets them without nineteen copies of the same CSS
       drifting apart. */
    .calc { border: 1px solid #e6e4de; border-radius: 12px; background: #fafaf6;
      padding: 4px 0 0; margin: 1.6em 0; overflow: hidden; }
    .calc-step { padding: 20px 24px; border-bottom: 1px solid #eceae4; }
    .calc-step:last-of-type { border-bottom: none; }
    .calc-step > h3 { margin: 0 0 4px; font-size: 15.5px; color: var(--navy);
      font-family: 'Poppins', system-ui, sans-serif; font-weight: 700; }
    .calc-step > h3 .num { display: inline-flex; align-items: center; justify-content: center;
      width: 22px; height: 22px; margin-right: 9px; border-radius: 50%;
      background: var(--navy); color: #fff; font-size: 12px; vertical-align: 1px; }
    .calc-step > p { margin: 0 0 14px 31px; font-size: 14px; color: #55555f; line-height: 1.55; }
    .calc-fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 16px 22px; margin-left: 31px; }
    @media (max-width: 600px) { .calc-fields, .calc-step > p { margin-left: 0; } }
    .calc-field label { display: block; font-size: 13.5px; font-weight: 600; color: #26262b;
      margin: 0 0 3px; }
    .calc-field input, .calc-field select { display: block; width: 100%; padding: 9px 11px;
      font-size: 16px; font-family: inherit; color: var(--ink); background: #fff;
      border: 1px solid #cfcdc6; border-radius: 7px; }
    .calc-field input:focus, .calc-field select:focus { outline: 2px solid var(--orange);
      outline-offset: 1px; border-color: var(--orange); }
    .calc-field .hint { display: block; margin: 5px 0 0; font-size: 12.5px; color: #7A8A9E;
      line-height: 1.5; }

    /* The answer. One number first, at a size that says it is the point of
       the page, then the arithmetic behind it, then a sentence in plain
       words. A reader who stops after the first line still has their answer. */
    .calc-answer { background: var(--navy); color: #fff; padding: 22px 24px; }
    .calc-answer .headline { color: #c9c8e0; margin: 0 0 2px;
      text-transform: uppercase; letter-spacing: .1em; font-size: 11.5px; font-weight: 700; }
    .calc-answer .big { font-size: 30px; line-height: 1.2; font-weight: 700; color: #fff;
      margin: 0 0 4px; font-family: 'Lora', Georgia, serif; }
    .calc-answer .big small { font-size: 17px; font-weight: 400; color: #c9c8e0; }
    .calc-answer .rows { margin: 14px 0 0; border-top: 1px solid rgba(255,255,255,.22); }
    .calc-answer .rows div { display: flex; justify-content: space-between; gap: 18px;
      padding: 7px 0; border-bottom: 1px solid rgba(255,255,255,.12); font-size: 14.5px; }
    .calc-answer .rows div:last-child { border-bottom: none; }
    .calc-answer .rows span:first-child { color: #c9c8e0; }
    .calc-answer .rows span:last-child { font-weight: 600; text-align: right; }
    .calc-answer .verdict { margin: 14px 0 0; padding: 11px 13px; border-radius: 7px;
      background: rgba(255,255,255,.1); font-size: 14.5px; line-height: 1.6; }
    .calc-answer .verdict b { color: var(--orange); }
    .calc-answer a { color: #fff; }

    .cite-box { border: 1px dashed var(--gray); padding: 14px 18px; margin: 30px 0 0;
      font-size: 13.5px; color: var(--gray); }
    /* A source link the checker has confirmed dead. The build turns the
       anchor into this span (see astro.config.mjs, neutraliseDeadLinks): the
       name stays so the citation still reads, the underline goes dotted so a
       reader can see it is not a link, and the title says why. */
    .dead-link { color: var(--gray); text-decoration: underline dotted; cursor: help; }
    .cite-box code { color: var(--ink); font-size: 13px; }
    /* CITE THIS PAGE, WITH A SCHEME. Stephen, 2026-09-20, having landed on
       /ai-lawsuits/noel-v-perplexity-ai/theworldofai.org/ai-lawsuits/noel-v-perplexity-ai/
       which 404s.

       The page's links were all correct. The cite box was the problem. It
       printed the URL with no scheme, as theworldofai.org/ai-lawsuits/slug/.
       Phone browsers, mail clients and chat apps auto-linkify a bare domain,
       and with no scheme they resolve it RELATIVE to the page being read, so
       the current URL plus that text gives the doubled path.

       Every cite box on this site had it: lawsuits, laws, companies,
       compliance, benchmarks, downloads, skills, sources, compute, the
       state-of-AI-laws report, and the two written on 2026-09-19 for the
       learning entries and the hub pages, which inherited it by copying the
       pattern. Roughly thirty templates.

       ONE RULE HERE RATHER THAN THIRTY EDITS. Every box already writes the
       bare domain in the same shape, so the scheme is added on render. A
       template that later writes a full URL itself would double it, so the
       convention is now: cite boxes carry the domain and path, never the
       scheme. Stated here because this is where it is enforced.

       It also makes the citation work as a citation. A reader pastes it and a
       model resolves it without guessing the protocol, so the missing scheme
       was costing citations as well as producing 404s.

       Copy behaviour is the reason this is ::before on the code element and
       not a wrapper span: selecting the line and copying takes the generated
       text along with it in every current browser. */
    .cite-box code::before { content: "https://"; }
    .btn { display: inline-block; background: var(--orange); color: var(--navy); font-weight: 700;
      padding: 12px 22px; font-size: 14px; letter-spacing: .04em; }
    .btn:hover { background: #ff8c1a; text-decoration: none; }
    .home-hero { padding: 26px 0 8px; max-width: 780px; }
    .home-hero p.lead { font-size: 18.5px; }
    .stat-row { display: flex; gap: 34px; flex-wrap: wrap; margin: 26px 0 8px; }
    .stat b { display: block; font-family: 'Lora', serif; font-size: 34px; color: var(--navy);
      line-height: 1.1; }
    .stat span { color: var(--gray); font-size: 14px; }
  
    /* SCROLL CHOREOGRAPHY, sitewide.
       Sections rise a short distance and fade as they enter. Two rules keep it
       from becoming the thing you notice: it happens ONCE per element, and the
       distance is 14px rather than the 60px that makes a page feel like it is
       assembling itself while you read.

       Content is visible by default and the class is added by script, so a
       reader without JavaScript, a crawler, or anyone with reduced motion sees
       a normal page rather than a blank one. That ordering is the whole safety
       of the pattern: an animation that hides content until JS runs is a
       content-blocking bug wearing a design costume. */
    @media (prefers-reduced-motion: no-preference) {
      .reveal-armed { opacity: 0; transform: translateY(14px); }
      .reveal-in {
        opacity: 1; transform: none;
        transition: opacity .5s cubic-bezier(.22,.61,.36,1), transform .5s cubic-bezier(.22,.61,.36,1);
      }
    }
</style>
</body>

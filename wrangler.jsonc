// Worker for theworldofai.org.
//
// HISTORY WORTH KEEPING. This file used to be assets-only with no "main", and
// the comment said its presence was load-bearing: without it, `wrangler deploy`
// auto-configured the project, ran `astro add cloudflare`, and converted the
// build to SSR, which breaks the node:fs reads the pages use at build time.
//
// That risk was auto-configuration, not the existence of a worker script. With
// "main" set EXPLICITLY here, wrangler deploys ./dist as static assets and runs
// src/worker.ts in front of them; it changes nothing about how Astro builds.
// The site is still a static build. The Worker exists for exactly one route.
//
// ASSETS.fetch handles every path except /api/ask, so a bug in the assistant
// cannot take the site down: the worst case is one endpoint returning 503 while
// 5,884 pages carry on serving.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twoai-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "ai": {
    "binding": "AI"
  },
  // Weekly talent match digest (Monday 14:00 UTC, after the 11:00 pipeline
  // run has refreshed listings and matches).
  "triggers": { "crons": ["0 14 * * 1"] },
  // Per-IP rate limit for /api/ask. The endpoint now spends real money on
  // every request (Claude Haiku via the Anthropic API), so an unthrottled
  // loop is a direct budget-drain vector. 10 questions a minute is generous
  // for a person and fatal to a naive script. Open-beta binding; the Worker
  // guards for its absence so a config regression degrades to unlimited
  // rather than to 500s.
  "unsafe": {
    "bindings": [
      {
        "name": "ASK_RATE",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      },
      // Talent Network write path. 5/min per IP: a person filling a form
      // never hits it, and every signup costs an Inkbox send against a
      // 100-recipient/day org quota, so the ceiling protects the mail budget.
      {
        "name": "TALENT_RATE",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "twoai-pages"
    }
  ],
  "d1_databases": [
    {
      "binding": "ASSISTANT_DB",
      "database_name": "twoai-assistant",
      "database_id": "db78dab4-42ea-4704-9cd0-3adeacebefe4"
    }
  ],
  // Talent Network resumes. PRIVATE by contract: this bucket must never gain
  // public access or appear in any content/export path. It exists separately
  // from the content bus precisely so that "in the bucket" can never be
  // mistaken for "publishable" — the synced_tools incident was that exact
  // class of failure, and PII is the one place it must be structurally
  // impossible rather than procedurally avoided.
  "r2_buckets": [
    {
      "binding": "TALENT_R2",
      "bucket_name": "twoai-talent"
    }
  ]
}
